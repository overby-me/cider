# Buck2 project config for the gradual Buck2 port (plan/buck2-port.md).
#
# No prelude: every rule Darling's BUCK files use is defined in buck/rules/*.bzl,
# and the toolchains in buck/toolchains/*.bzl. That is deliberate -- the Nix
# endpoint (overby.me nix/lib/buck2) interprets the Starlark itself and cannot
# eat Meta's buck2-prelude, and Darling's linking (MIG, reexport, install_name,
# the firstpass umbrella) needs custom rules regardless.

[cells]
root = .
toolchains = buck/toolchains

[buildfile]
name = BUCK

[project]
# Never crawl: VCS metadata, direnv/nix outputs (result* are symlinks INTO the
# nix store -- following them would walk the whole closure), buck2's own output,
# and the cmake build dir.
ignore = .jj, .git, .direnv, .claude, buck-out, build, result, result-*, __pycache__

[buck2]
# watchman (see .watchmanconfig). Two other backends were tried:
#
#  - `notify` (the default) registers ONE recursive watch on the project root
#    BEFORE consulting [project] ignore, so it walks into the `result-*` symlinks
#    (which point into the nix store, where a mode-000 dir inside a built prefix
#    makes it fail with EACCES) and refuses to start.
#  - `fs_hash_crawler` honors the ignore list and works, but re-hashes the tree on
#    every command: once buck-src held ~107 MB of materialized pins (which are
#    real build inputs and so cannot be ignored), the no-op floor went from ~1.0 s
#    to ~2.9 s.
#
# watchman does not descend into symlinks, so the `result-*` problem does not
# arise, and it keeps state between commands: no-op 0.01 s, one-file edit 0.32 s.
file_watcher = watchman
