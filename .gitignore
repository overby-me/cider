# Python bytecode cache (nix-ninja build helpers)
__pycache__/
*.pyc

# The duct-tape XNU subset is a PIN now, not vendored source (batch B). It is materialised
# into place from its own pin store: by scripts/buck-src.nu for a direct buck2 build, and by
# materializePins in nix/lib/ciderBuck2Graph.nix inside the Nix graph derivation. The pin
# carries the whole of XNU rather than the 1,974 file subset that used to be committed here,
# and patches/xnu-sys-xnu holds the delta that made the vendored copy differ from upstream.
/vendor/pins/ciderd/xnu-sys/xnu/

# The cargo build directory of the graph-specs tool (#99). NOT a blanket `target/` rule: 83
# TRACKED paths in this repo contain a /target/ component, all of them upstream, and a blanket
# rule would quietly untrack every one of them.
/src/linux/buildtools/graph-specs/target/
/src/linux/buildtools/skeleton/target/
/src/linux/buildtools/src-normalise/target/
/nix/lib/dyn-actions-spec-fixup/target/

# Editor state. .vscode/launch.json was TRACKED until the release prep; the build already
# excludes the directory so an editor cannot invalidate a derivation, and now it cannot be
# committed either.
.vscode/

# Scratch output from debugging runs. outputs/out/ held an empty loop.out and a 482 byte
# strace and was COMMITTED until the release prep.
/outputs/

# A 250 byte boot log that was sitting at the repository root.
/.dfx-boot.log
