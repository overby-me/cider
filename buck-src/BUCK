# Security's exported-symbols list, preprocessed out of Security.exp-in exactly as the
# reference does. Both passes link with -exported_symbols_list, and that is what pulls the
# static archives' members in: nothing in Security_obj references SSLRead, so without the
# list ld drops libsecurity_ssl entirely and every consumer of CFNetwork's TLS path comes
# out undefined.
preprocess_gen(
    name = "security_exp",
    src = "security/Security.exp-in",
    srcs = ["security/CSSMOID.exp-in"],
    out = "Security.x86_64.exp",
    language = "objective-c",
    flags = [
        "-D__KEYCHAINCORE__=1",
        "-DCORECRYPTO_DONOT_USE_TRANSPARENT_UNION=1",
        "-DSECUREOBJECTSYNC=1",
        "-DSHAREDWEBCREDENTIALS=0",
        "-DPLATFORM=macOS",
        "-DSECURITY_BUILD_VERSION=\"0\"",
        "-DNDEBUG=1",
        "-DPRIVATE",
        "-DDTRACE_PROBES_DISABLED=1",
        "-D_LIBC_NO_FEATURE_VERIFICATION",
    ],
    deps = [
        "//darwin:sdk_env",
        ":Security_inc_libcxxabi_include",
        ":Security_inc_security_darling_include",
        ":Security_inc_security",
    ],
    visibility = ["PUBLIC"],
)

