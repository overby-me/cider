    server_suffix = "Server.c",
    sheader_suffix = "Server.h",
    xtrace_suffix = "XtraceMig.c",
    xtrace_srcs = ["firehoseXtraceMig.c"],
    mig_sh = "//buck-src:mig.sh",
    migcom = "//buck-src:migcom",
    deps = [
        "//darwin:sdk_env",
    ],
