# nghttp2ver.h, which cmake writes at CONFIGURE time rather than building: two version
# placeholders, and curl includes it through the SDK's nghttp2 directory. Hand-written
# because the generator reads build edges and this is not one -- the same shape as
# src/include's darling-config.h.
configure_file(
    name = "nghttp2ver",
    out = "nghttp2/nghttp2ver.h",
    src = "nghttp2/lib/includes/nghttp2/nghttp2ver.h.in",
    values = {
        # From nghttp2's own project() version, 1.41.90, and cmake's HexVersion of it:
        # (major << 16) | (minor << 8) | patch.
        "PACKAGE_VERSION": "1.41.90",
        "PACKAGE_VERSION_NUM": "0x01295a",
    },
    visibility = ["PUBLIC"],
)



