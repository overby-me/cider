# libsecurity_utilities generates its OWN mach_notify stubs, from its own copy of
# mach_notify.defs -- not the one duct-tape generates for the kernel side. The two
# differ: this one is built with the Security define set, so its request/reply
# structures match what the Security code expects to receive.
#
# The generated header is included bare (`#include <mach_notifyServer.h>`), so the
# consumer needs the mig output on its include path, which it gets by taking this
# target as a gen: dep in buck/generated/extra-deps.json.
mig_gen(
    name = "security_utilities_mig_notify",
    defs = "security/OSX/libsecurity_utilities/lib/mach_notify.defs",
    out_base = "security/OSX/libsecurity_utilities/lib",
    user_suffix = "User.c",
    header_suffix = ".h",
    server_suffix = "Server.c",
    sheader_suffix = "Server.h",
    xtrace_suffix = "XtraceMig.c",
    compile_srcs = [
        "mach_notifyServer.c",
    ],
    xtrace_srcs = ["mach_notifyXtraceMig.c"],
    mig_sh = "//buck-src:mig.sh",
    migcom = "//buck-src:migcom",
    # The SAME include roots and defines the compiles use: mig runs the C
    # preprocessor over the .defs, and a different define set yields a different
    # protocol.
    deps = [
        "//darwin:sdk_env",
        ":security_utilities_inc_libcxxabi_include",
        ":security_utilities_inc_security_darling_include",
        ":security_utilities_inc_security",
        "//buck-src:fw_CoreFoundation",
    ],
    visibility = ["PUBLIC"],
)

# libsecurityd's two protocols. Consumers include <securityd_client/ucsp.h> while mig
# writes plain ucsp.h, so each header gets an alias link inside the output dir -- the
# same bridge src/external/security/OSX/libsecurityd/CMakeLists.txt builds with
# create_symlink().
mig_gen(
    name = "securityd_client_mig_ucsp",
    defs = "security/OSX/libsecurityd/mig/ucsp.defs",
    out_base = "security/OSX/libsecurityd/mig",
    user_suffix = "Client.cpp",
    header_suffix = ".h",
    server_suffix = "Server.cpp",
    sheader_suffix = "Server.h",
    xtrace_suffix = "XtraceMig.c",
    compile_srcs = [
        "ucspClient.cpp",
    ],
    xtrace_srcs = ["ucspXtraceMig.c"],
    alias_links = {"securityd_client/ucsp.h": "../ucsp.h"},
    # ss_types.defs is #included by ucsp.defs, and mig resolves that through the C
    # preprocessor: declaring it is what makes buck2 rebuild when it changes.
    extra_defs = ["security/OSX/libsecurityd/mig/ss_types.defs"],
    mig_sh = "//buck-src:mig.sh",
    migcom = "//buck-src:migcom",
    deps = [
        "//darwin:sdk_env",
        ":securityd_client_inc_libcxxabi_include",
        ":securityd_client_inc_security_darling_include",
        ":securityd_client_inc_security",
        "//buck-src:fw_CoreFoundation",
    ],
    visibility = ["PUBLIC"],
)

mig_gen(
    name = "securityd_client_mig_ucspnotify",
    defs = "security/OSX/libsecurityd/mig/ucspNotify.defs",
    out_base = "security/OSX/libsecurityd/mig",
    user_suffix = "Sender.cpp",
    header_suffix = ".h",
    server_suffix = "Receiver.cpp",
    sheader_suffix = "Server.h",
    xtrace_suffix = "XtraceMig.c",
    compile_srcs = [
        "ucspNotifySender.cpp",
    ],
    xtrace_srcs = ["ucspNotifyXtraceMig.c"],
    alias_links = {"securityd_client/ucspNotify.h": "../ucspNotify.h"},
    mig_sh = "//buck-src:mig.sh",
    migcom = "//buck-src:migcom",
    deps = [
        "//darwin:sdk_env",
        ":securityd_client_inc_libcxxabi_include",
        ":securityd_client_inc_security_darling_include",
        ":securityd_client_inc_security",
        "//buck-src:fw_CoreFoundation",
    ],
    visibility = ["PUBLIC"],
)

# ocspd's protocol. Its user/server suffixes are underscored where the others are
# camel-cased, which is a property of the cmake call, not a convention.
mig_gen(
    name = "security_ocspd_mig",
    defs = "security/OSX/libsecurity_ocspd/mig/ocspd.defs",
    out_base = "security/OSX/libsecurity_ocspd/mig",
    user_suffix = "_client.cpp",
    header_suffix = ".h",
    server_suffix = "_server.cpp",
    sheader_suffix = "Server.h",
    xtrace_suffix = "XtraceMig.c",
    compile_srcs = [
        "ocspd_client.cpp",
        "ocspd_server.cpp",
    ],
    xtrace_srcs = ["ocspdXtraceMig.c"],
    mig_sh = "//buck-src:mig.sh",
    migcom = "//buck-src:migcom",
    deps = [
        "//darwin:sdk_env",
        ":security_ocspd_inc_libcxxabi_include",
        ":security_ocspd_inc_security_darling_include",
        ":security_ocspd_inc_security",
        "//buck-src:fw_CoreFoundation",
    ],
    visibility = ["PUBLIC"],
)

# The SDK's libxml2 as <libxml/*.h>. The reference puts
# -I<sdk>/usr/include/libxml2 on the targets that need it, and that directory is a
# farm of links into this pin -- MOST into the checked-out headers, but xmlversion.h
# and a few others into "Pregenerated Files", which is what configure would have
# produced. A single glob would take one of the two and quietly miss the rest, so
# the map mirrors the farm link for link.
cc_header_root(
    name = "sdk_libxml2",
    header_map = {
        "libxml/DOCBparser.h": "libxml2/libxml2/include/libxml/DOCBparser.h",
        "libxml/HTMLparser.h": "libxml2/libxml2/include/libxml/HTMLparser.h",
        "libxml/HTMLtree.h": "libxml2/libxml2/include/libxml/HTMLtree.h",
        "libxml/SAX.h": "libxml2/libxml2/include/libxml/SAX.h",
        "libxml/SAX2.h": "libxml2/libxml2/include/libxml/SAX2.h",
        "libxml/c14n.h": "libxml2/libxml2/include/libxml/c14n.h",
        "libxml/catalog.h": "libxml2/libxml2/include/libxml/catalog.h",
        "libxml/chvalid.h": "libxml2/libxml2/include/libxml/chvalid.h",
        "libxml/debugXML.h": "libxml2/libxml2/include/libxml/debugXML.h",
        "libxml/dict.h": "libxml2/libxml2/include/libxml/dict.h",
        "libxml/encoding.h": "libxml2/libxml2/include/libxml/encoding.h",
        "libxml/entities.h": "libxml2/libxml2/include/libxml/entities.h",
        "libxml/globals.h": "libxml2/libxml2/include/libxml/globals.h",
        "libxml/hash.h": "libxml2/libxml2/include/libxml/hash.h",
        "libxml/list.h": "libxml2/libxml2/include/libxml/list.h",
        "libxml/nanoftp.h": "libxml2/libxml2/include/libxml/nanoftp.h",
        "libxml/nanohttp.h": "libxml2/libxml2/include/libxml/nanohttp.h",
        "libxml/parser.h": "libxml2/libxml2/include/libxml/parser.h",
        "libxml/parserInternals.h": "libxml2/libxml2/include/libxml/parserInternals.h",
        "libxml/pattern.h": "libxml2/libxml2/include/libxml/pattern.h",
        "libxml/relaxng.h": "libxml2/libxml2/include/libxml/relaxng.h",
        "libxml/schemasInternals.h": "libxml2/libxml2/include/libxml/schemasInternals.h",
        "libxml/schematron.h": "libxml2/libxml2/include/libxml/schematron.h",
        "libxml/threads.h": "libxml2/libxml2/include/libxml/threads.h",
        "libxml/tree.h": "libxml2/libxml2/include/libxml/tree.h",
        "libxml/uri.h": "libxml2/libxml2/include/libxml/uri.h",
        "libxml/valid.h": "libxml2/libxml2/include/libxml/valid.h",
        "libxml/xinclude.h": "libxml2/libxml2/include/libxml/xinclude.h",
        "libxml/xlink.h": "libxml2/libxml2/include/libxml/xlink.h",
        "libxml/xmlIO.h": "libxml2/libxml2/include/libxml/xmlIO.h",
        "libxml/xmlautomata.h": "libxml2/libxml2/include/libxml/xmlautomata.h",
        "libxml/xmlerror.h": "libxml2/libxml2/include/libxml/xmlerror.h",
        "libxml/xmlexports.h": "libxml2/libxml2/include/libxml/xmlexports.h",
        "libxml/xmlmemory.h": "libxml2/libxml2/include/libxml/xmlmemory.h",
        "libxml/xmlmodule.h": "libxml2/libxml2/include/libxml/xmlmodule.h",
        "libxml/xmlreader.h": "libxml2/libxml2/include/libxml/xmlreader.h",
        "libxml/xmlregexp.h": "libxml2/libxml2/include/libxml/xmlregexp.h",
        "libxml/xmlsave.h": "libxml2/libxml2/include/libxml/xmlsave.h",
        "libxml/xmlschemas.h": "libxml2/libxml2/include/libxml/xmlschemas.h",
        "libxml/xmlschemastypes.h": "libxml2/libxml2/include/libxml/xmlschemastypes.h",
        "libxml/xmlstring.h": "libxml2/libxml2/include/libxml/xmlstring.h",
        "libxml/xmlunicode.h": "libxml2/libxml2/include/libxml/xmlunicode.h",
        "libxml/xmlversion.h": "libxml2/Pregenerated Files/include/libxml/xmlversion.h",
        "libxml/xmlwriter.h": "libxml2/libxml2/include/libxml/xmlwriter.h",
        "libxml/xpath.h": "libxml2/libxml2/include/libxml/xpath.h",
        "libxml/xpathInternals.h": "libxml2/libxml2/include/libxml/xpathInternals.h",
        "libxml/xpointer.h": "libxml2/libxml2/include/libxml/xpointer.h",
    },
    visibility = ["PUBLIC"],
)


# IOKit's four mig protocols. iokitmig is generated TWICE from one definition, once per
# arch, because iokitmig.c #includes iokitmig64.c or iokitmig32.c depending on __LP64__ --
# so both spellings have to exist even in a 64-bit-only build. The other two are compiled
# directly, through gen_srcs.

mig_gen(
    name = "IOKit_mig_iokitmig32",
    defs = "IOKitUser/iokitmig.defs",
    out_base = "IOKitUser",
    arch = "i386",
    user_suffix = "32.c",
    header_suffix = "32.h",
    server_suffix = "Server32.c",
    sheader_suffix = "Server32.h",
    xtrace_suffix = "XtraceMig32.c",
    compile_srcs = [
    ],
    mig_sh = "//buck-src:mig.sh",
    migcom = "//buck-src:migcom",
    # The directory's COMPILE_DEFINITIONS, which mig runs the preprocessor with. Without
    # -DIOKIT the .defs preprocesses down to almost nothing: the generated user stub came
    # out 2.8K instead of the full routine set, and IOKit's link was missing every io_*.
    mig_flags = [
        "-DAPPLE",
        "-DDISPATCH_MACH_SPI=1",
        "-DHAVE_CFPLUGIN",
        "-DHAVE_CFURLACCESS",
        "-DIOKIT",
        "-DOS_CRASH_ENABLE_EXPERIMENTAL_LIBTRACE=1",
        "-DPRIVATE",
        "-D_ANSI_C_SOURCE",
        "-D_DARWIN_NO_64_BIT_INODE=1",
        "-D_LIBC_NO_FEATURE_VERIFICATION",
        "-D__MigTypeCheck=1",
        "-Dvolatile=__volatile",
    ],
    deps = [
        "//darwin:sdk_env",
        ":IOKit_inc_IOKitUser",
        "//buck-src:fw_CoreFoundation",
    ],
    visibility = ["PUBLIC"],
)

mig_gen(
    name = "IOKit_mig_iokitmig64",
    defs = "IOKitUser/iokitmig.defs",
    out_base = "IOKitUser",
    arch = "x86_64",
    user_suffix = "64.c",
    header_suffix = "64.h",
    server_suffix = "Server64.c",
    sheader_suffix = "Server64.h",
    xtrace_suffix = "XtraceMig64.c",
    compile_srcs = [
    ],
    mig_sh = "//buck-src:mig.sh",
    migcom = "//buck-src:migcom",
    # The directory's COMPILE_DEFINITIONS, which mig runs the preprocessor with. Without
    # -DIOKIT the .defs preprocesses down to almost nothing: the generated user stub came
    # out 2.8K instead of the full routine set, and IOKit's link was missing every io_*.
    mig_flags = [
        "-DAPPLE",
        "-DDISPATCH_MACH_SPI=1",
        "-DHAVE_CFPLUGIN",
        "-DHAVE_CFURLACCESS",
        "-DIOKIT",
        "-DOS_CRASH_ENABLE_EXPERIMENTAL_LIBTRACE=1",
        "-DPRIVATE",
