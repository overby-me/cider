# The generated darlingserver rpc.c, compiled for the STATIC (dyld) tier.
# Same shape as emulation_rpc_obj but with emulation_dyld's flags: the source
# needs dserver-rpc-defs.h force-included, which no other source in the group
# wants, so it cannot share their cc_objects.
cc_objects(
    name = "emulation_dyld_rpc_obj",
    gen_srcs = ["//src/external/darlingserver:dserver_rpc"],
    prefix_headers = [
        "//buck-src/xnu:darling_src_libsystem_kernel_emulation_include_linux_premigration_resources_dserver-rpc-defs.h",
    ],
    compiler_flags = [
        "-DBSDTHREAD_WRAP_LINUX_PTHREAD",
        "-DEMULATED_OSPRODUCTVERSION=\"14.4.1\"",
        "-DEMULATED_OSVERSION=\"23E224\"",
        "-DEMULATED_RELEASE=\"23.4.0\"",
        "-DEMULATED_SYSNAME=\"Darwin\"",
        "-DEMULATED_VERSION=\"Darwin Kernel Version 23.4.0\"",
        "-std=gnu99",
        "-fvisibility=hidden",
        "-fPIC",
        "-fno-builtin",
        "-ggdb",
        "-Wno-int-conversion",
        "-Wno-compare-distinct-pointer-types",
        "-ffunction-sections",
        "-DVARIANT_DYLD",
    ],
    toolchain = "toolchains//:darwin_cc",
    deps = [
        "//darwin:sdk_env",
        "//src/startup:rtsig_header",
        "//buck-src/xnu:emulation_included_sources",
        "//src/include:darling_config",
        "//src/external/darlingserver:dserver_headers",
        "//buck-src/xnu:emulation_dyld_inc_xnu_darling_src_libsystem_kernel",
        "//src/libsimple:libsimple_headers",
    ],
    visibility = ["PUBLIC"],
)





