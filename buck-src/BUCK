    name = "shell_cmds_expr_parser",
    src = "shell_cmds/expr/expr.y",
    out_c = "expr.c",
    out_h = "expr.h",
)

# find's date parser keeps the find_ prefix cmake gives it, because shell_cmds builds
# every tool into one directory and getdate.c would collide.
