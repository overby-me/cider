# ---------------------------------------------------------------------------
# libsystem_c, the firstpass pass.
#
# The object libraries are exactly the set the reference link edge names -- not
# every libc-* group. libc ships ALTERNATES of the same sources (the `_dyld`
# variants are for libsystem_dyld), so linking all of them gives ~190 duplicate
# symbols; the link edge is the authority on the subset.
#
# Each cmake object library can be several targets here, one per flag group,
# because cmake gives individual files their own defines.
#
# Not linked: kqueue -- see plan/buck2-port.md.
#
# A firstpass dylib resolves nothing, which is what makes it buildable before
# libsystem_kernel exists.
# ---------------------------------------------------------------------------
darwin_dylib(
    name = "system_c_firstpass",
    dylib_name = "libsystem_c_firstpass.dylib",
    firstpass = True,
    install_name = "/usr/lib/system/libsystem_c.dylib",
    objs = [
        # libc-db
        ":libc-db_obj",
        # libc-compat (5 flag groups)
        ":libc-compat_obj",
        ":libc-compat_obj2",
        ":libc-compat_obj3",
        ":libc-compat_obj4",
        ":libc-compat_obj5",
        # libc-compat_cancelable (2 flag groups)
        ":libc-compat_cancelable_obj",
        ":libc-compat_cancelable_obj2",
        # libc-emulated
        ":libc-emulated_obj",
        # libc-gdtoa
        ":libc-gdtoa_obj",
        # libc-gen (25 flag groups)
        ":libc-gen_obj",
        ":libc-gen_obj2",
        ":libc-gen_obj3",
        ":libc-gen_obj4",
        ":libc-gen_obj5",
        ":libc-gen_obj6",
        ":libc-gen_obj7",
        ":libc-gen_obj8",
        ":libc-gen_obj9",
        ":libc-gen_obj10",
        ":libc-gen_obj11",
        ":libc-gen_obj12",
