        "-D_DARWIN_NO_64_BIT_INODE=1",
        "-D_LIBC_NO_FEATURE_VERIFICATION",
        "-D__MigTypeCheck=1",
        "-Dvolatile=__volatile",
    ],
    deps = [
        "//darwin:sdk_env",
        ":IOKit_inc_IOKitUser",
        "//buck-src:fw_CoreFoundation",
    ],
    visibility = ["PUBLIC"],
)

