load("//buck/rules:cc.bzl", "cc_header_root", "cc_objects")
load("//buck/rules:files.bzl", "export_file")

# Targets over the copyfile pin, materialized by scripts/buck-src.sh. The tree
# itself is gitignored (content is pinned in nix/submodules.json); this file is
# committed. One package per pin keeps what the Nix-lowered path has to parse
# small enough to evaluate (plan/buck2-port.md phase 3).

# BEGIN generated: system_copyfile
# GENERATED from the reference build.ninja by
# scripts/gen-buck-from-ninja.py system_copyfile   -- review before committing.
# cmake target: system_copyfile  ->  system_copyfile

cc_header_root(
    name = "system_copyfile_inc_copyfile",
    headers = glob(["*.h", "**/*.h"]),
    root = "",
    visibility = ["PUBLIC"],
)

cc_objects(
    name = "system_copyfile_obj",
    srcs = [
        "copyfile.c",
        "xattr_flags.c",
    ],
    compiler_flags = [
        "-DHAVE_STDINT_H=1",
        "-DPRIVATE=1",
        "-D_LIBC_NO_FEATURE_VERIFICATION",
        "-Dsystem_copyfile_EXPORTS",
        "-fblocks",
        "-fPIC",
        "-w",
        "-nostdinc",
    ],
    toolchain = "toolchains//:darwin_cc",
    deps = [
        "//darwin:sdk_env",
        ":system_copyfile_inc_copyfile",
    ],
    visibility = ["PUBLIC"],
)
# END generated: system_copyfile

# BEGIN generated: pin exports
load("//buck/generated:exports_copyfile.bzl", "EXPORTS")

# One export_file per file another package names by label, from the list
# scripts/buck-exports.py keeps.
[
    export_file(name = _n, src = _s, visibility = ["PUBLIC"])
    for _n, _s in EXPORTS.items()
]
# END generated: pin exports
