# BEGIN generated: platform_64bit
# GENERATED from the reference build.ninja by
# scripts/gen-buck-from-ninja.py platform_64bit   -- review before committing.
# cmake target: platform_64bit  ->  src/external/libplatform/platform_64bit
# TODO these include dirs are GENERATED (codegen output):
#   src/external/libplatform/os/resolver

# Sibling include dirs, staged as ONE tree with -I into each: headers here
# reach each other with `#include "../<dir>/x.h"`, which only resolves if
# the sibling is in the same staged tree.
cc_header_root(
    name = "platform_64bit_inc_libplatform",
    headers = glob([
        "internal/*.h",
        "internal/**/*.h",
        "private/*.h",
        "private/**/*.h",
        "include/*.h",
        "include/**/*.h",
    ]),
    root = "",
    include_subdirs = [
        "internal",
        "private",
        "include",
    ],
    visibility = ["PUBLIC"],
)

