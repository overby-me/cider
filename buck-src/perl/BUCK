load("//buck/rules:cc.bzl", "cc_header_root", "cc_objects", "cc_static_lib")
load("//buck/rules:codegen.bzl", "configure_file")
load("//buck/rules:darwin.bzl", "darwin_binary", "darwin_dylib")
load("//buck/rules:files.bzl", "export_file")
load("//buck/rules:install.bzl", "prefix_dir")

# Targets over the perl pin, materialized by scripts/buck-src.nu. The tree
# itself is gitignored (content is pinned in nix/submodules.json); this file is
# committed. One package per pin keeps what the Nix-lowered path has to parse
# small enough to evaluate.
#
# Two perls live here, 5.18 and 5.28, and their module basenames are IDENTICAL --
# Cwd.bundle, POSIX.bundle and 50 more exist in both. Only the cmake target name
# tells them apart (perl5.18_Cwd_Cwd vs perl5.28_Cwd_Cwd), so drive the generator
# by target name and never by artifact.

# HAND-WRITTEN, deliberately outside the generated blocks so --write does not drop it.
#
# versions.h, which the `perl` wrapper's only source includes. cmake writes it with
# configure_file() from cmake/versioner.cmake, at CONFIGURE time -- so no ninja edge
# produces it and the generator can only report the include dir as "GENERATED (codegen
# output)". The values are versioner(perl "5.18;5.28" "5.18") expanded by hand: VERSIONS is
# built by appending ` "<v>",` per version, which is why it carries a trailing comma.
# versioner.c and its template, which python's wrapper needs too. cmake/versioner.cmake
# builds every project's version-dispatch wrapper out of this ONE source, so the files are
# perl's and python's dependency; CROSS_PACKAGE_SRCS in gen-buck-from-ninja.py maps the
# source path to the label, and python's own configure_file names the template.
export_file(
    name = "versioner_c",
    src = "versioner/versioner.c",
    visibility = ["PUBLIC"],
)

export_file(
    name = "versions_h_in",
    src = "versioner/versions.h.in",
    visibility = ["PUBLIC"],
)

configure_file(
    name = "perl_versions_h",
    out = "versions.h",
    src = "versioner/versions.h.in",
    values = {
        "DEFAULTVERSION": "5.18",
        "NVERSIONS": "2",
        "PROJECT": "perl",
        "UPROJECT": "PERL",
        "VERSIONS": " \"5.18\", \"5.28\",",
    },
    visibility = ["PUBLIC"],
)

