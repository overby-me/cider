    install_name = "/usr/lib/system/libremovefile.dylib",
    objs = [
        ":removefile_obj",
    ],
    toolchain = "toolchains//:darwin_cc",
    deps = ["//darwin:sdk_env"],
    visibility = ["PUBLIC"],
)
# END generated: removefile

# BEGIN generated: pin exports
load("//buck/generated:exports_removefile.bzl", "EXPORTS")

# One export_file per file another package names by label, from the list
