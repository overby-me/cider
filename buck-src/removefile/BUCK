        "removefile_random.c",
        "removefile_rename_unlink.c",
        "removefile_sunlink.c",
        "removefile_tree_walker.c",
    ],
    compiler_flags = [
        "-D_LIBC_NO_FEATURE_VERIFICATION",
        "-Dremovefile_EXPORTS",
        "-fblocks",
        "-fPIC",
        "-w",
        "-nostdinc",
    ],
    toolchain = "toolchains//:darwin_cc",
    deps = [
        "//darwin:sdk_env",
        ":removefile_inc_removefile",
    ],
    visibility = ["PUBLIC"],
)

