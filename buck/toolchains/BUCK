load(":cc.bzl", "cc_toolchain")
# The HOST (Linux/ELF) toolchain: xnu-sys, the XNU emulation glue, libsimple,
# migcom. `cc`/`ar` are command names resolved from PATH (the devShell's clang 21
# + binutils); override with absolute paths via .buckconfig.local's [cider]
# section if PATH is ever scrubbed. The Nix endpoint maps these command strings
# to packages instead.
cc_toolchain(
    name = "native_cc",
    ar = read_root_config("cider", "ar", "ar"),
    cc = read_root_config("cider", "cc", "clang"),
    cxx = read_root_config("cider", "cxx", "clang++"),
    # -g and -O are deliberately absent: they belong to the build mode, and the
    # cmake build compiles xnu-sys with neither (cmakeBuildType is blank in
    # nix/ciderBuildInputs.nix).
    cflags = [],
    cxxflags = [],
    visibility = ["PUBLIC"],
)

# The GUEST (Darwin/Mach-O) cross toolchain. Same clang, driven to emit Mach-O
# for x86_64-apple-darwin20, which is exactly how the cmake build cross-compiles
# (nix/ciderBuildInputs.nix even wraps clang so a `-target *darwin*` invocation
# bypasses nixpkgs' cc-wrapper and its Linux-specific flags).
#
# Flags are the reference build's, read off the configured build.ninja:
#   -mmacosx-version-min=11.0 -target x86_64-apple-darwin20 -arch x86_64
# `-B <cctools misc>` is a LINK-time flag here. The reference passes it to
# compiles too, but with clang's integrated assembler a `-c` compile never
# invokes an external tool, so it is only meaningful for links.
#
# The archiver must write Mach-O archives. The cmake build uses cctools'
# x86_64-apple-darwin20-ar; llvm-ar (from the same clang toolchain) writes the
# same format and is the default here, overridable once nix/cctools-port.nix
# exports the cctools one.
# The Mach-O linker and the cctools whose binaries a Darwin link invokes come
# from nix (`nix build .#cider-ld64 -o result-ld64`); they are prebuilt tools
# like clang, referenced by path. Override with [cider] ld64_dir in
# .buckconfig.local if they live elsewhere.
_LD64_DIR = read_root_config("cider", "ld64_dir", "result-ld64/bin")

# Guest compiles pass -nostdinc (as the reference build does), which drops
# clang's OWN builtin headers together with the host's, so the resource dir goes
# back on as -isystem exactly as the reference does. Written by
# scripts/buck-setup.nu, since it is a nix store path.
_CLANG_RESOURCE_DIR = read_root_config("cider", "clang_resource_dir", "")

# THE GUEST ARCHITECTURE (docs/plan-aarch64.md, D2). scripts/buck-setup.nu writes it into
# .buckconfig.local from `uname -m`; the committed default stays x86_64 so an existing
# x86_64 checkout is bit-identical until its owner reruns setup. darwin20 carries over
# unchanged: macOS 11 is the first arm64 macOS, so the version floor is the same on both.
GUEST_ARCH = read_root_config("cider", "guest_arch", "x86_64")

_DARWIN_FLAGS = [
    "-target",
    GUEST_ARCH + "-apple-darwin20",
    "-arch",
    GUEST_ARCH,
    "-mmacosx-version-min=11.0",
    # -O2, AND THIS IS A CORRECTNESS FLAG BEFORE IT IS A SPEED ONE.
    #
    # There was no -O flag here at all, so clang used its default, which is -O0, for every Darwin
    # object in the tree: the rasteriser, the font stack, Foundation, AppKit, libdispatch, all of it.
    #
    # What that costs is not only time. libdispatch RELIES on tail calls, its wakeup and drain paths
    # call each other in a chain an optimiser turns into a loop, and at -O0 every link becomes a real
    # stack frame of 656 bytes for a function taking three arguments. Measured: LibreOffice died
    # about eighteen seconds in, faulting on the store of a FUNCTION ARGUMENT into its own frame,
    # with the stack pointer inside the PROT_NONE guard page under a 520 KB worker stack. That is a
    # stack overflow caused by the absence of one flag.
    #
    # -O2 rather than -O3 or -Os: it is what Apple builds these sources with, so it is the setting
    # their inline assembly, their alignment assumptions and their tail calls are tested against.
    "-O2",
] + (["-isystem", _CLANG_RESOURCE_DIR + "/include"] if _CLANG_RESOURCE_DIR else [])

cc_toolchain(
    name = "darwin_cc",
    ar = read_root_config("cider", "darwin_ar", "llvm-ar"),
    # Empty by default: -B below is what selects the linker (see darwin.bzl).
    # -fuse-ld needs an absolute path, so it is opt-in per machine.
    ld = read_root_config("cider", "ld", ""),
    ld_search_dirs = [_LD64_DIR],
    # THE LINKER BUILT BY THIS GRAPH (#65). darwin.bzl writes a two line driver wrapper that
    # resolves $PWD at RUN time and execs clang with an absolute -fuse-ld, which is the only
    # thing that actually selects the linker here. The history is worth keeping:
    # cc_toolchain and darwin.bzl accept it, and ld64 itself builds and links a valid Mach-O
    # when driven by an absolute path. What fails is selecting it from a rule:
    #   -B <dir> alone does NOT win. Measured: clang went to binutils ld.bfd anyway and died
    #     with "unrecognised emulation mode: llvm", because the nixpkgs clang wrapper supplies
    #     its own linker and the -B lookup does not override it.
    #   -fuse-ld= DOES win but needs a genuinely ABSOLUTE path, and a rule only has
    #     project-relative ones. cmd_args(..., absolute_prefix = "$PWD/") emits that text
    #     LITERALLY and clang answers "invalid linker name in argument -fuse-ld=$PWD/...".
    # That wrapper is now in darwin.bzl and WORKS for buck2, but setting ld_target still
    # breaks the NIX DUMP, so it stays off until the last piece lands:
    #
    #   863 in-process artifact(s) were never materialised. Each one has to be reachable from
    #   a provider that buck/bxl/materialize.bxl ensures, which means the rule making it must
    #   declare it through InProcInfo.
    #
    # 863 is exactly the number of darwin links: every one now writes its own __ld_driver.sh,
    # and ctx.actions.write makes an IN-PROCESS artifact that the dump can only materialise if
    # the rule declares it. So _darwin_link has to hand the script back and darwin_dylib and
    # darwin_binary have to put it in InProcInfo.artifacts.
    #
    ld_target = "root//vendor/src:x86_64-apple-darwin20-ld",
    #
    # STILL OFF. BOTH placements of the driver script fail the DUMP, for different reasons, and
    # that is the whole remaining problem:
    #   per LINK      863 in-process artifacts were never materialised, one script per darwin
    #                 link, none declared through InProcInfo.
    #   per TOOLCHAIN buck2 audit output cannot parse the path a toolchain artifact lands at,
    #                 buck-out/nix/art/toolchains/<hash>-<hash>/__darwin_cc__/...:
    #                 "Path does not have a platform configuration or content-based hash".
    # The per RULE route is the one that can work, because the dump already resolves ordinary
    # target artifacts: _darwin_link has to return the script and darwin_dylib and
    # darwin_binary have to declare it in InProcInfo.artifacts.
    ldflags = [
        # -Z: do not search the standard library/framework dirs. Darling links
        # entirely against its own tree.
        "-Wl,-Z",
        "-Wl,-sdk_version,11.0",
    ],
    # The GUEST compiler may differ from the host one, and under Nix it has to: nixpkgs
    # wraps clang so that a link picks up this platform's crt files and
    # -dynamic-linker=<glibc>, which Darling's ld64 rejects outright. A host tool still
    # wants that wrapper, so the two are separate keys rather than one.
    cc = read_root_config("cider", "darwin_cc", read_root_config("cider", "cc", "clang")),
    cxx = read_root_config("cider", "darwin_cxx", read_root_config("cider", "cxx", "clang++")),
    cflags = _DARWIN_FLAGS,
    cxxflags = _DARWIN_FLAGS,
    visibility = ["PUBLIC"],
)
