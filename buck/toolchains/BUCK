load(":cc.bzl", "cc_toolchain")
# The HOST (Linux/ELF) toolchain: duct-tape, the XNU emulation glue, libsimple,
# migcom. `cc`/`ar` are command names resolved from PATH (the devShell's clang 21
# + binutils); override with absolute paths via .buckconfig.local's [darling]
# section if PATH is ever scrubbed. The Nix endpoint maps these command strings
# to packages instead.
cc_toolchain(
    name = "native_cc",
    ar = read_root_config("darling", "ar", "ar"),
    cc = read_root_config("darling", "cc", "clang"),
    cxx = read_root_config("darling", "cxx", "clang++"),
    # -g and -O are deliberately absent: they belong to the build mode, and the
    # cmake build compiles duct-tape with neither (cmakeBuildType is blank in
    # nix/darlingBuildInputs.nix).
    cflags = [],
    cxxflags = [],
    visibility = ["PUBLIC"],
)

# The GUEST (Darwin/Mach-O) cross toolchain. Same clang, driven to emit Mach-O
# for x86_64-apple-darwin20, which is exactly how the cmake build cross-compiles
# (nix/darlingBuildInputs.nix even wraps clang so a `-target *darwin*` invocation
# bypasses nixpkgs' cc-wrapper and its Linux-specific flags).
#
# Flags are the reference build's, read off the configured build.ninja:
#   -mmacosx-version-min=11.0 -target x86_64-apple-darwin20 -arch x86_64
# `-B <cctools misc>` is a LINK-time flag here. The reference passes it to
# compiles too, but with clang's integrated assembler a `-c` compile never
# invokes an external tool, so it is only meaningful for links.
#
# The archiver must write Mach-O archives. The cmake build uses cctools'
# x86_64-apple-darwin20-ar; llvm-ar (from the same clang toolchain) writes the
# same format and is the default here, overridable once nix/cctools-port.nix
# exports the cctools one.
# The Mach-O linker and the cctools whose binaries a Darwin link invokes come
# from nix (`nix build .#darling-ld64 -o result-ld64`); they are prebuilt tools
# like clang, referenced by path. Override with [darling] ld64_dir in
# .buckconfig.local if they live elsewhere.
_LD64_DIR = read_root_config("darling", "ld64_dir", "result-ld64/bin")

# Guest compiles pass -nostdinc (as the reference build does), which drops
# clang's OWN builtin headers together with the host's, so the resource dir goes
# back on as -isystem exactly as the reference does. Written by
# scripts/buck-setup.sh, since it is a nix store path.
_CLANG_RESOURCE_DIR = read_root_config("darling", "clang_resource_dir", "")

_DARWIN_FLAGS = [
    "-target",
    "x86_64-apple-darwin20",
    "-arch",
    "x86_64",
    "-mmacosx-version-min=11.0",
] + (["-isystem", _CLANG_RESOURCE_DIR + "/include"] if _CLANG_RESOURCE_DIR else [])

cc_toolchain(
    name = "darwin_cc",
    ar = read_root_config("darling", "darwin_ar", "llvm-ar"),
    # Empty by default: -B below is what selects the linker (see darwin.bzl).
    # -fuse-ld needs an absolute path, so it is opt-in per machine.
    ld = read_root_config("darling", "ld", ""),
    ld_search_dirs = [_LD64_DIR],
    ldflags = [
        # -Z: do not search the standard library/framework dirs. Darling links
        # entirely against its own tree.
        "-Wl,-Z",
        "-Wl,-sdk_version,11.0",
    ],
    cc = read_root_config("darling", "cc", "clang"),
    cxx = read_root_config("darling", "cxx", "clang++"),
    cflags = _DARWIN_FLAGS,
    cxxflags = _DARWIN_FLAGS,
    visibility = ["PUBLIC"],
)
