load("//buck/rules:cc.bzl", "cc_header_root")

# The Darwin (guest) compile environment: the defines and include roots every
# cross-compiled Darling target gets, in the reference build's order. A guest
# target depends on this one target instead of restating them.
#
# Defines and order are the reference build's, read off the configured
# build.ninja rather than inferred from CMakeLists.
# The include roots are shared between the two environment targets below, and libcxx sits
# at the position the reference gives it -- after the basic headers, before the SDK --
# rather than being appended, because include ORDER decides which header wins.
_ENV_FLAGS = [

        # Inherited by every Darling target from the top-level CMakeLists.
        "-Wno-error=implicit-function-declaration",
        "-Wno-nullability-completeness",
        "-Wno-deprecated-declarations",
        "-Wno-availability",
        "-Wno-expansion-to-defined",
        "-Wno-elaborated-enum-base",
        "-Wno-undef-prefix",
        # The Darwin target identity.
        "-DDARLING",
        "-DDARWIN",
        "-DPLATFORM_MacOSX",
        "-DTARGET_OS_MAC=1",
        "-D_DARWIN_C_SOURCE",
        "-D_POSIX_C_SOURCE",
        "-D__APPLE__",
        "-D__DYNAMIC__",
        "-D__MACH__",
]

_ENV_PRE = [
        "//darwin/basic-headers:basic_headers",
        # AvailabilityVersions.h and architecture/* reach basic-headers by symlink
        # into pinned trees, so they are staged from the materialized pins.
        "//buck-src:sdk_basic_headers_pins",
]

_ENV_POST = [
        "//buck-src:sdk_include",
        "//darwin/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX.sdk/usr/include:sdk_repo_include",
        "//buck-src:lkm_include",
        "//buck-src/configd:configd_dnsinfo",
        # SDK headers that live in COMMITTED repo trees rather than pinned ones;
        # each owning package declares its own root (a header_map's values must be
        # sources in the declaring package). Generated by
        # scripts/gen-sdk-header-roots.py --repo-roots.
        "//darwin/basic-headers:sdk_darwin_basic_headers_headers",
        "//darwin/frameworks:sdk_darwin_frameworks_headers",
        "//src/OpenScripting:sdk_src_OpenScripting_headers",
        "//src/duct:sdk_src_duct_headers",
        "//src/external/libpthread_workqueue-0.8.2:sdk_src_external_libpthread_workqueue_0.8.2_headers",
        "//src/external/libtrace:sdk_src_external_libtrace_headers",
        "//src/launchd:sdk_src_launchd_headers",
        "//src/libDiagnosticMessagesClient:sdk_src_libDiagnosticMessagesClient_headers",
        "//src/libMobileGestalt:sdk_src_libMobileGestalt_headers",
        "//src/libaccessibility:sdk_src_libaccessibility_headers",
        "//src/libacm:sdk_src_libacm_headers",
        "//src/libaks:sdk_src_libaks_headers",
        "//src/libcompression:sdk_src_libcompression_headers",
        "//src/libm:sdk_src_libm_headers",
        "//src/libpmenergy:sdk_src_libpmenergy_headers",
        "//src/libquit:sdk_src_libquit_headers",
        "//src/libsysmon:sdk_src_libsysmon_headers",
        "//src/libsystem_coreservices:sdk_src_libsystem_coreservices_headers",
        "//src/networkextension:sdk_src_networkextension_headers",
        "//src/opendirectory_internal:sdk_src_opendirectory_internal_headers",
        "//src/quarantine:sdk_src_quarantine_headers",
        "//src/sandbox:sdk_src_sandbox_headers",
        "//src/softlinking:sdk_src_softlinking_headers",
        "//linux/startup:sdk_src_startup_headers",
        "//src/xcselect:sdk_src_xcselect_headers",
]

# The Darwin (guest) compile environment: the defines and include roots every
# cross-compiled Darling target gets, in the reference build's order. A guest
# target depends on this one target instead of restating them.
#
# Defines and order are the reference build's, read off the configured
# build.ninja rather than inferred from CMakeLists.
cc_header_root(
    name = "sdk_env",
    exported_flags = _ENV_FLAGS,
    deps = _ENV_PRE + ["//buck-src/libcxx:libcxx_include"] + _ENV_POST,
    visibility = ["PUBLIC"],
)

# The same environment WITHOUT the C++ standard library, for the one target whose
# reference include list does not have it. libstdcxx compiles GCC 4.2.1's own <cstdlib>,
# which does `using ::abs;` and then declares abs(long); with libc++'s stdlib.h also on
# the path that redeclares what the using already brought in, and eight such conflicts
# made libstdc++.6.dylib the only target in the tree that would not build. The reference
# passes -nostdinc++ AND simply never adds libcxx there.
#
# The generator picks between the two by READING THE REFERENCE, not by name: a target
# whose include list does not mention libcxx gets this one. And libcxx belongs to exactly
# one of them, never both -- two copies of libcxx/include on a command line break
# #include_next, because libcxx's stdint.h defers to the next stdint.h on the path and
# finds the other staged copy of ITSELF instead of the SDK's.
cc_header_root(
    name = "sdk_env_nocxx",
    exported_flags = _ENV_FLAGS,
    deps = _ENV_PRE + _ENV_POST,
    visibility = ["PUBLIC"],
)
