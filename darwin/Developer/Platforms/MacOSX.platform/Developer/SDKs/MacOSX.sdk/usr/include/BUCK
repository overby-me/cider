load("//buck/rules:cc.bzl", "cc_header_root")

load("//buck/generated:sdk_headers.bzl", "SDK_REPO_HEADERS")

# The handful of SDK headers that are REAL FILES committed here rather than
# symlinks into a pinned upstream tree (sys/_symbol_aliasing.h,
# sys/_posix_availability.h, float.h, ...). Everything else in this tree is a link
# and is staged by //vendor/src:sdk_include.
#
# The list is generated (cider-sdk-header-roots) so it cannot drift out
# of sync with what is actually here. This package's paths ARE the include paths,
# so no mapping is needed.
cc_header_root(
    name = "sdk_repo_include",
    headers = SDK_REPO_HEADERS,
    visibility = ["PUBLIC"],
)

# BEGIN generated: framework roots
# One header root per framework, so a target declares the frameworks it includes
# instead of getting the whole surface. The reference build just puts
# darwin/framework-include on every Darwin compile's path; being explicit here is
# what stops a target compiling against a framework it never declared.
#
# These live HERE, not in //darwin/Developer, because their headers do. This
# directory is its own package (for sdk_repo_include above), and a source attribute
# cannot name a file across a package boundary -- declared in the parent, they made
# the whole parent package fail to parse, which is why nothing could ever depend on
# fw_Kernel and zprint had no way to reach <Kernel/IOKit/IOKitDebug.h>. The
# generated map still spells its paths relative to //darwin/Developer, so the shared
# prefix comes off here rather than by regenerating it.
load("//buck/generated:sdk_framework_darwin_Developer.bzl", FRAMEWORKS = "FRAMEWORKS")

_PREFIX = "Platforms/MacOSX.platform/Developer/SDKs/MacOSX.sdk/usr/include/"

# dnsinfo.h is a DANGLING link in the farm: it still points at src/configd, where configd
# was vendored before the darwin/ + linux/ reorg moved it to the pin src/external/configd.
# Nothing here can stage it, and nothing needs to -- //darwin:sdk_env puts configd's
# dnsinfo directory on every Darwin compile's path already. Listed rather than filtered
# because Starlark cannot ask whether a link resolves; regenerating the map after the
# submodule is materialized is what removes the need for this.
_DANGLING = ["dnsinfo.h"]

[
    cc_header_root(
        name = "fw_" + _name,
        header_map = {
            _k: _v[len(_PREFIX):]
            for _k, _v in _map.items()
            if _v[len(_PREFIX):] not in _DANGLING
        },
        visibility = ["PUBLIC"],
    )
    for _name, _map in FRAMEWORKS.items()
]
# END generated: framework roots

