# THE RUST PlistBuddy (#102). It holds the canonical name now and the C is kept beside it as
# PlistBuddy_c, because the parity gate needs both binaries to exist.
#
# It is 49 CoreFoundation externs plus a port of the 83 percent of the program that never touches
# CF. See PLAN.md #102b for the measurement that decided it was worth doing.
darwin_rust_staticlib(
    name = "PlistBuddy_rs_lib",
    crate_root = "PlistBuddy.rs",
    srcs = ["cf.rs"],
    visibility = ["PUBLIC"],
)

darwin_binary(
    # THE INSTALLED PlistBuddy (#102). buck/prefix/BUCK maps //darwin/PlistBuddy:PlistBuddy to
    # /usr/libexec/PlistBuddy, so this rename is the flip and no install entry changed.
    name = "PlistBuddy",
    objs = [
        # crt1 FIRST: it references _main, and an archive member is only pulled in to resolve a
        # reference that already exists.
        "//buck-src/csu:crt1.10.6_obj2",
        ":PlistBuddy_rs_lib",
    ],
    dylibs = [
        "//buck-src:system_final",
        "//buck-src/corefoundation:CoreFoundation_dylib",
    ],
    toolchain = "toolchains//:darwin_cc",
    deps = [
        "//darwin:sdk_env",
        "//buck-src:crt1.10.6",
    ],
    visibility = ["PUBLIC"],
)
