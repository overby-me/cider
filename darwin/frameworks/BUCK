# symlink, and a header_map's values must be sources in the declaring
# package. GENERATED by scripts/gen-sdk-header-roots.py --repo-roots.
# BEGIN generated: sdk headers
# SDK headers this package owns: the Darwin SDK tree reaches them by
# symlink, and a header_map's values must be sources in the declaring
# package. GENERATED by scripts/gen-sdk-header-roots.py --repo-roots.
cc_header_root(
    name = "sdk_darwin_frameworks_headers",
    header_map = {
        "coreauthd_spi.h": "LocalAuthentication/include/coreauthd_spi.h",
        "ctkclient/ctkclient.h": "CryptoTokenKit/include/ctkclient.h",
        "ctkclient/ctkclient_test.h": "CryptoTokenKit/include/ctkclient_test.h",
        "ctkclient/ctkloginhelper.h": "CryptoTokenKit/include/ctkloginhelper.h",
        "ctkloginhelper.h": "CryptoTokenKit/include/ctkloginhelper.h",
    },
    visibility = ["PUBLIC"],
)
# END generated: sdk headers

# BEGIN generated: framework roots
# One header root per framework, so a target declares the frameworks it includes
# instead of getting the whole surface. The reference build just puts
# darwin/framework-include on every Darwin compile's path; being explicit here is
# what stops a target compiling against a framework it never declared.
load("//buck/generated:sdk_framework_darwin_frameworks.bzl", FRAMEWORKS = "FRAMEWORKS")

[
    cc_header_root(
        name = "fw_" + _name,
        header_map = _map,
        visibility = ["PUBLIC"],
    )
    for _name, _map in FRAMEWORKS.items()
]
# END generated: framework roots

