load("//buck/rules:cc.bzl", "cc_header_root", "cc_library")
load("//buck/rules:darwin.bzl", "darwin_dylib")

# The Phase-0 leaf (plan/buck2-port.md): the smallest REAL Darling artifact on
# the host tier. One source file, two headers, no codegen, and it is one of the
# two archives the Rust daemon links via XNU_SYS_LIB, so getting it green is
# both the toolchain go/no-go gate and actual progress.
#
# Mirrors src/libsimple/CMakeLists.txt's `libsimple_ciderd` target:
#   add_library(libsimple_ciderd STATIC src/lock.c)
#   target_include_directories(... PUBLIC include)
#   target_compile_definitions(... PRIVATE LIBSIMPLE_LINUX=1)
cc_library(
    name = "libsimple_ciderd",
    srcs = ["src/lock.c"],
    exported_headers = [
        "include/libsimple/base.h",
        "include/libsimple/lock.h",
    ],
    # Consumers write `#include <libsimple/lock.h>`, so the staged include root
    # is `include/`, not the package.
    include_root = "include",
    compiler_flags = ["-DLIBSIMPLE_LINUX=1"],
    lib_name = "libsimple_ciderd",
    visibility = ["PUBLIC"],
)

# Headers only, for consumers that just need <libsimple/lock.h> on their include
# path and should not take a build dependency on the archive itself (xnu-sys's
# compile environment).
cc_header_root(
    name = "libsimple_headers",
    headers = [
        "include/libsimple/base.h",
        "include/libsimple/lock.h",
    ],
    root = "include",
    visibility = ["PUBLIC"],
)

# The GUEST build of the same source: libsimple compiled for Darwin/Mach-O.
# Mirrors the CMakeLists' other branch, add_cider_static_library(libsimple_cider
# FAT ...) with -DLIBSIMPLE_CIDER=1.
#
# Same file, same rules, one different toolchain -- which is the point of keeping
# the toolchain a selectable attribute. (FAT/lipo is not reproduced yet: the
# reference makes a fat archive with cctools lipo, and only x86_64 is built here.)
cc_library(
    name = "libsimple_cider",
    srcs = ["src/lock.c"],
    compiler_flags = ["-DLIBSIMPLE_CIDER=1"],
    exported_headers = [
        "include/libsimple/base.h",
        "include/libsimple/lock.h",
    ],
    include_root = "include",
    lib_name = "simple_cider",
    toolchain = "toolchains//:darwin_cc",
    deps = ["//darwin:sdk_env"],
    visibility = ["PUBLIC"],
)

# Phase 1.2 spike (plan/buck2-port.md): prove a Mach-O DYLIB link with an
# install_name flows through Darling's own ld64. libsimple is not a dylib in the
# real build; this target exists to exercise the link, using the same object.
darwin_dylib(
    name = "libsimple_cider_dylib",
    srcs = ["src/lock.c"],
    compiler_flags = ["-DLIBSIMPLE_CIDER=1"],
    dylib_name = "libsimple_cider.dylib",
    install_name = "/usr/lib/system/libsimple_cider.dylib",
    # Nothing to resolve against yet (libSystem is not ported), so allow
    # undefined symbols exactly as a firstpass link does.
    firstpass = True,
    deps = [
        ":libsimple_headers",
        "//darwin:sdk_env",
    ],
    visibility = ["PUBLIC"],
)
