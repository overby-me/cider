# THE RUST xcrun (#102), beside the C one rather than replacing it, exactly the arrangement
# getuuid_c, elfdep_c and wrapgen_c have: a parity check needs both binaries to exist. The C
# target above keeps the canonical name until the comparison has been run in the guest.
#
# It is the first GUEST tool the port builds from Rust. Everything it does is one decision about
# one argument, and then libxcselect does the work, unchanged. That is why it was picked first:
# the surface is small and the whole of it is observable.
darwin_rust_staticlib(
    name = "xcrun_rs_lib",
    crate_root = "xcrun.rs",
    visibility = ["PUBLIC"],
)

darwin_binary(
    # THE INSTALLED xcrun (#102). //darwin/xcselect:xcrun is what buck/prefix/BUCK maps to
    # /usr/bin/xcrun, so this rename is the whole flip and no install entry changed.
    name = "xcrun",
    objs = [
        # crt1 FIRST, then the archive: crt1 is what references _main and an archive member is
        # only pulled in to resolve a reference that already exists.
        "//vendor/src/csu:crt1.10.6_obj2",
        ":xcrun_rs_lib",
    ],
    dylibs = [
        "//darwin/xcselect:xcselect_dylib",
        "//vendor/src:system_final",
        "//vendor/src/corefoundation:CoreFoundation_dylib",
    ],
    toolchain = "toolchains//:darwin_cc",
    deps = [
        "//darwin:sdk_env",
        "//vendor/src:crt1.10.6",
    ],
    visibility = ["PUBLIC"],
)
