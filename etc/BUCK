# etc/ holds one file, and it is installed into the prefix
# (libexec/darling/private/etc/resolv.conf). A source attribute has to name a file of the
# package that DECLARES it, and until now nothing declared this one -- so buck/prefix could
# not reach it and the generator reported it as belonging to no package. This package exists
# so the prefix can name it by label like everything else it installs; the export itself is
# generated below.
load("//buck/rules:files.bzl", "export_file")

# BEGIN generated: prefix exports
# GENERATED from the reference build's install entries by
# scripts/gen-install-from-manifests.py -- review before committing.

export_file(
    name = "resolv.conf",
    src = "resolv.conf",
    visibility = ["PUBLIC"],
)

# END generated: prefix exports
