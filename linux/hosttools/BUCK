load("//buck/rules:cc.bzl", "cc_binary", "cc_header_root")

# cider-coredump: turns a Linux core dump of a Darling process into a Mach-O core the
# Darwin tools can read. A HOST program, so it builds with the native toolchain, but it
# parses Mach-O and therefore needs a narrow slice of Darwin headers -- see
# //buck-src:mldr_include and //linux/startup:mldr_shim_headers for why that slice is
# curated rather than "the SDK".
cc_header_root(
    name = "coredump_headers",
    headers = glob(["include/**/*.h"]),
    root = "include",
    visibility = ["PUBLIC"],
)

cc_binary(
    name = "cider-coredump",
    srcs = ["src/coredump/main.cpp"],
    # The reference links this one with CXX_EXECUTABLE_LINKER, and it has to: main.cpp uses
    # std::filesystem, so the C driver leaves every path operation undefined.
    link_cxx = True,
    # The reference's flags for this target, read off the configured build.ninja
    # (linux/hosttools/CMakeFiles/cider-coredump.dir). DARLING_COREDUMP_SANITIZE is a
    # cmake option that defaults OFF, so its -fsanitize flags are deliberately absent.
    compiler_flags = [
        "-DDARLING",
        "-std=c++17",
        "-Wno-error=implicit-function-declaration",
        "-Wno-nullability-completeness",
        "-Wno-deprecated-declarations",
        "-Wno-availability",
        "-Wno-expansion-to-defined",
        "-Wno-elaborated-enum-base",
        "-Wno-undef-prefix",
    ],
    # The shims come before the SDK-derived headers. cmake gets that order for free by
    # putting both in one directory, where a real file simply occupies a path the farm has
    # no symlink for; here the two are separate roots, so the order is stated.
    deps = [
        "//darwin/include:cider_config",
        ":coredump_headers",
        "//linux/startup:mldr_shim_headers",
        "//buck-src:mldr_include",
    ],
    visibility = ["PUBLIC"],
)
