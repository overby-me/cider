load("//buck/rules:rust.bzl", "rust_binary")

# The `cider` launcher (task #64): userns re-exec, prefix bootstrap, spawning
# ciderd as container init, and the shellspawn client that proxies a shell into the
# guest. libc only, so it is the smallest of the three Rust crates and the one that proves
# the rules.
rust_binary(
    name = "cider",
    crate_root = "src/main.rs",
    srcs = glob(["src/**/*.rs"]),
    # What build.rs bakes in through cargo:rustc-env. The git values are the build script's
    # OWN fallback for when git is unavailable: a build action that shells out to git would
    # make the binary depend on the checkout rather than on its inputs.
    env = {
        "CIDER_GIT_BRANCH": "unknown",
        "CIDER_GIT_COMMIT": "unknown",
        "CIDER_INSTALL_PREFIX": read_root_config("cider", "install_prefix", "/usr/local"),
    },
    deps = ["//buck-rust:libc"],
    visibility = ["PUBLIC"],
)
