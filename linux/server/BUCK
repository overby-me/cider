        "--allowlist-type=pid_for_task_args",
        "--allowlist-type=task_for_pid_args",
        "--allowlist-type=task_name_for_pid_args",
        "--allowlist-type=knote",
        "--allowlist-type=kevent_qos_s",
        "--allowlist-type=kevent_ctx_s",
        "--allowlist-type=klist",
        "--allowlist-type=ipc_space",
        "--allowlist-type=ipc_entry",
        "--allowlist-type=ipc_mqueue",
        "--allowlist-type=ipc_kmsg",
        "--allowlist-type=ipc_object",
