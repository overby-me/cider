# fast_context.c: the signal-mask-free ucontext the scheduler switches microthreads with.
# build.rs compiles it through the cc crate; here it goes through the port's own C rules,
# which is the whole point of not having cargo in the graph.
cc_library(
    name = "dserver_fast_context",
    srcs = ["//src/external/ciderd:src_fast_context.c"],
    compiler_flags = ["-DDSERVER_FAST_CONTEXT=1"],
    lib_name = "dserver_fast_context",
    visibility = ["PUBLIC"],
)

# ... staged into a directory, because -L names a search path and cc_library's own output
# is the archive file.
cc_lib_dir(
    name = "fast_context_lib",
    deps = [":dserver_fast_context"],
)

# The lib crate. Named `cider` regardless of the package, since that is how every binary
# in src/bin imports it.
rust_library(
    name = "cider",
    crate_root = "src/lib.rs",
    srcs = glob(["src/**/*.rs"]),
    out_dir = ":xnu_sys",
    deps = ["//buck-rust:libc"],
    visibility = ["PUBLIC"],
)

# scheduler_demo: a microthread blocks on a duct-tape semaphore, suspends, and is woken.
#
# This exists as a TARGET now because it is the fastest runtime check of the ported glue
# (#71). It drives dtape_semaphore_create, dtape_semaphore_down_simple and
# dtape_semaphore_up, which are Rust as of the semaphore port, all the way down through XNU
# and back out through the thread_suspend/thread_resume hooks, and it asserts that the
# microthread actually suspended and actually finished. It builds and runs in about a minute,
# against roughly an hour for checks.cider-buck2-min-smoke, so a broken port is visible
# immediately rather than at the end of a prefix build.
#
# Same link shape as the daemon: everything above duct-tape is Rust, the C below it comes in
# as static archives.
rust_binary(
    name = "scheduler_demo",
    crate_root = "src/bin/scheduler_demo.rs",
    out_dir = ":xnu_sys",
    deps = [
        ":cider",
        "//buck-rust:libc",
    ],
    link_archives = [
        "//src/external/ciderd/xnu-sys:ciderd_duct_tape",
        "//src/libsimple:libsimple_ciderd",
        ":dserver_fast_context",
    ],
    link_flags = [
        "-ldylib=pthread",
        "-ldylib=dl",
        "-ldylib=m",
        "-ldylib=rt",
    ],
    visibility = ["PUBLIC"],
)

# stage3_spike: the STRESS version of the same path. Phase 3 drives 500,000
# suspend/resume round-trips through dtape_semaphore_down_simple and dtape_semaphore_up,
# which are Rust as of the semaphore port, so a leak, a corrupted queue or an off-by-one
# shows up here where a single round-trip would not. It also prints ns/round-trip.
rust_binary(
    name = "stage3_spike",
    crate_root = "src/bin/stage3_spike.rs",
    out_dir = ":xnu_sys",
    deps = [
        ":cider",
        "//buck-rust:libc",
    ],
    link_archives = [
        "//src/external/ciderd/xnu-sys:ciderd_duct_tape",
        "//src/libsimple:libsimple_ciderd",
        ":dserver_fast_context",
    ],
    link_flags = [
        "-ldylib=pthread",
        "-ldylib=dl",
        "-ldylib=m",
        "-ldylib=rt",
    ],
    visibility = ["PUBLIC"],
)

# condvar_demo: the same shape as scheduler_demo, for the condvar port. A microthread waits
# on a duct-tape condvar (which drops its mutex and suspends it) and a signal from the main
# thread wakes it. condvar had no runtime coverage otherwise.
rust_binary(
    name = "condvar_demo",
    crate_root = "src/bin/condvar_demo.rs",
    out_dir = ":xnu_sys",
    deps = [
        ":cider",
        "//buck-rust:libc",
    ],
    link_archives = [
        "//src/external/ciderd/xnu-sys:ciderd_duct_tape",
        "//src/libsimple:libsimple_ciderd",
        ":dserver_fast_context",
    ],
    link_flags = [
        "-ldylib=pthread",
        "-ldylib=dl",
        "-ldylib=m",
        "-ldylib=rt",
    ],
    visibility = ["PUBLIC"],
)

# host_demo: the host.c port answers with NUMBERS, so this checks them against an INDEPENDENT
# source rather than against the code that produced them. host_info reaches its answers through
# sysinfo(2) and sysconf(3); the demo reads /proc/meminfo and /proc/cpuinfo, which share no code
# path with either, so a field written at the wrong offset shows up as a wrong number instead of
# agreeing with itself. It also drives the two refusal paths, a buffer too short for even the
# legacy structure and an unrecognised flavor, since a guard that never runs is a guard nobody
# knows is broken.
rust_binary(
    name = "host_demo",
    crate_root = "src/bin/host_demo.rs",
    out_dir = ":xnu_sys",
    deps = [
        ":cider",
        "//buck-rust:libc",
    ],
    link_archives = [
        "//src/external/ciderd/xnu-sys:ciderd_duct_tape",
        "//src/libsimple:libsimple_ciderd",
        ":dserver_fast_context",
    ],
    link_flags = [
        "-ldylib=pthread",
        "-ldylib=dl",
        "-ldylib=m",
        "-ldylib=rt",
    ],
    visibility = ["PUBLIC"],
)

# psynch_demo: psynch was the one ported glue file nothing drove (#77). It is also the one that
# fails SILENTLY rather than loudly, so this checks state instead of waiting for a crash: that
# init phase 2 left pthread_list_mlock and psynch_thcall allocated (a null first one was a real
# SIGSEGV once, surfacing only as a guest task exiting -111), and that all 18 callback vtable
# entries the port fills are non-null. The other 78 entries come from a zeroed const and are
# SUPPOSED to be None, which is why the check is by name rather than a sweep.
rust_binary(
    name = "psynch_demo",
    crate_root = "src/bin/psynch_demo.rs",
    out_dir = ":xnu_sys",
    deps = [
        ":cider",
        "//buck-rust:libc",
    ],
    link_archives = [
        "//src/external/ciderd/xnu-sys:ciderd_duct_tape",
        "//src/libsimple:libsimple_ciderd",
        ":dserver_fast_context",
    ],
    link_flags = [
        "-ldylib=pthread",
        "-ldylib=dl",
        "-ldylib=m",
        "-ldylib=rt",
    ],
    visibility = ["PUBLIC"],
)

# kqchan_demo: kqchan was the last ported file nothing drove (#80), the position psynch was in
# before #77. Drives the real MachPortKqchan::open path on a kernel microthread, so it exercises
# dtape_kqchan_mach_port_create, the notification callback registration, has_events, and destroy
# through Drop. The port it watches is a REAL receive right from mach_reply_port, because a
# made-up port number would exercise the failure path and prove much less. The guest side of the
# socket protocol (modify, fill, disable_notifications, on_readable) is still uncovered.
rust_binary(
    name = "kqchan_demo",
    crate_root = "src/bin/kqchan_demo.rs",
    out_dir = ":xnu_sys",
    deps = [
        ":cider",
        "//buck-rust:libc",
    ],
    link_archives = [
        "//src/external/ciderd/xnu-sys:ciderd_duct_tape",
        "//src/libsimple:libsimple_ciderd",
        ":dserver_fast_context",
    ],
    link_flags = [
        "-ldylib=pthread",
        "-ldylib=dl",
        "-ldylib=m",
        "-ldylib=rt",
    ],
    visibility = ["PUBLIC"],
)

# ciderd: the daemon itself. Everything above the duct-tape boundary is Rust; the
# static libraries below it are the ones cc_lib_dir already stages, plus the Linux libraries
# XNU's C pulls in, exactly as build.rs prints them.
