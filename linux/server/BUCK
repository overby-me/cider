        "--allowlist-function=thread_set_pending_block_hint",
        "--allowlist-var=TURNSTILE_.*",
        "--allowlist-var=TIMEOUT_URGENCY_USER_NORMAL",
        "--allowlist-var=LCK_SLEEP_.*",
        # msleep takes a struct timespec*, and psynch.c defines the three lock-group globals
        # the kext declares extern, so their types have to be real rather than respelled.
        "--allowlist-type=timespec",
        "--allowlist-type=lck_grp_attr_t",
        "--allowlist-var=NSEC_PER_USEC",
        "--allowlist-var=EWOULDBLOCK",
        "--allowlist-var=EINTR",
        "--allowlist-var=ERESTART",
        # misc.c (#71). The kmsg trace reads the header and, for a complex message, the first
        # descriptor; Assert and the trace both log, and Rust CALLS those variadics rather than
        # defining them.
        "--allowlist-function=ipc_port_get_receiver_task",
        "--allowlist-function=dtape_log",
        "--allowlist-function=panic",
        "--allowlist-type=mach_msg_body_t",
        "--allowlist-type=mach_msg_type_descriptor_t",
        "--allowlist-type=mach_msg_header_t",
        "--allowlist-type=dtape_log_level_t",
        "--allowlist-var=MACH_MSGH_BITS_COMPLEX",
        # Plain consts, not a Rust enum: two of these share a value (HOST_VM_INFO_REV0_COUNT
        # equals HOST_BASIC_INFO_COUNT at 12) and an enum cannot hold duplicate discriminants,
        # so bindgen aliases one to the other. Constified, each is simply its own value.
        "--constified-enum=dtape_rs_host_consts",
        # init.c ORs the zone flags together (ZC_NOENCRYPT | ZC_CACHING | ...), which a Rust
        # enum cannot express. Constified, they are plain integers and the OR is the C one.
        "--constified-enum=zone_create_flags_t",
        # kqchan.c does kn_status |= KN_VANISHED, which a Rust enum cannot express.
        "--constified-enum=kn_status_t",
        # psynch.c ORs the turnstile update flags (TURNSTILE_IMMEDIATE_UPDATE |
        # TURNSTILE_INHERITOR_THREAD), which a Rust enum cannot express.
        "--constified-enum=turnstile_update_flags",
        # Only the SIZE of the XNU giants crosses. Without this, struct task drags most of
        # osfmk into the bindings for no gain: nothing here reads its fields.
        "--opaque-type=task",
        "--opaque-type=thread",
        "--opaque-type=vm_.*",
        "--opaque-type=os_ref.*",
        "--opaque-type=waitq.*",
        "--opaque-type=zone.*",
        "--opaque-type=dtape_thread_user_state.*",
        # Function-pointer struct fields become Option<unsafe extern "C" fn ...>, which is
        # what lets the daemon zero the vtable and fill only the hooks it implements.
        "--default-enum-style=rust_non_exhaustive",
        "--no-layout-tests",
    ],
    # duct-tape's own defines and warning flags. The XNU headers do not parse without them:
    # priority_queue.h uses blocks, so -fblocks in particular is load bearing.
    clang_flags = DUCT_TAPE_DEFINES + DUCT_TAPE_FLAGS,
    include_dirs = [
        # mig FIRST: mach/task.h exists as both a MIG output and a hand-written XNU header,
        # and semaphore_create/semaphore_destroy are declared only in the generated one.
        # (XNU's kern/sync_sema.h declares just semaphore_destroy_all.)
        "//src/external/darlingserver/duct-tape:mig_mach_task",
        "//src/external/darlingserver/duct-tape:dt_include",
        "//src/external/darlingserver/duct-tape:dt_internal_include",
        "//src/external/darlingserver/duct-tape:dt_defines",
        "//src/external/darlingserver/duct-tape:xnu_osfmk",
        "//src/external/darlingserver/duct-tape:xnu_bsd",
        "//src/external/darlingserver/duct-tape:xnu_libkern",
        "//src/external/darlingserver/duct-tape:xnu_osfmk_libsa",
        "//src/external/darlingserver/duct-tape:xnu_pexpert",
        "//src/external/darlingserver/duct-tape:xnu_iokit",
        "//src/external/darlingserver/duct-tape:xnu_external_headers",
        "//src/external/darlingserver/duct-tape:xnu_root",
        "//src/libsimple:libsimple_headers",
        "//src/external/darlingserver:dserver_headers",
        # duct-tape.h uses DSERVER_DTAPE_DECLS, from the RPC wrapper generator.
        "//src/external/darlingserver:dserver_rpc",
        "//src/startup:rtsig_header",
    ],
)

# fast_context.c: the signal-mask-free ucontext the scheduler switches microthreads with.
# build.rs compiles it through the cc crate; here it goes through the port's own C rules,
# which is the whole point of not having cargo in the graph.
cc_library(
    name = "dserver_fast_context",
    srcs = ["//src/external/darlingserver:src_fast_context.c"],
    compiler_flags = ["-DDSERVER_FAST_CONTEXT=1"],
    lib_name = "dserver_fast_context",
    visibility = ["PUBLIC"],
)

# ... staged into a directory, because -L names a search path and cc_library's own output
# is the archive file.
cc_lib_dir(
    name = "fast_context_lib",
    deps = [":dserver_fast_context"],
)

# The lib crate. Named `darling` regardless of the package, since that is how every binary
# in src/bin imports it.
rust_library(
    name = "darling",
    crate_root = "src/lib.rs",
    srcs = glob(["src/*.rs"]),
    out_dir = ":dtape_bindings",
    deps = ["//buck-rust:libc"],
    visibility = ["PUBLIC"],
)

# scheduler_demo: a microthread blocks on a duct-tape semaphore, suspends, and is woken.
#
# This exists as a TARGET now because it is the fastest runtime check of the ported glue
# (#71). It drives dtape_semaphore_create, dtape_semaphore_down_simple and
# dtape_semaphore_up, which are Rust as of the semaphore port, all the way down through XNU
# and back out through the thread_suspend/thread_resume hooks, and it asserts that the
# microthread actually suspended and actually finished. It builds and runs in about a minute,
# against roughly an hour for checks.darling-buck2-min-smoke, so a broken port is visible
# immediately rather than at the end of a prefix build.
#
# Same link shape as the daemon: everything above duct-tape is Rust, the C below it comes in
# as static archives.
rust_binary(
    name = "scheduler_demo",
    crate_root = "src/bin/scheduler_demo.rs",
    out_dir = ":dtape_bindings",
    deps = [
        ":darling",
        "//buck-rust:libc",
    ],
    link_archives = [
        "//src/external/darlingserver/duct-tape:darlingserver_duct_tape",
        "//src/libsimple:libsimple_darlingserver",
        ":dserver_fast_context",
    ],
    link_flags = [
        "-ldylib=pthread",
        "-ldylib=dl",
        "-ldylib=m",
        "-ldylib=rt",
    ],
    visibility = ["PUBLIC"],
)

# stage3_spike: the STRESS version of the same path. Phase 3 drives 500,000
# suspend/resume round-trips through dtape_semaphore_down_simple and dtape_semaphore_up,
# which are Rust as of the semaphore port, so a leak, a corrupted queue or an off-by-one
# shows up here where a single round-trip would not. It also prints ns/round-trip.
rust_binary(
    name = "stage3_spike",
    crate_root = "src/bin/stage3_spike.rs",
    out_dir = ":dtape_bindings",
    deps = [
        ":darling",
        "//buck-rust:libc",
    ],
    link_archives = [
        "//src/external/darlingserver/duct-tape:darlingserver_duct_tape",
        "//src/libsimple:libsimple_darlingserver",
        ":dserver_fast_context",
    ],
    link_flags = [
        "-ldylib=pthread",
        "-ldylib=dl",
        "-ldylib=m",
        "-ldylib=rt",
    ],
    visibility = ["PUBLIC"],
)

# condvar_demo: the same shape as scheduler_demo, for the condvar port. A microthread waits
# on a duct-tape condvar (which drops its mutex and suspends it) and a signal from the main
# thread wakes it. condvar had no runtime coverage otherwise.
rust_binary(
    name = "condvar_demo",
    crate_root = "src/bin/condvar_demo.rs",
    out_dir = ":dtape_bindings",
    deps = [
        ":darling",
        "//buck-rust:libc",
    ],
    link_archives = [
        "//src/external/darlingserver/duct-tape:darlingserver_duct_tape",
        "//src/libsimple:libsimple_darlingserver",
        ":dserver_fast_context",
    ],
    link_flags = [
        "-ldylib=pthread",
        "-ldylib=dl",
        "-ldylib=m",
        "-ldylib=rt",
    ],
    visibility = ["PUBLIC"],
)

# host_demo: the host.c port answers with NUMBERS, so this checks them against an INDEPENDENT
# source rather than against the code that produced them. host_info reaches its answers through
# sysinfo(2) and sysconf(3); the demo reads /proc/meminfo and /proc/cpuinfo, which share no code
# path with either, so a field written at the wrong offset shows up as a wrong number instead of
# agreeing with itself. It also drives the two refusal paths, a buffer too short for even the
# legacy structure and an unrecognised flavor, since a guard that never runs is a guard nobody
# knows is broken.
rust_binary(
    name = "host_demo",
    crate_root = "src/bin/host_demo.rs",
    out_dir = ":dtape_bindings",
    deps = [
        ":darling",
        "//buck-rust:libc",
    ],
    link_archives = [
        "//src/external/darlingserver/duct-tape:darlingserver_duct_tape",
        "//src/libsimple:libsimple_darlingserver",
        ":dserver_fast_context",
    ],
    link_flags = [
        "-ldylib=pthread",
        "-ldylib=dl",
        "-ldylib=m",
        "-ldylib=rt",
    ],
    visibility = ["PUBLIC"],
)

# darlingserverd: the daemon itself. Everything above the duct-tape boundary is Rust; the
# static libraries below it are the ones cc_lib_dir already stages, plus the Linux libraries
# XNU's C pulls in, exactly as build.rs prints them.
rust_binary(
    name = "darlingserverd",
    crate_root = "src/bin/darlingserverd.rs",
    out_dir = ":dtape_bindings",
    deps = [
        ":darling",
        "//buck-rust:libc",
    ],
    link_archives = [
        "//src/external/darlingserver/duct-tape:darlingserver_duct_tape",
        "//src/libsimple:libsimple_darlingserver",
        ":dserver_fast_context",
    ],
    link_flags = [
        "-ldylib=pthread",
        "-ldylib=dl",
        "-ldylib=m",
        "-ldylib=rt",
    ],
    visibility = ["PUBLIC"],
)
