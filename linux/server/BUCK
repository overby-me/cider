        "--allowlist-function=assert_wait_deadline_with_leeway",
        # Turnstiles: psynch inherits priority from a mutex holder, so the wait shims are
        # written against the turnstile API rather than the bare waitq.
        "--allowlist-function=turnstile_cleanup",
        "--allowlist-function=turnstile_complete",
        "--allowlist-function=turnstile_prepare",
        "--allowlist-function=turnstile_update_inheritor",
        "--allowlist-function=turnstile_update_inheritor_complete",
