load("//buck/rules:cc.bzl", "cc_lib_dir", "cc_library")
load("//buck/rules:rust.bzl", "bindgen_gen", "rust_binary", "rust_library")
# duct-tape's own defines and warning flags, generated alongside its BUCK file. bindgen has
# to parse the XNU headers with the IDENTICAL set for the ported glue (#71); they do not
# parse without it, since osfmk/kern/priority_queue.h uses blocks and needs -fblocks.
load("//buck/generated:duct_tape_flags.bzl", "DUCT_TAPE_DEFINES", "DUCT_TAPE_FLAGS")

# The C libraries the Rust daemon links, staged into the single directory its
# build.rs expects in DUCT_TAPE_LIB:
#
#   DUCT_TAPE_LIB=$(buck2 build --show-output //linux/server:duct_tape_lib | ...) \
#     cargo build -p darling
#
# The daemon crate itself is still built by cargo (a Rust port of these rules is
# separate work -- overby.me's nix/lib/cargo is the model); this target is the
# seam between the Buck2-built C and that cargo build.
cc_lib_dir(
    name = "duct_tape_lib",
    deps = [
        "//src/external/darlingserver/duct-tape:darlingserver_duct_tape",
        "//src/libsimple:libsimple_darlingserver",
    ],
    visibility = ["PUBLIC"],
)

# The dtape hooks contract, generated from the real headers.
#
# The daemon implements a 36-function-pointer vtable that duct-tape calls back into, and
# binding it from hooks.h rather than transcribing it is what keeps the Rust side honest
# when the C side moves. build.rs calls the bindgen library; this calls the same generator
# as a tool (nix/devShell.nix provides it), so the port never has to build bindgen itself.
#
# The output is a DIRECTORY because the crate reaches it as OUT_DIR, which is what cargo
# hands a build script: src/lib.rs does include!(concat!(env!("OUT_DIR"), "/...")).
bindgen_gen(
    name = "dtape_bindings",
    out = "dtape_bindings.rs",
    header = "wrapper.h",
    # The same allowlist build.rs uses: the dtape surface, without the XNU and libsimple
    # internals those headers drag in.
    flags = [
        "--allowlist-type=dtape_hooks_t",
        "--allowlist-type=dtape_hooks",
        "--allowlist-type=dtape_.*_t",
        "--allowlist-type=dtape_.*_f",
        "--allowlist-type=libsimple_lock_t",
        "--allowlist-var=DTAPE_.*",
        # The internal structs and XNU entry points the ported glue needs (#71). semaphore.c
        # is Rust now and walks owning_task->xnu_task, so the offset of xnu_task inside
        # struct dtape_task has to be GENERATED; a hand-written offset drifts silently the
        # next time that struct gains a field.
        "--allowlist-type=dtape_semaphore",
        "--allowlist-type=dtape_task",
        "--allowlist-type=dtape_thread",
        "--allowlist-type=dtape_condvar",
        "--allowlist-type=dtape_mutex.*",
        "--allowlist-type=mpqueue_head",
        "--allowlist-type=timer_coalescing_priority_params_ns_t",
        "--allowlist-type=pal_rtc_nanotime",
        "--allowlist-function=timer_queue_expire",
        "--allowlist-function=mach_absolute_time",
        "--allowlist-function=lck_mtx_init_ext",
        "--allowlist-var=NSEC_PER_SEC",
        "--allowlist-function=current_thread",
        "--allowlist-function=dtape_mutex_lock",
        "--allowlist-function=dtape_mutex_unlock",
        "--allowlist-function=libsimple_lock_.*",
        "--allowlist-function=semaphore_create",
        "--allowlist-function=semaphore_destroy",
        "--allowlist-function=semaphore_signal",
        "--allowlist-function=semaphore_wait",
        "--allowlist-var=KERN_SUCCESS",
        "--allowlist-var=KERN_ABORTED",
        # host.c (#71). The three structs it fills by field, plus the flavor selectors and the
        # priority constants it copies out of XNU. vm_statistics is allowlisted but stays
        # OPAQUE below: host_statistics and vm_stats only memset it, never name a field, so the
        # port needs its size and nothing else.
        "--allowlist-type=host_basic_info",
        "--allowlist-type=host_priority_info",
        "--allowlist-type=host_preferred_user_arch",
        "--allowlist-type=vm_statistics",
        "--allowlist-type=vm_statistics64",
        "--allowlist-var=HOST_.*",
        "--allowlist-var=CPU_TYPE_X86",
        "--allowlist-var=CPU_SUBTYPE_X86_64_ALL",
        "--allowlist-var=CPU_THREADTYPE_NONE",
        "--allowlist-var=MINPRI.*",
        "--allowlist-var=MAXPRI.*",
        "--allowlist-var=BASEPRI.*",
        "--allowlist-var=DEPRESSPRI",
        "--allowlist-var=IDLEPRI",
        "--allowlist-var=KERN_INVALID_ARGUMENT",
        "--allowlist-var=KERN_FAILURE",
        "--allowlist-var=KERN_NOT_SUPPORTED",
        "--allowlist-type=dtape_rs_host_consts",
        # The scalar typedefs the host.c signatures are written in. Allowlisted rather than
        # respelled in Rust: an ABI typedef transcribed by hand is one that goes wrong quietly.
        # struct host stays opaque, so host_t crossing does not reopen it.
        "--allowlist-type=mach_msg_type_number_t",
        "--allowlist-type=host_flavor_t",
        "--allowlist-type=host_info_t",
        "--allowlist-type=host_t",
        "--allowlist-type=host_priv_t",
        # The stub signatures too, including the two structs passed BY VALUE
        # (security_token_t is 8 bytes and goes in a register, audit_token_t is 32 and goes on
        # the stack). Those are exactly the shapes a hand-written mirror gets wrong quietly, so
        # they are generated like everything else.
        "--allowlist-type=host_security_t",
        "--allowlist-type=memory_object_default_t",
        "--allowlist-type=memory_object_cluster_size_t",
        "--allowlist-type=kernel_boot_info_t",
        "--allowlist-type=lockgroup_info_array_t",
        "--allowlist-type=ledger_port_array_t",
        "--allowlist-type=hash_info_bucket_array_t",
        "--allowlist-type=security_token_t",
        "--allowlist-type=audit_token_t",
        "--allowlist-type=boolean_t",
        "--allowlist-type=task_t",
        "--allowlist-type=task_array_t",
        "--allowlist-type=thread_array_t",
        "--allowlist-type=vm_size_t",
        "--allowlist-type=vm_offset_t",
        # init.c (#71). It creates zones sized by these structs, and an OPAQUE binding carries
        # the size, which is all zone_create needs; none of their fields are touched.
        "--allowlist-type=host",
        # kqchan.c fills knote and kevent_qos_s fields. Reopening the kevent family measured
        # +1 struct and 657 bytes, so it is bound rather than shimmed.
        # kqchan.c (#71): the XNU entry points it calls and the constants it tests.
        "--allowlist-function=task_reference",
        "--allowlist-function=task_deallocate",
        "--allowlist-function=thread_deallocate",
        "--allowlist-function=thread_terminate_self",
        "--allowlist-function=kernel_thread_start",
        "--allowlist-function=clear_wait",
        "--allowlist-function=waitq_assert_wait64",
