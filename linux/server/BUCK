        "--allowlist-function=os_ref_init_count",
        "--allowlist-function=os_ref_release",
        "--allowlist-var=EVFILT_MACHPORT",
        "--allowlist-var=EV_ERROR",
        "--allowlist-var=EV_CLEAR",
        "--allowlist-var=EV_DISPATCH2",
        "--allowlist-var=EV_ONESHOT",
