        "--allowlist-var=KN_VANISHED",
        "--allowlist-var=FILTER_ACTIVE",
        "--allowlist-var=IPC_MQUEUE_RECEIVE",
        "--allowlist-type=dserver_kqchan_reply_mach_port_read_t",
        # traps.c (#71): the trap arg structs and the trap entry points themselves.
        "--allowlist-type=.*_trap_args",
        "--allowlist-function=.*_trap$",
        # Three traps whose names do NOT end in _trap, and whose arg structs are _args rather
        # than _trap_args, so the patterns above miss all six.
        # psynch.c (#71): the BSD sleep path entry points and the pthread kext callback table.
        "--allowlist-function=_psynch_.*",
        "--allowlist-function=pth_global_hashinit",
        "--allowlist-function=psynch_zoneinit",
        "--allowlist-function=psynch_wq_cleanup",
        "--allowlist-function=thread_call_allocate",
        "--allowlist-function=thread_syscall_return",
        "--allowlist-function=lck_mtx_alloc_init",
        "--allowlist-var=pthread_list_mlock",
        "--allowlist-var=pthread_lck_grp",
        "--allowlist-var=pthread_lck_attr",
        "--allowlist-var=psynch_thcall",
        "--allowlist-function=fls",
        "--allowlist-function=thread_should_abort",
