load("//buck/rules:cc.bzl", "cc_lib_dir", "cc_library")
load("//buck/rules:rust.bzl", "bindgen_gen", "rust_binary", "rust_library")
# duct-tape's own defines and warning flags, generated alongside its BUCK file. bindgen has
# to parse the XNU headers with the IDENTICAL set for the ported glue (#71); they do not
# parse without it, since osfmk/kern/priority_queue.h uses blocks and needs -fblocks.
load("//buck/generated:duct_tape_flags.bzl", "DUCT_TAPE_DEFINES", "DUCT_TAPE_FLAGS")

# The C libraries the Rust daemon links, staged into the single directory its
# build.rs expects in DUCT_TAPE_LIB:
#
#   DUCT_TAPE_LIB=$(buck2 build --show-output //linux/server:duct_tape_lib | ...) \
#     cargo build -p darling
#
# The daemon crate itself is still built by cargo (a Rust port of these rules is
# separate work -- overby.me's nix/lib/cargo is the model); this target is the
# seam between the Buck2-built C and that cargo build.
cc_lib_dir(
    name = "duct_tape_lib",
    deps = [
        "//src/external/darlingserver/duct-tape:darlingserver_duct_tape",
        "//src/libsimple:libsimple_darlingserver",
    ],
    visibility = ["PUBLIC"],
)

# The dtape hooks contract, generated from the real headers.
#
# The daemon implements a 36-function-pointer vtable that duct-tape calls back into, and
# binding it from hooks.h rather than transcribing it is what keeps the Rust side honest
# when the C side moves. build.rs calls the bindgen library; this calls the same generator
# as a tool (nix/devShell.nix provides it), so the port never has to build bindgen itself.
#
# The output is a DIRECTORY because the crate reaches it as OUT_DIR, which is what cargo
# hands a build script: src/lib.rs does include!(concat!(env!("OUT_DIR"), "/...")).
bindgen_gen(
    name = "dtape_bindings",
    out = "dtape_bindings.rs",
    header = "wrapper.h",
    # The same allowlist build.rs uses: the dtape surface, without the XNU and libsimple
    # internals those headers drag in.
    flags = [
        "--allowlist-type=dtape_hooks_t",
        "--allowlist-type=dtape_hooks",
        "--allowlist-type=dtape_.*_t",
        "--allowlist-type=dtape_.*_f",
        "--allowlist-type=libsimple_lock_t",
        "--allowlist-var=DTAPE_.*",
        # The internal structs and XNU entry points the ported glue needs (#71). semaphore.c
        # is Rust now and walks owning_task->xnu_task, so the offset of xnu_task inside
        # struct dtape_task has to be GENERATED; a hand-written offset drifts silently the
        # next time that struct gains a field.
        "--allowlist-type=dtape_semaphore",
        "--allowlist-type=dtape_task",
        "--allowlist-function=semaphore_create",
        "--allowlist-function=semaphore_destroy",
        "--allowlist-function=semaphore_signal",
        "--allowlist-function=semaphore_wait",
        "--allowlist-var=KERN_SUCCESS",
        "--allowlist-var=KERN_ABORTED",
        # Only the SIZE of the XNU giants crosses. Without this, struct task drags most of
        # osfmk into the bindings for no gain: nothing here reads its fields.
        "--opaque-type=task",
        "--opaque-type=thread",
        "--opaque-type=ipc_.*",
        "--opaque-type=vm_.*",
        "--opaque-type=_?lck_.*",
        "--opaque-type=queue_.*",
        "--opaque-type=priority_queue.*",
        "--opaque-type=os_ref.*",
        "--opaque-type=waitq.*",
        "--opaque-type=zone.*",
        # Function-pointer struct fields become Option<unsafe extern "C" fn ...>, which is
        # what lets the daemon zero the vtable and fill only the hooks it implements.
        "--default-enum-style=rust_non_exhaustive",
        "--no-layout-tests",
    ],
    # duct-tape's own defines and warning flags. The XNU headers do not parse without them:
    # priority_queue.h uses blocks, so -fblocks in particular is load bearing.
    clang_flags = DUCT_TAPE_DEFINES + DUCT_TAPE_FLAGS,
    include_dirs = [
        # mig FIRST: mach/task.h exists as both a MIG output and a hand-written XNU header,
        # and semaphore_create/semaphore_destroy are declared only in the generated one.
        # (XNU's kern/sync_sema.h declares just semaphore_destroy_all.)
        "//src/external/darlingserver/duct-tape:mig_mach_task",
        "//src/external/darlingserver/duct-tape:dt_include",
        "//src/external/darlingserver/duct-tape:dt_internal_include",
        "//src/external/darlingserver/duct-tape:dt_defines",
        "//src/external/darlingserver/duct-tape:xnu_osfmk",
        "//src/external/darlingserver/duct-tape:xnu_bsd",
        "//src/external/darlingserver/duct-tape:xnu_libkern",
        "//src/external/darlingserver/duct-tape:xnu_osfmk_libsa",
        "//src/external/darlingserver/duct-tape:xnu_pexpert",
        "//src/external/darlingserver/duct-tape:xnu_iokit",
        "//src/external/darlingserver/duct-tape:xnu_external_headers",
        "//src/external/darlingserver/duct-tape:xnu_root",
        "//src/libsimple:libsimple_headers",
        "//src/external/darlingserver:dserver_headers",
        # duct-tape.h uses DSERVER_DTAPE_DECLS, from the RPC wrapper generator.
        "//src/external/darlingserver:dserver_rpc",
        "//src/startup:rtsig_header",
    ],
)

# fast_context.c: the signal-mask-free ucontext the scheduler switches microthreads with.
# build.rs compiles it through the cc crate; here it goes through the port's own C rules,
# which is the whole point of not having cargo in the graph.
cc_library(
    name = "dserver_fast_context",
    srcs = ["//src/external/darlingserver:src_fast_context.c"],
    compiler_flags = ["-DDSERVER_FAST_CONTEXT=1"],
    lib_name = "dserver_fast_context",
    visibility = ["PUBLIC"],
)

# ... staged into a directory, because -L names a search path and cc_library's own output
# is the archive file.
cc_lib_dir(
    name = "fast_context_lib",
    deps = [":dserver_fast_context"],
)

# The lib crate. Named `darling` regardless of the package, since that is how every binary
# in src/bin imports it.
rust_library(
    name = "darling",
    crate_root = "src/lib.rs",
    srcs = glob(["src/*.rs"]),
    out_dir = ":dtape_bindings",
    deps = ["//buck-rust:libc"],
    visibility = ["PUBLIC"],
)

# darlingserverd: the daemon itself. Everything above the duct-tape boundary is Rust; the
# static libraries below it are the ones cc_lib_dir already stages, plus the Linux libraries
# XNU's C pulls in, exactly as build.rs prints them.
rust_binary(
    name = "darlingserverd",
    crate_root = "src/bin/darlingserverd.rs",
    out_dir = ":dtape_bindings",
    deps = [
        ":darling",
        "//buck-rust:libc",
    ],
    link_archives = [
        "//src/external/darlingserver/duct-tape:darlingserver_duct_tape",
        "//src/libsimple:libsimple_darlingserver",
        ":dserver_fast_context",
    ],
    link_flags = [
        "-ldylib=pthread",
        "-ldylib=dl",
        "-ldylib=m",
        "-ldylib=rt",
    ],
    visibility = ["PUBLIC"],
)
