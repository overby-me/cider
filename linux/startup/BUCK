load("//buck/rules:cc.bzl", "cc_binary", "cc_header_root")
load("//buck/rules:codegen.bzl", "host_gen")

# rtsig is a build-HOST probe: it compiles and runs on the Linux build machine
# and prints LINUX_SIGRTMIN/LINUX_SIGRTMAX, which the xnu emulation layer and
# xnu-sys include as <rtsig.h>. Reading the values from Linux headers at build
# time is the point (the guest code must not include Linux headers itself).
cc_binary(
    name = "rtsig",
    srcs = ["rtsig.c"],
    compiler_flags = [
        "-std=gnu11",
        "-D_GNU_SOURCE",
    ],
)

host_gen(
    name = "rtsig_header",
    out = "rtsig.h",
    tool = ":rtsig",
    visibility = ["PUBLIC"],
)

# SDK headers this package owns: the Darwin SDK tree reaches them by
# symlink, and a header_map's values must be sources in the declaring
# package. GENERATED by scripts/gen-sdk-header-roots.py --repo-roots.
# BEGIN generated: sdk headers
# SDK headers this package owns: the Darwin SDK tree reaches them by
# symlink, and a header_map's values must be sources in the declaring
# package. GENERATED by scripts/gen-sdk-header-roots.py --repo-roots.
cc_header_root(
    name = "sdk_src_startup_headers",
    header_map = {
        # UPSTREAM names this include: the xnu pin's bsdthread code does
        # #include <darling/mldr/elfcalls/dthreads.h>, so the staged path keeps
        # the old name even though the project is Cider.
        "darling/mldr/elfcalls/dthreads.h": "mldr/elfcalls/dthreads.h",
        "elfcalls.h": "mldr/elfcalls/elfcalls.h",
        "elfcalls/elfcalls.h": "mldr/elfcalls/elfcalls.h",
        "elfcalls/threads.h": "mldr/elfcalls/threads.h",
    },
    visibility = ["PUBLIC"],
)
# END generated: sdk headers


# The four SHIM headers inside mldr/include's symlink farm.
#
# Everything else in that farm is a symlink into the SDK, and //buck-src:mldr_include maps
# those. These four are REAL files, and they are real precisely because they must NOT be
# the SDK's versions: a host (Linux) compile that includes <mach-o/loader.h> would
# otherwise pull in Darwin's sys/_types.h and i386/_types.h on top of glibc's. Three are
# empty and the fourth defines one typedef, which is the entire Darwin type surface such a
# compile is allowed. They are named rather than globbed because a glob here would also
# pick up the farm's symlinks, which dangle in a working copy (they point at src/external
# paths that only exist materialized under buck-src).
cc_header_root(
    name = "mldr_shim_headers",
    header_map = {
        "i386/_types.h": "mldr/include/i386/_types.h",
        "mach/i386/vm_param.h": "mldr/include/mach/i386/vm_param.h",
        "mach/machine/thread_status.h": "mldr/include/mach/machine/thread_status.h",
        "sys/_types.h": "mldr/include/sys/_types.h",
    },
    visibility = ["PUBLIC"],
)

# The elfcalls ABI headers (elfcalls.h, threads.h, dthreads.h): the contract between the
# loader and the guest's libsystem_kernel. Real files, unlike mldr/include's symlink farm,
# so a glob is right here. Declared in this package because a header root can only glob
# files its own package owns.
cc_header_root(
    name = "mldr_elfcalls",
    headers = glob(["mldr/elfcalls/*.h"]),
    root = "mldr/elfcalls",
    visibility = ["PUBLIC"],
)
