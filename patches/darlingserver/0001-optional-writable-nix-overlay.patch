Optional writable native /nix overlay for guest Nix.

When a `.enable-writable-nix` marker exists in the prefix, overlay the host
/nix/store and /nix/var (read-only lowers) with writable uppers at the
container /nix, so guest nix has a writable native /nix/store plus the hosts
valid-paths DB and can `nix build` (nix refuses a diverted store). Two separate
overlays (whole /nix fails: a socket in /nix/var) each with userxattr (required
for unprivileged overlayfs); upper/work dirs sit beside the prefix on its real
filesystem (keep the prefix off tmpfs). Best-effort and opt-in; normal Darling
is unaffected.

diff --git a/src/darlingserver.cpp b/src/darlingserver.cpp
index f79f057..a107610 100644
--- a/src/darlingserver.cpp
+++ b/src/darlingserver.cpp
@@ -654,6 +654,53 @@ int main(int argc, char** argv) {
 		copyAndSetAttributes(fromPath, toPath);
 	}
 
+	// Optional writable native /nix for guest Nix. nix refuses to build in a
+	// "diverted" (non-/nix/store) store, and the host /nix the container sees
+	// (via SystemRoot) is read-only to the container's mapped root. Overlay the
+	// WHOLE host /nix (read-only lower: store AND var/db, so guest nix inherits
+	// the host's valid-paths database and trusts pre-populated deps) with a
+	// tmpfs upper, at the container /nix, so `nix build` can write outputs and DB
+	// entries. Opt-in via a `.enable-writable-nix` marker in the prefix, and
+	// entirely best-effort: any failure just leaves /nix as it was and the
+	// container still boots. The upper/work dirs must live on a non-overlay
+	// filesystem (overlayfs cannot be an overlayfs upperdir), so they are backed
+	// by a tmpfs mounted outside the prefix overlay.
+	{
+		char marker[4096];
+		snprintf(marker, sizeof(marker), "%s/.enable-writable-nix", prefix);
+		if (access(marker, F_OK) == 0 && access("/nix/store", F_OK) == 0) {
+			// Overlay the host /nix/store and /nix/var (read-only lowers) with
+			// writable uppers, so guest nix has a writable native /nix/store plus
+			// the host's valid-paths DB. Two separate overlays: overlaying the
+			// whole /nix fails (a socket in /nix/var), and each needs `userxattr`
+			// (required for unprivileged overlayfs). The upper/work dirs live in a
+			// sibling of the prefix on the same real filesystem (overlayfs cannot
+			// be an overlayfs upperdir and the prefix itself is an overlay, so
+			// they must be outside it -- keep the prefix off tmpfs). Best-effort.
+			char nixdir[4096], back[4096];
+			const char* subs[2] = { "store", "var" };
+			snprintf(nixdir, sizeof(nixdir), "%s/nix", prefix);
+			snprintf(back, sizeof(back), "%s.nixrw", prefix);
+			mkdir(nixdir, 0755);
+			mkdir(back, 0755);
+			for (int i = 0; i < 2; ++i) {
+				char lower[4096], mnt[4096], up[4096], wk[4096], nopts[8192];
+				snprintf(lower, sizeof(lower), "/nix/%s", subs[i]);
+				snprintf(mnt, sizeof(mnt), "%s/nix/%s", prefix, subs[i]);
+				snprintf(up, sizeof(up), "%s/%s.up", back, subs[i]);
+				snprintf(wk, sizeof(wk), "%s/%s.work", back, subs[i]);
+				mkdir(mnt, 0755);
+				mkdir(up, 0755);
+				mkdir(wk, 0755);
+				snprintf(nopts, sizeof(nopts),
+					"lowerdir=%s,upperdir=%s,workdir=%s,userxattr,index=off", lower, up, wk);
+				if (mount("overlay", mnt, "overlay", 0, nopts) != 0) {
+					fprintf(stderr, "Note: writable /nix/%s overlay failed: %s\n", subs[i], strerror(errno));
+				}
+			}
+		}
+	}
+
