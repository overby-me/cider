+# C++17 <filesystem> support. These sources are shipped in src/filesystem but
+# were omitted from the build, so the installed libc++.1.dylib exported zero
+# std::filesystem symbols -- which blocks modern C++ programs (e.g. the nixpkgs
+# `nix`, whose libnixutil imports 26 std::filesystem symbols) from loading.
+# They require C++17, so build just these with -std=c++17 (the rest of libc++
+# is compiled as C++11 here).
+set(cxx_cxx17_sources
+	src/filesystem/operations.cpp
+	src/filesystem/directory_iterator.cpp
+	src/filesystem/int128_builtins.cpp
+	# Minimal C++17 std::pmr (memory_resource + get_default_resource); Darling's
+	# LLVM-13 libcxx shipped only std::experimental::pmr. Needed by the nixpkgs
+	# `nix` (libnixexpr). See src/memory_resource_std.cpp.
+	src/memory_resource_std.cpp
+	# std::__1::__libcpp_verbose_abort -- the verbose-termination handler libc++
+	# gained in LLVM 14; Darling's LLVM-13 libcxx lacks it, so nixpkgs' LLVM-21
+	# clang/libLLVM fail to load under Darling (dyld "Symbol not found:
+	# __ZNSt3__122__libcpp_verbose_abortEPKcz"). See src/verbose_abort_std.cpp.
+	src/verbose_abort_std.cpp
+)
+set_source_files_properties(${cxx_cxx17_sources}
+	PROPERTIES COMPILE_FLAGS "-std=c++17")
+list(APPEND cxx_sources ${cxx_cxx17_sources})
+
 add_cider_object_library(cxx_obj ${cxx_sources})
 make_fat(cxx_obj)
 
