@@ -0,0 +1,42 @@
+//===------------------ verbose_abort_std.cpp -----------------------------===//
+//
+// std::__1::__libcpp_verbose_abort for Darling's libc++.
+//
+// libc++ gained __libcpp_verbose_abort in LLVM 14 as the single verbose
+// termination entry point (assertion/hardening failures and, under
+// -fno-exceptions, __throw_* all funnel through it). Darling's libcxx is
+// LLVM 13 and predates it, so libc++.1.dylib does not export
+//   std::__1::__libcpp_verbose_abort(char const*, ...)
+//   (__ZNSt3__122__libcpp_verbose_abortEPKcz)
+// The nixpkgs toolchain (clang / libLLVM 21.1.8, built for macOS 14)
+// references it from /usr/lib/libc++.1.dylib; without it dyld aborts every
+// clang invocation under Darling ("dyld: Symbol not found"), the last gap
+// stopping guest `nix build` from compiling anything. Verified with llvm-nm
+// to be the only genuine libc++ symbol the whole nixpkgs clang closure lacks.
+//
+// Standard behaviour: print the formatted message to stderr, then abort().
+// Built alongside the other C++17 additions (see CMakeLists.txt), though this
+// one only needs C++11.
+
+#include <cstdarg>
+#include <cstdio>
+#include <cstdlib>
+
+// libcxx builds -fvisibility=hidden; the real libc++ header marks this
+// _LIBCPP_EXPORTED_FROM_ABI. Force default visibility so the symbol is
+// actually exported from libc++.1.dylib (noreturn to match its contract).
+#define VA_VIS __attribute__((visibility("default"), noreturn))
+
+namespace std {
+inline namespace __1 {
+
+VA_VIS void __libcpp_verbose_abort(const char* __format, ...) {
+	va_list __args;
+	va_start(__args, __format);
+	::vfprintf(stderr, __format, __args);
+	va_end(__args);
+	::abort();
+}
+
+} // namespace __1
+} // namespace std
