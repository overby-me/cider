diff --git a/cider/src/libsystem_kernel/emulation/src/xnu_syscall/bsd/impl/unistd/renameatx_np.c b/cider/src/libsystem_kernel/emulation/src/xnu_syscall/bsd/impl/unistd/renameatx_np.c
new file mode 100644
index 0000000..5c9406b
--- /dev/null
+++ b/cider/src/libsystem_kernel/emulation/src/xnu_syscall/bsd/impl/unistd/renameatx_np.c
@@ -0,0 +1,66 @@
+#include <cider/emulation/xnu_syscall/bsd/impl/unistd/renameatx_np.h>
+
+#include <sys/errno.h>
+
+#include <cider/emulation/other/mach/lkm.h>
+#include <cider/emulation/common/base.h>
+#include <cider/emulation/conversion/errno.h>
+#include <cider/emulation/linux_premigration/linux-syscalls/linux.h>
+#include <cider/emulation/conversion/common_at.h>
+#include <cider/emulation/linux_premigration/vchroot_expand.h>
+
+// XNU flag values (bsd/sys/stdio.h)
+#define XNU_RENAME_SWAP 0x00000002
+#define XNU_RENAME_EXCL 0x00000004
+
+// Linux renameat2(2) flag values
+#define LINUX_RENAME_NOREPLACE 1
+#define LINUX_RENAME_EXCHANGE 2
+
+extern char* strcpy(char* dst, const char* src);
+
+// Syscall 488. Translates to Linux renameat2(2):
+//   RENAME_SWAP -> RENAME_EXCHANGE, RENAME_EXCL -> RENAME_NOREPLACE.
+// XNU rejects unknown flags and the SWAP+EXCL combination with EINVAL
+// (bsd/vfs/vfs_syscalls.c, renameat_internal); we mirror that here.
+// RENAME_SECLUDE has no Linux equivalent and is therefore also rejected.
+long sys_renameatx_np(int oldfd, const char* oldpath, int newfd, const char* newpath, unsigned int flags)
+{
+	int ret;
+	unsigned int linux_flags = 0;
+	struct vchroot_expand_args vc, vc2;
+
+	if (flags & ~(XNU_RENAME_SWAP | XNU_RENAME_EXCL))
+		return -EINVAL;
+	if ((flags & XNU_RENAME_SWAP) && (flags & XNU_RENAME_EXCL))
+		return -EINVAL;
+
+	if (flags & XNU_RENAME_SWAP)
+		linux_flags |= LINUX_RENAME_EXCHANGE;
+	if (flags & XNU_RENAME_EXCL)
+		linux_flags |= LINUX_RENAME_NOREPLACE;
+
+	vc.flags = 0;
+	vc.dfd = atfd(oldfd);
+
+	strcpy(vc.path, oldpath);
+
+	vc2.flags = 0;
+	vc2.dfd = atfd(newfd);
+
+	strcpy(vc2.path, newpath);
+
+	ret = vchroot_expand(&vc);
+	if (ret < 0)
+		return errno_linux_to_bsd(ret);
+	ret = vchroot_expand(&vc2);
+	if (ret < 0)
+		return errno_linux_to_bsd(ret);
+
+	ret = LINUX_SYSCALL(__NR_renameat2, vc.dfd, vc.path, vc2.dfd, vc2.path, linux_flags);
+
+	if (ret < 0)
+		return errno_linux_to_bsd(ret);
+
+	return 0;
+}
