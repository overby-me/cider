--- /dev/null
+++ b/darling/src/libsystem_kernel/emulation/src/xnu_syscall/bsd/impl/stat/mkfifoat.c
@@ -0,0 +1,43 @@
+#include <darling/emulation/xnu_syscall/bsd/impl/stat/mkfifoat.h>
+
+#include <sys/errno.h>
+
+#include <darling/emulation/conversion/stat/common.h>
+#include <darling/emulation/common/base.h>
+#include <darling/emulation/conversion/errno.h>
+#include <darling/emulation/linux_premigration/linux-syscalls/linux.h>
+#include <darling/emulation/conversion/common_at.h>
+#include <darling/emulation/linux_premigration/vchroot_expand.h>
+#include <darling/emulation/other/mach/lkm.h>
+
+#define LINUX_S_IFIFO 0010000
+
+extern char* strcpy(char* dst, const char* src);
+
+// mkfifoat is the *at form of mkfifo (BSD slot 132). Not a Darwin syscall;
+// macOS provides it in libSystem. Mirrors sys_mkfifo but honours the dirfd via
+// atfd(), issuing __NR_mknodat with S_IFIFO (Linux has no mkfifoat syscall).
+long sys_mkfifoat(int fd, const char* path, unsigned int mode)
+{
+	int ret;
+	struct vchroot_expand_args vc;
+
+	if (!path)
+		return -EFAULT;
+
+	vc.flags = 0;
+	vc.dfd = atfd(fd);
+
+	strcpy(vc.path, path);
+
+	ret = vchroot_expand(&vc);
+	if (ret < 0)
+		return errno_linux_to_bsd(ret);
+
+	ret = LINUX_SYSCALL(__NR_mknodat, vc.dfd, vc.path, mode | LINUX_S_IFIFO, 0);
+
+	if (ret < 0)
+		return errno_linux_to_bsd(ret);
+
+	return 0;
+}
--- /dev/null
+++ b/darling/src/libsystem_kernel/emulation/src/xnu_syscall/bsd/impl/unistd/mknodat.c
@@ -0,0 +1,46 @@
+#include <darling/emulation/xnu_syscall/bsd/impl/unistd/mknodat.h>
+
+#include <sys/errno.h>
+
+#include <darling/emulation/conversion/stat/common.h>
+#include <darling/emulation/common/base.h>
+#include <darling/emulation/conversion/errno.h>
+#include <darling/emulation/linux_premigration/linux-syscalls/linux.h>
+#include <darling/emulation/conversion/common_at.h>
+#include <darling/emulation/linux_premigration/vchroot_expand.h>
+#include <darling/emulation/other/mach/lkm.h>
+
+extern char* strcpy(char* dst, const char* src);
+
+// mknodat is not a Darwin BSD syscall (absent from syscalls.master); macOS
+// provides it as a libSystem entry. Darling exposes it as a private high-slot
+// handler (see gen/syscall.h SYS_mknodat) mirroring sys_mkdirat: translate the
+// Darwin dirfd via atfd() and issue the Linux __NR_mknodat.
+long sys_mknodat(int fd, const char* path, int mode, int dev)
+{
+	int ret;
+	struct vchroot_expand_args vc;
+
+	if (!path)
+		return -EFAULT;
+
+	vc.flags = 0;
+	vc.dfd = atfd(fd);
+
+	strcpy(vc.path, path);
+
+	ret = vchroot_expand(&vc);
+	if (ret < 0)
+		return errno_linux_to_bsd(ret);
+
+	#if defined(__NR_mknodat)
+		ret = LINUX_SYSCALL(__NR_mknodat, vc.dfd, vc.path, mode, dev);
+	#else
+		ret = LINUX_SYSCALL(__NR_mknod, vc.path, mode, dev);
+	#endif
+
+	if (ret < 0)
+		return errno_linux_to_bsd(ret);
+
+	return 0;
+}
