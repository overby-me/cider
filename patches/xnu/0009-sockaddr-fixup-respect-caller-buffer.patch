diff --git a/cider/src/libsystem_kernel/emulation/src/xnu_syscall/bsd/helper/network/duct.c b/cider/src/libsystem_kernel/emulation/src/xnu_syscall/bsd/helper/network/duct.c
--- a/cider/src/libsystem_kernel/emulation/src/xnu_syscall/bsd/helper/network/duct.c
+++ b/cider/src/libsystem_kernel/emulation/src/xnu_syscall/bsd/helper/network/duct.c
@@ -37,29 +37,70 @@
 	return ret;
 }
 
-int sockaddr_fixup_from_linux(struct sockaddr_fixup* out, const void* linux_sockaddr, int linux_sockaddr_len) {
+int sockaddr_fixup_from_linux(struct sockaddr_fixup* out, const void* linux_sockaddr, int linux_sockaddr_len, int capacity) {
+	// The head is the two bytes before sun_path: on Linux one 16 bit family, on BSD a
+	// length byte and a family byte.
+	const int head = (int) (sizeof(*out) - sizeof(out->sun_path));
 	int ret = linux_sockaddr_len;
+	int copy = linux_sockaddr_len;
 
-	memcpy(out, linux_sockaddr, linux_sockaddr_len);
+	// Every write below is bounded by `capacity`. It used to be bounded by nothing: for a
+	// PF_LOCAL address this wrote sizeof(sun_path) bytes plus a terminator into the
+	// caller's buffer, so bash calling getpeername with a 16 byte struct sockaddr (its
+	// isnetconn, which runs for every shell whose stdin is a socket) had 106 bytes written
+	// over its stack and died in __stack_chk_fail.
+	if (capacity < head)
+		return ret;
+
+	if (copy > capacity)
+		copy = capacity;
+	memcpy(out, linux_sockaddr, copy);
 
 	out->bsd_family = sfamily_linux_to_bsd(out->linux_family);
 
 	if (out->bsd_family == PF_LOCAL) {
 		struct vchroot_unexpand_args vc;
-		strcpy(vc.path, out->sun_path);
+		int src = copy - head;
+		int pathlen;
+
+		// Only the bytes the kernel actually wrote hold a path. The old code ran strcpy
+		// over sun_path regardless, so an unnamed socket (a socketpair, where Linux
+		// returns just the family) was read as an uninitialised string.
+		if (src < 0)
+			src = 0;
+		if (src > (int) sizeof(vc.path) - 1)
+			src = (int) sizeof(vc.path) - 1;
+
+		if (src == 0) {
+			// Unnamed: no path to translate and nothing further to write.
+			out->bsd_length = ret;
+			return ret;
+		}
+
+		memcpy(vc.path, out->sun_path, src);
+		vc.path[src] = '\0';
 
 		ret = vchroot_unexpand(&vc);
 		if (ret < 0)
 			return errno_linux_to_bsd(ret);
 
-		strncpy(out->sun_path, vc.path, sizeof(out->sun_path) - 1);
-		out->sun_path[sizeof(out->sun_path) - 1] = '\0';
-		ret = sizeof(*out) - sizeof(out->sun_path) + strlen(out->sun_path) + 1;
+		pathlen = (int) strlen(vc.path);
+
+		// The FULL length, which is what the caller learns from *socklen even when the
+		// address did not fit, exactly as truncation works on macOS.
+		ret = head + pathlen + 1;
+
+		if (capacity > head) {
+			int n = pathlen;
+			if (n > capacity - head - 1)
+				n = capacity - head - 1;
+			memcpy(out->sun_path, vc.path, n);
+			out->sun_path[n] = '\0';
+		}
 	}
 
-	if (ret >= 0) {
+	if (ret >= 0)
 		out->bsd_length = ret;
-	}
 
 	return ret;
 }
