#!/usr/bin/env bash
# darling-build-hook — Nix build hook that offloads x86_64-darwin builds to Darling
#
# Instead of SSH-based remote building, this hook invokes `darling shell`
# directly on the local machine.  This avoids the SSH setup overhead and
# is simpler to configure for single-machine setups.
#
# Nix build hook protocol (simplified):
#   1. Nix sends a line on fd 4: "# build <drv-path> <system> ..."
#   2. The hook reads from fd 5 for instructions.
#   3. The hook writes responses to fd 6.
#   4. If the hook accepts, it performs the build and reports results.
#
# However, the *actual* protocol used by Nix ≥ 2.4 is the "recursive Nix"
# / post-build-hook style, where the hook is specified via `build-hook` in
# nix.conf and communicates via a specific protocol on stdin/stdout.
#
# For the simpler `builders` / `buildMachines` approach, Nix has built-in
# SSH-based offloading.  This script implements the *alternative* approach
# described in Phase 7.4 of the plan: a lightweight wrapper that Nix's
# `--builders` flag can point to, using the `@/path/to/hook` syntax or
# the `system-features` / `post-build-hook` mechanism.
#
# In practice, this script is designed to be used as:
#
#   nix build --builders 'darling-build-hook x86_64-darwin - 4 1 - - -'
#
# Or configured in nix.conf / NixOS configuration:
#
#   nix.settings.builders = [
#     "darling-build-hook x86_64-darwin - 4 1 - - -"
#   ];
#
# It can also be invoked directly for testing:
#
#   ./scripts/darling-build-hook --build <drv-path>
#   ./scripts/darling-build-hook --check
#   ./scripts/darling-build-hook --help
#
# See: PLAN.md (Task 7.4)

set -euo pipefail

# ── Configuration ────────────────────────────────────────────────────

# Darling binary (auto-detected or overridden via environment)
DARLING="${DARLING_BUILD_HOOK_DARLING:-darling}"

# Darling prefix (default: whatever darling uses, usually ~/.darling)
DPREFIX="${DARLING_BUILD_HOOK_PREFIX:-${DPREFIX:-}}"

# Nix profile to source inside Darling
NIX_PROFILE="${DARLING_BUILD_HOOK_NIX_PROFILE:-/Users/root/.nix-profile/etc/profile.d/nix.sh}"

# Maximum concurrent jobs (for informational purposes; actual limiting
# is done by the Nix daemon based on maxJobs in the builders spec)
MAX_JOBS="${DARLING_BUILD_HOOK_MAX_JOBS:-4}"

# Verbosity
VERBOSE="${DARLING_BUILD_HOOK_VERBOSE:-0}"

# ── Helpers ──────────────────────────────────────────────────────────

log() {
    echo "[darling-build-hook] $*" >&2
}

debug() {
    if [[ "$VERBOSE" -ge 1 ]]; then
        echo "[darling-build-hook] [debug] $*" >&2
    fi
}

die() {
    echo "[darling-build-hook] ERROR: $*" >&2
    exit 1
}

# Run a command inside the Darling prefix with Nix on PATH
darling_run() {
    local prefix_args=()
    if [[ -n "$DPREFIX" ]]; then
        prefix_args=(--prefix "$DPREFIX")
    fi

    "$DARLING" "${prefix_args[@]}" shell bash -lc "
        # Source Nix profile
        for p in \
            '$NIX_PROFILE' \
            /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh \
            /nix/var/nix/profiles/default/etc/profile.d/nix.sh; do
            if [ -e \"\$p\" ]; then
                . \"\$p\"
                break
            fi
        done
        exec \"\$@\"
    " -- "$@"
}

# ── Subcommands ──────────────────────────────────────────────────────

# Check that the Darling builder environment is functional
cmd_check() {
    local exit_code=0

    log "Checking Darling builder environment ..."

    # 1. Darling binary exists
    if command -v "$DARLING" &>/dev/null; then
        log "  ✓ darling binary found: $(command -v "$DARLING")"
    else
        log "  ✗ darling binary not found (looked for: $DARLING)"
        exit_code=1
    fi

    # 2. Darling shell works
    if result=$("$DARLING" shell echo "ok" 2>&1) && [[ "$result" == *"ok"* ]]; then
        log "  ✓ darling shell functional"
    else
        log "  ✗ darling shell not working: $result"
        exit_code=1
    fi

    # 3. Reports Darwin
    if result=$("$DARLING" shell uname -s 2>&1) && [[ "$result" == *"Darwin"* ]]; then
        log "  ✓ uname -s reports Darwin"
    else
        log "  ✗ uname -s does not report Darwin: $result"
        exit_code=1
    fi

    # 4. sandbox-exec stub
    if "$DARLING" shell test -x /usr/bin/sandbox-exec 2>/dev/null; then
        log "  ✓ sandbox-exec stub present"
    else
        log "  ✗ sandbox-exec stub missing"
        exit_code=1
    fi

    # 5. Nix is installed and functional
    if result=$(darling_run nix --version 2>&1); then
        log "  ✓ nix installed: $result"
    else
        log "  ✗ nix not found or not working inside Darling"
        log "    Run scripts/install-nix-in-darling.nu first"
        exit_code=1
    fi

    # 6. System check
    if result=$(darling_run nix eval --raw --expr 'builtins.currentSystem' 2>&1); then
        if [[ "$result" == "x86_64-darwin" ]]; then
            log "  ✓ builtins.currentSystem = x86_64-darwin"
        else
            log "  ✗ builtins.currentSystem = $result (expected x86_64-darwin)"
            exit_code=1
        fi
    else
        log "  ✗ nix eval failed: $result"
        exit_code=1
    fi

    # 7. Nix store accessible
    if darling_run nix-store --verify --no-build &>/dev/null; then
        log "  ✓ nix store accessible and verified"
    else
        log "  ⚠ nix store verification failed (may be OK if store is empty)"
    fi

    if [[ "$exit_code" -eq 0 ]]; then
        log "All checks passed ✓"
    else
        log "Some checks failed — see above"
    fi

    return "$exit_code"
}

# Build a single derivation inside Darling
cmd_build() {
    local drv_path="$1"

    debug "Building derivation: $drv_path"

    # Validate the derivation path
    if [[ ! "$drv_path" == /nix/store/*.drv ]]; then
        die "Invalid derivation path: $drv_path (expected /nix/store/....drv)"
    fi

    # Check if the derivation exists in the store
    if [[ ! -e "$drv_path" ]]; then
        die "Derivation does not exist: $drv_path"
    fi

    # Query the system field to confirm it's a Darwin derivation
    local drv_system
    drv_system=$(nix derivation show "$drv_path" 2>/dev/null | grep -o '"system":"[^"]*"' | head -1 | cut -d'"' -f4) || true
    if [[ -n "$drv_system" && "$drv_system" != "x86_64-darwin" ]]; then
        die "Derivation system is '$drv_system', not x86_64-darwin — refusing to build"
    fi

    # Realise the derivation inside Darling
    log "Realising $drv_path inside Darling ..."
    local start_time
    start_time=$(date +%s)

    darling_run nix-store --realise "$drv_path" --add-root /tmp/darling-build-result --indirect
    local rc=$?

    local end_time elapsed
    end_time=$(date +%s)
    elapsed=$((end_time - start_time))

    if [[ "$rc" -eq 0 ]]; then
        log "Build succeeded in ${elapsed}s: $drv_path"
    else
        log "Build FAILED (exit $rc, ${elapsed}s): $drv_path"
    fi

    return "$rc"
}

# Interactive: query the derivation's outputs
cmd_query_outputs() {
    local drv_path="$1"
    darling_run nix-store --query --outputs "$drv_path"
}

# Print the builder machine spec line in Nix's expected format
cmd_machine_spec() {
    # Format: <store-uri> <system> <ssh-key> <max-jobs> <speed-factor> <supported-features> <mandatory-features> <public-host-key>
    # For a local hook, most fields are placeholders
    echo "- x86_64-darwin - $MAX_JOBS 1 - - -"
}

# ── Usage ────────────────────────────────────────────────────────────

usage() {
    cat >&2 << 'EOF'
Usage: darling-build-hook [--help] [--check] [--build <drv-path>]
                          [--query-outputs <drv-path>] [--machine-spec]

Nix build hook that offloads x86_64-darwin builds to a local Darling instance.

Subcommands:
  --check              Verify the Darling builder environment is functional
  --build <drv>        Build a derivation inside Darling
  --query-outputs <drv> Print the output paths of a derivation
  --machine-spec       Print the Nix builder machine specification line
  --help               Show this help

Environment variables:
  DARLING_BUILD_HOOK_DARLING    Path to the darling binary (default: darling)
  DARLING_BUILD_HOOK_PREFIX     Darling prefix path (default: auto)
  DARLING_BUILD_HOOK_NIX_PROFILE  Nix profile script inside Darling
  DARLING_BUILD_HOOK_MAX_JOBS   Max concurrent jobs (default: 4)
  DARLING_BUILD_HOOK_VERBOSE    Verbosity level (0=quiet, 1=debug)
  DPREFIX                       Fallback for Darling prefix path

When invoked by Nix as a build hook (no arguments), the script reads the
Nix build hook protocol from file descriptors and dispatches builds to
Darling automatically.

Examples:
  # Check the builder is ready
  ./scripts/darling-build-hook --check

  # Build a specific derivation
  ./scripts/darling-build-hook --build /nix/store/...-foo.drv

  # Use as a Nix builder via the builders option (nix.conf or CLI):
  #   builders = /path/to/darling-build-hook x86_64-darwin - 4 1 - - -
  #
  # Or in NixOS configuration:
  #   nix.settings.builders = [
  #     "/path/to/darling-build-hook x86_64-darwin - 4 1 - - -"
  #   ];

See: PLAN.md (Task 7.4)
EOF
}

# ── Nix build hook protocol handler ─────────────────────────────────
#
# When Nix invokes this script as a build hook, it communicates via a
# specific protocol.  The hook reads requests from stdin and writes
# responses to stdout.
#
# Protocol (Nix ≥ 2.0 legacy build hook):
#   - Nix sends on stdin: "1\n<drv-path>\n<system>\n"
#   - Hook responds on stdout:
#     "# decline\n"  — to decline the build
#     "# postpone\n" — to postpone (try again later)
#     "# accept\n"   — to accept, then perform the build
#
# For modern Nix (≥ 2.4), the build-hook setting is less commonly used
# in favour of nix.buildMachines with SSH.  This handler supports the
# legacy protocol for compatibility and adds the direct --build mode
# for manual/scripted use.

handle_hook_protocol() {
    debug "Entering build hook protocol handler (reading from stdin)"

    while true; do
        # Read the request version
        local version
        if ! IFS= read -r version; then
            debug "EOF on stdin — exiting hook loop"
            break
        fi

        # Trim whitespace
        version="${version#"${version%%[![:space:]]*}"}"
        version="${version%"${version##*[![:space:]]}"}"

        if [[ -z "$version" ]]; then
            continue
        fi

        if [[ "$version" != "1" ]]; then
            debug "Unknown hook protocol version: '$version' — declining"
            echo "# decline"
            continue
        fi

        # Read derivation path and system
        local drv_path system
        IFS= read -r drv_path || break
        IFS= read -r system || break

        # Trim whitespace
        drv_path="${drv_path#"${drv_path%%[![:space:]]*}"}"
        drv_path="${drv_path%"${drv_path##*[![:space:]]}"}"
        system="${system#"${system%%[![:space:]]*}"}"
        system="${system%"${system##*[![:space:]]}"}"

        debug "Hook request: drv=$drv_path system=$system"

        # Only accept x86_64-darwin builds
        if [[ "$system" != "x86_64-darwin" ]]; then
            debug "Declining: system '$system' is not x86_64-darwin"
            echo "# decline"
            continue
        fi

        echo "# accept"

        # Perform the build
        if cmd_build "$drv_path"; then
            debug "Hook build succeeded: $drv_path"
        else
            log "Hook build failed: $drv_path"
            # The build failure is communicated via the exit code of
            # nix-store --realise inside cmd_build.  Nix will see the
            # missing output paths and report the failure.
        fi
    done
}

# ── Main ─────────────────────────────────────────────────────────────

main() {
    if [[ $# -eq 0 ]]; then
        # No arguments — invoked as a build hook by Nix.
        # Check if stdin is a pipe/fd (i.e., Nix is talking to us)
        if [[ -p /dev/stdin ]] || [[ ! -t 0 ]]; then
            handle_hook_protocol
        else
            # Interactive invocation with no args — show help
            usage
            exit 0
        fi
        exit 0
    fi

    case "${1:-}" in
        --help | -h)
            usage
            exit 0
            ;;
        --check)
            cmd_check
            ;;
        --build)
            if [[ $# -lt 2 ]]; then
                die "--build requires a derivation path argument"
            fi
            cmd_build "$2"
            ;;
        --query-outputs)
            if [[ $# -lt 2 ]]; then
                die "--query-outputs requires a derivation path argument"
            fi
            cmd_query_outputs "$2"
            ;;
        --machine-spec)
            cmd_machine_spec
            ;;
        --verbose | -v)
            VERBOSE=1
            shift
            main "$@"
            ;;
        *)
            die "Unknown argument: $1 (try --help)"
            ;;
    esac
}

main "$@"
