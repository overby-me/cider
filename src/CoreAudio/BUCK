load("//buck/rules:cc.bzl", "cc_header_root", "cc_objects")
load("//buck/rules:codegen.bzl", "elf_wrapper")
load("//buck/rules:darwin.bzl", "darwin_binary", "darwin_dylib")
load("//buck/rules:files.bzl", "export_file")

# The five HOST libraries the audio stack reaches through libelfloader: ffmpeg's four and
# pulseaudio. Same shape as src/native's sixteen -- see the long comment there for what
# elf_wrapper does and why its output depends on a file outside the build graph. cmake
# writes these as wrap_elf() calls in src/CoreAudio/CMakeLists.txt, all with the default
# destination, so all five install into /usr/lib/native.
#
# (cmake target, host SONAME)
_AUDIO = [
    ("swresample", "libswresample.so"),
    ("avcodec", "libavcodec.so"),
    ("avformat", "libavformat.so"),
    ("avutil", "libavutil.so"),
    ("pulse", "libpulse.so"),
]

# What this package produces, for the registry in scripts/gen-buck-from-ninja.py: it is a
# text scan for a literal name/dylib_name pair and the comprehensions below write neither.
# Same reason src/native carries these; buck-test.nu fails if the list and _AUDIO disagree.
#
# buck-registry: libswresample.dylib = swresample_dylib
# buck-registry: libavcodec.dylib = avcodec_dylib
# buck-registry: libavformat.dylib = avformat_dylib
# buck-registry: libavutil.dylib = avutil_dylib
# buck-registry: libpulse.dylib = pulse_dylib

_ELF_LIB_DIRS = read_root_config("cider", "elf_lib_dirs", "")

[
    elf_wrapper(
        name = _n + "_wrap",
        soname = _so,
        name_base = _n,
        wrapgen = "//src/libelfloader:wrapgen",
        lib_dirs = _ELF_LIB_DIRS,
        deps = ["//darwin:sdk_env"],
        visibility = ["PUBLIC"],
    )
    for _n, _so in _AUDIO
]

[
    cc_objects(
        name = _n + "_obj",
        srcs = [],
        gen_srcs = [":" + _n + "_wrap"],
        compiler_flags = [
            "-DDARLING",
            "-fPIC",
            "-nostdinc",
        ],
        toolchain = "toolchains//:darwin_cc",
        deps = [
            "//darwin:sdk_env",
            "//src/startup:mldr_elfcalls",
        ],
        visibility = ["PUBLIC"],
    )
    for _n, _so in _AUDIO
]

[
    darwin_dylib(
        name = _n + "_dylib",
        dylib_name = "lib" + _n + ".dylib",
        install_name = "/usr/lib/native/lib" + _n + ".dylib",
        objs = [":" + _n + "_obj"],
        siblings = ["//buck-src:system_final"],
        toolchain = "toolchains//:darwin_cc",
        deps = ["//darwin:sdk_env"],
        visibility = ["PUBLIC"],
    )
    for _n, _so in _AUDIO
]

# BEGIN generated: framework roots
# One header root per framework, so a target declares the frameworks it includes
# instead of getting the whole surface. The reference build just puts
# darwin/framework-include on every Darwin compile's path; being explicit here is
# what stops a target compiling against a framework it never declared.
load("//buck/generated:sdk_framework_src_CoreAudio.bzl", FRAMEWORKS = "FRAMEWORKS")

[
    cc_header_root(
        name = "fw_" + _name,
        header_map = _map,
        visibility = ["PUBLIC"],
    )
    for _name, _map in FRAMEWORKS.items()
]
# END generated: framework roots

