load("//buck/rules:cc.bzl", "cc_binary", "cc_objects")
load("//buck/rules:rust.bzl", "rust_binary")

# getuuid and elfdep are HOST tools that read Mach-O out of the build tree: getuuid prints the
# LC_UUID payloads, elfdep prints the SONAME recorded in the __TEXT __elfname section.
#
# THE HEADER HERE USED TO SAY "No targets", on the grounds that the compile died in cctools own
# mach/machine.h looking for mach/machine/vm_types.h. That is STALE: both cc targets build
# today, verified by building them. The same staleness was recorded once already for
# src/bsdln/BUCK, so it is worth checking a claim like this rather than inheriting it.
#
# The Rust ports below (#76) are the reason it stops mattering. Parsing Mach-O at checked byte
# offsets needs no cctools headers at all, so the include path that caused the original trouble
# is not in the picture.

# BEGIN generated: getuuid
# GENERATED from the reference build.ninja by
# scripts/gen-buck-from-ninja.py getuuid   -- review before committing.
# cmake target: getuuid  ->  src/buildtools/getuuid
# TODO these include dirs are GENERATED (codegen output):
#   src/buildtools/include
#   src/include

cc_objects(
    name = "getuuid_obj",
    srcs = [
        "getuuid.c",
    ],
    toolchain = "toolchains//:native_cc",
    deps = [
        "//src/include:darling_config",
        "//buck-src:cctools_port_include",
    ],
    visibility = ["PUBLIC"],
)
# END generated: getuuid

# BEGIN generated: getuuid binary
# GENERATED from the reference build.ninja by
# scripts/gen-buck-from-ninja.py --binaries getuuid   -- review before committing.
# Links 1 cmake object library/ies, 1 flag groups in total.
# buck-registry: src/buildtools/getuuid = getuuid

cc_binary(
    name = "getuuid",
    objs = [
        # getuuid
        ":getuuid_obj",
    ],
    toolchain = "toolchains//:native_cc",
    deps = [
    ],
    visibility = ["PUBLIC"],
)
# END generated: getuuid binary

# BEGIN generated: elfdep
# GENERATED from the reference build.ninja by
# scripts/gen-buck-from-ninja.py elfdep   -- review before committing.
# cmake target: elfdep  ->  src/buildtools/elfdep
# TODO these include dirs are GENERATED (codegen output):
#   src/buildtools/include
#   src/include

cc_objects(
    name = "elfdep_obj",
    srcs = [
        "elfdep.c",
    ],
    toolchain = "toolchains//:native_cc",
    deps = [
        "//src/include:darling_config",
        "//buck-src:cctools_port_include",
    ],
    visibility = ["PUBLIC"],
)
# END generated: elfdep

# BEGIN generated: elfdep binary
# GENERATED from the reference build.ninja by
# scripts/gen-buck-from-ninja.py --binaries elfdep   -- review before committing.
# Links 1 cmake object library/ies, 1 flag groups in total.
# buck-registry: src/buildtools/elfdep = elfdep

cc_binary(
    name = "elfdep",
    objs = [
        # elfdep
        ":elfdep_obj",
    ],
    toolchain = "toolchains//:native_cc",
    deps = [
    ],
    visibility = ["PUBLIC"],
)
# END generated: elfdep binary

# ---- Rust ports (#76). Added ALONGSIDE the C targets rather than replacing them, so the two
# ---- can be diffed on the same inputs before anything switches over.
#
# Both are Darling-origin and GPL (getuuid.c is Copyright 2018 Lubos Dolezel, elfdep.c
# 2018-2020), so the headers stay on the Rust files and a Cider line is added beside them.
#
# The C mmaps the file and casts structures straight out of the mapping, so a lying cmdsize
# walks off the end. These read the file and parse at CHECKED offsets, which is the one
# deliberate behaviour difference; every output-visible behaviour is preserved exactly,
# including the ones that look like oversights (getuuid emits no trailing newline, elfdep exits
# 0 whether or not it found anything). Those were captured from the C binaries FIRST, so the
# comparison is against measured behaviour rather than a reading of the source.

rust_binary(
    name = "getuuid_rs",
    crate_root = "getuuid.rs",
    deps = ["//buck-rust:libc"],
    visibility = ["PUBLIC"],
)

rust_binary(
    name = "elfdep_rs",
    crate_root = "elfdep.rs",
    deps = ["//buck-rust:libc"],
    visibility = ["PUBLIC"],
)
