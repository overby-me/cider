load("//buck/rules:cc.bzl", "cc_objects")
load("//buck/rules:darwin.bzl", "darwin_binary")

# A GUEST PROBE for the kqueue end-of-file question in #235. It lives here rather than under
# vendor/src because run-dts-batch.sh builds its case list by grepping vendor/src/BUCK for names
# beginning with dts_, and a probe that prints an absence is not a pass or a fail.

cc_objects(
    name = "kq_eof_obj",
    srcs = ["kq_eof.c"],
    compiler_flags = ["-O2", "-Wall"],
    toolchain = "toolchains//:darwin_cc",
    deps = ["//src/darwin:sdk_env"],
    visibility = ["PUBLIC"],
)

cc_objects(
