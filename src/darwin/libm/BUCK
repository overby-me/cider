# arm64 has no external assembler files and no SSE; the Intel .c object target becomes the
# whole library, so the .S object target compiles the empty translation unit instead.
_LIBM_ARM_EMPTY = ["Source/empty.c"]

# The alias list the firstpass/final link applies: arm_vfp on arm64, the Intel pair otherwise.
_LIBM_ALIAS = ({
    "-Wl,-alias_list": "Exports/libm_arm_vfp.a.alias",
} if _M_ARM else {
    "-Wl,-alias_list": "Exports/libmathCommonIntel.alias",
})

# The arm64 flag set for the main .c object target: PR 1753 drops the SSE trio and the
# Carbon-legacy define, keeps the rest, and adds ARMLIBM_FENV_SUPPORT.
_LIBM_ARM_CFLAGS = [
    "-DPRIVATE",
    "-D_LIBC_NO_FEATURE_VERIFICATION",
    "-D__DARWIN_UNIX03",
    "-DARMLIBM_FENV_SUPPORT",
    "-fPIC",
    "-w",
    "-ggdb",
    "-O0",
    "-funroll-loops",
]

# The arm64 include root: Source/ARM in place of Source/Intel.
cc_header_root(
    name = "system_m_inc_libm_Source_ARM",
    headers = glob(["Source/ARM/*.h", "Source/ARM/**/*.h"]),
    root = "Source/ARM",
    visibility = ["PUBLIC"],
)

# SDK headers this package owns: the Darwin SDK tree reaches them by
# symlink, and a header_map's values must be sources in the declaring
# package. GENERATED by cider-sdk-header-roots --repo-roots.
# BEGIN generated: sdk headers
# SDK headers this package owns: the Darwin SDK tree reaches them by
# symlink, and a header_map's values must be sources in the declaring
# package. GENERATED by cider-sdk-header-roots --repo-roots.
cc_header_root(
    name = "sdk_src_libm_headers",
    header_map = {
        "architecture/i386/fenv.h": "Source/Intel/fenv.h",
        "architecture/i386/math.h": "Source/Intel/math.h",
        # The arm dispatch targets (aarch64 port, task A13): fenv.h dispatches here on arm64,
        # math.h reuses the Intel header (identical prototypes). Their contents came from
        # darling PR 1753 (Source/architecture/arm/fenv.h).
        "architecture/arm/fenv.h": "Source/architecture/arm/fenv.h",
        "architecture/arm/math.h": "Source/Intel/math.h",
        "complex.h": "Source/complex.h",
        "fenv.h": "Source/fenv.h",
        "math.h": "Source/math.h",
        "nan.h": "Source/nan.h",
    },
    visibility = ["PUBLIC"],
)
# END generated: sdk headers

