# SWIFT OVERLAYS THIS PORT DOES NOT HAVE.
#
# The prefix carries 44 prebuilt Apple Swift overlays from a pin. These ten are in no pin and in no
# application bundle, and dyld will not start a process whose library is missing however little of it
# is used. Each shim defines exactly the symbols an application binds EAGERLY, as placeholders that
# name themselves when reached. See src/darwin/swiftshim/<name>.c.

load("//buck/rules:cc.bzl", "cc_objects")
load("//buck/rules:darwin.bzl", "darwin_dylib")

# buck-registry: src/swiftshim/libswiftSystem = libswiftSystem_dylib
cc_objects(
    name = "libswiftSystem_obj",
    srcs = ["libswiftSystem.c"],
    compiler_flags = ["-fPIC", "-D_LIBC_NO_FEATURE_VERIFICATION"],
    toolchain = "toolchains//:darwin_cc",
    deps = ["//src/darwin:sdk_env"],
    visibility = ["PUBLIC"],
)

darwin_dylib(
    name = "libswiftSystem_dylib",
    dylib_name = "libswiftSystem",
    install_name = "/usr/lib/swift/libswiftSystem.dylib",
    compatibility_version = "1.0.0",
    current_version = "1.0.0",
    objs = [":libswiftSystem_obj"],
    siblings = ["//vendor/src:system_final"],
    toolchain = "toolchains//:darwin_cc",
    deps = ["//src/darwin:sdk_env"],
    visibility = ["PUBLIC"],
)


darwin_dylib(
    name = "libswift_Concurrency_dylib",
    dylib_name = "libswift_Concurrency",
    install_name = "/usr/lib/swift/libswift_Concurrency.dylib",
    compatibility_version = "1.0.0",
    current_version = "1.0.0",
    objs = [":libswift_Concurrency_obj"],
    siblings = ["//vendor/src:system_final"],
