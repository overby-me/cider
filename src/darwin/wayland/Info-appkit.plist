<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>English</string>
	<key>CFBundleExecutable</key>
	<string>Wayland</string>
	<key>CFBundleIdentifier</key>
	<string>me.overby.cider.AppKit.Wayland</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundlePackageType</key>
	<string>BNDL</string>
	<!-- HIGHER THAN X11, which is 200. _CGSLoadBackend sorts by this and takes the first whose
	     principal class answers isAvailable, so on a Wayland session this one wins and on any
	     other it declines and X11 is still there. -->
	<key>NSPriority</key>
	<integer>300</integer>
	<key>NSPrincipalClass</key>
	<string>NSDisplayWayland</string>
</dict>
</plist>
