# cmake target: xtracelib  ->  xtracelib
# 10 sources in 2 flag groups: cmake gives individual
# files their own defines and -include shims, and those decide symbol aliasing.

# Sibling include dirs, staged as ONE tree with -I into each: headers here
# reach each other with `#include "../<dir>/x.h"`, which only resolves if
# the sibling is in the same staged tree.
cc_header_root(
    name = "xtracelib_inc_src_xtrace",
    headers = glob([
        "include/*.h",
        "include/**/*.h",
        "include/*.c",
        "**/*",
    ]),
    root = "src/darwin/xtrace",
    include_subdirs = [
        "include",
        ".",
    ],
    visibility = ["PUBLIC"],
)

