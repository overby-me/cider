#!/bin/sh
# dseditgroup — Directory Services group management stub for Darling
#
# Translates macOS dseditgroup commands to direct /etc/group file operations.
# Only implements the subset needed by the Nix installer:
#
#   dseditgroup -o create [-q] [-i <GID>] <groupname>
#   dseditgroup -o edit -a <user> -t user <groupname>
#   dseditgroup -o delete <groupname>
#   dseditgroup -o checkmember -m <user> <groupname>
#   dseditgroup -o read <groupname>
#
# This stub operates on the Darling prefix's /etc/group file, NOT the host's.
#
# See: PLAN.md (Task 5.1)

set -eu

GROUP_FILE="/etc/group"

# ── Helpers ─────────────────────────────────────────────────────────────────

errcho() {
    echo "$@" >&2
}

usage() {
    errcho "Usage: dseditgroup -o <operation> [options] <groupname>"
    errcho ""
    errcho "Operations:"
    errcho "  create       Create a new group"
    errcho "  edit         Edit an existing group (add/remove members)"
    errcho "  delete       Delete a group"
    errcho "  checkmember  Check if a user is a member of a group"
    errcho "  read         Read group information"
    errcho ""
    errcho "Options:"
    errcho "  -q           Quiet mode (suppress informational output)"
    errcho "  -i <GID>     Group ID (for create)"
    errcho "  -a <user>    User to add (for edit)"
    errcho "  -d <user>    User to remove (for edit)"
    errcho "  -t <type>    Record type (user/group, for edit)"
    errcho "  -m <user>    User to check membership (for checkmember)"
    exit 64
}

# group_exists <name> — exit 0 if the group exists in /etc/group
group_exists() {
    grep -q "^${1}:" "$GROUP_FILE" 2>/dev/null
}

# get_group_gid <name> — print the GID of the named group
get_group_gid() {
    awk -F: -v name="$1" '$1 == name { print $3; exit }' "$GROUP_FILE"
}

# get_group_members <name> — print the comma-separated member list
get_group_members() {
    awk -F: -v name="$1" '$1 == name { print $4; exit }' "$GROUP_FILE"
}

# next_gid — find the next available GID >= 30000
next_gid() {
    awk -F: '{ if ($3 >= 30000 && $3 > max) max = $3 } END { print (max ? max + 1 : 30000) }' "$GROUP_FILE"
}

# ── Parse top-level arguments ───────────────────────────────────────────────

OPERATION=""
QUIET=0

# We need at least: dseditgroup -o <op> <groupname>
if [ "$#" -lt 3 ]; then
    usage
fi

# Parse -o <operation> which must come first (or early)
while [ "$#" -gt 0 ]; do
    case "$1" in
        -o)
            [ "$#" -ge 2 ] || usage
            OPERATION="$2"
            shift 2
            break
            ;;
        -q)
            QUIET=1
            shift
            ;;
        *)
            errcho "dseditgroup: expected -o <operation>, got '$1'"
            usage
            ;;
    esac
done

# ── Dispatch by operation ───────────────────────────────────────────────────

case "$OPERATION" in

# ── create ──────────────────────────────────────────────────────────────────
create)
    GID=""
    # Parse remaining options
    while [ "$#" -gt 1 ]; do
        case "$1" in
            -q)
                QUIET=1
                shift
                ;;
            -i)
                [ "$#" -ge 2 ] || usage
                GID="$2"
                shift 2
                ;;
            -r)
                # -r <realname> — ignored, not needed for /etc/group
                shift 2
                ;;
            *)
                break
                ;;
        esac
    done

    # Last argument is the group name
    if [ "$#" -lt 1 ]; then
        errcho "dseditgroup: create requires a group name"
        usage
    fi
    GROUPNAME="$1"

    # Validate group name (alphanumeric, underscore, dash)
    case "$GROUPNAME" in
        *[!a-zA-Z0-9_-]*)
            errcho "dseditgroup: invalid group name '$GROUPNAME'"
            exit 1
            ;;
    esac

    # Idempotent: if group already exists, succeed silently
    if group_exists "$GROUPNAME"; then
        [ "$QUIET" -eq 1 ] || echo "Group '$GROUPNAME' already exists"
        exit 0
    fi

    # Assign GID if not specified
    if [ -z "$GID" ]; then
        GID=$(next_gid)
    fi

    # Validate GID is numeric
    case "$GID" in
        *[!0-9]*)
            errcho "dseditgroup: GID must be numeric, got '$GID'"
            exit 1
            ;;
    esac

    # Check for GID conflicts
    if awk -F: -v gid="$GID" '$3 == gid { found=1; exit } END { exit !found }' "$GROUP_FILE" 2>/dev/null; then
        existing=$(awk -F: -v gid="$GID" '$3 == gid { print $1; exit }' "$GROUP_FILE")
        errcho "dseditgroup: GID $GID already in use by group '$existing'"
        exit 1
    fi

    # Create the group entry
    echo "${GROUPNAME}:x:${GID}:" >> "$GROUP_FILE"

    [ "$QUIET" -eq 1 ] || echo "Created group '$GROUPNAME' with GID $GID"
    ;;

# ── edit ────────────────────────────────────────────────────────────────────
edit)
    ADD_USER=""
    DEL_USER=""
    RECORD_TYPE="user"

    while [ "$#" -gt 1 ]; do
        case "$1" in
            -q)
                QUIET=1
                shift
                ;;
            -a)
                [ "$#" -ge 2 ] || usage
                ADD_USER="$2"
                shift 2
                ;;
            -d)
                [ "$#" -ge 2 ] || usage
                DEL_USER="$2"
                shift 2
                ;;
            -t)
                [ "$#" -ge 2 ] || usage
                RECORD_TYPE="$2"
                shift 2
                ;;
            *)
                break
                ;;
        esac
    done

    if [ "$#" -lt 1 ]; then
        errcho "dseditgroup: edit requires a group name"
        usage
    fi
    GROUPNAME="$1"

    if ! group_exists "$GROUPNAME"; then
        errcho "dseditgroup: group '$GROUPNAME' not found"
        exit 1
    fi

    if [ -n "$ADD_USER" ]; then
        # Check if user is already a member (idempotent)
        MEMBERS=$(get_group_members "$GROUPNAME")
        case ",$MEMBERS," in
            *,"$ADD_USER",*)
                [ "$QUIET" -eq 1 ] || echo "User '$ADD_USER' is already a member of '$GROUPNAME'"
                exit 0
                ;;
        esac

        # Append user to the member list
        if [ -z "$MEMBERS" ]; then
            NEW_MEMBERS="$ADD_USER"
        else
            NEW_MEMBERS="${MEMBERS},${ADD_USER}"
        fi

        # Use a temp file for atomic-ish update
        TMPFILE=$(mktemp "${GROUP_FILE}.XXXXXX")
        awk -F: -v name="$GROUPNAME" -v members="$NEW_MEMBERS" \
            'BEGIN { OFS=":" } $1 == name { $4 = members } { print }' \
            "$GROUP_FILE" > "$TMPFILE"
        mv "$TMPFILE" "$GROUP_FILE"

        [ "$QUIET" -eq 1 ] || echo "Added '$ADD_USER' to group '$GROUPNAME'"

    elif [ -n "$DEL_USER" ]; then
        MEMBERS=$(get_group_members "$GROUPNAME")

        # Remove the user from the comma-separated list
        NEW_MEMBERS=$(echo "$MEMBERS" | tr ',' '\n' | grep -v "^${DEL_USER}$" | paste -sd ',' -)

        TMPFILE=$(mktemp "${GROUP_FILE}.XXXXXX")
        awk -F: -v name="$GROUPNAME" -v members="$NEW_MEMBERS" \
            'BEGIN { OFS=":" } $1 == name { $4 = members } { print }' \
            "$GROUP_FILE" > "$TMPFILE"
        mv "$TMPFILE" "$GROUP_FILE"

        [ "$QUIET" -eq 1 ] || echo "Removed '$DEL_USER' from group '$GROUPNAME'"
    else
        errcho "dseditgroup: edit requires -a <user> or -d <user>"
        usage
    fi
    ;;

# ── delete ──────────────────────────────────────────────────────────────────
delete)
    while [ "$#" -gt 1 ]; do
        case "$1" in
            -q)
                QUIET=1
                shift
                ;;
            *)
                break
                ;;
        esac
    done

    if [ "$#" -lt 1 ]; then
        errcho "dseditgroup: delete requires a group name"
        usage
    fi
    GROUPNAME="$1"

    if ! group_exists "$GROUPNAME"; then
        [ "$QUIET" -eq 1 ] || errcho "dseditgroup: group '$GROUPNAME' not found"
        exit 0  # idempotent — deleting non-existent group is fine
    fi

    TMPFILE=$(mktemp "${GROUP_FILE}.XXXXXX")
    grep -v "^${GROUPNAME}:" "$GROUP_FILE" > "$TMPFILE" || true
    mv "$TMPFILE" "$GROUP_FILE"

    [ "$QUIET" -eq 1 ] || echo "Deleted group '$GROUPNAME'"
    ;;

# ── checkmember ─────────────────────────────────────────────────────────────
checkmember)
    CHECK_USER=""

    while [ "$#" -gt 1 ]; do
        case "$1" in
            -q)
                QUIET=1
                shift
                ;;
            -m)
                [ "$#" -ge 2 ] || usage
                CHECK_USER="$2"
                shift 2
                ;;
            *)
                break
                ;;
        esac
    done

    if [ "$#" -lt 1 ]; then
        errcho "dseditgroup: checkmember requires a group name"
        usage
    fi
    GROUPNAME="$1"

    if [ -z "$CHECK_USER" ]; then
        errcho "dseditgroup: checkmember requires -m <user>"
        usage
    fi

    if ! group_exists "$GROUPNAME"; then
        errcho "dseditgroup: group '$GROUPNAME' not found"
        exit 1
    fi

    MEMBERS=$(get_group_members "$GROUPNAME")
    case ",$MEMBERS," in
        *,"$CHECK_USER",*)
            [ "$QUIET" -eq 1 ] || echo "yes $CHECK_USER is a member of $GROUPNAME"
            exit 0
            ;;
        *)
            [ "$QUIET" -eq 1 ] || echo "no $CHECK_USER is NOT a member of $GROUPNAME"
            exit 1
            ;;
    esac
    ;;

# ── read ────────────────────────────────────────────────────────────────────
read)
    while [ "$#" -gt 1 ]; do
        case "$1" in
            -q)
                QUIET=1
                shift
                ;;
            *)
                break
                ;;
        esac
    done

    if [ "$#" -lt 1 ]; then
        errcho "dseditgroup: read requires a group name"
        usage
    fi
    GROUPNAME="$1"

    if ! group_exists "$GROUPNAME"; then
        errcho "dseditgroup: group '$GROUPNAME' not found"
        exit 1
    fi

    GID=$(get_group_gid "$GROUPNAME")
    MEMBERS=$(get_group_members "$GROUPNAME")

    echo "AppleMetaNodeLocation: /Local/Default"
    echo "GeneratedUID: 00000000-0000-0000-0000-$(printf '%012d' "$GID")"
    echo "PrimaryGroupID: $GID"
    echo "RecordName: $GROUPNAME"
    echo "RecordType: dsRecTypeStandard:Groups"
    if [ -n "$MEMBERS" ]; then
        echo "$MEMBERS" | tr ',' '\n' | while read -r member; do
            echo "GroupMembership: $member"
        done
    fi
    ;;

# ── unknown operation ───────────────────────────────────────────────────────
*)
    errcho "dseditgroup: unknown operation '$OPERATION'"
    usage
    ;;
esac
