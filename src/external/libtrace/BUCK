load("//buck/rules:cc.bzl", "cc_header_root", "cc_objects")
load("//buck/rules:darwin.bzl", "darwin_dylib")

# SDK headers this package owns: the Darwin SDK tree reaches them by
# symlink, and a header_map's values must be sources in the declaring
# package. GENERATED by scripts/gen-sdk-header-roots.py --repo-roots.
cc_header_root(
    name = "sdk_src_external_libtrace_headers",
    header_map = {
        "os/log.h": "include/os/log.h",
        "os/log_private.h": "include/os/log_private.h",
        "os/trace_private.h": "include/os/trace_private.h",
    },
    visibility = ["PUBLIC"],
)

