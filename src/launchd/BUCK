# BEGIN generated: launchproxy
# GENERATED from the reference build.ninja by
# scripts/gen-buck-from-ninja.py launchproxy   -- review before committing.
# cmake target: launchproxy  ->  src/launchd/support/launchproxy
# TODO these headers are FORCE-INCLUDED (-include) but could not be
# resolved to a file in this tree; the sources need them:
#   darwin/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX.sdk/usr/include/sys/fileport.h
# TODO these include dirs are GENERATED (codegen output):
#   src/launchd/support

# Sibling include dirs, staged as ONE tree with -I into each: headers here
# reach each other with `#include "../<dir>/x.h"`, which only resolves if
# the sibling is in the same staged tree.
cc_header_root(
    name = "launchproxy_inc_src_launchd",
    headers = glob([
        "src/*.h",
        "src/**/*.h",
        "liblaunch/*.h",
        "liblaunch/**/*.h",
    ]),
    root = "src/launchd",
    include_subdirs = [
        "src",
        "liblaunch",
    ],
    visibility = ["PUBLIC"],
)

cc_header_root(
    name = "launchproxy_inc_src_launchd_support",
    headers = glob(["support/*.h", "support/**/*.h"]),
    root = "support",
    visibility = ["PUBLIC"],
)

cc_objects(
    name = "launchproxy_obj",
    srcs = [
        "support/launchproxy.c",
    ],
    compiler_flags = [
        "-DPRIVATE",
