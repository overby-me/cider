# BEGIN generated: launch_obj
# GENERATED from the reference build.ninja by
# scripts/gen-buck-from-ninja.py launch_obj   -- review before committing.
# cmake target: launch_obj  ->  src/launchd/liblaunch/launch_obj
# TODO these sources are GENERATED; wire a codegen target for each:
#   src/launchd/liblaunch/helperServer.c
#   src/launchd/liblaunch/jobUser.c
# TODO these headers are FORCE-INCLUDED (-include) but could not be
# resolved to a file in this tree; the sources need them:
#   darwin/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX.sdk/usr/include/sys/fileport.h
# TODO these include dirs are GENERATED (codegen output):
#   src/launchd/liblaunch

cc_header_root(
    name = "launch_inc_src_launchd_src",
    headers = glob(["src/*.h", "src/**/*.h"]),
    root = "src",
    visibility = ["PUBLIC"],
)

cc_objects(
    name = "launch_obj",
    srcs = [
        "liblaunch/libbootstrap.c",
        "liblaunch/liblaunch.c",
        "liblaunch/libvproc.c",
    ],
    compiler_flags = [
        "-D_LIBC_NO_FEATURE_VERIFICATION",
        "-fblocks",
        "-ggdb",
        "-w",
        "-nostdinc",
    ],
    toolchain = "toolchains//:darwin_cc",
    deps = [
        "//darwin:sdk_env",
        "//buck-src:dispatchmig_protocol",
        ":launchmig_job",
        ":launchmig_helper",
        ":launch_inc_src_launchd_src",
    ],
    gen_srcs = [
        ":launchmig_job",
        ":launchmig_helper",
    ],
    visibility = ["PUBLIC"],
)
# END generated: launch_obj

# liblaunch's job protocol: launch_obj includes the generated job.h bare.
