# The include dir as the sources see it. sdk_src_libMobileGestalt_headers maps this
# same header FLAT, because that is where the SDK puts it (usr/include/MobileGestalt.h),
# but libMobileGestalt's own sources include <MobileGestalt/MobileGestalt.h> and the
# reference gives them -Isrc/libMobileGestalt/include for it. Both spellings are real.
cc_header_root(
    name = "mobilegestalt_include",
    headers = glob(["include/**/*.h"]),
    root = "include",
    visibility = ["PUBLIC"],
)
