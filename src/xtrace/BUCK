load("//buck/rules:cc.bzl", "cc_header_root")
load("//buck/rules:files.bzl", "export_file")

# xtrace's public headers, staged with the package structure INTACT: the per-protocol
# XtraceMig stubs include <xtrace/xtrace-mig-types.h>, and that header reaches back out
# with #include "../../base.h" -- which only resolves if the staged copy has the same
# shape, so the tree is staged from the package root with -I pointing at include/.
cc_header_root(
    name = "xtrace_headers",
    headers = glob(["*.h", "include/xtrace/*.h"]),
    include_subdirs = ["include"],
    visibility = ["PUBLIC"],
)

# BEGIN generated: prefix exports
# GENERATED from the reference build's install entries by
# scripts/gen-install-from-manifests.py -- review before committing.

export_file(
    name = "xtrace",
    src = "xtrace",
    visibility = ["PUBLIC"],
)

# END generated: prefix exports
