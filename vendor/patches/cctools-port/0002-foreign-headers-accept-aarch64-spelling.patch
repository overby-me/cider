foreign/ headers accept the aarch64 spelling (aarch64 port, task A4)

Same fix as xnu patch 0019, for the cross-build headers ld64 compiles against on a
Linux host: sixteen dispatch headers under cctools/include/foreign test __arm64__,
which an aarch64-linux clang does not define. The arm targets they dispatch to are
already in the tree (foreign/arm, foreign/mach/arm).

--- a/cctools/include/foreign/mach/machine/boolean.h
+++ b/cctools/include/foreign/mach/machine/boolean.h
@@ -33,7 +33,7 @@
 #include "mach/ppc/boolean.h"
 #elif defined (__i386__) || defined(__x86_64__)
 #include "mach/i386/boolean.h"
-#elif defined (__arm__) || defined(__arm64__)
+#elif defined (__arm__) || defined(__arm64__) || defined(__aarch64__)
 #include "mach/arm/boolean.h"
 #else
 #error architecture not supported
