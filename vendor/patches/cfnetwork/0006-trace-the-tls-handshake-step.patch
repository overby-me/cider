+/*
+ * CIDER_TRACE_TLS names the step an HTTPS stream stops at (task #199): a connected socket with no
+ * bytes looks identical whether the security level was never applied, the SSL context was never
+ * built, the handshake was never registered, or it ran and returned an error nobody prints.
+ */
+static int _CiderTraceTLS(void) {
+	static int on = -1;
+
+	if (on < 0) {
+		const char* value = getenv("CIDER_TRACE_TLS");
+
+		on = (value != NULL && value[0] != '\0') ? 1 : 0;
+	}
+	return on;
+}
+
+#define CIDER_TLS_LOG(...)                                     \
+	do {                                                       \
+		if (_CiderTraceTLS()) {                                \
+			fprintf(stderr, "CIDER_TLS " __VA_ARGS__);         \
+			fflush(stderr);                                    \
+		}                                                      \
+	} while (0)
+
