+/* ONE CHANNEL OF THE ICNS RUN LENGTH ENCODING, which ic04 and ic05 use for each of A, R, G and B in
+ * turn. A control byte with the top bit set repeats the next byte (control - 125) times; otherwise
+ * it introduces (control + 1) literal bytes. Returns where it stopped so the next channel can carry
+ * on, and stops early rather than reading past the chunk. */
+static uint32_t decodeICNSChannel(const uint8_t *bytes, uint32_t length, uint32_t offset,
+                                  uint8_t *out, uint32_t pixelCount) {
+    uint32_t written = 0;
+
+    while (written < pixelCount && offset < length) {
+        uint8_t control = bytes[offset++];
+
+        if (control & 0x80) {
+            uint32_t run = (uint32_t)control - 125;
+
+            if (offset >= length)
+                break;
+
+            uint8_t value = bytes[offset++];
+
+            while (run-- > 0 && written < pixelCount)
+                out[written++] = value;
+        } else {
+            uint32_t run = (uint32_t)control + 1;
+
+            while (run-- > 0 && written < pixelCount && offset < length)
+                out[written++] = bytes[offset++];
+        }
+    }
+
+    return offset;
+}
+
+/* An O2Image over RGBA samples. NOT PREMULTIPLIED, unlike the classic path below: an ARGB chunk
+ * stores straight alpha and macOS reports kCGImageAlphaLast for these icons. The buffer is handed
+ * to the NSData and freed with it. */
+- (void) addImageWithPixels: (O2rgba8u_BE *) pixels
+                      width: (uint32_t) width
+                     height: (uint32_t) height {
+    uint32_t pixelCount = width * height;
+
+    O2ColorSpaceRef colorSpace = O2ColorSpaceCreateDeviceRGB();
+    NSData *bitmap = [[NSData alloc] initWithBytesNoCopy: pixels
+                                                  length: pixelCount * sizeof(O2rgba8u_BE)];
+    O2DataProvider *provider = O2DataProviderCreateWithCFData((CFDataRef) bitmap);
+    O2Image *image = [[O2Image alloc]
+               initWithWidth: width
+                      height: height
+            bitsPerComponent: 8
+                bitsPerPixel: 32
+                 bytesPerRow: width * sizeof(O2rgba8u_BE)
+                  colorSpace: colorSpace
+                  bitmapInfo: kO2BitmapByteOrder32Big | kO2ImageAlphaLast
+                     decoder: NULL
+                    provider: provider
+                      decode: NULL
+                 interpolate: NO
+             renderingIntent: kO2RenderingIntentDefault];
+
+    O2ColorSpaceRelease(colorSpace);
+    O2DataProviderRelease(provider);
+    [bitmap release];
+
+    if (image != nil) {
+        [_images addObject: image];
+        O2ImageRelease(image);
+    }
+}
+
+/* ic07 through ic14 hold a whole PNG. Hand it to whichever source recognises it rather than
+ * decoding it here: O2ImageSource sniffs the data and picks the subclass. */
+- (void) addImageFromEncodedPayload: (const uint8_t *) bytes length: (uint32_t) length {
+    NSData *data = [[NSData alloc] initWithBytes: bytes length: length];
+    O2ImageSourceRef source = [O2ImageSource newImageSourceWithData: (CFDataRef) data
+                                                            options: NULL];
+
+    if (source != NULL) {
+        if ([source count] > 0) {
+            O2Image *image = [source createImageAtIndex: 0 options: NULL];
+
+            if (image != NULL) {
+                [_images addObject: image];
+                O2ImageRelease(image);
+            }
+        }
+
+        [source release];
+    }
+
+    [data release];
+}
+
+/* ic04 and ic05 hold RLE compressed ARGB, alpha channel first, at 16x16 and 32x32. */
+- (void) addImageFromARGBPayload: (const uint8_t *) bytes
+                          length: (uint32_t) length
+                           width: (uint32_t) width
+                          height: (uint32_t) height {
+    uint32_t pixelCount = width * height;
+    O2rgba8u_BE *pixels = calloc(pixelCount, sizeof(O2rgba8u_BE));
+    uint8_t *channel = malloc(pixelCount);
+
+    if (pixels == NULL || channel == NULL) {
+        free(pixels);
+        free(channel);
+        return;
+    }
+
+    uint32_t offset = 0, i, slot;
+
+    for (slot = 0; slot < 4; slot++) {
+        memset(channel, 0, pixelCount);
+        offset = decodeICNSChannel(bytes, length, offset, channel, pixelCount);
+
+        for (i = 0; i < pixelCount; i++) {
+            switch (slot) {
+            case 0: pixels[i].a = channel[i]; break;
+            case 1: pixels[i].r = channel[i]; break;
+            case 2: pixels[i].g = channel[i]; break;
+            case 3: pixels[i].b = channel[i]; break;
+            }
+        }
+    }
+
+    free(channel);
+    [self addImageWithPixels: pixels width: width height: height];
+}
