+
+/*
+ * STRAIGHT ALPHA IN, PREMULTIPLIED OUT, because those are two different things and only one of them
+ * composites. O2argb8u is premultiplied throughout: the source-over span in O2argb8u.m is
+ * Cr = Cs + Cd * (255 - As) / 255, with no multiply by As, so a straight sample drawn through it
+ * comes out too bright wherever alpha is partial.
+ *
+ * kO2ImageAlphaLast used to share the premultiplied reader, which made the two labels mean the same
+ * thing and quietly mis-drew every image that told the truth about holding straight alpha. Task #208.
+ */
+O2argb8u *O2ImageRead_RGBA8888_straight_to_argb8u(O2Image *self, int x, int y,
+                                                  O2argb8u *span, int length)
+{
+    const uint8_t *scanline = scanlineAtY(self, y);
+    int i;
+
+    if (scanline == NULL)
+        return NULL;
+
+    scanline += x * 4;
+    for (i = 0; i < length; i++) {
+        O2argb8u result;
+        uint8_t a = scanline[3];
+
+        result.r = O2Image_8u_mul_8u_div_255(scanline[0], a);
+        result.g = O2Image_8u_mul_8u_div_255(scanline[1], a);
+        result.b = O2Image_8u_mul_8u_div_255(scanline[2], a);
+        result.a = a;
+        *span++ = result;
+        scanline += 4;
+    }
+    return NULL;
+}
+
+O2argb8u *O2ImageRead_ABGR8888_straight_to_argb8u(O2Image *self, int x, int y,
+                                                  O2argb8u *span, int length)
+{
+    const uint8_t *scanline = scanlineAtY(self, y);
+    int i;
+
+    if (scanline == NULL)
+        return NULL;
+
+    scanline += x * 4;
+    for (i = 0; i < length; i++) {
+        O2argb8u result;
+        uint8_t a = scanline[0];
+
+        result.a = a;
+        result.b = O2Image_8u_mul_8u_div_255(scanline[1], a);
+        result.g = O2Image_8u_mul_8u_div_255(scanline[2], a);
+        result.r = O2Image_8u_mul_8u_div_255(scanline[3], a);
+        *span++ = result;
+        scanline += 4;
+    }
+    return NULL;
+}
 
