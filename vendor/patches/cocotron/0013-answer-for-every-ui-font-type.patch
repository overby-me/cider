 /*
+ * THE WHOLE DICTIONARY, since that is all a descriptor is here. Copy, because the name says Copy.
+ */
+CFDictionaryRef CTFontDescriptorCopyAttributes(CTFontDescriptorRef descriptor)
+{
+    if (descriptor == NULL) return NULL;
+    return CFDictionaryCreateCopy(kCFAllocatorDefault, (CFDictionaryRef) descriptor);
+}
+
+/*
+ * THE ORIGINAL OVERLAID WITH THE NEW ATTRIBUTES, which is what macOS documents: keys in attributes
+ * replace those in the descriptor and everything else is carried across.
+ */
+CTFontDescriptorRef CTFontDescriptorCreateCopyWithAttributes(CTFontDescriptorRef descriptor,
+                                                             CFDictionaryRef attributes)
+{
+    CFMutableDictionaryRef merged;
+
+    if (descriptor == NULL) return NULL;
+    if (attributes == NULL)
+        return (CTFontDescriptorRef) CFDictionaryCreateCopy(kCFAllocatorDefault,
+                                                            (CFDictionaryRef) descriptor);
+
+    merged = CFDictionaryCreateMutableCopy(kCFAllocatorDefault, 0, (CFDictionaryRef) descriptor);
+    if (merged == NULL) return NULL;
+
+    CFIndex count = CFDictionaryGetCount(attributes);
+    if (count > 0) {
+        const void **keys = malloc(sizeof(void *) * count);
+        const void **values = malloc(sizeof(void *) * count);
+
+        CFDictionaryGetKeysAndValues(attributes, keys, values);
+        for (CFIndex i = 0; i < count; i++)
+            CFDictionarySetValue(merged, keys[i], values[i]);
+        free(keys);
+        free(values);
+    }
+    return (CTFontDescriptorRef) merged;
+}
+
+/*
+ * THE MASK SAYS WHICH BITS THE CALLER IS SPEAKING ABOUT, so the bits outside it keep the value the
+ * descriptor already had. Passing the value alone would silently clear every trait not mentioned.
+ *
+ * The traits are a SUB-DICTIONARY under kCTFontTraitsAttribute, the same shape
+ * _CiderSymbolicTraitsOfDescriptor in CTFont.m reads, so this writes where that reads.
+ */
+CTFontDescriptorRef CTFontDescriptorCreateCopyWithSymbolicTraits(CTFontDescriptorRef descriptor,
+                                                                 CTFontSymbolicTraits symTraitValue,
+                                                                 CTFontSymbolicTraits symTraitMask)
+{
+    CFMutableDictionaryRef copy, traits;
+    CFDictionaryRef existing;
+    unsigned current = 0, resolved;
+    CFNumberRef number;
+
+    if (descriptor == NULL) return NULL;
+
+    copy = CFDictionaryCreateMutableCopy(kCFAllocatorDefault, 0, (CFDictionaryRef) descriptor);
+    if (copy == NULL) return NULL;
+
+    existing = (CFDictionaryRef) CFDictionaryGetValue(copy, kCTFontTraitsAttribute);
+    if (existing != NULL && CFGetTypeID(existing) == CFDictionaryGetTypeID()) {
+        CFNumberRef n = (CFNumberRef) CFDictionaryGetValue(existing, kCTFontSymbolicTrait);
+
+        if (n != NULL && CFGetTypeID(n) == CFNumberGetTypeID()) {
+            int value = 0;
+            CFNumberGetValue(n, kCFNumberIntType, &value);
+            current = (unsigned) value;
+        }
+        traits = CFDictionaryCreateMutableCopy(kCFAllocatorDefault, 0, existing);
+    } else {
+        traits = CFDictionaryCreateMutable(kCFAllocatorDefault, 0, &kCFTypeDictionaryKeyCallBacks,
+                                           &kCFTypeDictionaryValueCallBacks);
+    }
+    if (traits == NULL) {
+        CFRelease(copy);
+        return NULL;
+    }
+
+    resolved = (current & ~(unsigned) symTraitMask) | ((unsigned) symTraitValue & (unsigned) symTraitMask);
+    int as_int = (int) resolved;
+    number = CFNumberCreate(kCFAllocatorDefault, kCFNumberIntType, &as_int);
+    if (number != NULL) {
+        CFDictionarySetValue(traits, kCTFontSymbolicTrait, number);
+        CFRelease(number);
+    }
+    CFDictionarySetValue(copy, kCTFontTraitsAttribute, traits);
+    CFRelease(traits);
+    return (CTFontDescriptorRef) copy;
+}
+
+/*
  * WHICH INSTALLED FACES ANSWER A DESCRIPTION. A descriptor here is its attribute dictionary and the
  * collection of available fonts is an array of exactly such dictionaries, so matching is comparing
  * the attributes the caller cares about against each face.
