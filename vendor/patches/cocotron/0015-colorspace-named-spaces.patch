diff -u --recursive a/Onyx2D/O2ColorSpace.m b/Onyx2D/O2ColorSpace.m
--- a/Onyx2D/O2ColorSpace.m	2026-08-13 22:12:11.800560362 +0200
+++ b/Onyx2D/O2ColorSpace.m	2026-08-13 22:12:11.814382827 +0200
@@ -133,7 +133,6 @@
 }
 
 O2ColorSpaceRef O2ColorSpaceCreateWithName(CFStringRef name) {
-    printf("CALLED: O2ColorSpaceCreateWithName\n");
     if (CFStringCompare(name, kO2ColorSpaceSRGB, 0) == kCFCompareEqualTo) {
         O2ColorSpaceRef cs = [[O2ColorSpace alloc] initWithDeviceRGB];
         cs->_name = kO2ColorSpaceSRGB;
@@ -144,6 +143,32 @@
         cs->_type = kO2ColorSpaceModelRGB;
         return cs;
     }
+    /*
+     * THE REST OF THE NAMED SPACES. Only sRGB and Display P3 were handled, and everything else
+     * returned NULL, which is not a degraded colour: a caller that asks for a colour space and
+     * gets nothing cannot make a context, and the failure surfaces somewhere unrelated.
+     * LibreOffice asks for GenericGrayGamma2_2 while bringing its GUI up and died on it, with
+     * "unknown color space name" being the only clue and appearing two lines earlier.
+     *
+     * THE GAMMA IS NOT MODELLED, and that is the honest limitation to write down rather than
+     * hide: this maps each name to the device space with the right NUMBER OF COMPONENTS, so a
+     * grey stays grey and an RGB stays RGB, but a 2.2 gamma grey and a linear grey come out the
+     * same. That is a colour accuracy difference, visible only in a side by side comparison,
+     * where the alternative was a process that does not start.
+     */
+    if (CFStringCompare(name, kO2ColorSpaceGenericGray, 0) == kCFCompareEqualTo ||
+        CFStringCompare(name, kO2ColorSpaceGenericGrayGamma2_2, 0) == kCFCompareEqualTo) {
+        return [[O2ColorSpace alloc] initWithDeviceGray];
+    }
+    if (CFStringCompare(name, kO2ColorSpaceGenericRGB, 0) == kCFCompareEqualTo ||
+        CFStringCompare(name, kO2ColorSpaceGenericRGBLinear, 0) == kCFCompareEqualTo ||
+        CFStringCompare(name, kO2ColorSpaceAdobeRGB1998, 0) == kCFCompareEqualTo) {
+        return [[O2ColorSpace alloc] initWithDeviceRGB];
+    }
+    if (CFStringCompare(name, kO2ColorSpaceGenericCMYK, 0) == kCFCompareEqualTo) {
+        return [[O2ColorSpace alloc] initWithDeviceCMYK];
+    }
+
     printf("unknown color space name\n");
     CFShow(name);
     return NULL;
