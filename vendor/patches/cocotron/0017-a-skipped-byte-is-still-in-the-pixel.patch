+/* A,R,G,B in memory order, already premultiplied: kO2ImageAlphaPremultipliedFirst with the natural
+ * byte order, which is what an application that passes kCGBitmapByteOrderDefault means. */
+O2argb8u *O2ImageRead_ARGB8888_to_argb8u(O2Image *self, int x, int y,
+                                         O2argb8u *span, int length)
+{
+    const uint8_t *scanline = scanlineAtY(self, y);
+    int i;
+
+    if (scanline == NULL)
+        return NULL;
+
+    scanline += x * 4;
+    for (i = 0; i < length; i++) {
+        O2argb8u result;
+
+        result.a = scanline[0];
+        result.r = scanline[1];
+        result.g = scanline[2];
+        result.b = scanline[3];
+        *span++ = result;
+        scanline += 4;
+    }
+    return NULL;
+}
