+/*
+ * Window restoration, 10.7 and later: whether this window should be reopened when the
+ * application is relaunched. LibreOffice sets it on every frame it creates.
+ *
+ * ACCEPTED AND IGNORED, because there is nothing here to restore FROM. Restoration is a service
+ * of the window server, which keeps the state across launches; this platform has no such store,
+ * so remembering the flag would be a promise nothing can keep. The getter answers NO for the
+ * same reason, which is also what a window that has never been restored reports on a Mac.
+ *
+ * It was not implemented at all, and an unrecognised selector RAISES: LibreOffice caught that
+ * during startup and reported its own "Unspecified Application Error", so the GUI died with no
+ * mention of windows anywhere.
+ */
+- (void) setRestorable: (BOOL) flag {
+}
+
+- (BOOL) isRestorable {
+    return NO;
+}
