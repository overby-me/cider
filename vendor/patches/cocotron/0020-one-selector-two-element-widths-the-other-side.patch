+/*
+ * ONE SELECTOR, TWO ELEMENT WIDTHS. NSFont writes NSGlyph, which is NSUInteger and eight bytes wide;
+ * KTFont answers the SAME selector and writes CGGlyph, which is two. An attributed string built
+ * through CoreText legitimately carries a KTFont under NSFontAttributeName, because
+ * kCTFontAttributeName IS NSFontAttributeName, so this layout manager gets handed both kinds.
+ *
+ * Writing two byte elements into an eight byte array leaves the first slot holding four packed
+ * neighbours and every later slot untouched, so a twelve character button label laid out as one
+ * character with a meaningless width. That is what Money Manager EX drew. Task #212.
+ *
+ * THE WIDTH COMES FROM THE METHOD, NOT THE CLASS, which is the same rule the fix on the other side
+ * of this pair uses in CTFontGetGlyphsForCharacters: ^S is CGGlyph *, anything wider is fine as is.
+ */
+static NSUInteger _CiderGetGlyphsFromFont(NSFont *font, NSGlyph *glyphs,
+                                          unichar *characters, NSUInteger length)
+{
+    Method method = class_getInstanceMethod([font class],
+                                            @selector(getGlyphs:forCharacters:length:));
+    char *argumentType = (method != NULL) ? method_copyArgumentType(method, 2) : NULL;
+    BOOL narrow = (argumentType != NULL) && strcmp(argumentType, "^S") == 0;
+
+    if (argumentType != NULL)
+        free(argumentType);
+
+    if (!narrow)
+        return [font getGlyphs: glyphs forCharacters: characters length: length];
+
+    CGGlyph *narrowGlyphs = calloc(length > 0 ? length : 1, sizeof(CGGlyph));
+
+    if (narrowGlyphs == NULL)
+        return 0;
+
+    [(KTFont *) font getGlyphs: narrowGlyphs forCharacters: characters length: length];
+    for (NSUInteger i = 0; i < length; i++)
+        glyphs[i] = narrowGlyphs[i];
+    free(narrowGlyphs);
+    return length;
+}
+
