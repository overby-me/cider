diff -u --recursive a/Onyx2D/O2Surface.m b/Onyx2D/O2Surface.m
--- a/Onyx2D/O2Surface.m	2026-08-13 23:39:37.852935821 +0200
+++ b/Onyx2D/O2Surface.m	2026-08-13 23:39:37.877697260 +0200
@@ -581,7 +581,17 @@
 
     if (!initFunctionsForParameters(self, bitsPerComponent, _bitsPerPixel,
                                     colorSpace, bitmapInfo))
-        NSLog(@"O2Surface -init error, return");
+        /*
+         * SAY WHICH COMBINATION. The message named no parameters, and this function is a
+         * switch over three of them: without them the error says only that some surface
+         * somewhere is unsupported, which is not something anyone can act on. The surface is
+         * still returned below with a default writer, so this is a silent WRONG RESULT rather
+         * than a failure, which is the worst kind to leave unlabelled.
+         */
+        NSLog(@"O2Surface -init error: bitsPerComponent=%d bitsPerPixel=%d bitmapInfo=%08x "
+              @"components=%d, returning a surface with the default writer",
+              (int) bitsPerComponent, (int) _bitsPerPixel, (unsigned) bitmapInfo,
+              (int) O2ColorSpaceGetNumberOfComponents(colorSpace));
 
     _clampExternalPixels = NO; // only set to yes if premultiplied
     pthread_mutex_init(&_lock, NULL);
