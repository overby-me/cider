+static void ciderReportSpan(const char *what, int x, int y, int length,
+                            int became, int width, int height)
+{
+    static int printed;
+
+    if (printed >= 40)
+        return;
+    printed++;
+    fprintf(stderr, "CIDER_SPANBOUNDS %s x=%d y=%d len=%d -> %d surface=%dx%d\n",
+            what, x, y, length, became, width, height);
+    fflush(stderr);
+}
+
+/* The direct reader hands back a bare row pointer: O2ImageRead_BGRA8888_to_argb8u returns
+ * pixelBytes + y * bytesPerRow + x * 4 and nothing bounds x + length against the row, so a span
+ * wider than the surface runs into the next row and off the last row it leaves the mapping. The
+ * fault then lands in the blit, a long way from whatever produced the span (#214). */
+ONYX2D_STATIC_INLINE int ciderClampSpan(O2Surface *surface, const char *who, int x, int y,
+                                        int length)
+{
+    int width = (int) O2ImageGetWidth(surface);
+    int height = (int) O2ImageGetHeight(surface);
+    int clamped = length;
+
+    if (x < 0 || y < 0 || y >= height)
+        clamped = 0;
+    else if (x + length > width)
+        clamped = width - x;
+
+    if (clamped < 0)
+        clamped = 0;
+    if (clamped != length)
+        ciderReportSpan(who, x, y, length, clamped, width, height);
+    return clamped;
+}
+
+/* DO NOT ASK A SYSCALL WHETHER AN ADDRESS IS MAPPED. Run against 0x10 as a control, both write to
+ * /dev/null and stat of the pointer killed the guest instead of answering EFAULT: the syscall
+ * emulation does not fault protect its copyin. Naming the surface is what is left. */
+static BOOL ciderTraceSurface(void)
+{
+    static int cached = -1;
+
+    if (cached < 0) {
+        const char *value = getenv("CIDER_TRACE_SURFACE");
+
+        cached = (value != NULL && value[0] != '\0') ? 1 : 0;
+    }
+    return cached ? YES : NO;
+}
+
+/* A direct span pointer must lie inside the surface it came from. It does not once the pixel buffer
+ * is freed under a draw that is still running: the O2Image direct cache keeps the old bytes and the
+ * old length, scanlineAtY passes its own check against those, and the blit stores into an unmapped
+ * page (#214). The backtrace names the draw. */
+ONYX2D_STATIC_INLINE BOOL ciderDirectIsSane(O2Surface *surface, O2argb8u *direct, int x, int y,
+                                            int length)
+{
+    const uint8_t *base = O2SurfaceGetPixelBytes(surface);
+    size_t bytes = O2SurfaceGetBytesPerRow(surface) * O2SurfaceGetHeight(surface);
+    const uint8_t *first = (const uint8_t *) direct;
+    size_t span = (size_t) length * sizeof(O2argb8u);
+    static O2Surface *lastSurface;
+    static const uint8_t *lastBase;
+    static int printedSurface, printedBad;
+    /* One line per buffer, not per span: the process dies mid draw, so the LAST buffer named is the
+     * one it died in, and the backtrace under it is the draw that reached for it. */
+    BOOL newBuffer = (surface != lastSurface || base != lastBase);
+
+    if (newBuffer && printedSurface < 60) {
+        printedSurface++;
+        fprintf(stderr, "CIDER_SPANDIRECT surface=%p pixels=%p+%zu direct=%p x=%d y=%d len=%d\n",
+                surface, base, bytes, direct, x, y, length);
+        fflush(stderr);
+        if (ciderTraceSurface()) {
+            void *frames[24];
+
+            backtrace_symbols_fd(frames, backtrace(frames, 24), 2);
+        }
+    }
+    lastSurface = surface;
+    lastBase = base;
+
+    if (base != NULL && first >= base && first + span <= base + bytes)
+        return YES;
+
+    if (printedBad < 8) {
+        void *frames[24];
+        int count = backtrace(frames, 24);
+
+        printedBad++;
+        fprintf(stderr, "CIDER_SPANDIRECT STALE surface=%p pixels=%p+%zu direct=%p x=%d y=%d "
+                        "len=%d\n",
+                surface, base, bytes, direct, x, y, length);
+        fflush(stderr);
+        backtrace_symbols_fd(frames, count, 2);
+    }
+    return NO;
+}
+
+/* A paint reporting more pixels than it was asked for drives length negative, and the length == 0
+ * test in every one of these loops then never fires. Reporting none of them spins instead. */
+ONYX2D_STATIC_INLINE int ciderClampChunk(const char *who, int chunk, int length)
+{
+    if (chunk > 0 && chunk <= length)
+        return chunk;
+    ciderReportSpan(who, -1, -1, chunk, length, 0, 0);
+    return length;
+}
