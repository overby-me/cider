+/* All four corners, then the bounding box, which is what CGRectApplyAffineTransform documents.
+ * Transforming origin and size separately agrees only while the transform neither rotates nor
+ * shears, and gives a negative width the moment it flips. */
+static O2Rect applyToRect(O2Rect rect, O2AffineTransform xform) {
+    O2Point corner[4] = {
+        O2PointApplyAffineTransform(
+                O2PointMake(O2RectGetMinX(rect), O2RectGetMinY(rect)), xform),
+        O2PointApplyAffineTransform(
+                O2PointMake(O2RectGetMaxX(rect), O2RectGetMinY(rect)), xform),
+        O2PointApplyAffineTransform(
+                O2PointMake(O2RectGetMinX(rect), O2RectGetMaxY(rect)), xform),
+        O2PointApplyAffineTransform(
+                O2PointMake(O2RectGetMaxX(rect), O2RectGetMaxY(rect)), xform),
+    };
+    O2Float minX = corner[0].x, maxX = corner[0].x;
+    O2Float minY = corner[0].y, maxY = corner[0].y;
+    int i;
+
+    for (i = 1; i < 4; i++) {
+        minX = MIN(minX, corner[i].x);
+        maxX = MAX(maxX, corner[i].x);
+        minY = MIN(minY, corner[i].y);
+        maxY = MAX(maxY, corner[i].y);
+    }
+    return O2RectMake(minX, minY, maxX - minX, maxY - minY);
+}
+
 - (O2Rect) convertRectToDeviceSpace: (O2Rect) rect {
-    O2UnimplementedMethod();
-    return O2RectZero;
+    return applyToRect(rect, _deviceSpaceTransform);
 }
 
 - (O2Rect) convertRectToUserSpace: (O2Rect) rect {
-    O2UnimplementedMethod();
-    return O2RectZero;
+    return applyToRect(rect, O2AffineTransformInvert(_deviceSpaceTransform));
 }
 
