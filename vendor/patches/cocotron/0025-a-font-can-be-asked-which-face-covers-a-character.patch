 /*
+ * A FACE THAT CAN DRAW THIS CHARACTER, which is the half of font selection this port never had.
+ *
+ * The UI family list resolves to TeX Gyre Heros on this system, a Helvetica clone with Latin and
+ * BASIC Greek and nothing else, so Cyrillic and Arabic draw as nothing and accented Greek drops out
+ * of the middle of a word. The host is not short of faces; nothing was asking for one (#216).
+ *
+ * MEMOISED BY CODE POINT, and that is not an optimisation. FcFontMatch measured 28 percent of all
+ * samples in a LibreOffice text conversion, and this sits on a path that runs per character of a
+ * run. A code point is also the right key: what decides the face is the script, and every character
+ * of one script answers the same.
+ *
+ * The answer is FcNameUnparse of the match, which carries file=, so everything downstream takes the
+ * fast path in +filenameForPattern: rather than matching a second time.
+ */
+NSString *O2FontPatternCoveringCharacter(uint32_t code) {
+    static NSMutableDictionary *cache = nil;
+    NSNumber *key = [NSNumber numberWithUnsignedInt: code];
+
+    O2FontHostLock();
+    if (cache == nil)
+        cache = [[NSMutableDictionary alloc] init];
+    NSString *hit = [[cache objectForKey: key] retain];
+    O2FontHostUnlock();
+    if (hit != nil)
+        return [[hit autorelease] length] != 0 ? hit : nil;
+
+    FcConfig *config = O2FontSharedFontConfig();
+    NSString *answer = nil;
+
+    O2FontHostLock();
+    FcCharSet *charset = FcCharSetCreate();
+    FcPattern *pattern = (charset != NULL) ? FcPatternCreate() : NULL;
+
+    if (pattern != NULL && FcCharSetAddChar(charset, code)) {
+        FcResult result;
+
+        FcPatternAddCharSet(pattern, FC_CHARSET, charset);
+        FcPatternAddBool(pattern, FC_SCALABLE, FcTrue);
+        FcConfigSubstitute(config, pattern, FcMatchPattern);
+        FcDefaultSubstitute(pattern);
+
+        FcPattern *match = FcFontMatch(config, pattern, &result);
+
+        if (match != NULL) {
+            /* FcFontMatch NEVER FAILS, it substitutes, so a match that does not actually have the
+             * character is the normal answer for a script nothing installed covers. Returning it
+             * would swap the face and still draw nothing. */
+            FcCharSet *covered = NULL;
+
+            if (FcPatternGetCharSet(match, FC_CHARSET, 0, &covered) == FcResultMatch &&
+                covered != NULL && FcCharSetHasChar(covered, code)) {
+                FcChar8 *unparsed = FcNameUnparse(match);
+
+                if (unparsed != NULL) {
+                    answer = [NSString stringWithUTF8String: (const char *) unparsed];
+                    free(unparsed);
+                }
+            }
+            FcPatternDestroy(match);
+        }
+    }
+    if (pattern != NULL)
+        FcPatternDestroy(pattern);
+    if (charset != NULL)
+        FcCharSetDestroy(charset);
+
+    [cache setObject: (answer != nil) ? answer : @"" forKey: key];
+    O2FontHostUnlock();
+    return answer;
+}
