+
+    CFIndex length = (string != NULL) ? CFStringGetLength(string) : 0;
+    CFIndex start = (range.location > 0) ? range.location : 0;
+    CFIndex end = (range.length > 0 && start + range.length < length) ? start + range.length : length;
+    CTFontRef answer = NULL;
+
+    for (CFIndex i = start; i < end && answer == NULL; i++) {
+        UniChar character = CFStringGetCharacterAtIndex(string, i);
+        CGGlyph glyph = 0;
+
+        /* ASCII is in every face, and a surrogate half is not a character: neither is worth a
+         * fontconfig match. A pair is joined so the code point handed over is the real one. */
+        if (character < 0x80 || (character >= 0xDC00 && character <= 0xDFFF))
