+/* Declared rather than imported: Onyx2D's header is not on this file's include path. Defined in
+ * O2Font_freetype.m, and an implicit declaration would return int and truncate the pointer. */
+extern NSString *O2FontPatternCoveringCharacter(uint32_t code);
+
+/*
+ * THE FACE THAT CAN ACTUALLY DRAW IT.
+ *
+ * A font attribute names a FAMILY, not a set of characters, and a face without a glyph draws
+ * nothing whatever: no box, no width, no mark in the log. The UI family resolves to TeX Gyre Heros
+ * here, a Helvetica clone with Latin and BASIC Greek, so a Cyrillic or Arabic string comes out
+ * blank and accented Greek falls out of the middle of a word (#216).
+ *
+ * ONE FACE FOR THE RUN, decided by the first character the run's own font cannot draw. That is what
+ * fits the rasteriser, which puts a whole span through one FT_Face, and it is enough for a name
+ * written in one script with Latin around it: a face carrying Arabic or Cyrillic carries Latin too.
+ *
+ * An all-ASCII run costs one compare per character and no lookup, and O2FontPatternCoveringCharacter
+ * memoises by code point behind that.
+ */
+static NSFont *_CiderFontCoveringCharacters(NSFont *font, unichar *characters, NSUInteger length)
+{
+    NSUInteger i;
+
+    if (font == nil || characters == NULL)
+        return font;
+
+    for (i = 0; i < length; i++) {
+        unichar character = characters[i];
+        uint32_t code = character;
+        NSGlyph glyph = 0;
+
+        /* ASCII is in every face, and a trailing surrogate is half a character. */
+        if (character < 0x80 || (character >= 0xDC00 && character <= 0xDFFF))
+            continue;
+        if (character >= 0xD800 && character <= 0xDBFF && i + 1 < length &&
+            characters[i + 1] >= 0xDC00 && characters[i + 1] <= 0xDFFF)
+            code = 0x10000 + ((code - 0xD800) << 10) + (characters[i + 1] - 0xDC00);
+
+        _CiderGetGlyphsFromFont(font, &glyph, &character, 1);
+        if (glyph != NSNullGlyph)
+            continue;
+
+        NSString *pattern = O2FontPatternCoveringCharacter(code);
+        NSFont *substitute = (pattern != nil)
+                ? [NSFont fontWithName: pattern size: [font pointSize]]
+                : nil;
+
+        /* ASK THE SUBSTITUTE THE SAME QUESTION. fontconfig answers about a FILE and this answers
+         * about a loaded face, and the two disagree often enough to matter: a face that cannot be
+         * opened, or opens without the glyph, would swap the font and still draw nothing. */
+        if (substitute != nil) {
+            NSGlyph substituteGlyph = 0;
+
+            _CiderGetGlyphsFromFont(substitute, &substituteGlyph, &character, 1);
+            if (substituteGlyph != NSNullGlyph)
+                return substitute;
+        }
+        return font;
+    }
+    return font;
+}
+
+/*
+ * THE ATTRIBUTE RUN DECIDES, NOT THE RANGE THE CALLER PASSED, and that is the whole of it.
+ *
+ * Glyph generation is asked for one range and drawing for SUB-RANGES of it, so a decision taken
+ * from the passed range differs between them: the sub-run holding no uncovered character keeps the
+ * original face and then draws the SUBSTITUTE face's glyph indices through it, which comes out as
+ * mojibake. Three attempts to reconcile them by recording the face failed, twice because
+ * NSStringDrawer is a thread shared singleton that REPLACES its one text storage on every draw, so
+ * a table keyed by character index is stale by the next string on the manager and on the storage
+ * alike.
+ *
+ * An attribute run needs no table: effectiveRange is the same for every index inside it, so both
+ * sides reach the same answer from different indices, by construction.
+ *
+ * Sixty four characters is a bound on the scan, not on the run: both sides read the same first
+ * sixty four of the same run, so they still agree, and a rare uncovered character beyond that just
+ * means no substitution.
+ */
+static NSFont *_CiderFontCoveringRun(NSTextStorage *storage, NSFont *font,
+                                     NSUInteger characterIndex)
+{
+    NSRange runRange = NSMakeRange(0, 0);
+    unichar buffer[64];
+    NSUInteger storageLength;
+
+    if (font == nil || storage == nil)
+        return font;
+
+    storageLength = [[storage string] length];
+    if (characterIndex >= storageLength)
+        return font;
+
+    [storage attributesAtIndex: characterIndex effectiveRange: &runRange];
+    if (runRange.length == 0 || runRange.location >= storageLength)
+        return font;
+    if (NSMaxRange(runRange) > storageLength)
+        runRange.length = storageLength - runRange.location;
+    if (runRange.length > 64)
+        runRange.length = 64;
+
+    [[storage string] getCharacters: buffer range: runRange];
+    return _CiderFontCoveringCharacters(font, buffer, runRange.length);
+}
