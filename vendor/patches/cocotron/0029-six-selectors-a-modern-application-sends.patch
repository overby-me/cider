+
+/*
+ * FOUR MORE THE VIEW ANSWERS FOR. iA Writer configures its action panel field with all of them and
+ * each one was an unrecognized selector, one per run: the delivery fix in Combine took it into UI
+ * it had never reached (#194).
+ *
+ * The two BOOLs and the strategy are STORED AND RETURNED and nothing here acts on them: an
+ * expansion tooltip needs a tracking area over truncated text, completion needs a completion
+ * controller, and the line break strategy needs a typesetter that has one. A caller that sets one
+ * and reads it back gets what it set, and its configuration runs to the end.
+ */
+@implementation NSTextField (CiderModernProperties)
+
+- (NSUInteger) bezelStyle {
+    return (NSUInteger) [[self cell] bezelStyle];
+}
+
+- (void) setBezelStyle: (NSUInteger) style {
+    [[self cell] setBezelStyle: (NSTextFieldBezelStyle) style];
+    [self setNeedsDisplay: YES];
+}
+
+- (BOOL) allowsExpansionToolTips {
+    return [objc_getAssociatedObject(self, @selector(allowsExpansionToolTips)) boolValue];
+}
+
+- (void) setAllowsExpansionToolTips: (BOOL) value {
+    objc_setAssociatedObject(self, @selector(allowsExpansionToolTips),
+                             [NSNumber numberWithBool: value], OBJC_ASSOCIATION_RETAIN);
+}
+
+- (BOOL) isAutomaticTextCompletionEnabled {
+    return [objc_getAssociatedObject(self, @selector(isAutomaticTextCompletionEnabled)) boolValue];
+}
+
+- (void) setAutomaticTextCompletionEnabled: (BOOL) value {
+    objc_setAssociatedObject(self, @selector(isAutomaticTextCompletionEnabled),
+                             [NSNumber numberWithBool: value], OBJC_ASSOCIATION_RETAIN);
+}
+
+- (NSUInteger) lineBreakStrategy {
+    return [objc_getAssociatedObject(self, @selector(lineBreakStrategy)) unsignedIntegerValue];
+}
+
+- (void) setLineBreakStrategy: (NSUInteger) strategy {
+    objc_setAssociatedObject(self, @selector(lineBreakStrategy),
+                             [NSNumber numberWithUnsignedInteger: strategy],
+                             OBJC_ASSOCIATION_RETAIN);
+}
+
+@end
--- a/AppKit/NSWindow.m
+++ b/AppKit/NSWindow.m
@@ -4438,3 +4438,38 @@
 
 @end
 
+/*
+ * A CHANGE THROUGH THE PROXY IS APPLIED AT ONCE, because -animator returns self. That is the same
+ * policy NSSplitViewItem takes next door: a window snaps rather than slides, and the alternative,
+ * having no animator at all, loses the change and the process with it.
+ *
+ * The dictionary is an associated object rather than an ivar: applications subclass NSWindow, and
+ * an ivar added here would shift the ones they declare.
+ */
+@implementation NSWindow (CiderAnimatable)
+
+- (id) animator {
+    return self;
+}
+
+- (NSDictionary *) animations {
+    NSDictionary *animations = objc_getAssociatedObject(self, @selector(animations));
+
+    return animations != nil ? animations : [NSDictionary dictionary];
+}
+
+- (void) setAnimations: (NSDictionary *) animations {
+    objc_setAssociatedObject(self, @selector(animations), animations, OBJC_ASSOCIATION_COPY);
+}
+
+- (id) animationForKey: (NSString *) key {
+    id animation = [[self animations] objectForKey: key];
+
+    return animation != nil ? animation : [[self class] defaultAnimationForKey: key];
+}
+
++ (id) defaultAnimationForKey: (NSString *) key {
+    return nil;
+}
+
+@end
