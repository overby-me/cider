@@ -956,6 +956,27 @@
     return nil;
 }
 
+/*
+ * Darker and lighter versions of a colour, which is how a toolkit draws pressed and hovered
+ * states without a second colour for each.
+ *
+ * BOTH, because they are a pair and a caller that has one usually has the other: LibreOffice
+ * asked for shadowWithLevel: and highlightWithLevel: was already on the list of stubs it
+ * touches. They are blends toward black and white, which is their documented definition, so
+ * this is the existing blend with a fixed second colour rather than new arithmetic.
+ */
+- (NSColor *) shadowWithLevel: (CGFloat) level {
+    if (level <= 0.0) return self;
+    return [self blendedColorWithFraction: (level > 1.0 ? 1.0 : level)
+                                  ofColor: [NSColor blackColor]];
+}
+
+- (NSColor *) highlightWithLevel: (CGFloat) level {
+    if (level <= 0.0) return self;
+    return [self blendedColorWithFraction: (level > 1.0 ? 1.0 : level)
+                                  ofColor: [NSColor whiteColor]];
+}
+
 - (NSColor *) blendedColorWithFraction: (CGFloat) fraction
                                ofColor: (NSColor *) color
 {
