--- a/AppKit/NSWindow.m
+++ b/AppKit/NSWindow.m
@@ -4437,3 +4437,39 @@
 }
 
 @end
+
+/*
+ * A CHANGE THROUGH THE PROXY IS APPLIED AT ONCE, because -animator returns self. That is the same
+ * policy NSSplitViewItem takes next door: a window snaps rather than slides, and the alternative,
+ * having no animator at all, loses the change and the process with it.
+ *
+ * The dictionary is an associated object rather than an ivar: applications subclass NSWindow, and
+ * an ivar added here would shift the ones they declare.
+ */
+@implementation NSWindow (CiderAnimatable)
+
+- (id) animator {
+    return self;
+}
+
+- (NSDictionary *) animations {
+    NSDictionary *animations = objc_getAssociatedObject(self, @selector(animations));
+
+    return animations != nil ? animations : [NSDictionary dictionary];
+}
+
+- (void) setAnimations: (NSDictionary *) animations {
+    objc_setAssociatedObject(self, @selector(animations), animations, OBJC_ASSOCIATION_COPY);
+}
+
+- (id) animationForKey: (NSString *) key {
+    id animation = [[self animations] objectForKey: key];
+
+    return animation != nil ? animation : [[self class] defaultAnimationForKey: key];
+}
+
++ (id) defaultAnimationForKey: (NSString *) key {
+    return nil;
+}
+
+@end
