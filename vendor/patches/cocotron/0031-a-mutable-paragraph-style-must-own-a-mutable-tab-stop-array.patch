+/* REPLACE rather than mutate in place, so this cannot depend on what the last init left here.
+ * iA Writer runs its markdown live parser on every string change, that calls setTabStops: through
+ * -[IATextController adjustIndentOnParagraphStyle:...], and mutating an immutable array raised
+ * inside the parse. The application catches it, so the editor simply stayed empty (#194). */
 - (void) setTabStops: (NSArray *) tabStops {
-    if (tabStops != _tabStops) {
-        [_tabStops removeAllObjects];
-        [_tabStops addObjectsFromArray: tabStops];
-        [_tabStops sortUsingSelector: @selector(compare:)];
+    if (tabStops == _tabStops) {
+        return;
     }
+
+    NSMutableArray *replacement = [tabStops mutableCopy];
+
+    if (replacement == nil) {
+        replacement = [[NSMutableArray alloc] init];
+    }
+    [replacement sortUsingSelector: @selector(compare:)];
+    [_tabStops release];
+    _tabStops = replacement;
 }
 
