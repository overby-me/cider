+     * immutable object" from the first addTabStop: or removeTabStop:. _initWithDefaults above
+     * already uses -mutableCopy; this init and -initWithCoder: were the two that broke it. */
+    _tabStops = [other->_tabStops mutableCopy];
     _hyphenationFactor = other->_hyphenationFactor;
     _tighteningFactorForTruncation = other->_tighteningFactorForTruncation;
