diff -u --recursive a/AppKit/NSColor.subproj/NSColor_CGColor.m b/AppKit/NSColor.subproj/NSColor_CGColor.m
--- a/AppKit/NSColor.subproj/NSColor_CGColor.m	2026-08-14 01:16:29.519514338 +0200
+++ b/AppKit/NSColor.subproj/NSColor_CGColor.m	2026-08-14 01:16:29.535887733 +0200
@@ -153,6 +153,58 @@
             stringWithFormat: @"<%@ colorRef=%@>", [self class], _colorRef];
 }
 
+/*
+ * The same colour expressed in another named space.
+ *
+ * NSColor declares this abstract, so the base class RAISES: LibreOffice converts colours while
+ * drawing and the exception was caught, which is why it needed an instrument to find.
+ *
+ * SAME FAMILY IS A RELABEL, NOT A CONVERSION. Calibrated and device RGB differ by colour
+ * management, and there is none in this stack: the component values are identical, so producing
+ * new ones would be inventing precision that is not there. Only a change of FAMILY does
+ * arithmetic, and the grey conversion uses the standard luminance weights rather than an average,
+ * because an average makes blue text as dark as red text.
+ */
+- (NSColor *) colorUsingColorSpaceName: (NSString *) colorSpace {
+    if (colorSpace == nil || [colorSpace isEqualToString: _colorSpaceName]) {
+        return self;
+    }
+    BOOL wantRGB = [colorSpace isEqualToString: NSCalibratedRGBColorSpace] ||
+                   [colorSpace isEqualToString: NSDeviceRGBColorSpace];
+    BOOL wantWhite = [colorSpace isEqualToString: NSCalibratedWhiteColorSpace] ||
+                     [colorSpace isEqualToString: NSDeviceWhiteColorSpace];
+    if (!wantRGB && !wantWhite) {
+        /* A space this cannot produce, patterns and CMYK among them. Answering self is better
+         * than nil: the caller gets a usable colour in the wrong space rather than none. */
+        return self;
+    }
+
+    NSInteger count = CGColorGetNumberOfComponents(_colorRef);
+    const CGFloat *comps = CGColorGetComponents(_colorRef);
+    CGFloat alpha = CGColorGetAlpha(_colorRef);
+    if (comps == NULL) {
+        return self;
+    }
+
+    if (wantRGB) {
+        if (count >= 4) {
+            return [[[[self class] alloc] initWithColorRef: _colorRef
+                                                 spaceName: colorSpace] autorelease];
+        }
+        /* Grey to RGB: the same value on all three channels IS the same colour. */
+        CGFloat grey = comps[0];
+        return [NSColor_CGColor colorWithRed: grey green: grey blue: grey alpha: alpha
+                                   spaceName: colorSpace];
+    }
+
+    if (count >= 4) {
+        CGFloat luminance = comps[0] * 0.299 + comps[1] * 0.587 + comps[2] * 0.114;
+        return [NSColor_CGColor colorWithGray: luminance alpha: alpha spaceName: colorSpace];
+    }
+    return [[[[self class] alloc] initWithColorRef: _colorRef
+                                         spaceName: colorSpace] autorelease];
+}
+
 - (NSInteger) numberOfComponents {
     return CGColorGetNumberOfComponents(_colorRef);
 }
