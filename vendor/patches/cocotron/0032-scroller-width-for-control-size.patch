diff -u --recursive a/AppKit/NSScroller.m b/AppKit/NSScroller.m
--- a/AppKit/NSScroller.m	2026-08-14 01:18:02.111328053 +0200
+++ b/AppKit/NSScroller.m	2026-08-14 01:18:32.559646361 +0200
@@ -30,6 +30,34 @@
 
 @implementation NSScroller
 
+/*
+ * The 10.7 form, which takes a control size and a style. +scrollerWidth below is the older one
+ * and asks the display; this scales that answer rather than inventing a second source for the
+ * same number, so a backend that reports a different width stays consistent across both.
+ *
+ * THE STYLE IS DELIBERATELY IGNORED. An overlay scroller floats over the content and a legacy
+ * one takes space beside it, but the WIDTH a caller must reserve is the same either way here:
+ * this platform draws no overlay scrollers, so reporting a narrower one would reserve too little.
+ */
++ (CGFloat) scrollerWidthForControlSize: (NSControlSize) controlSize
+                          scrollerStyle: (NSScrollerStyle) scrollerStyle
+{
+    CGFloat regular = [self scrollerWidth];
+    switch (controlSize) {
+    case NSSmallControlSize:
+        return regular * 0.75;
+    case NSMiniControlSize:
+        return regular * 0.6;
+    default:
+        return regular;
+    }
+}
+
++ (CGFloat) scrollerWidthForControlSize: (NSControlSize) controlSize {
+    return [self scrollerWidthForControlSize: controlSize
+                               scrollerStyle: NSScrollerStyleLegacy];
+}
+
 + (CGFloat) scrollerWidth {
     return [[NSDisplay currentDisplay] scrollerWidth];
 }
