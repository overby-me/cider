diff -u --recursive a/AppKit/include/AppKit/NSScroller.h b/AppKit/include/AppKit/NSScroller.h
--- a/AppKit/include/AppKit/NSScroller.h	2026-08-14 02:04:32.060568610 +0200
+++ b/AppKit/include/AppKit/NSScroller.h	2026-08-14 02:04:32.045097046 +0200
@@ -80,6 +80,7 @@
 + (CGFloat) scrollerWidth;
 
 - (CGFloat) knobProportion;
+- (void) setKnobProportion: (CGFloat) zeroToOneKnob;
 - (NSScrollArrowPosition) arrowsPosition;
 - (NSControlSize) controlSize;
 - (NSScrollerStyle) scrollerStyle;
diff -u --recursive a/AppKit/NSScroller.m b/AppKit/NSScroller.m
--- a/AppKit/NSScroller.m	2026-08-14 02:04:32.060804343 +0200
+++ b/AppKit/NSScroller.m	2026-08-14 02:04:32.043097038 +0200
@@ -164,6 +164,17 @@
     return _knobProportion;
 }
 
+/* THE MODERN SETTER, which is the only half of this pair Cocotron was missing: it has the getter
+ * and it has -setFloatValue:knobProportion:, so the knob proportion was always settable, just not
+ * on its own. AppKit gained the separate setter in 10.5 and current applications use it, so its
+ * absence is not a degraded scroller, it is an unrecognized selector and a terminated process.
+ * LibreOffice hits this while laying out its first document window.
+ *
+ * Written in terms of the pair rather than beside it so the clamping stays in ONE place. */
+- (void) setKnobProportion: (CGFloat) zeroToOneKnob {
+    [self setFloatValue: _floatValue knobProportion: zeroToOneKnob];
+}
+
 - (NSScrollArrowPosition) arrowsPosition {
     return _arrowsPosition;
 }
