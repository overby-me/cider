+/* ON SCREEN IS MORE THAN IN A WINDOW. A view is visible when it has a window AND neither it nor any
+ * ancestor is hidden. Testing only the window meant a controller whose view was hidden or lifted out
+ * of the hierarchy never heard viewWillDisappear, and an application that commits its state there
+ * simply never commits: iA Writer implements viewWillDisappear on IAEditorViewController, next to
+ * commitRangeChangesToDocumentIfNeeded (#194). */
+- (BOOL) _ciderIsOnScreenForAppearance {
+    if (_window == nil)
+        return NO;
+
+    for (NSView *ancestor = self; ancestor != nil; ancestor = [ancestor superview])
+        if ([ancestor isHidden])
+            return NO;
+
+    return YES;
+}
+
+/* THE WHOLE SUBTREE, because hiding or detaching one view takes every controller below it off
+ * screen too, and each of those controllers is owed the same pair. */
+- (void) _ciderUpdateAppearanceTree {
+    if (_ciderViewController != nil)
+        [_ciderViewController _ciderSendAppearance: [self _ciderIsOnScreenForAppearance]];
+
+    for (NSView *child in [self subviews])
+        [child _ciderUpdateAppearanceTree];
+}
+
 - (void) viewDidMoveToWindow {
     /* A CONTROLLER LEARNS ITS VIEW IS ON SCREEN HERE. AppKit pairs viewWillAppear and viewDidAppear
      * with the view joining a window, and their absence is why setup deferred to them never ran. */
-    if (_ciderViewController != nil)
-        [_ciderViewController _ciderSendAppearance: _window != nil];
+    [self _ciderUpdateAppearanceTree];
 }
 
