-@interface NSTextInputContext : NSObject
+@class NSEvent;
+
+/*
+ * The text input context, which is how a modern Cocoa application receives TEXT rather than keys.
+ *
+ * An application that implements NSTextInputClient does not read characters out of the key event
+ * itself: it expects the input context to interpret the event and call -insertText:replacementRange:
+ * on it. LibreOffice is one of those, and with an EMPTY context class its view was the first
+ * responder, received every key event, and inserted nothing.
+ */
+@interface NSTextInputContext : NSObject {
+    id _client;
+}
+
++ (NSTextInputContext *) currentInputContext;
+
+- (instancetype) initWithClient: (id) client;
+- (id) client;
+
+- (void) activate;
+- (void) deactivate;
+
+/* YES if the event was consumed as text. */
+- (BOOL) handleEvent: (NSEvent *) event;
+
+- (void) discardMarkedText;
+- (void) invalidateCharacterCoordinates;
 
 @end
 
