--- a/AppKit/NSViewController.m
+++ b/AppKit/NSViewController.m
@@ -4,6 +4,7 @@
 #import <AppKit/NSRaise.h>
 #import <AppKit/NSViewController.h>
 #import <objc/runtime.h>
+#import <stdio.h>
 
 @implementation NSViewController
 
@@ -397,4 +398,44 @@
         [parent removeChildViewControllerAtIndex: (NSInteger) index];
 }
 
+/*
+ * SWAPPING ONE CHILD FOR ANOTHER, which is how a container shows a different screenful.
+ *
+ * This was missing entirely, and a missing method here is silent: iA Writer sends the selector
+ * (it is in __objc_methname, so it is SENT, not merely mentioned) and CATCHES the resulting
+ * exception, so the new view controller is built and filled and simply never reaches the window.
+ * That is the shape of #194.
+ *
+ * The animation in options is not performed. macOS animates the swap; the CONTRACT is that the new
+ * view ends up in the old one's place and the handler runs, and doing it immediately keeps that
+ * contract. Animating it is a separate question from being correct.
+ */
+- (void) transitionFromViewController: (NSViewController *) fromViewController
+                     toViewController: (NSViewController *) toViewController
+                              options: (NSViewControllerTransitionOptions) options
+                    completionHandler: (void (^)(void)) completion {
+    NSView *fromView = [fromViewController view];
+    NSView *toView = [toViewController view];
+    NSView *parent = [fromView superview];
+
+    if (getenv("CIDER_TRACE_VIEWS") != NULL) {
+        fprintf(stderr,
+                "CIDER_VIEW transition from=%s(%p) to=%s(%p) options=0x%lx parent=%s(%p)\n",
+                object_getClassName(fromViewController), fromViewController,
+                object_getClassName(toViewController), toViewController,
+                (unsigned long) options, parent != nil ? object_getClassName(parent) : "(nil)",
+                parent);
+        fflush(stderr);
+    }
+
+    if (toView != fromView && parent != nil) {
+        [toView setFrame: [fromView frame]];
+        [toView setAutoresizingMask: [fromView autoresizingMask]];
+        [parent replaceSubview: fromView with: toView];
+    }
+
+    if (completion != NULL)
+        completion();
+}
+
 @end
