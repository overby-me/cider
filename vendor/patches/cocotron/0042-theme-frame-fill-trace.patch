@@ -22,6 +22,7 @@
 #import <AppKit/NSMainMenuView.h>
 #import <AppKit/NSMenuView.h>
 #import <AppKit/NSThemeFrame.h>
+#import <objc/runtime.h>
 #import <AppKit/NSToolbarView.h>
 #import <AppKit/NSWindow-Private.h>
