+/*
+ * ALPHA FIRST, IN MEMORY ORDER. kCGBitmapByteOrder32Big with an alpha-first layout means the bytes
+ * are A, R, G, B in that order, and the writer next to this one puts them R, G, B, A. Nothing
+ * complained: the pixels were written, just with every channel one place to the left.
+ *
+ * LibreOffice reads its system colours through exactly this format. It renders a one pixel NSBox
+ * into a bitmap declared kCGImageAlphaNoneSkipFirst | kCGBitmapByteOrder32Big and reads the struct
+ * back as { skip, r, g, b }, so a colour of 0.2, 0.4, 0.8 came back as 0.4, 0.8, 1.0. That is not a
+ * subtle shade difference: it is what decides the colour of every background in the application.
+ */
+static void O2SurfaceWrite_argb8u_to_ARGB8888(O2Surface *self, int x, int y,
+                                              O2argb8u *span, int length)
+{
+    uint8_t *scanline = self->_pixelBytes + y * self->_bytesPerRow;
+    int i;
+
+    scanline += x * 4;
+    for (i = 0; i < length; i++) {
+        O2argb8u rgba = *span++;
+
+        *scanline++ = rgba.a;
+        *scanline++ = rgba.r;
+        *scanline++ = rgba.g;
+        *scanline++ = rgba.b;
+    }
+}
+
+static void O2SurfaceWrite_argb32f_to_ARGB8888(O2Surface *self, int x, int y,
+                                               O2argb32f *span, int length)
+{
+    uint8_t *scanline = self->_pixelBytes + y * self->_bytesPerRow;
+    int i;
+
+    scanline += x * 4;
+    for (i = 0; i < length; i++) {
+        O2argb32f rgba = *span++;
+
+        *scanline++ = O2ByteFromFloat(rgba.a);
+        *scanline++ = O2ByteFromFloat(rgba.r);
+        *scanline++ = O2ByteFromFloat(rgba.g);
+        *scanline++ = O2ByteFromFloat(rgba.b);
+    }
+}
+
