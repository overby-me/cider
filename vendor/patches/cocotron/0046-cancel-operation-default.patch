+/*
+ * Escape, in the modern spelling.
+ *
+ * AppKit binds Escape to -cancelOperation: and its default implementation passes the OLDER -cancel:
+ * along the responder chain. This framework own panels implement cancel: and applications implement
+ * cancelOperation:, so both have to work: the binding sends cancelOperation:, and anything that does
+ * not implement it ends up here and gets cancel: as before.
+ */
+- (void) cancelOperation: (id) sender {
+    [self doCommandBySelector: @selector(cancel:)];
+}
