+/*
+ * A SYSTEM COLOUR IS SHARED AND IMMORTAL ON macOS, AND THAT IS AN ABI AN APPLICATION RELIES ON.
+ * +[NSColor controlTextColor] there answers the same instance every time and it is never
+ * deallocated, so keeping the pointer without retaining it is safe and shipping applications do it.
+ * This returned a FRESH AUTORELEASED entry per call, so the pointer Qt kept while building its
+ * palette died at the next pool drain and every later use read freed memory. See task #227: the
+ * catalog entry was gone and its _color slot pointed at a block libobjc had already recycled into
+ * O2Paint class_rw_t, which is why the crash looked like a colour bug and was a lifetime bug.
+ *
+ * System only. Another catalog belongs to the application, which may reuse a system name for
+ * something else and may legitimately expect a fresh entry.
+ */
+static NSMutableDictionary *_CiderSystemCatalogColors(void) {
+    static NSMutableDictionary *shared;
+    if (shared == nil)
+        shared = [[NSMutableDictionary alloc] init];
+    return shared;
+}
+
+/* Returns a BORROWED reference, like the autorelease it replaces: the cache is the owner and it
+ * never gives that up. */
+static NSColor *_CiderCachedSystemColor(NSColorListName catalogName, NSColorName colorName) {
+    if (colorName == nil || ![catalogName isEqualToString: @"System"])
+        return nil;
+    return [_CiderSystemCatalogColors() objectForKey: colorName];
+}
+
+static void _CiderCacheSystemColor(NSColorListName catalogName, NSColorName colorName,
+                                   NSColor *entry) {
+    if (entry == nil || colorName == nil || ![catalogName isEqualToString: @"System"])
+        return;
+    [_CiderSystemCatalogColors() setObject: entry forKey: colorName];
+}
