+/*
+ * THE MENU BAR CHANGED, so the strip that draws it has to be repainted.
+ *
+ * A window builds its main menu view once, from the menu object the application shares, and nothing
+ * told it when items were added to that object afterwards. LibreOffice fills its menu bar in as it
+ * loads, so the bar showed Application and File and nothing else for the whole session; one click
+ * on it repainted the strip and all twelve menus appeared at once.
+ */
+- (void) _mainMenuChanged {
+    if (_menuView != nil) {
+        [_menuView setNeedsDisplay: YES];
+    }
+}
