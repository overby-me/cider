+/*
+ * THE TRAITS DICTIONARY, which is what a descriptor carries under kCTFontTraitsAttribute and what
+ * CTFontCopyTraits hands out. One builder for both, because they must not be able to disagree.
+ *
+ * macOS puts symbolic, weight, width and slant in EVERY font derived traits dictionary, and a
+ * caller that reads one and passes the result to CFNumberGetValue has nothing to check against.
+ * The numeric three are derived from the symbolic bits, which is all this port knows: normalised,
+ * 0 meaning regular.
+ */
+static CFMutableDictionaryRef _CiderCopyTraitsForFont(CTFontRef font)
+{
+    int symbolic = (int) [font symbolicTraits];
+    CFMutableDictionaryRef traits = CFDictionaryCreateMutable(kCFAllocatorDefault, 0,
+            &kCFTypeDictionaryKeyCallBacks, &kCFTypeDictionaryValueCallBacks);
+
+    if (traits == NULL) return NULL;
+
+    CFNumberRef n = CFNumberCreate(kCFAllocatorDefault, kCFNumberIntType, &symbolic);
+    if (n != NULL) {
+        CFDictionarySetValue(traits, kCTFontSymbolicTrait, n);
+        CFRelease(n);
+    }
+    _CiderSetTrait(traits, kCTFontWeightTrait,
+                   (symbolic & kCTFontTraitBold) != 0 ? 0.4 : 0.0);
+    _CiderSetTrait(traits, kCTFontWidthTrait,
+                   (symbolic & kCTFontTraitCondensed) != 0
+                           ? -0.4
+                           : ((symbolic & kCTFontTraitExpanded) != 0 ? 0.4 : 0.0));
+    _CiderSetTrait(traits, kCTFontSlantTrait,
+                   (symbolic & kCTFontTraitItalic) != 0 ? 0.2 : 0.0);
+    return traits;
+}
