+/* WHO READS THE COMPONENTS, and how many there are.
+ *
+ * A grey colour has TWO components and an RGB colour has FOUR, so a caller that assumes four and is
+ * handed a grey reads two values that belong to nobody. That produces a colour with a couple of
+ * plausible channels and the rest arbitrary, which is what the application chrome has been. This
+ * says whether that is happening and who is doing it. Diagnostic only, under
+ * CIDER_WAYLAND_TRACE_COLORS. */
+static void cider_trace_components(O2ColorRef color) {
+    if (getenv("CIDER_WAYLAND_TRACE_COLORS") == NULL) {
+        return;
+    }
+    static int printed;
+    if (printed >= 30) {
+        return;
+    }
+    printed++;
+    void *frames[6];
+    int depth = backtrace(frames, 6);
+    size_t count = color ? O2ColorGetNumberOfComponents(color) : 0;
+    const O2Float *values = color ? color->_components : NULL;
+    fprintf(stderr, "CIDER_COMPONENTS color=%p n=%zu v=%.4f,%.4f,%.4f,%.4f", (void *) color, count,
+            (count > 0 && values) ? (double) values[0] : -1.0,
+            (count > 1 && values) ? (double) values[1] : -1.0,
+            (count > 2 && values) ? (double) values[2] : -1.0,
+            (count > 3 && values) ? (double) values[3] : -1.0);
+    for (int i = 1; i < depth; i++) {
+        Dl_info info;
+        if (dladdr(frames[i], &info) != 0 && info.dli_sname != NULL) {
+            fprintf(stderr, " <- %s", info.dli_sname);
+        }
+    }
+    fprintf(stderr, "\n");
+    fflush(stderr);
+}
+
 const O2Float *O2ColorGetComponents(O2ColorRef self) {
+    cider_trace_components(self);
     return self->_components;
 }
 
