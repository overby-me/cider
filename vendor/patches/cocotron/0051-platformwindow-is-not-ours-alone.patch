+/*
+ * THE BACKING STORE CONVERSIONS, 10.7. A view coordinate times the window backing scale is a pixel,
+ * and this port renders at scale 1, so today these are identity; they are written against the scale
+ * rather than hard coded to 1 so a HiDPI backing later does not need them revisited.
+ *
+ * Qt asks -convertSizeToBacking: on every QNSView it creates, and the unrecognized selector killed
+ * CMake.app the first time its main window laid out. The whole family goes in together because a
+ * caller that converts one way converts back, and finding them one exception at a time is what this
+ * cost already. Task #227.
+ */
+- (CGFloat) _ciderBackingScale {
+    NSWindow *window = [self window];
+    return window != nil ? [window backingScaleFactor] : 1.0;
+}
+
+- (NSSize) convertSizeToBacking: (NSSize) size {
+    CGFloat s = [self _ciderBackingScale];
+    return NSMakeSize(size.width * s, size.height * s);
+}
+
+- (NSSize) convertSizeFromBacking: (NSSize) size {
+    CGFloat s = [self _ciderBackingScale];
+    return s != 0.0 ? NSMakeSize(size.width / s, size.height / s) : size;
+}
+
+- (NSPoint) convertPointToBacking: (NSPoint) point {
+    CGFloat s = [self _ciderBackingScale];
+    return NSMakePoint(point.x * s, point.y * s);
+}
+
+- (NSPoint) convertPointFromBacking: (NSPoint) point {
+    CGFloat s = [self _ciderBackingScale];
+    return s != 0.0 ? NSMakePoint(point.x / s, point.y / s) : point;
+}
+
+- (NSRect) convertRectToBacking: (NSRect) rect {
+    CGFloat s = [self _ciderBackingScale];
+    return NSMakeRect(rect.origin.x * s, rect.origin.y * s, rect.size.width * s,
+                      rect.size.height * s);
+}
+
+- (NSRect) convertRectFromBacking: (NSRect) rect {
+    CGFloat s = [self _ciderBackingScale];
+    if (s == 0.0) return rect;
+    return NSMakeRect(rect.origin.x / s, rect.origin.y / s, rect.size.width / s,
+                      rect.size.height / s);
+}
+
