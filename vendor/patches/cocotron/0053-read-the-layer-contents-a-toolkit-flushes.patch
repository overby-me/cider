+/*
+ * THE SOFTWARE PATH FOR LAYER CONTENTS. This port has no GL, so CALayerContext answers nil and
+ * CARenderer never runs; a view that draws via drawRect: is unaffected, but a toolkit that paints
+ * into a buffer and FLUSHES it with layer.contents (Qt: QCALayerBackingStore sets an IOSurface)
+ * put every frame somewhere nothing read, and its windows stayed the clear colour. Compositing the
+ * contents when the view displays is the missing read side. Task #227.
+ *
+ * The IOSurface is messaged, not linked: it is an ObjC object in this port and AppKit asking it
+ * for its geometry avoids a new framework dependency.
+ */
+- (void) _ciderCompositeLayerContents: (id) contents inRect: (NSRect) rect {
+    CGContextRef port = (CGContextRef) [[NSGraphicsContext currentContext] graphicsPort];
+    CGImageRef image = NULL;
+    BOOL owned = NO;
+
+    if (port == NULL)
+        return;
+
+    /* A CGImageRef IS an O2Image object in this port, so a class check replaces
+     * CGImageGetTypeID, which the CG stack here does not export. */
+    if ([contents isKindOfClass: NSClassFromString(@"O2Image")]) {
+        image = (CGImageRef) contents;
+    } else if ([contents respondsToSelector: @selector(baseAddress)] &&
+               [contents respondsToSelector: @selector(bytesPerRow)]) {
+        size_t width = (size_t) [contents width];
+        size_t height = (size_t) [contents height];
+        size_t bytesPerRow = (size_t) [contents bytesPerRow];
+        void *base = [contents baseAddress];
+
+        if (base == NULL || width == 0 || height == 0)
+            return;
+
+        /* The provider retains the surface so the pixels outlive the image even if the layer
+         * swaps its contents while we draw. */
+        CGDataProviderRef provider = CGDataProviderCreateWithData(
+                [contents retain], base, bytesPerRow * height, ciderReleaseSurfaceForImage);
+        CGColorSpaceRef space = CGColorSpaceCreateDeviceRGB();
+
+        /* Qt asks for BGRA; premultiplied-first little endian is that layout in memory. */
+        image = CGImageCreate(width, height, 8, 32, bytesPerRow, space,
+                              kCGImageAlphaPremultipliedFirst | kCGBitmapByteOrder32Little,
+                              provider, NULL, false, kCGRenderingIntentDefault);
+        CGColorSpaceRelease(space);
+        CGDataProviderRelease(provider);
+        owned = YES;
+        if (image == NULL)
+            return;
+    } else {
+        return;
+    }
+
+    NSRect bounds = [self bounds];
+    CGContextSaveGState(port);
+    /* drawRect: runs with a flipped CTM for a flipped view, which would put the frame upside
+     * down; the image is drawn in unflipped coordinates instead. */
+    if ([self isFlipped]) {
+        CGContextTranslateCTM(port, 0, bounds.origin.y * 2 + bounds.size.height);
+        CGContextScaleCTM(port, 1, -1);
+    }
+    CGContextDrawImage(port, bounds, image);
+    CGContextRestoreGState(port);
+
+    if (owned)
+        CGImageRelease(image);
+}
+
+
