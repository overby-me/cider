+/*
+ * THE FOCUS RING MASK, which every cell is asked for and none of them answered.
+ *
+ * AppKit draws a focus ring by asking the cell to fill the SHAPE it wants ringed, then stroking
+ * around that fill. NSCell defines the default -- fill the cell frame -- and subclasses override it
+ * for round buttons and the like; nothing here defined it at all, so the first control that took
+ * focus raised. Command F in LibreOffice opens a find toolbar with a combo box in it, and
+ * -[NSComboBoxCell drawFocusRingMaskWithFrame:inView:] was an unrecognized selector that killed the
+ * process.
+ *
+ * The bounds accessor goes with it: the ring is drawn around the mask, and a caller that wants to
+ * know how much room it needs asks for the bounds rather than drawing to find out.
+ */
+- (void) drawFocusRingMaskWithFrame: (NSRect) cellFrame inView: (NSView *) controlView {
+    NSRectFill(cellFrame);
+}
+
+- (NSRect) focusRingMaskBoundsForFrame: (NSRect) cellFrame inView: (NSView *) controlView {
+    return cellFrame;
+}
