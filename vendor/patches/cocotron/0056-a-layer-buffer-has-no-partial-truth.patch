+/* Cached like the glyph traces: these sit on the per repaint path, and a getenv for every
+ * invalidation of every view is a cost a terminal repainting whole screens can measure. */
+static BOOL ciderTraceLayerBlit(void)
+{
+    static int cached = -1;
+
+    if (cached < 0) {
+        const char *value = getenv("CIDER_TRACE_LAYERBLIT");
+
+        /* Empty is OFF: a harness forwarding unset switches writes VAR= and getenv answers "". */
+        cached = (value != NULL && value[0] != '\0') ? 1 : 0;
+    }
+    return cached ? YES : NO;
+}
