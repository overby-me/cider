--- a/AppKit/NSView.m
+++ b/AppKit/NSView.m
@@ -768,15 +768,71 @@
     return NO;
 }
 
+/*
+ * DRAWING A VIEW INTO A BITMAP, which an application does when it wants the pixels rather than the
+ * screen: a control rendered for its own compositing, a drag image, a snapshot for an animation.
+ *
+ * Both halves were NSUnimplementedMethod, and the pair is used TOGETHER -- ask for a rep, then fill
+ * it -- so a caller got nil and then nothing, fifteen times in a single LibreOffice run, all of them
+ * from NSScroller. A view that answers nil here is indistinguishable from one that drew an empty
+ * image, which is why this never surfaced as an error anywhere.
+ *
+ * The rep is RGBA8, non planar, the format every consumer here can read. Zero or negative sizes
+ * answer nil rather than building a rep nothing can use.
+ */
 - (NSBitmapImageRep *) bitmapImageRepForCachingDisplayInRect: (NSRect) rect {
-    NSUnimplementedMethod();
-    return nil;
+    NSInteger width = (NSInteger) ceil(rect.size.width);
+    NSInteger height = (NSInteger) ceil(rect.size.height);
+
+    if (width <= 0 || height <= 0) {
+        return nil;
+    }
+    return [[[NSBitmapImageRep alloc] initWithBitmapDataPlanes: NULL
+                                                    pixelsWide: width
+                                                    pixelsHigh: height
+                                                 bitsPerSample: 8
+                                               samplesPerPixel: 4
+                                                      hasAlpha: YES
+                                                      isPlanar: NO
+                                                colorSpaceName: NSDeviceRGBColorSpace
+                                                   bytesPerRow: 0
+                                                  bitsPerPixel: 0] autorelease];
 }
 
+/*
+ * THE TRANSLATION IS THE WHOLE OF IT. The rep starts at its own origin, so the rect being cached has
+ * to be moved there: caching a control that lives at x=200 into a 60 point wide rep otherwise draws
+ * it 200 points off the edge and the caller gets an empty image, which looks exactly like a view
+ * that refused to draw.
+ *
+ * -displayRectIgnoringOpacity:inContext: is reused rather than -drawRect: for the reason written
+ * above it: it handles focus, clipping and subviews, INCLUDING for a view with no window, which is
+ * the usual case for something being rendered into a bitmap.
+ */
 - (void) cacheDisplayInRect: (NSRect) rect
            toBitmapImageRep: (NSBitmapImageRep *) imageRep
 {
-    NSUnimplementedMethod();
+    if (imageRep == nil) {
+        return;
+    }
+
+    NSGraphicsContext *context =
+            [NSGraphicsContext graphicsContextWithBitmapImageRep: imageRep];
+
+    if (context == nil) {
+        return;
+    }
+
+    CGContextRef port = (CGContextRef) [context graphicsPort];
+
+    if (port != NULL) {
+        CGContextSaveGState(port);
+        CGContextTranslateCTM(port, -rect.origin.x, -rect.origin.y);
+    }
+    [self displayRectIgnoringOpacity: rect inContext: context];
+    if (port != NULL) {
+        CGContextRestoreGState(port);
+    }
 }
 
