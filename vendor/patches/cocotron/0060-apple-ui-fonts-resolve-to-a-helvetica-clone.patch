+/*
+ * THE APPLE USER INTERFACE FONTS, WHICH ARE NOT HERE AND MUST NOT BECOME DEJAVU.
+ *
+ * AppKit asks for San Francisco, and applications ask for Helvetica Neue and Lucida Grande. None of
+ * them can be shipped: they are Apple fonts. Fontconfig never fails, it SUBSTITUTES, and its answer
+ * for an unknown sans family on this system is DejaVu Sans -- a wide, large eyed face that is the
+ * single most obvious reason the interface does not look like macOS. Measured, not guessed:
+ *
+ *     CIDER_FONT pattern=San Francisco file=.../dejavu-fonts-2.37/.../DejaVuSans.ttf
+ *
+ * TeX Gyre Heros is a Helvetica clone and is the closest thing available, with Liberation Sans
+ * (Arial metrics) behind it and Helvetica itself in front in case a real one is installed. The list
+ * is a fontconfig family list, so the first one present wins and the styles still resolve: a
+ * request for :style=Bold picks the bold face of whichever family answered.
+ */
+static NSString *_CiderPreferredFamilies(NSString *family)
+{
+    static NSDictionary *map = nil;
+
+    if (map == nil) {
+        map = [[NSDictionary alloc]
+                initWithObjectsAndKeys:
+                        @"Helvetica,TeX Gyre Heros,Liberation Sans,sans-serif", @"san francisco",
+                        @"Helvetica,TeX Gyre Heros,Liberation Sans,sans-serif", @".applesystemuifont",
+                        @"Helvetica,TeX Gyre Heros,Liberation Sans,sans-serif", @"sf pro",
+                        @"Helvetica,TeX Gyre Heros,Liberation Sans,sans-serif", @"sf pro text",
+                        @"Helvetica,TeX Gyre Heros,Liberation Sans,sans-serif", @"sf pro display",
+                        @"Helvetica,TeX Gyre Heros,Liberation Sans,sans-serif", @"helvetica neue",
+                        @"Helvetica,TeX Gyre Heros,Liberation Sans,sans-serif", @"lucida grande",
+                        nil];
+    }
+    return [map objectForKey: [family lowercaseString]];
+}
