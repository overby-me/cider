+/*
+ * WINDOW TAGS ARE A PRESENTATION HINT the window server keeps for a window: sticky, ignores cycle,
+ * no shadow and the like. There is no window server here holding them, so accepting and discarding
+ * them is the whole of the honest implementation.
+ *
+ * SUCCESS, NOT AN ERROR. A caller that gets an error back from setting a hint may decide the window
+ * is unusable; a caller whose hint is silently not honoured carries on and looks the same as a
+ * window server that chose to ignore it. Declared in CoreGraphicsPrivate.h and never defined, so it
+ * aborted inside dyld_stub_binder on first use. Task #234.
+ */
+CGError CGSSetWindowTags(CGSConnectionID cid, CGSWindowID wid, const int tags[2], size_t tag_size)
+{
+	return kCGErrorSuccess;
+}
+
+CGError CGSClearWindowTags(CGSConnectionID cid, CGSWindowID wid, const int tags[2], size_t tag_size)
+{
+	return kCGErrorSuccess;
+}
