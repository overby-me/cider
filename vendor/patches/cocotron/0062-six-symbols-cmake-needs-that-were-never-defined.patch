--- a/CoreGraphics/CGPath.m
+++ b/CoreGraphics/CGPath.m
@@ -450,3 +450,40 @@
     }
     return out;
 }
+
+/*
+ * A rounded rectangle, built from the arcs this file already has. Task #234.
+ *
+ * The radii are CLAMPED TO HALF THE SIDE, which is what CoreGraphics does: a corner wider than the
+ * rectangle would otherwise wrap the arcs past each other and produce a self intersecting path.
+ * A zero radius degenerates to the plain rectangle rather than to nothing.
+ */
+CGPathRef CGPathCreateWithRoundedRect(CGRect rect, CGFloat cornerWidth, CGFloat cornerHeight,
+                                      const CGAffineTransform *transform) {
+    CGMutablePathRef path = CGPathCreateMutable();
+
+    CGFloat halfWidth = CGRectGetWidth(rect) / 2;
+    CGFloat halfHeight = CGRectGetHeight(rect) / 2;
+    if (cornerWidth > halfWidth)
+        cornerWidth = halfWidth;
+    if (cornerHeight > halfHeight)
+        cornerHeight = halfHeight;
+
+    if (cornerWidth <= 0 || cornerHeight <= 0) {
+        CGPathAddRect(path, transform, rect);
+        return path;
+    }
+
+    CGFloat minX = CGRectGetMinX(rect), midX = CGRectGetMidX(rect), maxX = CGRectGetMaxX(rect);
+    CGFloat minY = CGRectGetMinY(rect), midY = CGRectGetMidY(rect), maxY = CGRectGetMaxY(rect);
+    CGFloat radius = cornerWidth < cornerHeight ? cornerWidth : cornerHeight;
+
+    CGPathMoveToPoint(path, transform, minX, midY);
+    CGPathAddArcToPoint(path, transform, minX, minY, midX, minY, radius);
+    CGPathAddArcToPoint(path, transform, maxX, minY, maxX, midY, radius);
+    CGPathAddArcToPoint(path, transform, maxX, maxY, midX, maxY, radius);
+    CGPathAddArcToPoint(path, transform, minX, maxY, minX, midY, radius);
+    CGPathCloseSubpath(path);
+
+    return path;
+}
--- a/CoreGraphics/CGS.m
+++ b/CoreGraphics/CGS.m
@@ -421,3 +421,23 @@
 
 	return kCGSErrorSuccess;
 }
