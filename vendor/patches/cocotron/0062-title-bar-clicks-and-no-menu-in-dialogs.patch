+/*
+ * ONLY A DOCUMENT WINDOW CARRIES THE MENU BAR, not every titled window.
+ *
+ * Apple puts the menu bar on the SCREEN and every window shares it. Cocotron has no screen menu, so
+ * it draws one inside each window instead, and this said any titled window gets it -- which put a
+ * full LibreOffice menu bar, File through Help, inside a 419x165 Save Document dialog. No dialog on
+ * macOS has ever looked like that.
+ *
+ * Resizable is the distinction that holds: a document window is resizable and a dialog is not, which
+ * is the same signal the Wayland backend uses to decide that a window is a dialog and should float
+ * over its parent rather than sit beside it.
+ */
 + (BOOL) hasMainMenuForStyleMask: (NSWindowStyleMask) styleMask {
-    return styleMask & NSTitledWindowMask;
+    if ((styleMask & NSTitledWindowMask) == 0) {
+        return NO;
+    }
+    return (styleMask & NSResizableWindowMask) != 0;
 }
 
