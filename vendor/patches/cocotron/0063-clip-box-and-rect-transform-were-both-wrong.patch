+/*
+ * THE CLIP RECTANGLE, declared in the header since the beginning and never defined.
+ *
+ * O2ContextGetClipBoundingBox needs it: with a clip set, the bounding box IS this rectangle, and
+ * without one it is the whole surface. Nothing referenced it before, which is why the missing
+ * definition never broke a link.
+ */
+O2Rect O2ClipStateIntegralRect(O2ClipState *self) {
+    if (self == nil) {
+        return O2RectZero;
+    }
+    if (self->_type == O2ClipStateTypeNone) {
+        return O2RectZero;
+    }
+    return self->_rect;
