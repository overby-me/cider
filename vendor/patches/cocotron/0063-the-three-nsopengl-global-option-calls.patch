 @end
+
+/*
+ * WHAT YOU SET IS WHAT YOU GET, which is all these can honestly promise here: there is no renderer
+ * library behind them to cache formats for or to reset. The defaults are the documented macOS ones
+ * so a caller that reads before writing sees a sane cache size rather than zero. Task #228.
+ */
+static GLint _NSOpenGLFormatCacheSize = 5;
+static GLint _NSOpenGLRetainRenderers = 0;
+static GLint _NSOpenGLUseBuildCache = 0;
+
+void NSOpenGLSetOption(NSOpenGLGlobalOption pname, GLint param) {
+    switch (pname) {
+        case NSOpenGLGOFormatCacheSize: _NSOpenGLFormatCacheSize = param; break;
+        case NSOpenGLGORetainRenderers: _NSOpenGLRetainRenderers = param; break;
+        case NSOpenGLGOUseBuildCache: _NSOpenGLUseBuildCache = param; break;
+        /* Actions, not settings: clearing a cache that does not exist is a no-op, not an error. */
+        case NSOpenGLGOClearFormatCache:
+        case NSOpenGLGOResetLibrary: break;
+    }
+}
+
+void NSOpenGLGetOption(NSOpenGLGlobalOption pname, GLint *param) {
+    if (param == NULL)
+        return;
+    switch (pname) {
+        case NSOpenGLGOFormatCacheSize: *param = _NSOpenGLFormatCacheSize; break;
+        case NSOpenGLGORetainRenderers: *param = _NSOpenGLRetainRenderers; break;
+        case NSOpenGLGOUseBuildCache: *param = _NSOpenGLUseBuildCache; break;
+        default: *param = 0; break;
+    }
+}
+
+/* The NSOpenGL API version, 1.0 since it was introduced, NOT the OpenGL version. */
+void NSOpenGLGetVersion(GLint *major, GLint *minor) {
+    if (major != NULL)
+        *major = 1;
+    if (minor != NULL)
+        *minor = 0;
+}
