+#import <AppKit/NSOpenGL.h>
 #import <AppKit/NSOpenGLContext.h>
 #import <AppKit/NSOpenGLPixelFormat.h>
 #import <AppKit/NSRaise.h>
@@ -261,3 +262,42 @@
