+/*
+ * The text input context for this view, made on demand.
+ *
+ * NIL IS ONLY THE RIGHT ANSWER FOR A VIEW THAT CANNOT TAKE TEXT, and answering it for one that can
+ * is silent: iTerm2 3.5 asks its text view for this on every key press and hands the event to it,
+ * so with nil the keys arrived at the correct first responder and produced nothing at all, with no
+ * exception and nothing in any log. Its 3.4 release computed the bytes from the event itself, which
+ * is why the older build typed and the newer one did not. Task #239.
+ *
+ * WHO GETS ONE is decided the way macOS decides it, by whether the view can act as an
+ * NSTextInputClient. insertText:replacementRange: is the method the context calls, so a view that
+ * has neither it nor the older insertText: gets nil, as it should.
+ *
+ * An associated object rather than an ivar, because NSView is a bundled pin and this is the idiom
+ * the rest of the port already uses for per-view state.
+ */
 - (NSTextInputContext *) inputContext {
-    NSUnimplementedMethod();
-    return nil;
+    static const char kCiderInputContext;
+
+    if (![self respondsToSelector: @selector(insertText:replacementRange:)] &&
+        ![self respondsToSelector: @selector(insertText:)]) {
+        return nil;
+    }
+
+    NSTextInputContext *context = objc_getAssociatedObject(self, &kCiderInputContext);
+    if (context == nil) {
+        context = [[[NSTextInputContext alloc] initWithClient: self] autorelease];
+        objc_setAssociatedObject(self, &kCiderInputContext, context, OBJC_ASSOCIATION_RETAIN);
+        if (getenv("CIDER_TRACE_KEYS") != NULL)
+            NSLog(@"cider-keys inputContext made for=%@", [self class]);
+    }
+    return context;
 }
 
