--- a/AppKit/NSButtonCell.m
+++ b/AppKit/NSButtonCell.m
@@ -1520,6 +1520,39 @@
     result.width += adjustment.size.width;
     result.height += adjustment.size.height;
 
+    /*
+     * A BORDERED BUTTON IS NEVER SHORTER THAN ITS OWN BEZEL, whatever is written on it.
+     *
+     * Everything above adds up the title and the image, so a button with NEITHER comes out ZERO
+     * HIGH. That is not a hypothetical: an application that draws its own text and asks AppKit only
+     * for the frame -- LibreOffice, for every dialog button -- sets no title on the cell, asks the
+     * cell how big it should be, and lays the button out at that size. Measured, from the button
+     * trace: cell=NSButtonCell bezel=1 bordered=1 title= frame=93x0, ninety three wide and nothing
+     * tall, which is why the OK button in the print alert was an empty outline.
+     *
+     * The floors are the ones NSPopUpButtonCell already uses for the same three control sizes, so
+     * a popup button and a push button next to each other line up.
+     */
+    if ([self isBordered] || [self isBezeled]) {
+        CGFloat floorHeight;
+
+        switch ([self controlSize]) {
+
+        case NSSmallControlSize:
+            floorHeight = 19.0;
+            break;
+
+        case NSMiniControlSize:
+            floorHeight = 15.0;
+            break;
+
+        default:
+            floorHeight = 22.0;
+            break;
+        }
+        result.height = MAX(result.height, floorHeight);
+    }
+
     return result;
 }
 
