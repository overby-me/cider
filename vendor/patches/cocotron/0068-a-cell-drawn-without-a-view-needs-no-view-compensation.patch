+         * clipped, drawn above, or drawn below. The halo is the same rectangle grown by forty
+         * points in every direction, in two colours: whatever survives the clip shows WHERE this
+         * coordinate space actually is on screen relative to what the application drew. */
+        [[NSColor colorWithCalibratedRed: 0.0 green: 0.9 blue: 0.4 alpha: 1.0] setFill];
+        NSRectFill(NSInsetRect(frame, -40.0, -40.0));
+        [[NSColor magentaColor] setFill];
+        NSRectFill(frame);
+    }
