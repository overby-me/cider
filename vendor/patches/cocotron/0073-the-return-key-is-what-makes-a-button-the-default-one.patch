 - (void) drawBezelWithFrame: (NSRect) frame inView: (NSView *) controlView {
-    BOOL defaulted = ([[controlView window] defaultButtonCell] == self);
+    /*
+     * THE RETURN KEY IS WHAT MAKES A BUTTON THE DEFAULT ONE, and asking the window is not enough.
+     *
+     * The window only knows when there IS one: an application that draws a cell straight into a
+     * context passes no view, so [[controlView window] defaultButtonCell] is nil against nil and
+     * every button looks ordinary. That is why the default button in every LibreOffice dialog was
+     * an empty white box: LibreOffice draws its label in alternateSelectedControlTextColor, which
+     * is WHITE because on Apple systems that button is filled with the accent colour, and ours was
+     * filled with white.
+     *
+     * A key equivalent of carriage return is the convention macOS itself uses for the default
+     * button, and LibreOffice sets it. It was in the trace all along as key=^M, invisible because
+     * the log printed the string raw and a control character does not show.
+     */
+    BOOL defaulted = ([[controlView window] defaultButtonCell] == self) ||
+                     [[self keyEquivalent] isEqualToString: @"\r"];
 
     /* WHICH BEZEL, AND WHETHER ONE IS DRAWN AT ALL. A button with no visible frame is either
      * unbordered, or has a bezel style nothing draws, and those two look identical on screen. */
     if (getenv("CIDER_TRACE_PANEL") != NULL) {
         NSLog(@"CIDER_BUTTON cell=%s type=%d state=%d img=%s imgname=%@ title=%@ attr=%@ class=%s window=%@ bezel=%d bordered=%d "
-               "defaulted=%d key=%@ frame=%gx%g+%g+%g view=%gx%g",
+               "defaulted=%d keychar=%u frame=%gx%g+%g+%g view=%gx%g",
               object_getClassName(self), (int) _highlightsBy, (int) [self state],
               // what it would draw INSIDE the bezel, which is the other half of an empty control
               ([self image] != nil) ? "image" : "noimage", [[self image] name],
               [self title], [[self attributedTitle] string],
               object_getClassName(controlView), [[controlView window] title],
               (int) _bezelStyle, (int) [self isBordered], (int) defaulted,
-              // THE DEFAULT BUTTON HAS TO ANNOUNCE ITSELF SOMEHOW. cocotron only knows one through
-              // the window, and an application that draws with no view has no window to ask; the
-              // Return key equivalent is the other convention and libvclplug_osxlo does import
-              // setKeyEquivalent:, so this says whether that is how it marks its default button.
-              [self keyEquivalent],
+              // AS A CHARACTER CODE, NOT AS A STRING. The key equivalent of the default button
+              // is a CARRIAGE RETURN, and printing it raw put a control character in the log that
+              // moved the cursor instead of showing: two lines that differed only by it looked
+              // identical, and I concluded from that identity that the application gives no signal
+              // at all. It gives exactly this one.
+              (unsigned) (([[self keyEquivalent] length] > 0)
+                                  ? [[self keyEquivalent] characterAtIndex: 0]
+                                  : 0),
               frame.size.width, frame.size.height, frame.origin.x, frame.origin.y,
               [controlView frame].size.width, [controlView frame].size.height);
     }
