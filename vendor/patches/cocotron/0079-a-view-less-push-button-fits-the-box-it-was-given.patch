--- a/AppKit/NSButtonCell.m
+++ b/AppKit/NSButtonCell.m
@@ -913,6 +913,22 @@
      * print alert appeared to be sitting on the bottom border of its own box.
      */
     if (_controlView == nil) {
+        /*
+         * BUT THE WIDTH STILL HAS TO COME IN. An application drawing a push button with no view
+         * hands the bounding box Apple reserves for one, and that box is TEN POINTS WIDER than the
+         * button: LibreOffice draws its label and its clip inside the inner rect, so a bezel drawn
+         * at the full width had its rounded ends five points outside the visible area at each end.
+         * What survived was the middle band, a white rectangle with a grey line above and below and
+         * no sides at all, which is what Reset, Apply and Cancel looked like.
+         *
+         * The height and the vertical shift stay at zero, which is the part that was wrong before:
+         * subtracting ten from the height and moving up seven painted a short strip below the
+         * button instead of the button.
+         */
+        if ([self isBordered] && _bezelStyle == NSRoundedBezelStyle) {
+            frame.size.width = 10;
+            frame.origin.x = 5;
+        }
         return frame;
     }
 
