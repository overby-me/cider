+    CGFloat midX = NSMidX(box);
+    CGFloat midY = NSMidY(box);
+    CGFloat half = MIN(NSWidth(box) * 0.24, 3.0);
+    CGFloat rise = MIN(NSHeight(box) * 0.22, 2.5);
