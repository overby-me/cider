+/* The Help menu search changes how many rows there are, so the view and the window it is in have to
+ * follow. The TOP edge stays where it is, because that is the edge attached to the menu bar. */
+- (void) _resizeForCurrentItems {
+    NSSize size = [self sizeForMenuItems: [self visibleItemArray]];
+    NSWindow *window = [self window];
+    NSRect frame = [self frame];
+
+    frame.size = size;
+    [self setFrame: frame];
+
+    if (window != nil) {
+        NSRect windowFrame = [window frame];
+
+        windowFrame.origin.y = NSMaxY(windowFrame) - size.height;
+        windowFrame.size = size;
+        [window setFrame: windowFrame display: YES];
+    }
+    [self setNeedsDisplay: YES];
+}
