+    NSFont *converted = [[NSFontManager sharedFontManager] convertFont: font
+                                                           toHaveTrait: NSBoldFontMask];
+
+    if (converted != nil && converted != font) {
+        return converted;
+    }
+
+    /* AND THE TRAIT TEST HAS TO BE A TEST OF BITS. -typefaceWithTraits: compares the mask for
+     * EQUALITY, and a real face carries more than one bit -- bold and unitalic at least -- so
+     * asking it for NSBoldFontMask alone matches nothing that exists. */
+    NSFontFamily *family = [NSFontFamily fontFamilyWithName: [font familyName]];
+    NSArray *typefaces = [family typefaces];
+    NSInteger i, faceCount = [typefaces count];
+    NSFontTypeface *face = nil;
+
+    for (i = 0; i < faceCount; i++) {
+        NSFontTypeface *candidate = [typefaces objectAtIndex: i];
+        NSFontTraitMask traits = [candidate traits];
+
+        if (!(traits & NSBoldFontMask) || (traits & NSItalicFontMask)) {
+            continue;
+        }
+        /* AND NOT THE CONDENSED ONE. The first bold face in this family is DejaVu Sans Condensed
+         * Bold, which is narrower than the regular text next to it; the plain bold is the one that
+         * belongs beside it. A condensed face is still better than no bold at all, so it is kept as
+         * a fallback rather than skipped. */
+        if (!(traits & NSNarrowFontMask) && !(traits & NSExpandedFontMask)) {
+            face = candidate;
+            break;
+        }
+        if (face == nil) {
+            face = candidate;
+        }
+    }
+
+    if (face != nil) {
+        NSFont *bold = [NSFont fontWithName: [face name] size: [font pointSize]];
+
+        if (bold != nil) {
+            return bold;
+        }
+    }
+    return font;
 }
 
