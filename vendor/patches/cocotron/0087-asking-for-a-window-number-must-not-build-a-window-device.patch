--- a/AppKit/NSWindow.m
+++ b/AppKit/NSWindow.m
@@ -2084,7 +2084,14 @@
 }
 
 - (NSInteger) windowNumber {
-    return [[self cider_platformWindow] windowNumber];
+    /* ASKING FOR A NUMBER MUST NOT BUILD A WINDOW DEVICE. cider_platformWindow is lazy and
+     * creating it creates a compositor surface, so a window that is never shown got one purely
+     * because something read this. AppKit answers 0 for a window with no device, which is what a
+     * deferred window is. See docs/iterm2-preferences-gap.md. */
+    if (_platformWindow == nil) {
+        return 0;
+    }
+    return [_platformWindow windowNumber];
 }
 
