+/*
+ * WHICH CELLS THINK THEY ARE ON, at the moment they are drawn.
+ *
+ * A radio group showing TWO filled dots is either two cells whose state is on, which is a state
+ * defect, or one cell drawn wrong, which is a drawing defect, and the selection traces cannot tell
+ * them apart: they report what the MATRIX believes, and the matrix can believe one thing while a
+ * cell holds another. Swift Publisher preferences draws Template Gallery and Blank Document both
+ * filled while selectedCell reports index 0.
+ *
+ * Bounded to 12 dumps so a redisplay loop cannot fill a log.
+ */
+static void _CiderMatrixCells(NSMatrix *matrix, NSArray *cells, NSInteger selectedIndex,
+                              NSInteger rows, NSInteger cols)
+{
+    static int dumped = 0;
+
+    if (getenv("CIDER_TRACE_CONTROL") == NULL || dumped >= 12)
+        return;
+    dumped++;
+    fprintf(stderr, "CIDER_MATRIX cells self=%p rows=%ld cols=%ld count=%lu selected=%ld\n",
+            (void *) matrix, (long) rows, (long) cols, (unsigned long) [cells count],
+            (long) selectedIndex);
+    for (NSUInteger i = 0; i < [cells count]; i++) {
+        NSCell *cell = [cells objectAtIndex: i];
+        NSString *title = [cell respondsToSelector: @selector(title)] ? [cell title] : nil;
+
+        fprintf(stderr, "CIDER_MATRIX   [%lu] state=%ld title=%s\n", (unsigned long) i,
+                (long) [cell state], [title UTF8String] ?: "(none)");
+    }
+    fflush(stderr);
+}
