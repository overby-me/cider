 - (void) setState: (NSControlStateValue) value {
+    /*
+     * WHO TURNS A RADIO ON, with the caller. A radio group drawing two filled dots while its matrix
+     * reports one selected index means a cell was set on by someone the matrix does not know about,
+     * and only the caller can say who. CIDER_TRACE_CELLSTATE matches a title substring, or star for
+     * every cell, and stops after 20 so a redisplay cannot fill a log.
+     */
+    const char *want = getenv("CIDER_TRACE_CELLSTATE");
+
+    if (want != NULL && want[0] != '\0') {
+        static int printed = 0;
+        NSString *title = [self title];
+        const char *name = [title UTF8String] ?: "";
+
+        /* A TITLELESS CELL CANNOT BE THE ONE BEING HUNTED, and a gallery full of them spent a
+         * whole budget before the radios were touched once. */
+        if (name[0] != '\0' && (strcmp(want, "*") == 0 || strstr(name, want) != NULL) &&
+            printed < 30) {
+            void *frames[12];
+            int count = backtrace(frames, 12);
+
+            printed++;
+            fprintf(stderr, "CIDER_CELLSTATE title=%s %ld -> %ld\n", name,
+                    (long) [self state], (long) value);
+            for (int i = 1; i < count; i++) {
+                Dl_info info;
+
+                if (dladdr(frames[i], &info) != 0 && info.dli_sname != NULL)
+                    fprintf(stderr, "CIDER_CELLSTATE   #%d %s\n", i, info.dli_sname);
+                else
+                    fprintf(stderr, "CIDER_CELLSTATE   #%d %p\n", i, frames[i]);
+            }
+            fflush(stderr);
+        }
+    }
     [self setIntValue: value];
 }
 
