+/* AND IT IS READ FROM THE MENU, NEVER COPIED OUT OF IT. AppKit's pop-up shows whatever its selected
+ * item says NOW. This cell copied the title into itself in -synchronizeTitleAndSelectedItem, which
+ * is only correct if the item already carries its final title.
+ *
+ * wxWidgets inserts a menu item and gives it its title afterwards, so the copy took the empty string
+ * the item had at insertion and nothing ever replaced it. The trace of Money Manager Ex building its
+ * Account Type control reads: setmenu items=0, additem items=1, sync title= (empty), then eight more
+ * additem lines and four more sync lines all still empty, while the nine real titles go into the
+ * items. That is why Account Type and Account Status draw as empty boxes. */
+- (NSString *) title
+{
+    NSArray *itemArray = [_menu itemArray];
+    NSMenuItem *item = nil;
+    NSString *title;
+
+    if (_selectedIndex < 0 || _pullsDown) {
+        if ([itemArray count] > 0)
+            item = [itemArray objectAtIndex: 0];
+    } else if (_selectedIndex < (NSInteger) [itemArray count]) {
+        item = [itemArray objectAtIndex: _selectedIndex];
+    }
+
+    title = [item title];
+
+    if (getenv("CIDER_TRACE_POPUP") != NULL) {
+        static int budget = 60;
+
+        if (budget-- > 0) {
+            fprintf(stderr, "CIDER_POPUP title cell=%p items=%ld selected=%ld item=%s super=%s\n",
+                    self, (long) [itemArray count], (long) _selectedIndex,
+                    [title UTF8String] ?: "(nil)", [[super title] UTF8String] ?: "(nil)");
+            fflush(stderr);
+        }
+    }
+
+    return title != nil ? title : [super title];
+}
+
