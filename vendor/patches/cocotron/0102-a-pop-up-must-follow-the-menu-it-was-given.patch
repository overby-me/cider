+/* AN ITEM PUT STRAIGHT INTO THE MENU MUST STILL REACH THE BUTTON. AppKit's pop-up follows its own
+ * menu: give it an empty one and add items to that menu afterwards, and the button selects the
+ * first item and draws its title. This cell only looked at the menu in -setMenu:, so a pop-up built
+ * that way stayed on selectedIndex -1 with a nil title and drew an EMPTY BOX for ever.
+ *
+ * That is how every wxWidgets choice is built. -[wxChoiceCocoaImpl wxChoiceCocoaImpl] makes an empty
+ * wxMenu, sends setMenu: with it, and -[wxChoiceCocoaImpl InsertItem] then calls wxMenuBase::Insert
+ * and sends the button NOTHING AT ALL, which is correct on a Mac. Money Manager Ex showed an empty
+ * Account Type and an empty Account Status because of it. */
+- (void) _ciderMenuDidAddItem: (NSNotification *) notification
+{
+    if (getenv("CIDER_TRACE_POPUP") != NULL)
+        fprintf(stderr, "CIDER_POPUP additem menu=%p items=%ld selected=%ld pulls=%d\n", _menu,
+                (long) [_menu numberOfItems], (long) _selectedIndex, (int) _pullsDown);
+
+    if (_pullsDown || _selectedIndex >= 0 || [_menu numberOfItems] == 0)
+        return;
+
+    _selectedIndex = 0;
+    [self synchronizeTitleAndSelectedItem];
+}
+
+- (void) _ciderWatchMenu
+{
+    if (_menu == nil)
+        return;
+
+    [[NSNotificationCenter defaultCenter] addObserver: self
+                                             selector: @selector(_ciderMenuDidAddItem:)
+                                                 name: NSMenuDidAddItemNotification
+                                               object: _menu];
+}
+
+- (void) _ciderStopWatchingMenu
+{
+    if (_menu == nil)
+        return;
+
+    [[NSNotificationCenter defaultCenter] removeObserver: self
+                                                    name: NSMenuDidAddItemNotification
+                                                  object: _menu];
+}
+
 - (void) dealloc {
+    [self _ciderStopWatchingMenu];
     [_menu release];
     [super dealloc];
 }
