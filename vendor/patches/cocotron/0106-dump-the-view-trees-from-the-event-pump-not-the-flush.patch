+             * event pump comes round whatever the windows are doing, and the per window throttle
+             * inside the dumper is unchanged, so this costs one timestamp comparison per window
+             * per pass and nothing at all when the variable is unset.
+             */
+            if (getenv("CIDER_TRACE_TREE") != NULL) {
+                for (NSWindow *window in [NSApp windows])
+                    if ([window isVisible])
