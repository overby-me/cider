+/* THE RECTANGLE INSIDE THE GROOVE, matching the groove -drawRect: paints, less the margins. */
+- (NSRect) _ciderContentFrame {
+    NSRect content = _bounds;
+    NSRect title = [self titleRect];
+
+    switch (_titlePosition) {
+
+    case NSNoTitle:
+    case NSBelowTop:
+    case NSAboveBottom:
+        break;
+
+    case NSAboveTop:
+        content.size.height -= title.size.height + TEXTGAP;
+        break;
+
+    case NSAtTop:
+        content.size.height -= floor(title.size.height / 2);
+        break;
+
+    case NSAtBottom:
+        content.origin.y += floor(title.size.height / 2);
+        content.size.height -= floor(title.size.height / 2);
+        break;
+
+    case NSBelowBottom:
+        content.origin.y += title.size.height + TEXTGAP;
+        content.size.height -= title.size.height + TEXTGAP;
+        break;
+    }
+
+    content = NSInsetRect(content, _contentViewMargins.width, _contentViewMargins.height);
+
+    if (content.size.width < 0)
+        content.size.width = 0;
+    if (content.size.height < 0)
+        content.size.height = 0;
+
+    return content;
+}
+
+- (void) _ciderSizeContentView {
+    NSView *content = [self contentView];
+
+    if (content != nil)
+        [content setFrame: [self _ciderContentFrame]];
+}
+
+/* EVERYTHING ADDED TO A BOX BELONGS TO ITS CONTENT VIEW. A box keeps exactly one subview, so
+ * -contentView can go on answering the last one; more importantly the content view is the one an
+ * application flips, and a child that lands on the box instead gets its y converted against the
+ * box and drifts a thousand points off the dialog. */
+- (void) addSubview: (NSView *) view {
+    NSView *content = [self contentView];
+
+    if (content != nil && view != content)
+        [content addSubview: view];
+    else
+        [super addSubview: view];
+}
+
