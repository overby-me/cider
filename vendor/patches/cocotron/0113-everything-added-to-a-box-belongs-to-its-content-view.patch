     if (![[self subviews] containsObject: view]) {
         [[self subviews]
                 makeObjectsPerformSelector: @selector(removeFromSuperview)];
-        // FIX, adjust size
-        [self addSubview: view];
+        [super addSubview: view];
     }
+
+    /* AND GIVE IT THE BOX TO FILL. A view adopted here keeps the frame it was created with, and a
+     * view created in code starts 1x1: wx built the whole New Transaction dialog inside a content
+     * view one pixel square, so the box drew and every field in it was clipped away. */
+    [view setAutoresizingMask: NSViewWidthSizable | NSViewHeightSizable];
+    [self _ciderSizeContentView];
+}
+
+- (void) setFrameSize: (NSSize) size {
+    [super setFrameSize: size];
+    [self _ciderSizeContentView];
