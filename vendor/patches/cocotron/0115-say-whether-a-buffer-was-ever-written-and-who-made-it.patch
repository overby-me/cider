--- a/Onyx2D/O2Surface.m
+++ b/Onyx2D/O2Surface.m
@@ -898,6 +898,30 @@
     if (length == 0)
         return;
 
+    /* WHETHER ANYTHING REACHED A BUFFER AT ALL. A caller drawing into its own bitmap cannot tell a
+     * draw that produced nothing from one that produced black, because a zeroed XRGB buffer IS
+     * black. CIDER_TRACE_SURFACE_WIDTH names one width so a single control can be watched without
+     * the rest of the screen burying it. */
+    static int ciderWantedWidth = -2;
+
+    if (ciderWantedWidth == -2) {
+        const char *spec = getenv("CIDER_TRACE_SURFACE_WIDTH");
+
+        ciderWantedWidth = (spec != NULL) ? atoi(spec) : -1;
+    }
+    if (ciderWantedWidth >= 0 && (int) self->_width == ciderWantedWidth) {
+        static int printed;
+
+        if (printed < 60) {
+            printed++;
+            fprintf(stderr,
+                    "CIDER_SURFACE write %dx%d at %d,%d len=%d first=%02x,%02x,%02x,%02x\n",
+                    (int) self->_width, (int) self->_height, x, y, length, span[0].a, span[0].r,
+                    span[0].g, span[0].b);
+            fflush(stderr);
+        }
+    }
+
     self->_writeargb8u(self, x, y, span, length);
 }
 
