+#include <execinfo.h>
 #import <Onyx2D/O2BitmapContext.h>
 #include <stdio.h>
 #include <stdlib.h>
@@ -111,10 +112,22 @@
     if (getenv("CIDER_TRACE_IMAGESOURCE") != NULL &&
         getenv("CIDER_TRACE_IMAGESOURCE")[0] != '\0') {
         fprintf(stderr,
-                "CIDER_IMAGESOURCE O2BitmapContextCreate %lux%lu bpc=%lu bpr=%lu data=%p info=0x%lx -> %s\n",
+                "CIDER_IMAGESOURCE O2BitmapContextCreate %lux%lu bpc=%lu bpr=%lu data=%p info=0x%lx -> %s",
                 (unsigned long) width, (unsigned long) height,
                 (unsigned long) bitsPerComponent, (unsigned long) bytesPerRow, data,
                 (unsigned long) bitmapInfo, result ? "ok" : "NULL");
+
+        /* AND WHO ASKED. A buffer that is created and never drawn into blits as black, and the
+         * only way to tell which of several callers made it is the stack that made it. */
+        void *frames[8];
+        int count = backtrace(frames, 8);
+        char **names = backtrace_symbols(frames, count);
+
+        for (int i = 1; i < count && names != NULL; i++)
+            fprintf(stderr, " <- %s", names[i]);
+        if (names != NULL)
+            free(names);
+        fprintf(stderr, "\n");
         fflush(stderr);
     }
     return result;
