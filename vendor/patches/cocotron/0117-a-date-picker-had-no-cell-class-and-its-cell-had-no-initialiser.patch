+/*
+ * THE SIZE THIS CELL ACTUALLY DRAWS. NSCell answers 10000 when it does not measure itself, which
+ * -[NSControl intrinsicContentSize] rejects, so a date picker had no natural size at all and
+ * wxWidgets gave Money Manager Ex a 16x16 one: a date field with no date in it on both the Edit
+ * Account and New Transaction dialogs. The arithmetic is -drawWithFrame: read backwards: the text
+ * sits inside the bezel inset by 2, the bezel is the frame less the stepper and inset by 1 and 3,
+ * and the stepper is always drawn.
+ */
+- (NSSize) cellSize {
+    NSArray *array = [self _attributedStrings];
+    NSInteger i, count = [array count];
+    CGFloat width = 0, height = 0;
+
+    for (i = 0; i < count; i++) {
+        NSAttributedString *string = [array objectAtIndex: i];
+        NSSize size = [string size];
+        NSNumber *fixed = [[string attributesAtIndex: 0 effectiveRange: NULL]
+                objectForKey: @"_width"];
+
+        width += (fixed != nil) ? [fixed floatValue] : size.width;
+        height = MAX(height, size.height);
+    }
+
+    if (count == 0)
+        return [super cellSize];
+
+    return NSMakeSize(ceil(width) + 2 * 2 + 2 * 1 + 15, ceil(height) + 2 * 3);
+}
