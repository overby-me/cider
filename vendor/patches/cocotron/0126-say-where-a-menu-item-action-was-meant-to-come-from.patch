 - (void) setTarget: (id) target {
+    if (getenv("CIDER_TRACE_MENUITEM_DECODE") != NULL) {
+        fprintf(stderr, "CIDER_ITEMSET target title=%s to=%s\n",
+                [_title UTF8String] ?: "(nil)",
+                target != nil ? object_getClassName(target) : "nil");
+        fflush(stderr);
+    }
     _target = target;
 }
 
 - (void) setAction: (SEL) action {
+    /* WHO SETS WHAT, IN ORDER. MoneyMoney About ends up with a real target and a NULL action, and
+     * the only thing that can separate a connection that never ran from one that ran and was
+     * undone is the sequence of writes. */
+    if (getenv("CIDER_TRACE_MENUITEM_DECODE") != NULL) {
+        fprintf(stderr, "CIDER_ITEMSET action title=%s sel=%s\n",
+                [_title UTF8String] ?: "(nil)", action != NULL ? sel_getName(action) : "NULL");
+        fflush(stderr);
+    }
     _action = action;
 }
 
