-        O2ContextShowGlyphsAtPoint(context, positions[i].x, positions[i].y, &glyphs[i], 1);
+        O2ContextShowGlyphsAtPoint(context, base.x + positions[i].x, base.y + positions[i].y,
+                                   &glyphs[i], 1);
     }
+    O2ContextSetTextPosition(context, base.x, base.y);
 }
 
