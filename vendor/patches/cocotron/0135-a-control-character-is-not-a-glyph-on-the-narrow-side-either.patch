-    for (NSUInteger i = 0; i < length; i++)
-        glyphs[i] = narrowGlyphs[i];
+    for (NSUInteger i = 0; i < length; i++) {
+        unichar check = characters[i];
+
+        /*
+         * AND A CONTROL CHARACTER IS NOT A GLYPH, which only the wide side of this pair knew.
+         *
+         * -[NSFont getGlyphs:forCharacters:length:] answers NSControlGlyph for everything below
+         * space; KTFont answers a table lookup, which is 0 for a character no face draws. The
+         * typesetter acts on a paragraph break inside if (glyph == NSControlGlyph), so a newline
+         * that arrives as 0 breaks nothing and the next line is appended to the current one.
+         *
+         * iA Writer showed it: a document reading "# Cider", blank line, "A document iA Writer can
+         * open." drew as one line, "# CiderA document iA Writer can open.", because 89 of its runs
+         * carry a CoreText font under NSFontAttributeName and its three newlines all fell in them:
+         *
+         *     CIDER_TEXTCTL char=U+000A glyph=0 isControlGlyph=0 index=7
+         *
+         * while U+0000 and U+0008 in NSFont runs arrived as 16777215 with isControlGlyph=1.
+         */
+        if (check < ' ' || (check >= 0x7F && check <= 0x9F) || check == 0x200B ||
+            check == 0x2028 || check == 0x2029)
+            glyphs[i] = NSControlGlyph;
+        else
+            glyphs[i] = narrowGlyphs[i];
+    }
     free(narrowGlyphs);
     return length;
 }
