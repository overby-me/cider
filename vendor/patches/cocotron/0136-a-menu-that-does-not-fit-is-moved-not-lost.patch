 #import <AppKit/NSPopUpView.h>
 #import <AppKit/NSPopUpWindow.h>
+#import <AppKit/NSScreen.h>
 
 @implementation NSPopUpWindow
 
@@ -58,6 +59,38 @@
     [_view selectItemAtIndex: index];
 }
 
+/*
+ * A MENU THAT DOES NOT FIT IS MOVED, NOT LOST. Placing the selected item over the button is the
+ * whole point of the shift above, and for a button near the bottom of a window it puts the menu
+ * past the edge of the screen. macOS slides it back on; here nothing did, so Swift Publisher
+ * Open Recent opened at y -27, the pointer-to-screen conversion answered a negative y, and the
+ * tracking loop read that as outside the menu and hid it one event later. Measured, not inferred:
+ * create=ok number=3 size=72x38 at=20,-27 followed by hide number=3 visible=true.
+ */
+- (NSRect) _ciderFrameClampedToScreen: (NSRect) frame {
+    NSScreen *screen = [self screen];
+    NSRect visible;
+
+    if (screen == nil)
+        screen = [NSScreen mainScreen];
+    if (screen == nil)
+        return frame;
+
+    visible = [screen visibleFrame];
+    /* A menu taller or wider than the screen keeps its origin at the near edge rather than being
+     * pushed off the far one. */
+    if (NSMaxX(frame) > NSMaxX(visible))
+        frame.origin.x = NSMaxX(visible) - frame.size.width;
+    if (frame.origin.x < visible.origin.x)
+        frame.origin.x = visible.origin.x;
+    if (NSMaxY(frame) > NSMaxY(visible))
+        frame.origin.y = NSMaxY(visible) - frame.size.height;
+    if (frame.origin.y < visible.origin.y)
+        frame.origin.y = visible.origin.y;
+
+    return frame;
+}
+
 - (NSInteger) runTrackingWithEvent: (NSEvent *) event {
     NSSize size = [_view sizeForContents];
     NSRect selectedRect = [_view rectForSelectedItem];
@@ -67,6 +100,7 @@
     frame.size = size;
     frame.origin.y -=
             (size.height - selectedRect.origin.y) - selectedRect.size.height;
+    frame = [self _ciderFrameClampedToScreen: frame];
     [self setFrame: frame display: NO];
 
     [_view setFrameSize: size];
