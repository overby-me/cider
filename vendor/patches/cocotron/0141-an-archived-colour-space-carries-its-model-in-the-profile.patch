+/* WHAT THE ARCHIVE ACTUALLY CARRIES, counted over 568 of these in four applications: an NSICC
+ * profile every time, whose data colour space field decides the model. NSModel is ABSENT on every
+ * RGB one, so decoding it with the usual zero default would have made all 32 of them Gray. */
+- (id) initWithCoder: (NSCoder *) coder {
+    NSData *profile = nil;
+    int model = 1;
+
+    if ([coder allowsKeyedCoding]) {
+        profile = [coder decodeObjectForKey: @"NSICC"];
+
+        if ([coder containsValueForKey: @"NSModel"])
+            model = [coder decodeIntForKey: @"NSModel"];
+    }
+
+    /* Bytes 16 to 20 of an ICC header are its data colour space. This port has no ICC support, so
+     * the profile decides the MODEL and a device space of that model is as much as can be honoured;
+     * the alternative was raising, which is what every one of these used to do. */
+    if ([profile length] >= 20) {
+        const char *signature = (const char *) [profile bytes] + 16;
+
+        if (memcmp(signature, "GRAY", 4) == 0)
+            model = 0;
+        else if (memcmp(signature, "RGB ", 4) == 0)
+            model = 1;
+        else if (memcmp(signature, "CMYK", 4) == 0)
+            model = 2;
+    }
+
+    switch (model) {
+    case 0:
+        _cgColorSpace = CGColorSpaceCreateDeviceGray();
+        break;
+
+    case 2:
+        _cgColorSpace = CGColorSpaceCreateDeviceCMYK();
+        break;
+
+    default:
+        _cgColorSpace = CGColorSpaceCreateDeviceRGB();
+        break;
+    }
+
+    if (getenv("CIDER_TRACE_COLORSPACE") != NULL) {
+        fprintf(stderr, "CIDER_CSDECODE model=%d icc=%ld cg=%p\n", model,
+                (long) [profile length], (void *) _cgColorSpace);
+        fflush(stderr);
+    }
+
+    return self;
+}
+
 - (void) dealloc {
     CGColorSpaceRelease(_cgColorSpace);
     [super dealloc];
