 #import <objc/runtime.h>
 #import <Foundation/NSKeyedArchiver.h>
 
+#import <stdio.h>
+#import <stdlib.h>
+
 @implementation NSTextFieldCell
 
 @synthesize allowedInputSourceLocales = _allowedInputSourceLocales;
@@ -318,6 +321,17 @@
