     NSSize size = [[self attributedStringValue] size];
 
+    /* WHAT A LABEL IS TOLD IT NEEDS. -sizeToFit, -intrinsicContentSize and -fittingSize all funnel
+     * through here, so this one line covers every route a toolkit can ask a width by. Money
+     * Manager Ex draws a nine character weekday into a 64 point rect when the string measures 65,
+     * and the question is whether it ever asked. */
+    if (getenv("CIDER_TRACE_MEASURE") != NULL) {
+        fprintf(stderr, "CIDER_MEASURE cellSize \"%.40s\" string=%.2f bezeled=%d bordered=%d\n",
+                [[self stringValue] UTF8String] ?: "(nil)", size.width, (int) [self isBezeled],
+                (int) [self isBordered]);
+        fflush(stderr);
+    }
