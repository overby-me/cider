 - (NSInteger) numberOfRows {
+    /* WHAT THE TABLE BELIEVES, and whether it asked. The cached answer is returned until
+     * noteNumberOfRowsChanged clears it, so a table that never reloads and a data source that
+     * answers zero look identical from outside. Prints only when it actually ASKS, which is the
+     * interesting event; the cached returns are silent on purpose or this floods every redraw. */
+    BOOL ciderAsking = (_numberOfRows < 0) && (getenv("CIDER_TRACE_TABLE_ROWS") != NULL);
 
     if (_numberOfRows < 0) {
         id binding = [self _binderForBinding: @"content"];
@@ -367,6 +375,13 @@
         }
     }
 
+    if (ciderAsking) {
+        fprintf(stderr, "CIDER_ROWS ask %s source=%s binder=%d -> %ld\n", object_getClassName(self),
+                _dataSource != nil ? object_getClassName(_dataSource) : "(nil)",
+                [self _binderForBinding: @"content"] != nil, (long) _numberOfRows);
+        fflush(stderr);
+    }
+
     return _numberOfRows;
 }
 
@@ -1243,6 +1258,14 @@
     NSSize size = [self frame].size;
     NSSize headerSize = [_headerView frame].size;
 
+    /* EVERY runtime invalidation goes through here: reloadData calls it, and reloadDataForRowIndexes,
+     * insertRowsAtIndexes, removeRowsAtIndexes and moveRowAtIndex all call reloadData. */
+    if (getenv("CIDER_TRACE_TABLE_ROWS") != NULL) {
+        fprintf(stderr, "CIDER_ROWS invalidate %s had=%ld\n", object_getClassName(self),
+                (long) _numberOfRows);
+        fflush(stderr);
