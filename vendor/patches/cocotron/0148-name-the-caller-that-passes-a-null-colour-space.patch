 O2ColorRef O2ColorCreate(O2ColorSpaceRef colorSpace, const O2Float *components)
 {
+    /* WHO BUILDS A COLOUR WITH NO SPACE. The guards in O2ColorSpace keep that survivable and name
+     * this function as the caller; one more frame is what says whose colour it is. */
+    if (colorSpace == NULL && getenv("CIDER_TRACE_COLORSPACE") != NULL) {
+        void *ret = __builtin_return_address(0);
+        Dl_info info;
+        if (dladdr(ret, &info) != 0 && info.dli_fname != NULL) {
+            const char *base = strrchr(info.dli_fname, '/');
+            fprintf(stderr, "CIDER_CSNULL create ret=%p image=%s sym=%s+%ld\n", ret,
+                    base != NULL ? base + 1 : info.dli_fname,
+                    info.dli_sname != NULL ? info.dli_sname : "(none)",
+                    info.dli_saddr != NULL ? (long) ((char *) ret - (char *) info.dli_saddr) : 0L);
+        } else {
+            fprintf(stderr, "CIDER_CSNULL create ret=%p image=(unknown)\n", ret);
+        }
+        fflush(stderr);
+    }
     return O2ColorInitWithColorSpace([O2Color alloc], colorSpace, components);
 }
 
