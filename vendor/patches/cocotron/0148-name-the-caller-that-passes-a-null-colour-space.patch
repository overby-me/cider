-            fprintf(stderr, "CIDER_CSNULL components ret=%p\n", __builtin_return_address(0));
-            fflush(stderr);
-        }
+        CiderTraceNullColorSpace("components", __builtin_return_address(0));
         return 0;
     }
 
@@ -233,10 +253,7 @@
      * reached here and killed iA Writer opening the Editor preferences pane; -1 sends that switch
      * to its default instead. */
     if (self == NULL) {
-        if (getenv("CIDER_TRACE_COLORSPACE") != NULL) {
-            fprintf(stderr, "CIDER_CSNULL model ret=%p\n", __builtin_return_address(0));
-            fflush(stderr);
-        }
+        CiderTraceNullColorSpace("model", __builtin_return_address(0));
         return (O2ColorSpaceModel) -1;
