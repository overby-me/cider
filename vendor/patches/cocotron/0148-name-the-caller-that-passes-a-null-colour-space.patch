 #import <Foundation/NSString.h>
 #import <Onyx2D/O2ColorSpace.h>
+#include <dlfcn.h>
+#include <string.h>
 
 const CFStringRef kO2ColorSpaceDisplayP3 = CFSTR("kCGColorSpaceDisplayP3");
 const CFStringRef kO2ColorSpaceGenericGray = CFSTR("kCGColorSpaceGenericGray");
@@ -193,15 +195,33 @@
     return self->_isPlatformRGB;
 }
 
+/* NAME THE CALLER, not its address. A bare return address needs the load map of a process that has
+ * already exited to mean anything, and two of them went unread for that reason. dladdr answers the
+ * image and the nearest exported symbol, which is enough to say whose gap this is. */
+static void CiderTraceNullColorSpace(const char *what, void *ret)
+{
+    if (getenv("CIDER_TRACE_COLORSPACE") == NULL)
+        return;
+
+    Dl_info info;
+    if (dladdr(ret, &info) != 0 && info.dli_fname != NULL) {
+        const char *base = strrchr(info.dli_fname, '/');
+        fprintf(stderr, "CIDER_CSNULL %s ret=%p image=%s sym=%s+%ld\n", what, ret,
+                base != NULL ? base + 1 : info.dli_fname,
+                info.dli_sname != NULL ? info.dli_sname : "(none)",
+                info.dli_saddr != NULL ? (long) ((char *) ret - (char *) info.dli_saddr) : 0L);
+    } else {
+        fprintf(stderr, "CIDER_CSNULL %s ret=%p image=(unknown)\n", what, ret);
+    }
+    fflush(stderr);
+}
+
