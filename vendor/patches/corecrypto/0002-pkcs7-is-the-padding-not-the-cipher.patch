-	return 8;
+	size_t block_size = cbc->block_size;
+	size_t padding = block_size - (nbytes % block_size);
+	size_t total = nbytes + padding;
+	uint8_t *buffer;
+	size_t i;
+
+	if (block_size == 0)
+		return 0;
+
+	buffer = (uint8_t *) malloc(total);
+	if (buffer == NULL)
+		return 0;
