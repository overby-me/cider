+/*
+ * PKCS#7 IS THE PADDING, NOT THE CIPHER: decrypt every block, then take the last byte of the
+ * plaintext as the number of bytes that were added and drop them.
+ *
+ * This was a stub that decrypted nothing and answered 8, so a caller got 8 bytes of whatever was in
+ * its output buffer. iA Writer keeps its Markdown regular expressions in an encrypted resource, and
+ * that is where they came from: the regexes were nil strings, and the failure surfaced as
+ * "Nil string passed to NSRegularExpression API" from inside a dispatch_once, with nothing to say
+ * that a cipher was involved.
+ *
+ * A CORRUPT PAD IS NOT A CRASH. If the last byte is not a length this cipher could have written, the
+ * whole plaintext is returned rather than a negative length, because the caller decides what a bad
+ * decryption means and an underflow here would be a very long memcpy somewhere else.
+ */
 size_t ccpad_pkcs7_decrypt(const struct ccmode_cbc *cbc, cccbc_ctx *ctx, cccbc_iv *iv,
                            size_t nbytes, const void *in, void *out) {
-	printf("DARLING CRYPTO STUB: %s\n", __PRETTY_FUNCTION__);
-	return 8;
+	size_t block_size = cbc->block_size;
+	const uint8_t *plaintext;
+	size_t padding;
+	size_t i;
+
+	if (nbytes == 0 || block_size == 0 || nbytes % block_size != 0)
+		return 0;
+
+	if (cbc->cbc(ctx, iv, nbytes / block_size, in, out) != 0)
+		return 0;
+
+	plaintext = (const uint8_t *) out;
+	padding = plaintext[nbytes - 1];
+
+	if (padding == 0 || padding > block_size || padding > nbytes)
+		return nbytes;
+
+	for (i = 0; i < padding; i++) {
+		if (plaintext[nbytes - 1 - i] != padding)
+			return nbytes;
+	}
+
+	return nbytes - padding;
 }
 
