 - (void)setObject:(id)obj forKeyedSubscript:(id <NSCopying>)key
 {
+    /*
+     * NIL REMOVES THE KEY, it does not throw. That is what the subscript is DOCUMENTED to do, and
+     * the difference is not academic: dict[key] = something-that-might-be-nil is ordinary code, and
+     * forwarding it straight to setObject:forKey: turns every one of those into a fatal
+     * NSInvalidArgumentException.
+     *
+     * MoneyMoney dies in exactly that way during startup: -[NSDateFormatter setDateFormat:] stores
+     * its argument with _attributes[@"dateFormat"] = string, the application passes nil to clear it,
+     * and the process is killed with Cannot set nil objects nor nil keys.
+     */
+    if (obj == nil) {
+        [self removeObjectForKey:key];
+        return;
+    }
     [self setObject:obj forKey:key];
 }
 
