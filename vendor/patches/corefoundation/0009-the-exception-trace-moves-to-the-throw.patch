--- a/NSException.m
+++ b/NSException.m
@@ -28,8 +28,11 @@
 typedef id (*objc_exception_preprocessor)(id exception);
 extern objc_exception_preprocessor objc_setExceptionPreprocessor(objc_exception_preprocessor fn);
 
+static void cider_trace_exception(NSException *exception);
+
 static NSException *__exceptionPreprocess(NSException *exception)
 {
+    cider_trace_exception(exception);
 
     // this is quite expensive (1/3 sec lag), when it can be made more performant (under 1/60 sec) this should be re-enabled
     // UPDATE(facekapow): i've re-enabled this even though nothing has really changed in the code, but from limited testing
@@ -97,7 +100,18 @@
     [super dealloc];
 }
 
-- (void) raise {
+/*
+ * THE TRACE LIVES AT THE THROW, NOT AT -raise.
+ *
+ * It used to sit inside -[NSException raise], which is one of TWO ways an exception is thrown and
+ * not the one Foundation itself uses: every range check in NSArray does
+ * @throw [NSException exceptionWithName:...] and never touches -raise, so the exception that
+ * mattered went past unseen. iTerm2 reported "index (0) beyond array bounds (0)" from inside its own
+ * handler with nothing to say where it came from. objc_exception_throw runs the preprocessor for
+ * BOTH paths, which is where this belongs.
+ */
+static void cider_trace_exception(NSException *exception)
+{
     /*
      * EVERY RAISE, NAMED, when CIDER_TRACE_EXCEPTIONS is set.
      *
@@ -111,8 +125,8 @@
      */
     if (getenv("CIDER_TRACE_EXCEPTIONS") != NULL) {
         fprintf(stderr, "cider: RAISE %s: %s\n",
-                [[self name] UTF8String] ?: "?",
-                [[self reason] UTF8String] ?: "?");
+                [[exception name] UTF8String] ?: "?",
+                [[exception reason] UTF8String] ?: "?");
 
         /*
          * AND WHO RAISED IT, which the name and the reason cannot say.
@@ -139,6 +153,9 @@
         }
         fflush(stderr);
     }
+}
+
+- (void) raise {
     @throw self;
 }
 
