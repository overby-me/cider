 extern void __HALT(void);
 
+extern id objc_constructInstance(Class cls, void *bytes);
+extern size_t class_getInstanceSize(Class cls);
+
+/* Build the object in the caller buffer when it fits, and say so plainly when it does not. */
+static id __CFPlaceEmptySingleton(Class cls, void *storage, size_t capacity, SEL selAlloc,
+                                  SEL selInit)
+{
+    if (cls == NULL) {
+        return NULL;
+    }
+    if (class_getInstanceSize(cls) <= capacity) {
+        id placed = objc_constructInstance(cls, storage);
+
+        if (placed != NULL) {
+            return objc_msgSend(placed, selInit);
+        }
+    }
+    return objc_msgSend(objc_msgSend(cls, selAlloc), selInit);
+}
