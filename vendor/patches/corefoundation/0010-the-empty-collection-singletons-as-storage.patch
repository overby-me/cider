 static CFTypeID __kCFNotATypeTypeID = _kCFRuntimeNotATypeID;
 id __NSDictionary0__, __NSArray0__;
 
+/*
+ * THE EMPTY SINGLETONS AS STORAGE, WHICH IS WHAT A MODERN BINARY IMPORTS.
+ *
+ * __NSDictionary0__ and __NSArray0__ are POINTERS to the shared empty collections, and code compiled
+ * against a current SDK does not use them: it refers to __NSDictionary0__struct and
+ * __NSArray0__struct, the STORAGE of those two objects, so that an empty literal is an address
+ * rather than a load. iTerm2 3.6.10 does exactly that, and dyld stops before main with
+ *
+ *     Symbol not found: ___NSDictionary0__struct
+ *
+ * The two objects are built INSIDE these buffers with objc_constructInstance, which is the runtime
+ * call for placing an instance in memory the caller owns, so the pointer and the struct are the same
+ * object rather than two empty dictionaries that are not identical to each other. The buffers are
+ * generous and the size is CHECKED at construction: if a class ever outgrows one, the pointer falls
+ * back to an ordinary allocation and the struct stays zero, which is a visible nil rather than a
+ * silently corrupt object.
+ */
+__attribute__((aligned(16))) char __NSDictionary0__struct[512];
+__attribute__((aligned(16))) char __NSArray0__struct[512];
+
