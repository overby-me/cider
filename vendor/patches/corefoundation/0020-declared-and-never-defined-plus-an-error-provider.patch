+// THE CACHE IS REAL HERE, so clearing it is real too. Every resource property a CFURL answers is
+// kept in the per-URL resourceInfo dictionary until the client drops it, and CFURL.h says the
+// client has complete control over that lifetime. Both of these were declared and never defined.
+void CFURLClearResourcePropertyCacheForKey(CFURLRef url, CFStringRef key)
+{
+    CFMutableDictionaryRef resourceInfo = CFURLResourceInfo(url);
+
+    pthread_mutex_lock(&resInfoLock);
+    CFDictionaryRemoveValue(resourceInfo, key);
+    pthread_mutex_unlock(&resInfoLock);
+
+    CFURLResourceInfoRelease(resourceInfo);
+}
+
+void CFURLClearResourcePropertyCache(CFURLRef url)
+{
+    CFMutableDictionaryRef resourceInfo = CFURLResourceInfo(url);
+
+    pthread_mutex_lock(&resInfoLock);
+    CFDictionaryRemoveAllValues(resourceInfo);
+    pthread_mutex_unlock(&resInfoLock);
+
+    CFURLResourceInfoRelease(resourceInfo);
+}
