++ (void)setUserInfoValueProviderForDomain:(NSString *)errorDomain provider:(id (^)(NSError *err, NSString *userInfoKey))provider
+{
+    if (errorDomain == nil)
+    {
+        return;
+    }
+
+    pthread_mutex_lock(&_userInfoValueProviderLock);
+
+    if (_userInfoValueProviders == nil)
+    {
+        _userInfoValueProviders = [[NSMutableDictionary alloc] init];
+    }
+
+    if (provider != NULL)
+    {
+        // Copy the block: a stack block registered from +load is gone by the time anyone asks.
+        id copied = [(id)provider copy];
+        [_userInfoValueProviders setObject:copied forKey:errorDomain];
+        [copied release];
+    }
+    else
+    {
+        [_userInfoValueProviders removeObjectForKey:errorDomain];
+    }
+
+    pthread_mutex_unlock(&_userInfoValueProviderLock);
+}
+
++ (id (^)(NSError *err, NSString *userInfoKey))userInfoValueProviderForDomain:(NSString *)errorDomain
+{
+    if (errorDomain == nil)
+    {
+        return NULL;
+    }
+
+    pthread_mutex_lock(&_userInfoValueProviderLock);
+    id provider = [[[_userInfoValueProviders objectForKey:errorDomain] retain] autorelease];
+    pthread_mutex_unlock(&_userInfoValueProviderLock);
+
+    return provider;
+}
+
+// Ask the domain's provider for one key. Every accessor below goes through this when the userInfo
+// dictionary does not already carry the value, which is the whole point of the mechanism.
+- (id)_ciderProvidedValueForKey:(NSString *)key
+{
+    id (^provider)(NSError *, NSString *) = [NSError userInfoValueProviderForDomain:[self domain]];
+
+    return (provider != NULL) ? provider(self, key) : nil;
+}
