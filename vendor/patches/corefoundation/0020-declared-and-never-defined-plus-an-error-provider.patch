+/*
+ * USER INFO VALUE PROVIDERS, which iA Writer registers from a +load method and which every modern
+ * framework that defines an error domain uses: instead of filling a userInfo dictionary at the
+ * moment an error is made, a domain registers one block that is asked for a key when someone wants
+ * it. Registering was an unrecognised selector here, and an unrecognised selector in +load is a
+ * process that dies before its first window.
+ *
+ * The registry is a dictionary keyed by domain, guarded by its own lock because a provider can be
+ * registered from any thread while errors are being read on another.
+ */
+static NSMutableDictionary *_userInfoValueProviders = nil;
+static pthread_mutex_t _userInfoValueProviderLock = PTHREAD_MUTEX_INITIALIZER;
