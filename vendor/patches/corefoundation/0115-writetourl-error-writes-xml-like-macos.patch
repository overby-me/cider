+++ b/NSDictionary.m
@@ -1061,16 +1061,17 @@
 }
 
 /*
- * macOS 10.13. Note the FORMAT: the atomically: methods above write XML, this one writes BINARY,
- * which is what Foundation changed to when it introduced these. A caller that writes with one and
- * reads with the other still works, because property-list reading sniffs the format, so the choice
- * only shows up in the bytes on disk -- but the bytes on disk are what fidelity means here.
+ * macOS 10.13. XML, like the atomically: methods above. An earlier version of this wrote BINARY on
+ * the theory that Foundation changed format when it introduced these; the testsuite says otherwise
+ * and it is the arbiter, because its expected resource was captured from a real Mac and begins
+ * "<plist version=" rather than "bplist00". Reading sniffs the format either way, so the choice
