+/*
+ * ONE RUN INSTEAD OF ONE BUILD PER SELECTOR, and it is a diagnostic, not a policy.
+ *
+ * A missing setter raises, the process dies, and the next missing setter is only visible after
+ * another build: finding four of them on one iA Writer text field cost four builds. With
+ * CIDER_SWALLOW_SETTERS set, a one argument set... message with no implementation is DROPPED and
+ * named on stderr, so a single run lists all of them.
+ *
+ * ONLY a setter, and only one taking one argument, because those return void: the caller reads
+ * nothing back and dropping the message loses a stored value rather than a computed answer. It is
+ * off unless asked for, and it must stay off for any run that judges whether an application works,
+ * since an application configured by messages that went nowhere is not the application.
+ */
+static BOOL _CiderSwallowSetter(SEL selector)
+{
+    static int cached = -1;
+    const char *name;
+    size_t length;
+
+    if (cached < 0)
+    {
+        const char *value = getenv("CIDER_SWALLOW_SETTERS");
+        cached = (value != NULL && value[0] != '\0' && value[0] != '0') ? 1 : 0;
+    }
+    if (cached == 0)
+    {
+        return NO;
+    }
+    name = sel_getName(selector);
+    if (name == NULL || strncmp(name, "set", 3) != 0 || name[3] < 'A' || name[3] > 'Z')
+    {
+        return NO;
+    }
+    length = strlen(name);
+    if (length < 5 || name[length - 1] != ':')
+    {
+        return NO;
+    }
+    return strchr(name, ':') == name + length - 1;
+}
