 static void NSUnrecognizedForwarding() { __asm__("int3"); }
 
+/*
+ * WHO SENT IT. The superclass chain says where the method should have come from and cannot say
+ * who asked for it, and when the sender catches the exception there is no other trace at all:
+ * MoneyMoney loses its whole Preferences window to one caught raise. Off by default, because an
+ * application is allowed to probe for a selector this way.
+ */
+static void _CiderTraceUnrecognizedSender(void)
+{
+    const char *on = getenv("CIDER_TRACE_UNRECOGNIZED");
+    void *frames[32];
+    int n;
+
+    if (on == NULL || on[0] == '\0')
+    {
+        return;
+    }
+    n = backtrace(frames, 32);
+    fprintf(stderr, "cider:   sent by:\n");
+    fflush(stderr);
+    backtrace_symbols_fd(frames, n, 2);
+}
+
