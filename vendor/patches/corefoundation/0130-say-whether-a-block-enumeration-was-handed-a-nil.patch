+/*
+ * CIDER_TRACE_ENUM reports the shape of every block enumeration: its count, and how many elements
+ * arrived nil. An element that IS nil and an element whose property ANSWERS nil are the same crash
+ * from the caller's side, and nothing above this line can tell them apart.
+ *
+ * It announces itself on the first call so silence means "not reached" rather than "not armed".
+ */
+static BOOL CiderEnumTraceArmed(void)
+{
+    static BOOL looked = NO;
+    static BOOL armed = NO;
+
+    if (!looked)
+    {
+        const char *value = getenv("CIDER_TRACE_ENUM");
+        looked = YES;
+        armed = (value != NULL && value[0] != '\0' && value[0] != '0');
+        if (armed)
+        {
+            fprintf(stderr, "CIDER_ENUM armed\n");
+            fflush(stderr);
+        }
+    }
+    return armed;
+}
+
+static void CiderNoteEnumeration(NSArray *array, NSUInteger count, NSEnumerationOptions opts)
+{
+    NSUInteger nils = 0;
+    NSUInteger firstNil = NSNotFound;
+
+    for (NSUInteger i = 0; i < count; i++)
+    {
+        if ([array objectAtIndex:i] == nil)
+        {
+            if (nils == 0) firstNil = i;
+            nils++;
+        }
+    }
+
+    id first = (count > 0) ? [array objectAtIndex:0] : nil;
+    fprintf(stderr, "CIDER_ENUM count=%lu opts=%#lx nils=%lu firstNil=%ld first=%s\n",
+            (unsigned long) count, (unsigned long) opts, (unsigned long) nils,
+            (nils == 0) ? -1L : (long) firstNil,
+            (first != nil) ? object_getClassName(first) : "(nil)");
+    fflush(stderr);
+}
+
 - (void)enumerateObjectsUsingBlock:(void (^)(id obj, NSUInteger idx, BOOL *stop))block
 {
     [self enumerateObjectsWithOptions:0 usingBlock:block];
