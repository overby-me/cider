-CFDataRef CFURLCreateBookmarkDataFromFile(CFAllocatorRef allocator, CFURLRef fileURL, CFErrorRef *errorRef)
+/*
+ * BOOKMARK DATA IS OPAQUE, AND THAT IS WHAT MAKES THIS POSSIBLE. macOS documents the blob as
+ * private and nothing outside the framework parses one, so any format round trips as long as
+ * create and resolve agree. This records the path, and the device and inode at creation so
+ * staleness can be answered rather than guessed.
+ *
+ * RETURNING NULL WITHOUT SETTING THE ERROR IS A COMBINATION macOS NEVER PRODUCES, and an
+ * application is entitled to read it as "no failure". iA Writer does exactly that: on a nil
+ * bookmark with a nil error its addURL: adds the nil to its bookmarks array, and four layers later
+ * a nil key reaches removeObjectForKey: and the process dies. Every exit below therefore either
+ * returns a blob or fills *error.
+ */
+#define CIDER_BOOKMARK_MAGIC 0x6B6D6263  /* "cbmk" little endian */
+#define CIDER_BOOKMARK_VERSION 1
+
+struct CiderBookmarkHeader {
+    uint32_t magic;
+    uint32_t version;
+    uint64_t device;
+    uint64_t inode;
+    uint32_t pathLength;    /* bytes, no terminator */
+    uint32_t reserved;
+};
+
+static void bookmarkError(CFErrorRef *error, CFIndex code, CFStringRef reason)
 {
-#warning TODO: FIXME
-    return NULL;
+    if (error == NULL)
+    {
+        return;
+    }
+
+    const CFStringRef key = kCFErrorLocalizedDescriptionKey;
+    CFTypeRef value = reason;
+    *error = CFErrorCreateWithUserInfoKeysAndValues(kCFAllocatorDefault, kCFErrorDomainCocoa, code,
+                                                    (const void *const *) &key,
+                                                    (const void *const *) &value, 1);
 }
 
