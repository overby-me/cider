+    {
+        posixError(errorRef);
+        return false;
+    }
+
+    size_t length = (size_t) CFDataGetLength(bookmarkRef);
+    size_t wrote = fwrite(CFDataGetBytePtr(bookmarkRef), 1, length, handle);
+    fclose(handle);
+
+    if (wrote != length)
+    {
+        bookmarkError(errorRef, 512, CFSTR("the alias file was written short"));
+        return false;
+    }
+    return true;
