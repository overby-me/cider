+    // The space a colour is already in. NSColor returns self here, so the components must survive
+    // exactly; 0.25, 0.5 and 0.75 are representable, so this is not a float tolerance question.
+    NSColor* rgb = [NSColor colorWithDeviceRed: 0.25 green: 0.5 blue: 0.75 alpha: 1.0];
+    NSColor* sameSpace = [rgb colorUsingColorSpaceName: NSDeviceRGBColorSpace];
+
+    assert_is_true(sameSpace != nil);
+    assert_equals_NSString(NSDeviceRGBColorSpace, [sameSpace colorSpaceName]);
+    assert_equals_CGFloat("redComponent", 0.25, [sameSpace redComponent]);
+    assert_equals_CGFloat("greenComponent", 0.5, [sameSpace greenComponent]);
+    assert_equals_CGFloat("blueComponent", 0.75, [sameSpace blueComponent]);
+    assert_equals_CGFloat("alphaComponent", 1.0, [sameSpace alphaComponent]);
+
+    // Grey to RGB. The exact level depends on the profile, but a grey has no hue in any of them,
+    // so the three channels must agree with each other whatever they are.
+    NSColor* grey = [NSColor colorWithCalibratedWhite: 0.5 alpha: 1.0];
+    NSColor* greyAsRGB = [grey colorUsingColorSpaceName: NSCalibratedRGBColorSpace];
+
+    assert_is_true(greyAsRGB != nil);
+    assert_equals_CGFloat("grey red vs green", [greyAsRGB redComponent], [greyAsRGB greenComponent]);
+    assert_equals_CGFloat("grey green vs blue", [greyAsRGB greenComponent], [greyAsRGB blueComponent]);
+    assert_equals_CGFloat("grey alphaComponent", 1.0, [greyAsRGB alphaComponent]);
+
+    // A NAMED COLOUR, which is what task #227 is about.
+    //
+    // A catalog colour is a name that the running system resolves, so nil is a legitimate answer
