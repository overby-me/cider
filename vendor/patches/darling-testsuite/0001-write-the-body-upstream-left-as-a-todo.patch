+    // asking does not RAISE: Qt converts every system colour while building its palette, and an
+    // exception here kills the application before it draws anything. The observed failure was
+    //     -[__NSCFString colorUsingColorSpaceName:device:]: unrecognized selector
+    // so the conversion reached something that was not a colour at all.
+    NSColor* named = [NSColor textBackgroundColor];
