+++ b/src/fmdb/FMDBCiderRename.h	2026-09-03 15:12:42.119101048 +0200
@@ -0,0 +1,29 @@
+/*
+ * OUR COPY OF FMDB MUST NOT ANSWER TO THE APPLICATION'S NAME.
+ *
+ * A class name is registered by the ObjC runtime for every loaded image, and two images that
+ * register the same name make the runtime pick ONE OF THEM ARBITRARILY. It says so:
+ *
+ *   objc[2]: Class FMDatabaseQueue is implemented in both
+ *     /System/Library/PrivateFrameworks/FMDB.framework/Versions/A/FMDB and
+ *     /Applications/iA Writer.app/Contents/Frameworks/Kit.framework/Versions/A/Kit.
+ *     One of the two will be used. Which one is undefined.
+ *
+ * iA Writer carries its own FMDB inside Kit.framework and runs its library indexing through it.
+ * When our copy wins the toss, the application's queries are served by a DIFFERENT build of FMDB
+ * than the one it was compiled against.
+ *
+ * macOS ships this framework too and does not collide, because a system copy of third party code is
+ * renamed before it ships. This is that rename. LaunchServices is the only thing here that uses
+ * FMDB and it includes these headers, so it follows automatically.
+ */
+#ifndef FMDB_CIDER_RENAME_H
+#define FMDB_CIDER_RENAME_H
+
+#define FMDatabase CiderFMDatabase
+#define FMDatabasePool CiderFMDatabasePool
+#define FMDatabaseQueue CiderFMDatabaseQueue
+#define FMResultSet CiderFMResultSet
+#define FMStatement CiderFMStatement
+
+#endif
