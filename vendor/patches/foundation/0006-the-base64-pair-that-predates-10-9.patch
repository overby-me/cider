--- a/src/NSData.m
+++ b/src/NSData.m
@@ -1260,6 +1260,29 @@
     return result;
 }
 
+/*
+ * THE PAIR THAT PREDATES 10.9, WHICH IS DEPRECATED AND NOT GONE.
+ *
+ * -initWithBase64Encoding: and -base64Encoding were the only base64 in Foundation until 10.9, they
+ * still work on macOS today, and an application built against a current SDK is free to call them
+ * because deprecation is not removal. iTerm2 does, while it builds its terminal window, and the
+ * unrecognized selector was ending the process.
+ *
+ * The old decoder IGNORES characters it does not know rather than failing, which is what callers of
+ * this spelling expect: it was routinely handed base64 with line breaks in it. The old encoder emits
+ * one unbroken line.
+ */
+- (id)initWithBase64Encoding:(NSString *)base64String
+{
+    return [self initWithBase64EncodedString:base64String
+                                     options:NSDataBase64DecodingIgnoreUnknownCharacters];
+}
+
+- (NSString *)base64Encoding
+{
+    return [[self base64EncodedStringWithOptions:0] autorelease];
+}
+
 @end
 
