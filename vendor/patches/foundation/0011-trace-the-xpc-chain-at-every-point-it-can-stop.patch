+/*
+ * THE RECEIVING HALF, TRACED, because everything about the sending half already checks out.
+ *
+ * iTerm2 asks a bundled service to decode an inline image. The service is spawned, the lookup
+ * succeeds, the worker is alive, the request goes out with a valid reply block, and nothing ever
+ * comes back: no reply, no decode, no error, no invalidation. That is a question about what the far
+ * side does with the message rather than a question about images, and os_log_debug answers it to
+ * nobody, since nothing here is wired to show debug level logging.
+ *
+ * So the chain is traced at every point it could stop, and the points are named so the FIRST line
+ * that fails to appear is the answer:
+ *
+ *   CIDER_XPCMAIN     the service reached xpc_main and knows its own name;
+ *   CIDER_XPCSERVER   a connection object arrived at the server event handler;
+ *   CIDER_XPCPEER     a peer connection was built and the delegate was asked to accept it;
+ *   CIDER_XPCRECV     a message arrived on a connection, either side;
+ *   CIDER_XPCINVOKE   the message was decoded far enough to name a selector.
+ *
+ * NON EMPTY IS REQUIRED. A gate written as getenv() != NULL reads an env var that is SET BUT EMPTY
+ * as on, which has already cost a run here, so an empty value means off.
+ */
+static bool cider_trace_xpc(void) {
+    const char *value = getenv("CIDER_TRACE_XPC");
+
+    return value != NULL && value[0] != '\0';
+}
