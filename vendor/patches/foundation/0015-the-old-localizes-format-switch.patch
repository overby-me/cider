+/*
+ * THE LEGACY BOUNDS AND FORMAT, which the header declares and nothing implemented.
+ *
+ * minimum, maximum, format, thousandSeparator and hasThousandSeparators are the pre
+ * CFNumberFormatter surface. Swift Publisher sets them on its measurement units formatter while
+ * building the inspector, and each missing one raised an unrecognized selector that unwound the
+ * whole nib load and left the document window unbuilt.
+ *
+ * STORED AND ANSWERED, not enforced: minimum and maximum are kept but nothing here clamps a value
+ * to them when formatting. Saying that plainly is better than a comment implying the range works.
+ */
+- (NSNumber *)minimum
+{
+    return _attributes[@"NSMinimum"];
+}
+
+- (void)setMinimum:(NSNumber *)number
+{
+    if (number != nil) {
+        _attributes[@"NSMinimum"] = number;
+    } else {
+        [_attributes removeObjectForKey:@"NSMinimum"];
+    }
+}
+
+- (NSNumber *)maximum
+{
+    return _attributes[@"NSMaximum"];
+}
+
+- (void)setMaximum:(NSNumber *)number
+{
+    if (number != nil) {
+        _attributes[@"NSMaximum"] = number;
+    } else {
+        [_attributes removeObjectForKey:@"NSMaximum"];
+    }
+}
+
+- (NSString *)format
+{
+    return [self positiveFormat];
+}
+
+- (void)setFormat:(NSString *)format
+{
+    /* The old single string carried positive;negative;zero separated by semicolons. Only the
+     * positive part has a modern equivalent that this object already implements. */
+    NSArray *parts = [format componentsSeparatedByString:@";"];
+
+    if ([parts count] > 0) {
+        [self setPositiveFormat:[parts objectAtIndex:0]];
+    }
+    if ([parts count] > 1) {
+        [self setNegativeFormat:[parts objectAtIndex:1]];
+    }
+}
+
+- (BOOL)hasThousandSeparators
+{
+    return [self usesGroupingSeparator];
+}
+
+- (void)setHasThousandSeparators:(BOOL)flag
+{
+    [self setUsesGroupingSeparator:flag];
+}
+
+- (NSString *)thousandSeparator
+{
+    return [self groupingSeparator];
+}
+
+- (void)setThousandSeparator:(NSString *)separator
+{
+    [self setGroupingSeparator:separator];
+}
+
 @end
