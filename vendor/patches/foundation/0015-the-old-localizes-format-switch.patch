+/*
+ * THE OLD STYLE SWITCH, WITH NO CORE FOUNDATION KEY BEHIND IT.
+ *
+ * localizesFormat predates the CFNumberFormatter era and has no kCFNumberFormatter counterpart, so
+ * it cannot go through the SET_BOOL macros like everything else here. It is kept in the same
+ * attributes dictionary under its own name, which is where the rest of this object state lives.
+ *
+ * Swift Publisher calls it on a formatter while building its inspector, and an unrecognized
+ * selector there unwound an entire nib load and cost the document window. Storing and answering it
+ * is the property contract; nothing in this formatter consults it when formatting, and that is
+ * said here rather than implied, because the modern behaviour IS localised and setting NO would
+ * not turn that off.
+ */
+- (BOOL)localizesFormat
+{
+    return [_attributes[@"NSLocalizesFormat"] boolValue];
+}
+
+- (void)setLocalizesFormat:(BOOL)flag
+{
+    _attributes[@"NSLocalizesFormat"] = @(flag);
+}
+
