--- a/src/NSBundle.m
+++ b/src/NSBundle.m
@@ -254,12 +254,42 @@
 
 + (NSBundle *)bundleWithIdentifier:(NSString *)identifier
 {
+    if (identifier == nil) {
+        return nil;
+    }
+
     NSBundle *bundle = nil;
     @synchronized(bundlesByIdentifier)
     {
         bundle = [bundlesByIdentifier[identifier] retain];
-        // TODO: we should be doing some searching if the bundle is nil
     }
+
+    if (bundle != nil) {
+        return [bundle autorelease];
+    }
+
+    /*
+     * NOW SEARCH, which the TODO here asked for and which is the difference between an application
+     * starting and not. The table only holds bundles somebody has already created, so an identifier
+     * belonging to a framework the loader mapped but nobody has asked about yet came back nil. A
+     * framework asking for ITSELF this way is ordinary: iA Writer does it from a +load, gets nil,
+     * and inserts that nil into a set, which raises before its first window exists.
+     *
+     * +allFrameworks walks every loaded image and creates a bundle for each framework path, and
+     * each of those registers its own identifier on the way, so the table is complete afterwards
+     * and one repeated lookup answers.
+     */
+    (void)[self allFrameworks];
+
+    @synchronized(bundlesByIdentifier)
+    {
+        bundle = [bundlesByIdentifier[identifier] retain];
+    }
+
+    if (bundle == nil && [[[self mainBundle] bundleIdentifier] isEqualToString: identifier]) {
+        bundle = [[self mainBundle] retain];
+    }
+
     return [bundle autorelease];
 }
 
