+/** Returns 'YES' iff all four insets are the same. Declared in NSGeometry.h since 10.10 and
+ * never defined here, which is a link error in any application that compares two insets. */
+BOOL NSEdgeInsetsEqual(NSEdgeInsets aInsets, NSEdgeInsets bInsets)
+{
+	return ((aInsets.top == bInsets.top)
+			&& (aInsets.left == bInsets.left)
+			&& (aInsets.bottom == bInsets.bottom)
+			&& (aInsets.right == bInsets.right)) ? YES : NO;
+}
+
