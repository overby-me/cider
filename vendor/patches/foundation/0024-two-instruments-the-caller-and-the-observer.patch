@@ -561,6 +561,15 @@
 
 - (void)addObserver:(NSObject *)observer forKeyPath:(NSString *)keyPath options:(NSKeyValueObservingOptions)options context:(void *)context
 {
+    /* WHO WATCHES WHAT. An application that lays out in an observer callback is invisible to every
+     * other instrument: nothing is drawn, nothing raises, and the missing notification looks like
+     * missing layout code. Naming the pairs is one line per registration. */
+    if (getenv("CIDER_TRACE_KVO") != NULL) {
+        fprintf(stderr, "CIDER_KVO %s observes %s of %s\n", object_getClassName(observer),
+                [keyPath UTF8String] ?: "(nil)", object_getClassName(self));
+        fflush(stderr);
+    }
+
