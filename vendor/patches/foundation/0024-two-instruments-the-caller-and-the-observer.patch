 - (NSPoint) transformPoint: (NSPoint)aPoint
 {
   NSPoint new;
 
+  /* WHO ASKED, not just what was asked. A trace of the values alone cannot say which call site in
+   * the application used this transform, and the whole question for Swift Publisher is whether the
+   * transform its geometry code holds is the one we see being used. The return address names the
+   * caller; subtract the image base to read it against the disassembly. */
+  if (getenv("CIDER_TRACE_XFORM") != NULL)
+    {
+      fprintf(stderr, "CIDER_XFORM point (%g,%g) identity=%d caller=%p\n",
+              (double) aPoint.x, (double) aPoint.y, (int) _isIdentity,
+              __builtin_return_address(0));
+      fflush(stderr);
+    }
+
   if (_isIdentity)
     {
       new.x = TX + aPoint.x;
@@ -513,6 +530,14 @@
  */
