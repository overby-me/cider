+/*
+ * APPLE DOCUMENTS THE DEFAULT AS THE OLDER METHOD. A subclass that implements only
+ * getObjectValue:forString:errorDescription: still has to answer this one, or a caller that uses the
+ * range form gets an unrecognized selector instead of a parse.
+ */
+- (BOOL)getObjectValue:(out id *)obj forString:(NSString *)string range:(inout NSRange *)rangep error:(out NSError **)error
+{
+    NSString *description = nil;
+    BOOL parsed = [self getObjectValue:obj forString:string errorDescription:&description];
+
+    if (parsed)
+    {
+        if (rangep != NULL)
+        {
+            rangep->location = 0;
+            rangep->length = [string length];
+        }
+        return YES;
+    }
+
+    if (error != NULL)
+    {
+        NSDictionary *info = (description != nil)
+                ? [NSDictionary dictionaryWithObject:description forKey:NSLocalizedDescriptionKey]
+                : nil;
+
+        *error = [NSError errorWithDomain:NSCocoaErrorDomain code:NSFormattingError userInfo:info];
+    }
+    return NO;
+}
