+/*
+ * THE ONLY CONCRETE PARSE IN THIS CLASS, AND IT WAS MISSING. -getObjectValue:forString:errorDescription:
+ * above forwards to this selector, nothing in the chain implemented it, and NSFormatter has no default
+ * either, so every parse raised. AppKit catches that per event and the field editor tries again on the
+ * next display pass: Swift Publisher's margin field turned one click into 68,612 raises and 137,224
+ * display passes, and the keystrokes never got processed at all.
+ */
+- (BOOL)getObjectValue:(out id *)obj forString:(NSString *)string range:(inout NSRange *)rangep error:(out NSError **)error
+{
+    if (obj != NULL)
+    {
+        *obj = nil;
+    }
+    if (error != NULL)
+    {
+        *error = nil;
+    }
+    if (string == nil)
+    {
+        return NO;
+    }
+
+    [self _regenerateFormatter];
+
+    /* A RANGE FROM A CALLER IS CHECKED, not trusted: CFNumberFormatter reads it directly and a
+     * caller that leaves it uninitialised faults inside CoreFoundation with nothing to say why. */
+    NSUInteger length = [string length];
+    CFRange range = CFRangeMake(0, length);
+
+    if (rangep != NULL && rangep->location <= length)
+    {
+        range.location = rangep->location;
+        range.length = (rangep->length <= length - rangep->location) ? rangep->length
+                                                                     : length - rangep->location;
+    }
+    CFOptionFlags options = [_attributes[@"parseIntegersOnly"] boolValue] ? kCFNumberFormatterParseIntegersOnly : 0;
+    CFNumberRef number = CFNumberFormatterCreateNumberFromString(kCFAllocatorDefault, _formatter,
+                                                                (CFStringRef)string, &range, options);
+
+    if (number == NULL)
+    {
+        if (error != NULL)
+        {
+            *error = [NSError errorWithDomain:NSCocoaErrorDomain
+                                         code:NSFormattingError
+                                     userInfo:nil];
+        }
+        return NO;
+    }
+
+    if (obj != NULL)
+    {
+        *obj = [(id)number autorelease];
+    }
+    else
+    {
+        CFRelease(number);
+    }
+    if (rangep != NULL)
+    {
+        rangep->location = range.location;
+        rangep->length = range.length;
+    }
+    return YES;
+}
