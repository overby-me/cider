+- (BOOL) isActive
+{
+    return _active;
+}
+
+/*
+ * ACTIVATING A CONSTRAINT IS WHAT PUTS IT ON A VIEW, and macOS picks the nearest common ancestor of
+ * the two items. Holding it on the first item is enough here, because nothing reads the list back
+ * except the view that owns it, and what an application can otherwise notice is the constraint being
+ * deallocated the moment the statement that made it ends.
+ *
+ * ASKED BY SELECTOR, NOT BY CLASS. NSView is AppKit's and this is Foundation; respondsToSelector is
+ * how a lower framework talks to a higher one without a dependency it cannot have.
+ */
+- (void) setActive: (BOOL) active
+{
+    if (active == _active) {
+        return;
+    }
+    _active = active;
+
+    id owner = nil;
+
+    if ([_firstItem respondsToSelector: @selector(superview)]) {
+        owner = [_firstItem performSelector: @selector(superview)];
+        if (owner == nil) {
+            owner = _firstItem;
+        }
+    } else if ([_secondItem respondsToSelector: @selector(superview)]) {
+        owner = _secondItem;
+    }
+    if (owner == nil) {
+        return;
+    }
+    if (active) {
+        if ([owner respondsToSelector: @selector(addConstraint:)]) {
+            [owner performSelector: @selector(addConstraint:) withObject: self];
+        }
+    } else if ([owner respondsToSelector: @selector(removeConstraint:)]) {
+        [owner performSelector: @selector(removeConstraint:) withObject: self];
+    }
+}
+
+- (NSString *) description
+{
+    return [NSString stringWithFormat: @"<%@ %p first=%@ attr=%ld rel=%ld second=%@ attr=%ld x%g +%g%@>",
+                                       [self class], self, [_firstItem class], (long) _firstAttribute,
+                                       (long) _relation, [_secondItem class], (long) _secondAttribute,
+                                       _multiplier, _constant, _active ? @" active" : @""];
 }
 
 @end
