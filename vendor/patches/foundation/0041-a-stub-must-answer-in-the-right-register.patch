+#import <objc/runtime.h>
 #import <Foundation/NSUserActivity.h>
 #import <Foundation/NSMethodSignature.h>
 #import <Foundation/NSInvocation.h>
@@ -25,14 +26,41 @@
 
 @implementation NSUserActivity
 
-- (NSMethodSignature *)methodSignatureForSelector:(SEL)aSelector
-{
-    return [NSMethodSignature signatureWithObjCTypes: "v@:"];
+@synthesize activityType = _activityType;
+@synthesize title = _title;
+@synthesize userInfo = _userInfo;
+@synthesize webpageURL = _webpageURL;
+@synthesize eligibleForHandoff = _eligibleForHandoff;
+@synthesize eligibleForSearch = _eligibleForSearch;
+@synthesize eligibleForPublicIndexing = _eligibleForPublicIndexing;
+@synthesize needsSave = _needsSave;
+
+- (instancetype) initWithActivityType: (NSString *) activityType {
+    if ((self = [super init]) == nil)
+        return nil;
+
+    _activityType = [activityType copy];
+    _valid = YES;
+    return self;
 }
 
-- (void)forwardInvocation:(NSInvocation *)anInvocation
-{
-    NSLog(@"Stub called: %@ in %@", NSStringFromSelector([anInvocation selector]), [self class]);
+- (void) dealloc {
+    [_activityType release];
+    [_title release];
+    [_userInfo release];
+    [_webpageURL release];
+    [super dealloc];
+}
+
+/* Nothing continues an activity, so becoming current is bookkeeping and invalidating is final. */
+- (void) becomeCurrent {
+}
+
+- (void) resignCurrent {
+}
+
+- (void) invalidate {
+    _valid = NO;
 }
 
 @end
