-@interface NSLayoutAnchor : NSObject
+/*
+ * ONE EDGE OF ONE VIEW, and the constraints you can make from it.
+ *
+ * An anchor is a pair: the item it belongs to and which attribute of it. Every method here builds an
+ * NSLayoutConstraint out of that pair and hands it back, which is all an anchor does on macOS too.
+ * There is no solver behind it, exactly as for the constraints themselves, so what a caller gets is
+ * a real constraint object that records the relation it asked for.
+ *
+ * The names live in Foundation because NSLayoutConstraint does; a second class of the same name in
+ * AppKit would be a coin toss the runtime resolves however it likes.
+ */
+@interface NSLayoutAnchor : NSObject {
+    id _item;
+    NSLayoutAttribute _attribute;
+}
+
++ (instancetype) anchorWithItem: (id) item attribute: (NSLayoutAttribute) attribute;
+
+@property (readonly, assign) id item;
+@property (readonly) NSLayoutAttribute attribute;
+
+- (NSLayoutConstraint *) constraintEqualToAnchor: (NSLayoutAnchor *) anchor;
+- (NSLayoutConstraint *) constraintEqualToAnchor: (NSLayoutAnchor *) anchor
