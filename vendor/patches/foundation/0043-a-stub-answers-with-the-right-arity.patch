+/*
+ * A DURATION AS TEXT, which is what every caller of this class wants and nil is not.
+ *
+ * The stub answered nil for everything, and a caller that copies the result crashed inside
+ * CFStringCreateCopy on a null string. This formats the components it was given in the plain
+ * "1h 2m 3s" shape, largest unit first, skipping the ones that are zero. It does not consult
+ * allowedUnits or the zero-formatting behaviour, which a real formatter would; what it guarantees
+ * is a string.
+ */
+- (NSString *) stringFromDateComponents: (NSDateComponents *) components {
+    NSMutableString *result = [NSMutableString string];
+    NSInteger parts[4];
+    const char *suffixes[4] = { "d", "h", "m", "s" };
+    NSInteger i;
+
+    if (components == nil)
+        return @"";
+
+    parts[0] = [components day];
+    parts[1] = [components hour];
+    parts[2] = [components minute];
+    parts[3] = [components second];
+
+    for (i = 0; i < 4; i++) {
+        if (parts[i] == NSIntegerMax || parts[i] <= 0)
+            continue;
+        if ([result length] > 0)
+            [result appendString: @" "];
+        [result appendFormat: @"%ld%s", (long) parts[i], suffixes[i]];
+    }
+    return [result length] > 0 ? result : @"0s";
+}
+
+- (NSString *) stringFromTimeInterval: (NSTimeInterval) interval {
+    NSInteger total = (NSInteger) (interval < 0 ? -interval : interval);
+    NSInteger hours = total / 3600;
+    NSInteger minutes = (total % 3600) / 60;
+    NSInteger seconds = total % 60;
+
+    if (hours > 0)
+        return [NSString stringWithFormat: @"%ldh %ldm %lds", (long) hours, (long) minutes,
+                                           (long) seconds];
+    if (minutes > 0)
+        return [NSString stringWithFormat: @"%ldm %lds", (long) minutes, (long) seconds];
+    return [NSString stringWithFormat: @"%lds", (long) seconds];
+}
+
 @end
