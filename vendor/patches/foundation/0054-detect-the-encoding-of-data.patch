++ (NSStringEncoding)stringEncodingForData:(NSData *)data
+                          encodingOptions:(NSDictionary *)options
+                          convertedString:(NSString **)convertedString
+                      usedLossyConversion:(BOOL *)usedLossyConversion
+{
+    if (convertedString != NULL)
+    {
+        *convertedString = nil;
+    }
+    if (usedLossyConversion != NULL)
+    {
+        *usedLossyConversion = NO;
+    }
+
+    if ([data length] == 0)
+    {
+        return 0;
+    }
+
+    NSArray *suggested = [options objectForKey:NSStringEncodingDetectionSuggestedEncodingsKey];
+    NSArray *disallowed = [options objectForKey:NSStringEncodingDetectionDisallowedEncodingsKey];
+    BOOL onlySuggested = [[options objectForKey:NSStringEncodingDetectionUseOnlySuggestedEncodingsKey] boolValue];
+    id allowLossy = [options objectForKey:NSStringEncodingDetectionAllowLossyKey];
+    NSMutableArray *candidates = [NSMutableArray array];
+
+    [candidates addObjectsFromArray:suggested];
+    if (!onlySuggested)
+    {
+        NSStringEncoding detected = _NSDetectEncodingOfBytes([data bytes], [data length]);
+
+        if (detected != 0)
+        {
+            [candidates addObject:[NSNumber numberWithUnsignedInteger:detected]];
+        }
+        [candidates addObject:[NSNumber numberWithUnsignedInteger:NSUTF8StringEncoding]];
+    }
+
+    for (NSNumber *candidate in candidates)
+    {
+        NSStringEncoding encoding = [candidate unsignedIntegerValue];
+
+        if (encoding == 0 || [disallowed containsObject:candidate])
+        {
+            continue;
+        }
+
+        NSString *string = [[NSString alloc] initWithData:data encoding:encoding];
+
+        if (string != nil)
+        {
+            if (convertedString != NULL)
+            {
+                *convertedString = [string autorelease];
+            }
+            else
+            {
+                [string release];
+            }
+            return encoding;
+        }
+    }
+
+    // Lossy conversion is allowed unless the caller says otherwise.
+    if (allowLossy != nil && ![allowLossy boolValue])
+    {
+        return 0;
+    }
+
+    // Latin 1 maps every byte, so it always answers, and it is a guess rather than a reading.
+    NSString *lossy = [[NSString alloc] initWithData:data encoding:NSISOLatin1StringEncoding];
+
+    if (lossy == nil)
+    {
+        return 0;
+    }
+    if (convertedString != NULL)
+    {
+        *convertedString = [lossy autorelease];
+    }
+    else
+    {
+        [lossy release];
+    }
+    if (usedLossyConversion != NULL)
+    {
+        *usedLossyConversion = YES;
+    }
+    return NSISOLatin1StringEncoding;
+}
