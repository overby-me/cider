+/*
+ * A REAL TOKENISER, because an initialiser that answers nil is a policy answer and this one was
+ * answering it nineteen times a run to iA Writer, which is a WRITING application. Every method of
+ * this class was a stub: nil in, nil out, and a Swift caller gets nil where its type says it cannot
+ * be, so whatever feature asked for the tagger simply disappears (#194).
+ *
+ * WHAT IS EXACT and what is not, stated rather than implied. The TOKEN RANGES are exact, and they
+ * are what a word count, a selection by word and a text excerpt actually need. The TAG is exact for
+ * NSLinguisticTagSchemeTokenType, which is the scheme that asks only what KIND of token this is.
+ * For the classification schemes, lexical class and name type, a real answer needs a part of speech
+ * model that is not here, so those get the conservative Other tags rather than nil: a caller that
+ * enumerates gets every token with a usable range, and no caller is told a noun is a verb.
+ */
+@interface NSLinguisticTagger ()
+{
+    NSArray *_ciderSchemes;
+    NSString *_ciderString;
+    NSUInteger _ciderOptions;
+}
+@end
+
+/* Word, whitespace, punctuation or none of those, which is the whole of the token type scheme. */
+typedef enum {
+    CiderTokenWord,
+    CiderTokenWhitespace,
+    CiderTokenPunctuation,
+    CiderTokenOther
+} CiderTokenKind;
+
+static CiderTokenKind CiderKindOfCharacter(unichar c)
+{
+    /* Every set is fetched ONCE. This runs per character of a document, so a +characterSet message
+     * inside the loop is the difference between a tokeniser and a stall. */
+    static NSCharacterSet *word, *space, *punct, *symbol;
+
+    if (word == nil)
+    {
+        NSMutableCharacterSet *w = [[NSCharacterSet alphanumericCharacterSet] mutableCopy];
+
+        /* An apostrophe and an underscore are INSIDE a word, not between two: splitting "don't"
+         * into three tokens is the difference between a word count and a nonsense. */
+        [w addCharactersInString:@"'’_"];
+        word = w;
+        space = [[NSCharacterSet whitespaceAndNewlineCharacterSet] retain];
+        punct = [[NSCharacterSet punctuationCharacterSet] retain];
+        symbol = [[NSCharacterSet symbolCharacterSet] retain];
+    }
+    if ([word characterIsMember:c])
+    {
+        return CiderTokenWord;
+    }
+    if ([space characterIsMember:c])
+    {
+        return CiderTokenWhitespace;
+    }
+    if ([punct characterIsMember:c] || [symbol characterIsMember:c])
+    {
+        return CiderTokenPunctuation;
+    }
+    return CiderTokenOther;
+}
+
+static BOOL CiderKindIsOmitted(CiderTokenKind kind, NSLinguisticTaggerOptions opts)
+{
+    switch (kind)
+    {
+        case CiderTokenWord:        return (opts & NSLinguisticTaggerOmitWords) != 0;
+        case CiderTokenWhitespace:  return (opts & NSLinguisticTaggerOmitWhitespace) != 0;
+        case CiderTokenPunctuation: return (opts & NSLinguisticTaggerOmitPunctuation) != 0;
+        default:                    return (opts & NSLinguisticTaggerOmitOther) != 0;
+    }
+}
+
+static NSString *CiderTagForKind(CiderTokenKind kind, NSString *scheme)
+{
+    BOOL tokenType = (scheme == nil) || [scheme isEqualToString:NSLinguisticTagSchemeTokenType];
+
+    switch (kind)
+    {
+        case CiderTokenWord:
+            return tokenType ? NSLinguisticTagWord : NSLinguisticTagOtherWord;
+        case CiderTokenWhitespace:
+            return tokenType ? NSLinguisticTagWhitespace : NSLinguisticTagOtherWhitespace;
+        case CiderTokenPunctuation:
+            return tokenType ? NSLinguisticTagPunctuation : NSLinguisticTagOtherPunctuation;
+        default:
+            return NSLinguisticTagOther;
+    }
+}
+
+/* The sentence a character index belongs to, bounded by a terminator followed by whitespace and by
+ * the ends of the string. Good enough for the ranges a caller uses to highlight or excerpt. */
+static NSRange CiderSentenceRange(NSString *string, NSUInteger index)
+{
+    NSUInteger length = [string length];
+    NSUInteger start = 0;
+    NSUInteger i;
+
+    if (length == 0)
+    {
+        return NSMakeRange(0, 0);
+    }
+    if (index >= length)
+    {
+        index = length - 1;
+    }
+    for (i = index; i > 0; i--)
+    {
+        unichar c = [string characterAtIndex:i - 1];
+
+        if ((c == '.' || c == '!' || c == '?' || c == '\n') && i <= index)
+        {
+            start = i;
+            break;
+        }
+    }
+    for (i = index; i < length; i++)
+    {
+        unichar c = [string characterAtIndex:i];
+
+        if (c == '.' || c == '!' || c == '?' || c == '\n')
+        {
+            return NSMakeRange(start, i + 1 - start);
+        }
+    }
+    return NSMakeRange(start, length - start);
+}
+
