+/* An operation whose main RAISES never reaches its isFinished, so it stays executing forever and
+ * everything that depends on it waits: a library that says Updating... and never stops looks
+ * exactly like that (#194). Bounded, and off unless asked for. */
+static BOOL _CiderTraceOps(void)
+{
+    static int cached = -1;
+    if (cached < 0)
+    {
+        const char *value = getenv("CIDER_TRACE_OPS");
+        cached = (value != NULL && strcmp(value, "0") != 0) ? 1 : 0;
+    }
+    return cached == 1;
+}
+
+static void _CiderOp(const char *what, id operation, const char *extra)
+{
+    static int printed;
+    if (!_CiderTraceOps() || printed++ > 400)
+        return;
+    fprintf(stderr, "CIDER_OP %s %s %s\n", what,
+            operation ? class_getName(object_getClass(operation)) : "(nil)", extra ?: "");
+}
 
