 NSString *const NSInvalidUnarchiveOperationException = @"NSInvalidUnarchiveOperationException";
 
+/* A SUBCLASS OF AN ALLOWED CLASS IS ALLOWED, which containsObject: alone does not say. An archive
+ * naming NSMutableArray decodes against an allowed NSArray on Darwin, and every such archive was
+ * rejected here. */
+static BOOL classIsAllowed(Class class, NSSet *allowed)
+{
+    if ([allowed containsObject:class])
+    {
+        return YES;
+    }
+    for (Class candidate in allowed)
+    {
+        if ([class isSubclassOfClass:candidate])
+        {
+            return YES;
+        }
+    }
+    return NO;
+}
