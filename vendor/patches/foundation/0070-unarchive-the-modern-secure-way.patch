+/* THE MODERN FORM ANSWERS AN ERROR WHERE THE OLD ONE RAISES, and secure coding is on for it
+ * whether or not the caller says so. Nothing implemented either of these, so iA Writer's library
+ * indexer died on an unrecognized selector (#194). */
++ (id)unarchivedObjectOfClasses:(NSSet *)classes fromData:(NSData *)data error:(NSError **)outError
+{
+    id object = nil;
+    NSError *failure = nil;
+
+    @autoreleasepool {
+        NSKeyedUnarchiver *unarchiver = nil;
+        @try {
+            NSError *openError = nil;
+            unarchiver = [[NSKeyedUnarchiver alloc] initForReadingFromData:data error:&openError];
+            failure = [openError retain];
+            if (unarchiver != nil && failure == nil)
+            {
+                [unarchiver setRequiresSecureCoding:YES];
+                object = [[unarchiver decodeObjectOfClasses:classes forKey:@"root"] retain];
+                [unarchiver finishDecoding];
+            }
+        } @catch (NSException *exception) {
+            [object release];
+            object = nil;
+            [failure release];
+            failure = [[NSError alloc] initWithDomain:NSCocoaErrorDomain
+                                                 code:NSCoderReadCorruptError
+                                             userInfo:@{NSDebugDescriptionErrorKey:
+                                                            [exception reason] ?: [exception name]}];
+        }
+        [unarchiver release];
+    }
+
+    if (outError != NULL)
+    {
+        *outError = [failure autorelease];
+    }
+    else
+    {
+        [failure release];
+    }
+    return [object autorelease];
+}
+
++ (id)unarchivedObjectOfClass:(Class)cls fromData:(NSData *)data error:(NSError **)outError
+{
+    return [self unarchivedObjectOfClasses:(cls != Nil ? [NSSet setWithObject:cls] : nil)
+                                  fromData:data
+                                     error:outError];
+}
