 #import "ForFoundationOnly.h"
 #import <dispatch/dispatch.h>
 #import <objc/runtime.h>
+#import <string.h>
 #import <stdlib.h>
 
 static NSMutableDictionary *archiverClasses = nil;
 
 NSString *const NSInvalidUnarchiveOperationException = @"NSInvalidUnarchiveOperationException";
 
+/* THE ARCHIVE CARRIES THE WHOLE CHAIN, and $classes is what it is for.
+ *
+ * A Swift Dictionary bridged into an archive names _TtGCs26_SwiftDeferredNSDictionarySSP__, a
+ * generic specialisation the ObjC runtime cannot look up here, and the object was DROPPED: one
+ * NSLog saying class not found and nil where a dictionary should have been. $classes lists the
+ * class and its ancestors precisely so a reader that lacks the leaf can decode it as one of them,
+ * and for a bridged collection the ancestor IS the payload. Darwin raises here instead, because
+ * Darwin always has the leaf.
+ *
+ * A CLASS THE SWIFT RUNTIME IMPLEMENTS IS SKIPPED, and that rule is the third attempt at this
+ * chain, which is
+ *
+ *   _TtGCs26_SwiftDeferredNSDictionarySSP__, Swift.__SwiftNativeNSDictionary,
+ *   __SwiftNativeNSDictionaryBase, NSDictionary
+ *
+ * Both middle names RESOLVE. They are abstract bases in libswiftCore that work only on an instance
+ * the Swift runtime built, and decoding into either replaced a silent nil with
+ * "count requires a subclass implementation" and killed the process. Skipping them BY NAME took two
+ * tries and would have taken more, because the names do not share a prefix. The image does: ask
+ * class_getImageName, which says exactly the thing that matters, that the implementation is the
+ * Swift runtime's. An application's own Swift classes live in its own binary and are unaffected. */
+static Class classFromArchivedNames(NSKeyedUnarchiver *unarchiver, NSArray *names)
+{
+    if (![names isKindOfClass:[NSArray class]])
+    {
+        return Nil;
+    }
+    for (id name in names)
+    {
+        Class candidate;
+
+        if (![name isKindOfClass:[NSString class]])
+        {
+            continue;
+        }
+        candidate = [unarchiver classForClassName:name];
+        if (candidate == Nil)
+        {
+            candidate = [[unarchiver class] classForClassName:name];
+        }
+        if (candidate == Nil)
+        {
+            candidate = NSClassFromString(name);
+        }
+        if (candidate != Nil)
+        {
+            const char *image = class_getImageName(candidate);
+
+            if (image != NULL && strstr(image, "libswift") != NULL)
+            {
+                continue;
+            }
+            return candidate;
+        }
+    }
+    return Nil;
+}
