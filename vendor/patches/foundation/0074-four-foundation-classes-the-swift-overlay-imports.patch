+
+#import <Foundation/NSOrderedCollectionDifference.h>
+#import <Foundation/NSArray.h>
+#import <Foundation/NSIndexSet.h>
+
+@implementation NSOrderedCollectionDifference {
+	NSArray *_insertions;
+	NSArray *_removals;
+	/* Removals first, then insertions, which is the order the changes must be APPLIED in and so
+	 * the order fast enumeration yields. Kept whole rather than concatenated on demand so an
+	 * enumeration does not allocate. */
+	NSArray *_all;
+}
+
+- (instancetype)initWithChanges:(NSArray *)changes
+{
+	self = [super init];
+	if (self == nil)
+		return nil;
+
+	NSMutableArray *insertions = [[NSMutableArray alloc] init];
+	NSMutableArray *removals = [[NSMutableArray alloc] init];
+
+	for (NSOrderedCollectionChange *change in changes) {
+		if ([change changeType] == NSCollectionChangeInsert)
+			[insertions addObject:change];
+		else
+			[removals addObject:change];
+	}
+
+	_insertions = insertions;
+	_removals = removals;
+	_all = [[removals arrayByAddingObjectsFromArray:insertions] retain];
+	return self;
+}
+
+- (instancetype)initWithInsertIndexes:(NSIndexSet *)inserts
+                      insertedObjects:(NSArray *)insertedObjects
+                        removeIndexes:(NSIndexSet *)removes
+                       removedObjects:(NSArray *)removedObjects
+{
+	NSMutableArray *changes = [[NSMutableArray alloc] init];
+	__block NSUInteger slot = 0;
+
+	[removes enumerateIndexesUsingBlock:^(NSUInteger index, BOOL *stop) {
+		id object = slot < [removedObjects count] ? [removedObjects objectAtIndex:slot] : nil;
+		[changes addObject:[NSOrderedCollectionChange changeWithObject:object
+		                                                         type:NSCollectionChangeRemove
+		                                                        index:index]];
+		slot++;
+	}];
+
+	slot = 0;
+	[inserts enumerateIndexesUsingBlock:^(NSUInteger index, BOOL *stop) {
+		id object = slot < [insertedObjects count] ? [insertedObjects objectAtIndex:slot] : nil;
+		[changes addObject:[NSOrderedCollectionChange changeWithObject:object
+		                                                         type:NSCollectionChangeInsert
+		                                                        index:index]];
+		slot++;
+	}];
+
+	self = [self initWithChanges:changes];
+	[changes release];
+	return self;
+}
+
+- (void)dealloc
+{
+	[_insertions release];
+	[_removals release];
+	[_all release];
+	[super dealloc];
+}
+
+- (NSArray *)insertions
+{
+	return _insertions;
+}
+
+- (NSArray *)removals
+{
+	return _removals;
+}
+
+- (BOOL)hasChanges
+{
+	return [_all count] > 0;
+}
+
+- (NSUInteger)countByEnumeratingWithState:(NSFastEnumerationState *)state
+                                  objects:(id *)buffer
+                                    count:(NSUInteger)len
+{
+	return [_all countByEnumeratingWithState:state objects:buffer count:len];
+}
+
+@end
