+
+/* Type encodings, class names and C strings all share one table: "@" is written once per archive. */
+- (void)cider_writeSharedString:(const char *)string
+{
+    CiderArchiverContext *context = [self cider_context];
+    if (string == NULL || context == NULL)
+    {
+        [self cider_writeChar:NullLabel];
+        return;
+    }
+
+    NSString *key = [[NSString alloc] initWithUTF8String:string];
+    NSNumber *existing = [context->stringIndexes objectForKey:key];
+    if (existing != nil)
+    {
+        [self cider_writeInt:UNBIAS([existing intValue])];
+        [key release];
+        return;
+    }
+
+    [self cider_writeChar:NewLabel];
+    [self cider_writeCharsAsString:string];
+
+    NSUInteger index = [context->sharedStrings count];
+    [context->sharedStrings addObject:key];
+    [context->stringIndexes setObject:[NSNumber numberWithUnsignedInteger:index] forKey:key];
+    [key release];
+}
