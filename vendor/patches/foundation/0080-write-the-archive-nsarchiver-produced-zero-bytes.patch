+static unsigned int ciderRoundUp(unsigned int size, unsigned int align)
+{
+    return ((size + align - 1) / align) * align;
+}
+
+static const char *ciderSkipStructName(const char *str)
+{
+    const char *type = str;
+
+    while (TRUE)
+    {
+        switch (*type++)
+        {
+            case '=':
+                return type;
+            case '}':
+            case '{':
+            case ')':
+            case '(':
+            case 0:
+                return str;
+        }
+    }
+}
+
+/* Stops after the FIRST type it finds, which is what walking a struct encoding needs. */
+static const char *ciderSizeofType(const char *type, unsigned int *size, unsigned int *align)
+{
+    char c = *type++;
+
+#define simpleCase(cc, ctype) case cc: *size = sizeof(ctype); *align = __alignof(ctype); break
+
+    switch (c)
+    {
+        simpleCase('c', char);
+        simpleCase('C', char);
+        simpleCase('s', short);
+        simpleCase('S', short);
+        simpleCase('i', int);
+        simpleCase('I', int);
+        simpleCase('!', int);
+        simpleCase('l', int);
+        simpleCase('L', int);
+        simpleCase('f', float);
+        simpleCase('d', double);
+        simpleCase('@', id);
+        simpleCase('*', char *);
+        simpleCase('%', char *);
+        simpleCase(':', SEL);
+        simpleCase('#', Class);
+        case '[':
+        {
+            unsigned int count = 0;
+            unsigned int s, a;
+
+            while ('0' <= *type && *type <= '9')
+                count = 10 * count + (*type++ - '0');
+
+            type = ciderSizeofType(type, &s, &a);
+
+            *size = count * ciderRoundUp(s, a);
+            *align = a;
+
+            c = *type++;
+            if (c != ']')
+                [NSException raise:NSInvalidArgumentException format:@"Invalid char found in array encoding, expected ], found %c", c];
+            break;
+        }
+        case '(':
+        {
+            unsigned int unionSize = 0;
+            unsigned int unionAlign = 1;
 
+            type = ciderSkipStructName(type);
+
+            while (*type != ')')
+            {
+                unsigned int s, a;
+
+                type = ciderSizeofType(type, &s, &a);
+                if (s > unionSize)
+                    unionSize = s;
+                if (a > unionAlign)
+                    unionAlign = a;
+            }
+
+            *size = ciderRoundUp(unionSize, unionAlign);
+            *align = unionAlign;
+            break;
+        }
+        case '{':
+        {
+            unsigned int structSize = 0;
+            unsigned int structAlign = 1;
+
+            type = ciderSkipStructName(type);
+
+            while (*type != '}')
+            {
+                unsigned int s, a;
+
+                type = ciderSizeofType(type, &s, &a);
+                structSize = ciderRoundUp(structSize, a);
+                structSize += s;
+                if (a > structAlign)
+                    structAlign = a;
+            }
+
+            *size = ciderRoundUp(structSize, structAlign);
+            *align = structAlign;
+            break;
+        }
+        default:
+            *size = 0;
+            *align = 1;
+            break;
+    }
+
+#undef simpleCase
+    return type;
+}
 
