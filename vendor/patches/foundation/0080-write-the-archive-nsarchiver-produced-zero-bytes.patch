+static signed char const Long2Label       = -127;
+static signed char const Long4Label       = -126;
+static signed char const RealLabel        = -125;
+static signed char const NewLabel         = -124;
+static signed char const NullLabel        = -123;
+static signed char const EndOfObjectLabel = -122;
+static signed char const SmallestLabel    = -110;
+
+/* Biased so every reference lands above the six labels and cannot be mistaken for one. */
+#define UNBIAS(index) ((int) ((index) + SmallestLabel))
+
+/*
+ * Carried behind the `ids` ivar rather than in new ones: NSArchiver.h is public and an application
+ * may subclass it, so changing the ivar layout moves where a subclass's own ivars land.
+ */
+typedef struct {
+    /* The shared STRING table is a list indexed by order of first appearance. */
+    NSMutableArray *sharedStrings;
+    NSMutableDictionary *stringIndexes;
+    /*
+     * A separate counter, which objects AND classes draw from. Keyed by IDENTITY, not -isEqual:,
+     * because identity is what the reader reproduces.
+     */
+    CFMutableDictionaryRef objectLabels;
+    int objectCounter;
+} CiderArchiverContext;
 
