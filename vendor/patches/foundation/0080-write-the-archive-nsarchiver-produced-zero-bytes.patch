+
+/*
+ * A bare byte only for a value the reader cannot confuse with a label. finishDecodeInt: would
+ * accept -125 through -122 as plain values, but every caller that matters checks for those labels
+ * BEFORE calling it, so writing one bare would be read as RealLabel or NewLabel by the caller above.
+ */
+- (void)cider_writeInt:(int)value
+{
+    if (value >= SmallestLabel && value <= 127)
+    {
+        [self cider_writeChar:(signed char)value];
+    }
+    else if (value >= -32768 && value <= 32767)
+    {
+        short small = (short)value;
+        [self cider_writeChar:Long2Label];
+        [self cider_writeBytes:&small length:2];
+    }
+    else
+    {
+        [self cider_writeChar:Long4Label];
+        [self cider_writeBytes:&value length:4];
+    }
+}
+
+- (void)cider_writeShort:(short)value
+{
+    if (value >= SmallestLabel && value <= 127)
+        [self cider_writeChar:(signed char)value];
+    else
+    {
+        [self cider_writeChar:Long2Label];
+        [self cider_writeBytes:&value length:2];
+    }
+}
+
+- (void)cider_writeFloat:(float)value
+{
+    [self cider_writeChar:RealLabel];
+    [self cider_writeBytes:&value length:sizeof(float)];
+}
+
+- (void)cider_writeDouble:(double)value
+{
+    [self cider_writeChar:RealLabel];
+    [self cider_writeBytes:&value length:sizeof(double)];
+}
+
+/* Length then ASCII bytes, no terminator. decodeCharsAsString: rejects a length of 0. */
+- (void)cider_writeCharsAsString:(const char *)string
+{
+    if (string == NULL)
+    {
+        [self cider_writeChar:NullLabel];
+        return;
+    }
+    int length = (int)strlen(string);
+    [self cider_writeInt:length];
+    [self cider_writeBytes:string length:length];
