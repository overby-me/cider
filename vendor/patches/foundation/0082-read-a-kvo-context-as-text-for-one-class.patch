+        if (want != NULL && want[0] != (char) 0 && context != NULL &&
+            strstr(object_getClassName(observer), want) != NULL) {
+            fprintf(stderr, "CIDER_KVO   context %p is %s text=%s\n", context,
+                    object_getClassName((id) context), _CiderKVOText((id) context));
+        }
