+    _priority = NSLayoutPriorityRequired;
+    _relation = NSLayoutRelationEqual;
+    _multiplier = 1.0;
+
+    if ([coder allowsKeyedCoding]) {
+        NSKeyedUnarchiver *keyed = (NSKeyedUnarchiver *) coder;
