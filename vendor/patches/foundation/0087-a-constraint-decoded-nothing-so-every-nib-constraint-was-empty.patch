+        _firstItem = [keyed decodeObjectForKey: @"NSFirstItem"];
+        _secondItem = [keyed decodeObjectForKey: @"NSSecondItem"];
+
+        if ([keyed containsValueForKey: @"NSFirstAttributeV2"])
+            _firstAttribute = [keyed decodeIntegerForKey: @"NSFirstAttributeV2"];
+        else if ([keyed containsValueForKey: @"NSFirstAttribute"])
+            _firstAttribute = [keyed decodeIntegerForKey: @"NSFirstAttribute"];
+
+        if ([keyed containsValueForKey: @"NSSecondAttributeV2"])
+            _secondAttribute = [keyed decodeIntegerForKey: @"NSSecondAttributeV2"];
+        else if ([keyed containsValueForKey: @"NSSecondAttribute"])
+            _secondAttribute = [keyed decodeIntegerForKey: @"NSSecondAttribute"];
+
+        if ([keyed containsValueForKey: @"NSConstantV2"])
+            _constant = [keyed decodeDoubleForKey: @"NSConstantV2"];
+        else if ([keyed containsValueForKey: @"NSConstant"])
+            _constant = [keyed decodeDoubleForKey: @"NSConstant"];
+
+        if ([keyed containsValueForKey: @"NSRelation"])
+            _relation = [keyed decodeIntegerForKey: @"NSRelation"];
+        if ([keyed containsValueForKey: @"NSMultiplier"])
+            _multiplier = [keyed decodeDoubleForKey: @"NSMultiplier"];
+        if ([keyed containsValueForKey: @"NSPriority"])
+            _priority = (float) [keyed decodeDoubleForKey: @"NSPriority"];
     }
