 }
+
+/*
+ * THE SINGULAR LOOKUP, WHICH WAS A STUB WHILE THE PLURAL WORKED. IOServiceGetMatchingService is
+ * how IOSurface finds IOSurfaceRoot, and a stub returning KERN_NOT_SUPPORTED meant every
+ * IOSurfaceCreate in the system failed while iokitd sat here running: Qt retains the resulting
+ * NULL surface unchecked and CMake.app died in CFRetain. Task #227.
+ *
+ * The unserializer is chosen by CONTENT, not by which wire form arrived: the client picks the
+ * form by SIZE (inband when the dictionary is small, ool otherwise) and the encoding by its own
+ * option flags, so either form can carry either encoding. Binary first, because that is what
+ * IOKitLib sends by default under Darling.
+ */
+static CFTypeRef unserializeMatching(const char* data, size_t length)
+{
+	CFTypeRef criteria = IOCFUnserializeBinary(data, length, nullptr, 0, nullptr);
+	if (!criteria)
+		criteria = IOCFUnserializeWithSize(data, length, nullptr, 0, nullptr);
+	return criteria;
+}
+
+static kern_return_t firstMatchingPort(const char* data, size_t length, mach_port_t* service)
+{
+	CFTypeRef criteria = unserializeMatching(data, length);
+
+	if (!criteria)
+	{
+		os_log_error(OS_LOG_DEFAULT, "io_service_get_matching_service: cannot parse matching dictionary");
+		return kIOReturnBadArgument;
+	}
+	if (CFGetTypeID(criteria) != CFDictionaryGetTypeID())
+	{
+		CFRelease(criteria);
+		return kIOReturnBadArgument;
+	}
+
+	IOService* found = ServiceRegistry::instance()->firstMatchingService((NSDictionary*) criteria);
+	CFRelease(criteria);
+
+	if (!found)
+	{
+		/* Success with a null port is the answer for NO MATCH, mirroring what the client already
+		 * treats as absence; an error here is indistinguishable from a broken transport. */
+		*service = MACH_PORT_NULL;
+		return kIOReturnSuccess;
+	}
+
+	/* One send right for the client. A registered service keeps the right its constructor made,
+	 * so no-senders cannot destroy it underneath the registry. */
+	found->retain();
+	*service = found->port();
+	return kIOReturnSuccess;
+}
+
+kern_return_t is_io_service_get_matching_service
+(
+	mach_port_t master_port,
+	io_string_t matching,
+	mach_port_t *service
+)
+{
+	return firstMatchingPort(matching, strlen(matching), service);
+}
+
+kern_return_t is_io_service_get_matching_service_bin
+(
+	mach_port_t master_port,
+	io_struct_inband_t matching,
+	mach_msg_type_number_t matchingCnt,
+	mach_port_t *service
+)
+{
+	return firstMatchingPort(matching, matchingCnt, service);
+}
+
+kern_return_t is_io_service_get_matching_service_ool
+(
+	mach_port_t master_port,
+	io_buf_ptr_t matching,
+	mach_msg_type_number_t matchingCnt,
+	kern_return_t *result,
+	mach_port_t *service
+)
+{
+	*result = firstMatchingPort(matching, matchingCnt, service);
+	return KERN_SUCCESS;
+}
