--- a/src/common/map.c
+++ b/src/common/map.c
@@ -18,6 +18,22 @@
 
 struct map {
     size_t len;
+    /*
+     * ONE PAST THE HIGHEST INDEX EVER INSERTED, so that walking the map does not mean walking the
+     * file descriptor limit.
+     *
+     * The map is a flat array indexed by descriptor, created with the process HARD limit, which on
+     * this system is 524287 slots. map_foreach walked all of them, and it is called from
+     * kqueue_closed_fd on EVERY close(2): four megabytes scanned to find the handful of kqueues an
+     * application actually has. Measured on a LibreOffice text to PDF conversion, map_foreach was
+     * 15.47 percent of the entire run, second only to memmove, and every one of its callers was a
+     * close: fclose, opendir, the bootstrap reader, the file access layer, Python.
+     *
+     * It only ever grows. A walk that races an insert into a higher slot would have missed that
+     * entry anyway, because map_foreach walks in index order and an insert behind its cursor is
+     * missed with or without this.
+     */
+    size_t high;
     void **data;
 };
 
@@ -47,10 +63,27 @@
     }
     dst->len = len;
 #endif
+    dst->high = 0;
 
     return (dst);
 }
 
+/* Raise the high water mark to cover idx, without a lock. */
+static void
+map_note_index(struct map *m, int idx)
+{
+    size_t want = (size_t) idx + 1;
+    size_t seen;
+
+    for (;;) {
+        seen = m->high;
+        if (seen >= want)
+            return;
+        if (__sync_val_compare_and_swap(&m->high, seen, want) == seen)
+            return;
+    }
+}
+
 int
 map_insert(struct map *m, int idx, void *ptr)
 {
@@ -58,6 +91,7 @@
            return (-1);
 
     if (atomic_ptr_cas(&(m->data[idx]), 0, ptr) == NULL) {
+        map_note_index(m, idx);
         dbg_printf("inserted %p in location %d", ptr, idx);
         return (0);
     } else {
@@ -93,6 +127,10 @@
 
     tmp = atomic_ptr_cas(&(m->data[idx]), oldp, newp);
     if (tmp == oldp) {
+        /* A replace can put a value in a slot that map_insert never touched, so the high water mark
+         * has to move here as well or that slot would be walked past. */
+        if (newp != NULL)
+            map_note_index(m, idx);
         dbg_printf("replaced value %p in location %d with value %p",
                 oldp, idx, newp);
