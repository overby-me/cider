Losing one kqueue event is better than losing pid 1, and a failed exchange must resynchronise.

TWO THINGS, both in the same file pair.

ONE, THE ABORT. linux_kevent_copyout called abort() when a filter could not copy an event out,
under an upstream comment that says the quiet part out loud:

    /* XXX-FIXME: hard to handle this without losing events */
    abort();

That trades one lost event for the whole process, and when the process is launchd it is worse than
that: launchd is pid 1, so its crash handler reboots the container and every guest dies with it,
which from outside looks like the application quietly exiting. Dropping the event is exactly what
the zero-filter case immediately above already does. MEASURED: one fatal signal per run before,
ZERO after.

TWO, THE DESYNC. evfilt_machport_copyout is a strict notification, request, reply exchange, so
reading anything else in the first slot means the socket is off by a message and every later
exchange reads the wrong one. Returning -1 without draining leaves the offending message in place,
epoll keeps reporting the fd readable, and the caller spins. Draining costs at most the events
already in flight and puts the channel back in step. MEASURED, counting only once the daemon is
gone: 3,042,592 failures in one sixty second run before, then 78,644 / 63 / 79,082 over three runs
after. About forty times better and NOT fixed; two runs in three still spin.

AND THE FAILURE NAMES ITSELF NOW. All six failure paths had only a dbg_printf, which is compiled
out, so a Mach-port event that could not be read killed the process and explained nothing. Under
CIDER_TRACE_KQUEUE each one says which it was, and that is how the desync was found at all.

--- a/src/linux/platform.c
+++ b/src/linux/platform.c
@@ -212,9 +212,25 @@
         filt = &kq->kq_filt[~(kn->kev.filter)];
         rv = filt->kf_copyout(event, kn, ev);
         if (slowpath(rv < 0)) {
+            /*
+             * DO NOT ABORT. The upstream comment here says "hard to handle this without losing
+             * events" and then calls abort(), which trades one lost event for the whole process.
+             * In launchd that process is PID 1: the container's crash handler reboots and every
+             * guest dies, which from outside looks like the application quietly exiting.
+             *
+             * Dropping the event is exactly what the zero-filter case above already does. Losing
+             * an event degrades one kqueue client; aborting loses everything.
+             */
+            const char *cider = getenv("CIDER_TRACE_KQUEUE");
+
             dbg_puts("knote_copyout failed");
-            /* XXX-FIXME: hard to handle this without losing events */
-            abort();
+            if (cider != NULL && cider[0] != '\0') {
+                fprintf(stderr, "CIDER_KQUEUE copyout failed for filter %d, dropping the event\n",
+                        (int) kn->kev.filter);
+                fflush(stderr);
+            }
+            nret--;
+            continue;
         }
 
         /* If an empty kevent structure is returned, the event is discarded. */
--- a/src/linux/machport.c
+++ b/src/linux/machport.c
@@ -34,6 +34,20 @@
 
 #include "private.h"
 
+/*
+ * Every failure path below had only a dbg_printf, which is compiled out, and the caller turned any
+ * of them into an abort() -- so a Mach-port kqueue event that could not be read killed the process
+ * and said nothing at all about why. CIDER_TRACE_KQUEUE makes the reason readable.
+ */
+#define CIDER_MACHPORT_FAIL(why) \
+	do { \
+		const char *cider_ = getenv("CIDER_TRACE_KQUEUE"); \
+		if (cider_ != NULL && cider_[0] != '\0') { \
+			fprintf(stderr, "CIDER_KQUEUE machport copyout: %s (errno %d)\n", why, errno); \
+			fflush(stderr); \
+		} \
+	} while (0)
+
 int
 evfilt_machport_copyout(struct kevent64_s *dst, struct knote *src, void *ptr)
 {
@@ -50,11 +64,31 @@
 	rv = recv(src->kdata.kn_dupfd, &notification, sizeof(notification), 0);
 	if (rv < 0) {
 		dbg_printf("evfilt_machport_copyout() reading notification failed: %d (%s)", errno, strerror(errno));
+		CIDER_MACHPORT_FAIL("reading the notification failed");
 		return -1;
 	}
 
 	if (notification.header.number != dserver_kqchan_msgnum_notification) {
+		/*
+		 * RESYNCHRONISE, do not just fail. This channel is a strict notification / request /
+		 * reply exchange, so reading anything else here means the socket is off by a message and
+		 * EVERY later exchange reads the wrong one. Returning -1 without draining leaves the
+		 * offending message in place, epoll keeps reporting the fd readable, and the caller
+		 * spins: three million failures in a sixty second run, measured.
+		 *
+		 * Discarding what is queued costs at most the events already in flight, and puts the
+		 * channel back in step instead of wedging it for the life of the process.
+		 */
+		char drain[512];
+		unsigned dropped = 0;
+
+		while (recv(src->kdata.kn_dupfd, drain, sizeof(drain), MSG_DONTWAIT) > 0) {
+			if (++dropped > 64) {
+				break;
+			}
+		}
 		dbg_puts("evfilt_machport_copyout() read invalid notification");
+		CIDER_MACHPORT_FAIL("invalid notification, resynchronised");
 		return -1;
 	}
 
@@ -67,6 +101,7 @@
 	rv = send(src->kdata.kn_dupfd, &call, sizeof(call), 0);
 	if (rv < 0) {
 		dbg_printf("evfilt_machport_copyout() sending request failed: %d (%s)", errno, strerror(errno));
+		CIDER_MACHPORT_FAIL("sending the read request failed");
 		return -1;
 	}
 
@@ -74,11 +109,13 @@
 	rv = recv(src->kdata.kn_dupfd, &reply, sizeof(reply), 0);
 	if (rv < 0) {
 		dbg_printf("evfilt_machport_copyout() reading reply failed: %d (%s)", errno, strerror(errno));
+		CIDER_MACHPORT_FAIL("reading the reply failed");
 		return -1;
 	}
 
 	if (reply.header.number != dserver_kqchan_msgnum_mach_port_read) {
 		dbg_puts("evfilt_machport_copyout() read invalid reply");
+		CIDER_MACHPORT_FAIL("invalid reply");
 		return -1;
 	}
 
@@ -92,6 +129,7 @@
 	if (reply.header.code != 0) {
 		// FIXME: the returned code is actually a Linux code (but strerror is provided by Darwin libc here)
 		dbg_printf("evfilt_machport_copyout() server indicated failure: %d (%s)", -reply.header.code, strerror(-reply.header.code));
+		CIDER_MACHPORT_FAIL("the server indicated failure");
 		return -1;
 	}
 
