+/* TEARDOWN MUST FREE THE KNOTES, and upstream's filter_unregister_all left that as an XXX-FIXME.
+ * A kqueue registration costs no descriptor on macOS; here every watched fd gets a private dup, so
+ * upstream's leak is memory and ours is a DESCRIPTOR. Leak the write end of a pipe and its reader
+ * never sees end of file: CMake registered filters on a child's pipe ends, closed that kqueue,
+ * and then waited forever for output that could not end. Task #235. */
+void
+knote_delete_all(struct filter *filt)
+{
+    for (;;) {
+        struct knote *kn;
+
+        pthread_rwlock_rdlock(&filt->kf_knote_mtx);
+        kn = RB_MIN(knt, &filt->kf_knote);
+        pthread_rwlock_unlock(&filt->kf_knote_mtx);
+
+        /* Stop on refusal rather than spinning: knote_delete only fails on a double delete, and a
+         * knote that will not leave the tree would loop here forever. */
+        if (kn == NULL || knote_delete(filt, kn) < 0)
+            return;
+    }
+}
+
 int
 knote_delete(struct filter *filt, struct knote *kn)
 {
