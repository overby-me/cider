trace platform semaphore lifetime, with a control for every probe

The cached path creates in libplatform, not libdispatch, so a trace there reported created=0
for a name that was plainly in use. Each field exists because the one before it was not enough,
and THREE of the probes needed controls of their own before anything could be concluded:

  refs      mod_refs(+1) then re-read, because a query that answers 1 for everything is not
            reading a counter. It is real: 1 becomes 3, and the task port reads 10
  kotype    mach_port_kobject answers 0 even for the HOST port, so it says nothing at all,
            and kohost in the same line is what shows that
  names     allocate a port, ask again, put it back. It sees the new port (found=1), so the
            count can be trusted -- as a count of THIS table, which is not the daemon's

--- a/src/os/semaphore.c
+++ b/src/os/semaphore.c
@@ -19,7 +19,11 @@
  */
 
 #include "os/internal.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <unistd.h>
 #include <mach/mach_init.h>
+#include <mach/mach_port.h>
 #include <mach/semaphore.h>
 #include <mach/task.h>
 #include <mach/thread_switch.h>
@@ -36,14 +40,120 @@
 		} \
 	} while (0)
 
+/* A TOTAL ORDER FOR THE TRACE. Several threads write these lines, so the order they appear in is
+ * not the order they happened; an atomic counter makes the sequence unambiguous. */
+static int _cider_sem_seq = 0;
+
 os_semaphore_t
 _os_semaphore_create(void)
 {
 	semaphore_t s4;
 	kern_return_t kr;
+	/* BEFORE AND AFTER, because a count on its own cannot say whether the create added an entry. */
+	mach_msg_type_number_t before = 0;
+	mach_port_name_array_t bn = NULL;
+	mach_port_type_array_t bt = NULL;
+	mach_msg_type_number_t btc = 0;
+	if (getenv("CIDER_TRACE_SEM")) {
+		mach_port_names(mach_task_self(), &bn, &before, &bt, &btc);
+	}
 	kr = semaphore_create(mach_task_self(), &s4, SYNC_POLICY_FIFO, 0);
 	OS_VERIFY_MIG(kr, "Allocating semaphore failed with MIG_REPLY_MISMATCH");
 	OS_SEMAPHORE_VERIFY_KR(kr, "Creating semaphore failed, possible port leak");
+	/* THE CACHED PATH CREATES HERE, not in libdispatch, which is why a trace there saw nothing.
+	 * CIDER_TRACE_SEM, off by default: this is a hot path. */
+	if (getenv("CIDER_TRACE_SEM")) {
+		/* refs SEPARATES THE TWO CAUSES of a repeated name. Mach gives one name per port, so if
+		 * the same port is copied out twice the name repeats with refs=2; a name allocator handing
+		 * out a name that is already in use repeats it with refs=1. */
+		mach_port_urefs_t refs = 0;
+		kern_return_t rkr = mach_port_get_refs(mach_task_self(), s4,
+		                                       MACH_PORT_RIGHT_SEND, &refs);
+		mach_port_t self = mach_thread_self();
+		/* THE REPLY PORT IS PER THREAD, in TSD. If two threads report the SAME one they can each
+		 * receive the other's reply, which is what a shared name would look like from up here. */
+		extern mach_port_t mig_get_reply_port(void);
+		mach_port_t reply = mig_get_reply_port();
+		/* HOW BIG THE NAMESPACE IS separates a wrong space from a broken free list: a real task's
+		 * space holds many names, so allocating a live one is a bug in the allocator; a space
+		 * holding one or two means the copyout went somewhere that is not the task's space. */
+		mach_port_name_array_t names = NULL;
+		mach_port_type_array_t types = NULL;
+		mach_msg_type_number_t ncount = 0, tcount = 0;
+		kern_return_t nkr = mach_port_names(mach_task_self(), &names, &ncount,
+		                                    &types, &tcount);
+		/* WAS THE NAME ALREADY THERE, and what is it? A name the task held BEFORE the call cannot
+		 * have been created by it, and the right type says whose it is: a receive right means the
+		 * task was handed the name of something it owns. */
+		/*
+		 * THE CONTROL FOR mach_port_names ITSELF, which every conclusion here rests on.
+		 *
+		 * Allocate a port, ask again, and put it back: a namespace query that cannot see a port this
+		 * thread just made cannot be trusted to say that semaphore_create made none.
+		 */
+		{
+			mach_port_t probe = MACH_PORT_NULL;
+			mach_port_name_array_t pn = NULL;
+			mach_port_type_array_t pt = NULL;
+			mach_msg_type_number_t pnc = 0, ptc = 0;
+			kern_return_t akr = mach_port_allocate(mach_task_self(),
+			                                       MACH_PORT_RIGHT_RECEIVE, &probe);
+			int found = 0;
+			mach_msg_type_number_t i;
+
+			if (akr == KERN_SUCCESS) {
+				mach_port_names(mach_task_self(), &pn, &pnc, &pt, &ptc);
+				for (i = 0; pn != NULL && i < pnc; i++) {
+					if (pn[i] == probe) { found = 1; break; }
+				}
+				fprintf(stderr, "CIDER_SEM control allocate name=%d names=%d->%d found=%d\n",
+				        (int) probe, (int) ncount, (int) pnc, found);
+				mach_port_mod_refs(mach_task_self(), probe, MACH_PORT_RIGHT_RECEIVE, -1);
+			} else {
+				fprintf(stderr, "CIDER_SEM control allocate FAILED kr=%d\n", (int) akr);
+			}
+			fflush(stderr);
+		}
+
+		/* THE CONTROL FOR refs. If the query answers 1 for a name whose count was just raised, it
+		 * is not reading a counter and nothing may be concluded from it. taskrefs is a second
+		 * control: the task port is held many times over, so a 1 there means the same. */
+		mach_port_urefs_t bumped = 0, taskrefs = 0;
+		mach_port_mod_refs(mach_task_self(), s4, MACH_PORT_RIGHT_SEND, 1);
+		mach_port_get_refs(mach_task_self(), s4, MACH_PORT_RIGHT_SEND, &bumped);
+		mach_port_mod_refs(mach_task_self(), s4, MACH_PORT_RIGHT_SEND, -1);
+		mach_port_get_refs(mach_task_self(), mach_task_self(), MACH_PORT_RIGHT_SEND, &taskrefs);
+
+		/* WHAT SITS BEHIND THE NAME. IKOT_SEMAPHORE means the port is a semaphore and the question
+		 * is why the same one; anything else names the port that was copied out by mistake. */
+		/* WHICH WELL-KNOWN PORT IS IT? The name is the same for every thread, so it is a port the
+		 * whole task shares. kohost is the control for kotype: the host port IS a kernel object, so
+		 * a 0 there means mach_port_kobject answers 0 for everything and says nothing. */
+		mach_port_t host = mach_host_self();
+		unsigned int kohost = 0;
+		mach_vm_address_t hoaddr = 0;
+		mach_port_kobject(mach_task_self(), host, &kohost, &hoaddr);
+		unsigned int kotype = 0;
+		mach_vm_address_t kaddr = 0;
+		mach_port_kobject(mach_task_self(), s4, &kotype, &kaddr);
+
+		int preexisting = 0, type = 0;
+		for (mach_msg_type_number_t i = 0; bn != NULL && i < before; i++) {
+			if (bn[i] == s4) {
+				preexisting = 1;
+				if (bt != NULL && i < btc) type = (int) bt[i];
+				break;
+			}
+		}
+		fprintf(stderr, "CIDER_SEM seq=%d pid=%d thread=%d platform created name=%d refs=%d rkr=%d "
+		                "names=%d->%d nkr=%d preexisting=%d type=0x%x bumped=%d taskrefs=%d kotype=%u host=%d kohost=%u task=%d reply=%d\n",
+		        __sync_fetch_and_add(&_cider_sem_seq, 1), (int)getpid(), (int)self,
+		        (int)s4, (int)refs, (int)rkr, (int)before, (int)ncount, (int)nkr,
+		        preexisting, type, (int)bumped, (int)taskrefs, kotype,
+		        (int)host, kohost, (int)mach_task_self(), (int)reply);
+		fflush(stderr);
+		mach_port_deallocate(mach_task_self(), self);
+	}
 	return (os_semaphore_t)s4;
 }
 
@@ -51,6 +161,13 @@
 _os_semaphore_dispose(os_semaphore_t sema)
 {
 	semaphore_t s4 = (semaphore_t)sema;
+	if (getenv("CIDER_TRACE_SEM")) {
+		mach_port_t self = mach_thread_self();
+		fprintf(stderr, "CIDER_SEM seq=%d pid=%d thread=%d platform destroying name=%d\n",
+		        __sync_fetch_and_add(&_cider_sem_seq, 1), (int)getpid(), (int)self, (int)s4);
+		fflush(stderr);
+		mach_port_deallocate(mach_task_self(), self);
+	}
 	kern_return_t kr = semaphore_destroy(mach_task_self(), s4);
 	OS_SEMAPHORE_VERIFY_KR(kr, "Destroying semaphore failed");
 }
