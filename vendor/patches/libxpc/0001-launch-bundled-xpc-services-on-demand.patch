+/*
+ * LAUNCH A BUNDLED XPC SERVICE ON DEMAND, which is the half of this that was missing.
+ *
+ * libxpc already DISCOVERS them: -[bundle resolve] walks Contents/XPCServices and builds a bundle
+ * for each .xpc it finds. Nothing ever started one. On macOS that is launchd's job, and our launchd
+ * has no notion of XPCServices at all, so a client connecting to a bundled service looked its name
+ * up, found nothing, and gave up silently.
+ *
+ * iTerm2 decodes inline images in exactly such a service, com.iterm2.sandboxed-worker, which is why
+ * imgcat drew nothing and said nothing.
+ *
+ * Spawning is all that is needed: xpc_main in the service reads its OWN bundle, checks the package
+ * type is XPC and takes CFBundleIdentifier as the name it checks in under, so there is no handshake
+ * to arrange and no environment to pass.
+ */
+static bool cider_spawn_bundled_service(const char* serviceName)
+{
+	XPC_CLASS(bundle)* mainBundle = [XPC_CLASS(bundle) mainBundle];
+	bool spawned = false;
+
+	if (!mainBundle || !serviceName) {
+		return false;
+	}
+
+	[mainBundle resolve];
+
+	for (XPC_CLASS(bundle)* service in ((struct xpc_bundle_s*)mainBundle)->services) {
+		XPC_CLASS(string)* identifier = [service.infoDictionary stringForKey: "CFBundleIdentifier"];
+
+		if (!identifier || strcmp(identifier.CString, serviceName) != 0) {
+			continue;
+		}
+
+		XPC_CLASS(string)* executable = service.executablePath;
+		if (!executable) {
+			break;
+		}
+
+		{
+			const char* path = executable.CString;
+			char* const argv[] = { (char*)path, NULL };
+			pid_t pid = 0;
+
+			if (posix_spawn(&pid, path, NULL, NULL, argv, *_NSGetEnviron()) == 0) {
+				spawned = true;
+			}
+			if (getenv("CIDER_TRACE_XPC") != NULL) {
+				fprintf(stderr, "CIDER_XPC %s bundled service %s at %s\n",
+					spawned ? "spawned" : "failed to spawn", serviceName, path);
+				fflush(stderr);
+			}
+		}
+		break;
+	}
+
+	return spawned;
+}
