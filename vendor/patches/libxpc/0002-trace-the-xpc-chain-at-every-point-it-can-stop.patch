+/*
+ * Two points on the service side, so a bundled XPC service that answers nothing can say how far it
+ * got. See the note in Foundation NSXPCConnection.m for the whole chain; these are the first two
+ * links, and they double as PROOF THAT THE SERVICE CAN SPEAK AT ALL. A spawned service inherits
+ * stderr from the application, and until one of these lines appears, silence from the worker is not
+ * evidence of anything.
+ *
+ * Empty means off: a gate written as getenv() != NULL treats a variable that is set but empty as on.
+ */
+static bool cider_trace_xpc(void) {
+	const char* value = getenv("CIDER_TRACE_XPC");
+
+	return value != NULL && value[0] != '\0';
+}
 
