 				if (header->msgh_id != XPC_MSGH_ID_CHECKIN) {
+					/*
+					 * A LISTENER DROPS ANYTHING THAT IS NOT A CHECK-IN, and says so only through
+					 * xpc_log_fault, which goes to syslog -- and there is no syslog socket here.
+					 * So a client whose first message is not a check-in waits forever while the
+					 * server silently throws it away, which is indistinguishable from a daemon
+					 * that is not running at all.
+					 */
+					if (getenv("CIDER_TRACE_XPC") != NULL) {
+						fprintf(stderr, "CIDER_XPC listener %s DROPPED a non-checkin message, id=0x%x\n",
+						        this->service_name ? this->service_name : "(anonymous)",
+						        (unsigned) header->msgh_id);
+						fflush(stderr);
+					}
 					xpc_log_fault(connection, "server connection received non-checkin message");
 					mach_msg_destroy(header);
 					return;
