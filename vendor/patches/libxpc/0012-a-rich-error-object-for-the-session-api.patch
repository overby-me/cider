+
+#import <xpc/objects/rich_error.h>
+#import <xpc/util.h>
+#import <xpc/xpc.h>
+
+/*
+ * THE ERROR OBJECT THE SESSION API HANDS BACK, and NOTHING IN THIS LIBRARY MAKES ONE YET.
+ *
+ * xpc_rich_error_t arrived with xpc_session_* in macOS 12, as the replacement for reading a
+ * description out of an error dictionary. This library stops at xpc_connection_*, so the only way
+ * a caller can hold one is to have been given it by a session, and there are no sessions here.
+ *
+ * It is a real object rather than a typedef because the caller of the two functions below owns what
+ * it gets back and the ownership rules differ: copy_description returns memory the CALLER frees,
+ * and can_retry answers a question about the error rather than about the call. A typedef would
+ * compile and then be wrong in a way nothing reports.
+ */
+
+XPC_CLASS_SYMBOL_DECL(rich_error);
+
+OS_OBJECT_NONLAZY_CLASS
+@implementation XPC_CLASS(rich_error)
+
+XPC_CLASS_HEADER(rich_error);
+
++ (instancetype)richErrorWithDescription: (const char*)description canRetry: (BOOL)canRetry
+{
+	return [[[[self class] alloc] initWithDescription: description canRetry: canRetry] autorelease];
+}
+
+- (instancetype)initWithDescription: (const char*)description canRetry: (BOOL)canRetry
+{
+	if (self = [super init]) {
+		XPC_THIS_DECL(rich_error);
+		this->description = description ? strdup(description) : NULL;
+		this->freeDescriptionWhenDone = description != NULL;
+		this->canRetry = canRetry;
+	}
+	return self;
+}
+
+- (void)dealloc
+{
+	XPC_THIS_DECL(rich_error);
+	if (this->freeDescriptionWhenDone && this->description) {
+		free((void*)this->description);
+	}
+	[super dealloc];
+}
+
+- (const char*)errorDescription
+{
+	XPC_THIS_DECL(rich_error);
+	return this->description;
+}
+
+- (BOOL)canRetry
+{
+	XPC_THIS_DECL(rich_error);
+	return this->canRetry;
+}
+
+- (char*)xpcDescription
+{
+	XPC_THIS_DECL(rich_error);
+	char* output = NULL;
+	asprintf(&output, "<%s: %s>", xpc_class_name(self), this->description ?: "(no description)");
+	return output;
+}
+
+@end
+
+//
+// C API
+//
+
+XPC_EXPORT
+char* xpc_rich_error_copy_description(xpc_rich_error_t xrerror) {
+	XPC_CLASS(rich_error)* error = XPC_CAST(rich_error, xrerror);
+	const char* description = error ? error.errorDescription : NULL;
+
+	/* THE CALLER FREES THIS, which is why it is strdup'd rather than handed out. A NULL return
+	 * would be a second thing every caller has to test for, and free(NULL) is fine, so an empty
+	 * string is the answer that keeps the contract in one shape. */
+	return strdup(description ?: "");
+};
+
+XPC_EXPORT
+bool xpc_rich_error_can_retry(xpc_rich_error_t xrerror) {
+	XPC_CLASS(rich_error)* error = XPC_CAST(rich_error, xrerror);
+	return error ? (error.canRetry != NO) : false;
+};
