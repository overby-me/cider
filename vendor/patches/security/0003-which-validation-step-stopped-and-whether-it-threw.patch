+/*
+ * CIDER_TRACE_SECITEM: which step of a static validation never came back.
+ *
+ * SecStaticCodeCheckValidity has already been shown to enter this and never return, while the
+ * application it belongs to keeps animating a spinner, so the caller looks merely slow. These are
+ * the steps it is made of; a step with a call line and no back line IS the answer.
+ */
+static bool CiderTraceSecItem(void) {
+	/* Non-EMPTY: our drivers export switches unset-as-empty. */
+	const char *v = getenv("CIDER_TRACE_SECITEM");
+	return v != NULL && v[0] != '\0';
+}
+
+#define CIDER_CSSTEP(fmt, ...) \
+	do { if (CiderTraceSecItem()) { fprintf(stderr, "CIDER_CSSTEP " fmt "\n", ##__VA_ARGS__); fflush(stderr); } } while (0)
