 #include "reqinterp.h"
+#include <stdio.h>
+#include <stdlib.h>
 #include "codesigning_dtrace.h"
 #include <Security/SecTrustSettingsPriv.h>
 #include <Security/SecCertificatePriv.h>
@@ -354,11 +356,53 @@
 
 //
 // Check the Apple-signed condition
+/*
+ * WHY A REQUIREMENT THAT PARSES DOES NOT MATCH.
+ *
+ * Now that the parser is reachable, requirements COMPILE and then evaluate to false: two nested
+ * components of MoneyMoney fail their designated requirement, and isAppleDeveloperCert returns false
+ * for a Developer ID application whose chain plainly ends at an Apple root.
+ *
+ * anchor apple generic is just isAppleCA on the LAST certificate of the chain, and the chain handed
+ * to the evaluator comes from the CMS signature rather than from a verified trust evaluation. Saying
+ * how many certificates there are and what the anchor test said separates "the chain is wrong" from
+ * "the anchor table is empty".
+ */
+static bool CiderTraceSecItem(void) {
+	const char *v = getenv("CIDER_TRACE_SECITEM");
+	return v != NULL && v[0] != '\0';
+}
+
+#define CIDER_REQEVAL(...) do { \
+	if (CiderTraceSecItem()) { fprintf(stderr, "CIDER_REQEVAL " __VA_ARGS__); fputc('\n', stderr); fflush(stderr); } \
+} while (0)
+
 //
 bool Requirement::Interpreter::appleAnchored()
 {
-	if (SecCertificateRef cert = mContext->cert(anchorCert))
-		if (isAppleCA(cert))
+	SecCertificateRef cert = mContext->cert(anchorCert);
+	bool apple = cert ? isAppleCA(cert) : false;
+
+	if (CiderTraceSecItem()) {
+		/* WHICH certificate is being treated as the anchor. anchorCert is the LAST entry of the
+		 * chain, and the chain here is a copy of the CMS certificate SET, which is unordered -- a
+		 * real trust evaluation is what puts leaf first and root last. If the subject printed is not
+		 * a root, the anchor test is being asked about the wrong certificate. */
+		CFStringRef sub = cert ? SecCertificateCopySubjectSummary(cert) : NULL;
+		std::string subject = sub ? cfString(sub) : "(none)";
+		if (sub) CFRelease(sub);
+		CIDER_REQEVAL("anchor apple generic: chain has %d, anchor subject=%s isAppleCA=%d",
+		              (int) mContext->certCount(), subject.c_str(), apple ? 1 : 0);
+		/* The WHOLE chain in order, because "the anchor is wrong" and "the chain is unordered" look
+		 * identical when only the last entry is printed. */
+		for (unsigned int ix = 0; ix < mContext->certCount(); ix++) {
+			SecCertificateRef c = mContext->cert((int) ix);
+			CFStringRef s = c ? SecCertificateCopySubjectSummary(c) : NULL;
+			CIDER_REQEVAL("  chain[%u] = %s", ix, s ? cfString(s).c_str() : "(none)");
+			if (s) CFRelease(s);
+		}
+	}
+	if (cert && apple)
 		return true;
 	return false;
 }
