+	}
+	catch (...) {
+		if (getenv("CIDER_TRACE_SECCERT")) {
+			fprintf(stderr, "CIDER_SECCERT ItemImpl create threw something else\n");
+			fflush(stderr);
+		}
+	}
 	CFRelease(data);
