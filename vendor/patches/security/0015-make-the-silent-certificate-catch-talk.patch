--- a/OSX/libsecurity_keychain/lib/SecCertificate.cpp	2026-09-06 20:35:30.504845801 +0200
+++ b/OSX/libsecurity_keychain/lib/SecCertificate.cpp	2026-09-06 20:35:30.478301393 +0200
@@ -104,10 +104,42 @@
 		SecPointer<Certificate> certificatePtr(new Certificate(cssmCertData, CSSM_CERT_X_509v3, CSSM_CERT_ENCODING_DER));
 		implCertRef = certificatePtr->handle();
 	}
-	catch (...) {}
+	/*
+	 * A SILENT CATCH HIDES THE WHOLE LEGACY CERTIFICATE PATH. Returning NULL here makes every caller
+	 * that goes through BEGIN_SECCERTAPI answer errSecParam, which reads as a bad argument rather
+	 * than as whatever actually went wrong in here (task #199).
+	 */
+	catch (const MacOSError &err) {
+		if (getenv("CIDER_TRACE_SECCERT")) {
+			fprintf(stderr, "CIDER_SECCERT ItemImpl create threw MacOSError %d\n", (int) err.osStatus());
+			fflush(stderr);
+		}
+	}
+	catch (const CommonError &err) {
+		if (getenv("CIDER_TRACE_SECCERT")) {
+			fprintf(stderr, "CIDER_SECCERT ItemImpl create threw CommonError %d\n", (int) err.osStatus());
+			fflush(stderr);
+		}
+	}
+	catch (...) {
+		if (getenv("CIDER_TRACE_SECCERT")) {
+			fprintf(stderr, "CIDER_SECCERT ItemImpl create threw something else\n");
+			fflush(stderr);
+		}
+	}
 	CFRelease(data);
 	/* Positive control for the traces above: silence here would otherwise be unreadable, because a
 	 * throw and a path never taken look identical from outside. */
+	if (getenv("CIDER_TRACE_SECCERT")) {
+		/* The SecPointer above has been destroyed by now, and handle() does NOT retain a new object,
+		 * so this asks the question that matters: is the reference we are about to hand back still a
+		 * live ItemImpl, or did it die with its owner (task #199)? */
+		fprintf(stderr, "CIDER_SECCERT ItemImpl create -> %s alive=%d rc=%ld\n",
+				implCertRef ? "OK" : "NULL",
+				implCertRef ? (int) SecCertificateIsItemImplInstance(implCertRef) : -1,
+				implCertRef ? (long) CFGetRetainCount(implCertRef) : -1L);
+		fflush(stderr);
+	}
 	return implCertRef;
 }
 
