--- a/OSX/libsecurity_keychain/lib/Certificate.cpp	2026-09-06 20:21:53.323765616 +0200
+++ b/OSX/libsecurity_keychain/lib/Certificate.cpp	2026-09-06 20:21:53.310744102 +0200
