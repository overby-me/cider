 using namespace CssmClient;
 
+/* check() discards the CSSM_RETURN and the caller sees only a mapped OSStatus, so print the raw
+   one. Gated on CIDER_TRACE_SECCERT, the switch the certificate path above it already uses. */
+static void _CiderTraceCssm(const char *step, unsigned rc)
+{
+	if (getenv("CIDER_TRACE_SECCERT")) {
+		fprintf(stderr, "CIDER_SECCERT %s -> 0x%08x\n", step, rc);
+		fflush(stderr);
+	}
+}
