 #include <security_cdsa_client/mdsclient.h>
 #include <Security/mdspriv.h>
+#include <stdio.h>
+#include <stdlib.h>
 
 
 namespace Security {
 namespace MDSClient {
 
+/* CssmError::check discards the CSSM_RETURN, so print the raw one. Gated on
+   CIDER_TRACE_SECCERT, the switch the certificate path uses. */
+static void _CiderTraceMdsClient(const char *step, unsigned rc)
+{
+	if (getenv("CIDER_TRACE_SECCERT")) {
+		fprintf(stderr, "CIDER_SECCERT mdsclient %s -> 0x%08x\n", step, rc);
+		fflush(stderr);
+	}
+}
 
