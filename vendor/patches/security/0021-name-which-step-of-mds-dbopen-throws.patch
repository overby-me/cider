+/* DbOpen has three steps that can throw and the caller only sees one status, so name the step.
+   Gated on CIDER_TRACE_SECCERT, the switch the certificate path uses. */
+static void _CiderTraceDbOpen(const char *step, const char *detail)
+{
+	if (getenv("CIDER_TRACE_SECCERT")) {
+		fprintf(stderr, "CIDER_SECCERT MDS DbOpen %s: %s\n", step, detail);
+		fflush(stderr);
+	}
+}
