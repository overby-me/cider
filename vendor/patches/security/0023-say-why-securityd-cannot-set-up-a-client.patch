+/* A file, not Syslog: securityd's Syslog output does not reach var/log/system.log in a container,
+   and its stderr is not collected either. The path is in the writable prefix overlay. */
+static void _CiderSecdProbe(const char *fmt, ...)
+{
+	FILE *f = fopen("/tmp/cider-secd-setup.log", "a");
+	if (f == NULL)
+		return;
+	va_list ap;
+	va_start(ap, fmt);
+	vfprintf(f, fmt, ap);
+	va_end(ap);
+	fputc('\n', f);
+	fclose(f);
+}
