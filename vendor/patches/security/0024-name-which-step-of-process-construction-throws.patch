 #include <security_utilities/ccaudit.h>
 #include <security_utilities/logging.h>	//@@@ debug only
 #include "agentquery.h"
+#include <stdio.h>
+#include <stdarg.h>
+
+/* Process construction has several steps that can throw and END_IPCN collapses them into one
+   rcode, so name the step. A file, not Syslog: securityd's Syslog does not reach system.log in a
+   container and its stderr is not collected. */
+static void _CiderSecdProbe(const char *fmt, ...)
+{
+	FILE *f = fopen("/tmp/cider-secd-setup.log", "a");
+	if (f == NULL)
+		return;
+	va_list ap;
+	va_start(ap, fmt);
+	vfprintf(f, fmt, ap);
+	va_end(ap);
+	fputc('\n', f);
+	fclose(f);
+}
 
 
