+
+/* Which branch refuses a bundle. Gated on CIDER_TRACE_CODESIGN and written to a file, because the
+   caller that matters is securityd, whose stderr is not collected. */
+static void _CiderTraceDR(const char *fmt, ...)
+{
+	if (!getenv("CIDER_TRACE_CODESIGN"))
+		return;
+	FILE *f = fopen("/tmp/cider-codesign.log", "a");
+	if (f == NULL)
+		return;
+	va_list ap;
+	va_start(ap, fmt);
+	vfprintf(f, fmt, ap);
+	va_end(ap);
+	fputc('\n', f);
+	fclose(f);
+}
+
