 	asl_msg_list_t *out;
 	caddr_t vmstr;
-	mach_port_t asl_server_port = asl_core_get_service_port(0);
+	mach_port_t asl_server_port;
+
+	if (_cider_asl_store_is_unavailable()) return NULL;
+	asl_server_port = asl_core_get_service_port(0);
 
 	if (asl_server_port == MACH_PORT_NULL) return NULL;
 
