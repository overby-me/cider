 	_asl_global_init();
+	/* No ASL server here, so a query is a Mach round trip nobody answers. See asl_client.c. */
+	if (1) return NULL;
 	if (_asl_global.server_port == MACH_PORT_NULL) return NULL;
 
 	len = strlen(ctlstr) + 1;
@@ -1983,6 +1985,8 @@
 	uint64_t cmax;
 
 	_asl_global_init();
+	/* Same: with no server, the store is a file, which is what this answers without asking. */
+	if (1) return ASL_STORE_LOCATION_FILE;
 	if (_asl_global.server_port == MACH_PORT_NULL) return ASL_STORE_LOCATION_FILE;
 
 	res = NULL;
--- a/libsystem_asl.tproj/src/asl_client.c
+++ b/libsystem_asl.tproj/src/asl_client.c
@@ -203,6 +203,27 @@
 	return asl_client_internal_send((asl_object_t)client, (asl_object_t)msg, __builtin_return_address(0));
 }
 
+/*
+ * NOTHING SERVES THE ASL STORE HERE, and a read from it is a Mach round trip that waits for a reply.
+ *
+ * com.apple.system.logger is registered by launchd from the syslogd job, and that job is disabled
+ * upstream ("until I can figure out why syslogd keeps crashing"), so launchd holds the receive right
+ * and no one ever answers. A sender does not learn that: bootstrap hands back a live-looking name
+ * and mach_msg blocks forever.
+ *
+ * login reads the store to print "Last login:" (asl_ipc routine 121, _asl_server_query_2) and hangs
+ * there, which is why iTerm2 never gets a shell. Reporting "no records" is what an absent store
+ * actually means, and it is what the callers already handle: both of these functions return NULL
+ * when the service port is null.
+ *
+ * WRITES are untouched. _asl_server_message is a simpleroutine with no reply, so it cannot block,
+ * and dropping log lines is not the same as refusing to read a store that does not exist.
+ */
+static int _cider_asl_store_is_unavailable(void)
+{
+	return 1;
+}
