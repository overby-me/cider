name the process a right is copied into, and count the space on both sides

The guest says its port namespace never grows when semaphore_create runs, and the daemon says
it copied a send right into that task. Both are true, and the reason is that they are NOT
counting the same table:

    guest   mach_port_names ....... 59 to 61 names
    daemon  space->is_table_hashed .. 1, then 2

for the same pid, with the daemon's two entries being names 259 and 515, which are exactly the
task port and the host port the guest reports. So the two sides agree about the well known
ports and disagree about everything else.

The pid is what makes this readable at all: before it, the copyout trace named a task pointer
and there was no way to tell whose it was.

--- a/osfmk/kern/ipc_sync.c
+++ b/osfmk/kern/ipc_sync.c
@@ -33,6 +33,8 @@
 #include <kern/sync_sema.h>
 #include <kern/sync_lock.h>
 #include <kern/ipc_kobject.h>
+#include <stdlib.h>
+extern void xnu_sys_log(int level, const char* format, ...);
 #include <kern/ipc_sync.h>
 #include <ipc/port.h>
 #include <ipc/ipc_space.h>
@@ -143,6 +145,12 @@
 	    (ipc_kobject_t) semaphore, IKOT_SEMAPHORE, IPC_KOBJECT_ALLOC_NONE, false, 0)) {
 		semaphore_dereference(semaphore);
 	}
+	/* CIDER_TRACE_SEM: the guest sees ONE name for every semaphore it creates and its namespace
+	 * never grows, so the question this answers is whether the ports handed back here are distinct
+	 * objects at all. */
+	xnu_sys_log(2, "CIDER_SEM daemon convert semaphore=%p port=%p owner=%p pid=%d",
+	            (void *) semaphore, (void *) semaphore->port, (void *) semaphore->owner,
+	            semaphore->owner != TASK_NULL ? (int) task_pid(semaphore->owner) : -1);
 	return semaphore->port;
 }
 
--- a/osfmk/ipc/ipc_object.c
+++ b/osfmk/ipc/ipc_object.c
@@ -86,6 +86,8 @@
 #include <ipc/ipc_space.h>
 #include <ipc/ipc_entry.h>
 #include <ipc/ipc_object.h>
+#include <stdlib.h>
+extern void xnu_sys_log(int level, const char* format, ...);
 #include <ipc/ipc_hash.h>
 #include <ipc/ipc_right.h>
 #include <ipc/ipc_notify.h>
@@ -1022,6 +1024,27 @@
 		ipc_object_destroy(object, msgt_name);
 	}
 
+	/* CIDER_SEM: which name a copied-out right is given, and for which object. The guest sees one
+	 * name for every semaphore it creates while five distinct ports are made here. */
+	/* CIDER_TRACE_SEM, read once: every right the guest receives comes through here, so this is
+	 * far too hot to leave on. */
+	static int trace = -1;
+	if (trace < 0) {
+		trace = getenv("CIDER_TRACE_SEM") != NULL;
+	}
+	if (trace)
+	/* WHICH PROCESS the right lands in, which is the whole question when a guest says its own
+	 * namespace never grew. */
+	/* AND HOW BIG THE SPACE IS ON THIS SIDE. The guest counts its own namespace with
+	 * mach_port_names and says it never grows; if the two counts disagree they are not looking at
+	 * the same table. */
+	xnu_sys_log(2, "CIDER_SEM copyout space=%p task=%p pid=%d entries=%u object=%p kr=%d name=%u",
+	            (void *) space, (void *) (space ? space->is_task : NULL),
+	            (space && space->is_task) ? (int) task_pid(space->is_task) : -1,
+	            space ? (unsigned) space->is_table_hashed : 0u,
+	            (void *) object, (int) kr,
+	            (unsigned) (kr == KERN_SUCCESS ? name : 0));
+
 	return kr;
 }
 
