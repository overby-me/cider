+// How long a parked workqueue thread waits before giving up and exiting. Diagnostic knob; the
+// default is what it always was.
+static int __cider_workq_park_seconds(void) {
+	static int cached = 0;
+	if (cached == 0) {
+		const char* value = getenv("CIDER_WORKQ_PARK_SECONDS");
+		cached = (value != NULL) ? atoi(value) : 15;
+		if (cached <= 0) {
+			cached = 15;
+		}
+	}
+	return cached;
+}
