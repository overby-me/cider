+/*
+ * AN APPLICATION CRASH HANDLER HIDES THE CRASH FROM EVERYTHING OUTSIDE THE PROCESS.
+ *
+ * A fatal signal is delivered to the handler the application installed, which is right, and it is
+ * also the end of any hope of debugging: the handler prints its own message and exits cleanly, so
+ * there is no core, coredumpctl has nothing, and scripts/core-guest-stack.py has nothing to read.
+ * LibreOffice does exactly this. Its first run with no profile dies with Unspecified Application
+ * Error and no more, and what is underneath is a SIGSEGV this file dutifully forwarded.
+ *
+ * CIDER_SIGNAL_NO_APP_HANDLER=1 takes the DEFAULT effect for the four signals that mean the process
+ * is broken, so the kernel writes a core and the stack can be read. It changes nothing unless it is
+ * set, and it is read ONCE at setup rather than in the handler, where opening a file would be a new
+ * way to crash.
+ *
+ * The environment is read through /proc/self/environ rather than getenv, because this file is below
+ * libc: there is no environ pointer here yet at the time this runs.
+ */
+static int cider_no_app_handler = 0;
+
+static void cider_read_no_app_handler(void)
+{
+	char buf[8192];
+	long fd = LINUX_SYSCALL(__NR_openat, -100 /* AT_FDCWD */, "/proc/self/environ", 0 /* O_RDONLY */, 0);
+
+	if (fd < 0)
+		return;
+
+	long len = LINUX_SYSCALL(__NR_read, fd, buf, sizeof(buf) - 1);
+
+	LINUX_SYSCALL(__NR_close, fd);
+	if (len <= 0)
+		return;
+	buf[len] = '\0';
+
+	static const char key[] = "CIDER_SIGNAL_NO_APP_HANDLER=";
+	long i = 0;
+
+	while (i < len)
+	{
+		const char* entry = &buf[i];
+		long j = 0;
+
+		while (entry[j] != '\0' && key[j] != '\0' && entry[j] == key[j])
+			j++;
+		if (key[j] == '\0')
+		{
+			/* Present but empty is OFF, which is what a shell writes for VAR= and is not what
+			 * anyone means by it. */
+			cider_no_app_handler = (entry[j] != '\0');
+			return;
+		}
+		while (i < len && buf[i] != '\0')
+			i++;
+		i++;
+	}
+}
+
+/* The four that mean the process is broken rather than being asked to stop. */
+static int cider_signal_is_fatal(int bsd_signum)
+{
+	return bsd_signum == SIGSEGV || bsd_signum == SIGBUS || bsd_signum == SIGILL
+		|| bsd_signum == SIGFPE;
+}
+
