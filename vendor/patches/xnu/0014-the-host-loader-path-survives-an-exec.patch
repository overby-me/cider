+/*
+ * THE HOST LOADER PATH HAS TO SURVIVE AN EXEC, and no application is going to carry it.
+ *
+ * Every Mach-O image that wraps a host ELF library dlopens that library from a CONSTRUCTOR and
+ * ABORTS if it is missing (wrapgen writes that constructor; the elfcall is dlopen_fatal). The
+ * library is found through LD_LIBRARY_PATH, which points into the nix store. An application that
+ * builds a fresh environment for a helper it spawns drops it, and the helper dies before it runs a
+ * line of its own code:
+ *
+ *     cider mldr: FATAL dlopen failed: libGL.so.1: cannot open shared object file
+ *
+ * iTerm2 spawns iTermServer to own its pty and does exactly this. So take the value from the
+ * CURRENT process HOST environment, which is mldr own and always has it, rather than from the
+ * guest environment, which is whatever the application decided to pass.
+ *
+ * The value travels under a PRIVATE NAME as well. An application that builds a fresh environment
+ * for a helper drops LD_LIBRARY_PATH deliberately, and would drop it again however many times it
+ * is re-injected, but it has no reason to strip __mldr_elf_path, which nothing but this runtime
+ * knows about. mldr falls back to that name when a dlopen by soname fails.
+ *
+ * Returns a pointer to a static buffer holding the VALUE (no name, no equals), or NULL.
+ */
+static const char* host_loader_path(void)
+{
+	static char entry[8192];
+	static bool looked = false;
+	static bool have = false;
+
+	if (looked)
+		return have ? entry : NULL;
+
+	looked = true;
+
+	int fd = LINUX_SYSCALL(__NR_open, "/proc/self/environ", LINUX_O_RDONLY, 0);
+	if (fd < 0)
+	{
+		__simple_kprintf("loader path: open /proc/self/environ failed %d", fd);
+		return NULL;
+	}
+
+	/* READ THE WHOLE THING, in a loop, into a STATIC buffer.
+	 *
+	 * Two mistakes are easy here and both were made. A 16 KB automatic buffer does not fit on the
+	 * stack this runs on, and the read silently produced nothing. And ONE read of 16 KB is not the
+	 * environment: a shell session carries far more than that, LD_LIBRARY_PATH sat past the cut,
+	 * and the lookup answered "not present" for the one process that mattered. */
+	static char buf[262144];
+	long len = 0;
+
+	for (;;)
+	{
+		long chunk = LINUX_SYSCALL(__NR_read, fd, buf + len, sizeof(buf) - 1 - len);
+
+		if (chunk <= 0)
+			break;
+		len += chunk;
+		if (len >= (long) sizeof(buf) - 1)
+			break;
+	}
+
+	LINUX_SYSCALL(__NR_close, fd);
+
+	if (len <= 0)
+		return NULL;
+	buf[len] = '\0';
+
+	/* The private name wins, because it is the one that survived the last exec. */
+	for (int pass = 0; pass < 2 && !have; pass++)
+	{
+		const char* want = (pass == 0) ? "__mldr_elf_path=" : "LD_LIBRARY_PATH=";
+		long wantlen = strlen(want);
+
+		for (long i = 0; i < len; )
+		{
+			const char* var = &buf[i];
+			long varlen = strlen(var);
+
+			if (strncmp(var, want, wantlen) == 0)
+			{
+				const char* value = var + wantlen;
+
+				if (varlen - wantlen < (long) sizeof(entry) && *value != '\0')
+				{
+					memcpy(entry, value, varlen - wantlen + 1);
+					have = true;
+				}
+				break;
+			}
+
+			i += varlen + 1;
+		}
+	}
+
+	return have ? entry : NULL;
+}
