+/*
+ * THE WORKING DIRECTORY OF A PROCESS, and THE LIST OF PROCESSES.
+ *
+ * Both were answered with ENOTSUP, and the cost is visible in the iTerm2 title bar. On the real
+ * system that bar reads the directory the session is in; here it read an empty name followed by a
+ * size, because iTerm2 asks proc_listpids for the processes under the shell and then asks the one
+ * it finds for its working directory. Measured in one run: 265 calls to proc_listpids and one to
+ * PROC_PIDVNODEPATHINFO, every one of them refused.
+ *
+ * A guest pid IS the Linux pid in this emulation, which is what the rest of this file already
+ * assumes when it reads /proc/<pid>/stat, so both come straight out of /proc.
+ */
+
+struct cider_linux_dirent64
+{
+	uint64_t d_ino;
+	int64_t d_off;
+	unsigned short d_reclen;
+	unsigned char d_type;
+	char d_name[];
+};
+
+// The parent of a pid, out of field four of /proc/<pid>/stat, or -1 if it cannot be read.
+static int32_t _cider_ppid_of(int32_t pid)
+{
+	char path[64], stat[1024];
+	char* statptr;
+	const char* elem;
+
+	__simple_sprintf(path, "/proc/%d/stat", pid);
+	if (!read_string(path, stat, sizeof(stat)))
+		return -1;
+
+	statptr = stat;
+	skip_stat_elems(&statptr, 3); // pid, comm, state
+	elem = next_stat_elem(&statptr);
+	if (!elem)
+		return -1;
+
+	return __simple_atoi(elem, NULL);
+}
+
+/*
+ * THE GUEST procfs, WHICH IS NOT THE ONE AT /proc.
+ *
+ * The container clones into a NEW PID NAMESPACE and mounts a procfs for it at <prefix>/proc, so
+ * every pid an application holds is namespace local and small, while a bare /proc down here is the
+ * HOST procfs. Reading /proc/<guest pid> answers about an unrelated system process: iTerm2 asking
+ * for the working directory of pid 25 got EACCES, and the identical read under the prefix answered
+ * /Users/root.
+ *
+ * TWO THINGS THIS DELIBERATELY DOES NOT DO, both of which killed iTerm2 during startup with no
+ * output at all. It does not call vchroot_expand, which initialises on demand and ABORTS if its RPC
+ * fails. And it does not HOLD a descriptor: opening one early and keeping it changes which numbers
+ * the rest of the process gets, and a guest runtime that expects particular descriptors does not
+ * survive that. Paths are built and opened per read, exactly as read_string always did, and every
+ * caller falls back to the host procfs while the prefix is still unknown.
+ */
+static bool _cider_guest_proc_path(char* out, int outlen, const char* rel)
+{
+	const char* prefix = vchroot_prefix_if_known();
+	int plen;
+
+	if (prefix == NULL)
+		return false;
+
+	/* SMALL FRAMES ONLY. Every attempt that put a multi kilobyte buffer on this path killed the
+	 * process during early startup, before a single trace could print, while the one that kept to
+	 * a late path survived: guest startup runs on a small stack and a four kilobyte frame does not
+	 * fit. A prefix longer than this is refused rather than accommodated, and the caller then does
+	 * what it always did and reads the host procfs. */
+	plen = strlen(prefix);
+	if (plen + (int) strlen(rel) + 8 > outlen)
+		return false;
+
+	__simple_sprintf(out, "%s/proc/%s", prefix, rel);
+	return true;
+}
+
+/* The LENGTH is returned because a command line is a run of NUL separated strings, where strlen
+ * stops at the first of them. */
+static int _cider_read_guest_proc(const char* rel, char* dst, int maxlen)
+{
+	char path[512];
+	int fd, len;
+
+	if (!_cider_guest_proc_path(path, sizeof(path), rel))
+		return -1;
+
+	fd = LINUX_SYSCALL(__NR_openat, LINUX_AT_FDCWD, path, LINUX_O_RDONLY, 0);
+	if (fd < 0)
+		return -1;
+
+	len = LINUX_SYSCALL(__NR_read, fd, dst, maxlen - 1);
+	LINUX_SYSCALL(__NR_close, fd);
+	if (len < 0)
+		return -1;
+
+	dst[len] = '\0';
+	return len;
+}
+
+static long _proc_listpids(uint32_t type, uint32_t typeinfo, void* buffer, int32_t bufsize)
+{
+	char dirents[4096];
+	int32_t* out = (int32_t*) buffer;
+	int32_t capacity = (buffer != NULL) ? (bufsize / (int32_t) sizeof(int32_t)) : 0;
+	int32_t count = 0;
+	int fd, len;
+
+	/*
+	 * ONLY THE TWO KINDS THAT CAN BE ANSWERED HONESTLY. Everything under /proc is every process,
+	 * so answering a uid or tty filter with the whole list would be worse than refusing: the
+	 * caller cannot tell the difference between a filter that ran and one that did nothing.
+	 */
+	if (type != 1 /*PROC_ALL_PIDS*/ && type != 6 /*PROC_PPID_ONLY*/)
+	{
+		__simple_printf("sys_proc_info(): Unsupported listpids type: %d\n", type);
+		return -ENOTSUP;
+	}
+
+	{
+		char dir[512];
+
+		if (!_cider_guest_proc_path(dir, sizeof(dir), ""))
+			__simple_sprintf(dir, "/proc");
+		fd = LINUX_SYSCALL(__NR_openat, LINUX_AT_FDCWD, dir,
+				LINUX_O_RDONLY | LINUX_O_DIRECTORY, 0);
+	}
+	if (fd < 0)
+		return errno_linux_to_bsd(fd);
+
+	while ((len = LINUX_SYSCALL(__NR_getdents64, fd, dirents, sizeof(dirents))) > 0)
+	{
+		int off = 0;
+
+		while (off < len)
+		{
+			struct cider_linux_dirent64* de = (struct cider_linux_dirent64*) (dirents + off);
+			const char* name = de->d_name;
+			bool numeric = name[0] >= '1' && name[0] <= '9';
+			int32_t pid;
+			const char* p;
+
+			off += de->d_reclen;
+
+			for (p = name; numeric && *p != '\0'; p++)
+			{
+				if (*p < '0' || *p > '9')
+					numeric = false;
+			}
+			if (!numeric)
+				continue;
+
+			pid = __simple_atoi(name, NULL);
+			if (type == 6 /*PROC_PPID_ONLY*/ && _cider_ppid_of(pid) != (int32_t) typeinfo)
+				continue;
+
+			// A NULL buffer is a request for the size, which is what the wrapper does first.
+			if (buffer != NULL)
+			{
+				if (count >= capacity)
+					break;
+				out[count] = pid;
+			}
+			count++;
+		}
+	}
+
+	LINUX_SYSCALL(__NR_close, fd);
+	return count * (long) sizeof(int32_t);
+}
+
+static long _proc_pidinfo_vnodepathinfo(int32_t pid, void* buffer, int32_t bufsize)
+{
+	struct vchroot_unexpand_args args;
+	struct proc_vnodepathinfo* vpi;
+	char link[64];
+	int rv;
+
+	if (!buffer)
+		return -EFAULT;
+	if (bufsize < (int32_t) sizeof(struct proc_vnodepathinfo))
+		return -ENOSPC;
+
+	memset(buffer, 0, sizeof(struct proc_vnodepathinfo));
+	vpi = (struct proc_vnodepathinfo*) buffer;
+
+	{
+		char rel[64];
+
+		__simple_sprintf(rel, "%d/cwd", pid);
+		if (!_cider_guest_proc_path(link, sizeof(link), rel))
+			__simple_sprintf(link, "/proc/%d/cwd", pid);
+		rv = LINUX_SYSCALL(__NR_readlinkat, LINUX_AT_FDCWD, link, args.path,
+				sizeof(args.path) - 1);
+	}
+	if (rv < 0)
+		return errno_linux_to_bsd(rv);
+	args.path[rv] = '\0';
+
+	// The answer has to be in the guest view of the filesystem, not the host one.
+	rv = vchroot_unexpand(&args);
+	if (rv != 0)
+		return rv;
+
+	strncpy(vpi->pvi_cdir.vip_path, args.path, sizeof(vpi->pvi_cdir.vip_path) - 1);
+	return sizeof(struct proc_vnodepathinfo);
+}
