+/*
+ * THE PREFIX, BUT ONLY IF IT IS ALREADY KNOWN.
+ *
+ * -vchroot_expand() initialises the prefix on demand, and init_vchroot_path() ABORTS the process if
+ * its RPC to the daemon fails. That is fine for ordinary path work, which happens long after the
+ * daemon is there, and fatal for anything on an early startup path: routing the process info reads
+ * through vchroot_expand() killed iTerm2 during startup with no output at all, because the abort
+ * came before any of its traces could speak.
+ *
+ * This answers NULL rather than initialising anything, so a caller that is merely trying to do
+ * better when it can, and is happy with the old behaviour when it cannot, has a way to ask.
+ */
+const char* vchroot_prefix_if_known(void)
+{
+	if (prefix_path_len <= 0)
+		return NULL;
+	return prefix_path;
+}
