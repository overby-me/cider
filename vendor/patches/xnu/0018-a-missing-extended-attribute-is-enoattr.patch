--- /dev/null
+++ b/darling/src/libsystem_kernel/emulation/include/conversion/xattr/errors.h
@@ -0,0 +1,37 @@
+#ifndef DARLING_CONVERSION_XATTR_ERRORS
+#define DARLING_CONVERSION_XATTR_ERRORS
+
+#include <sys/errno.h>
+#include <darling/emulation/conversion/errno.h>
+
+/*
+ * LINUX AND DARWIN DISAGREE ABOUT WHAT "NO SUCH ATTRIBUTE" IS, and the global errno table cannot
+ * settle it because the disagreement is per call rather than per value.
+ *
+ * On Linux, ENOATTR IS ENODATA: one number, 61, for both "this stream has no data" and "this file
+ * has no such extended attribute". Darwin splits them, ENOATTR 93 and ENODATA 96, so the global
+ * table has to choose, and it chose ENODATA, which is right for the stream calls and wrong for
+ * these six.
+ *
+ * A filesystem with no extended attribute support answers ENOTSUP. macOS has no such filesystem,
+ * so no caller is written for that answer: Apple's own code-signing machinery treats anything but
+ * ENOATTR or EPERM as fatal (checkFork in libsecurity_utilities/unix++.cpp), and that is exactly
+ * how MoneyMoney came to declare its own application file damaged and refuse to start. Its first
+ * call was getxattr for com.apple.FinderInfo on the bundle root, our answer was EOPNOTSUPP, and
+ * SecStaticCodeCreateWithPath returned errSecErrnoBase plus 102 before reading a byte of the
+ * signature. "There is no such attribute" is both true here and the answer macOS would give.
+ *
+ * SETTING one is a different question and is deliberately not translated: an application that
+ * stores an attribute and is told it succeeded, when nothing was stored, has been lied to.
+ */
+static inline long xattr_errno_linux_to_bsd(int linux_ret)
+{
+	long err = errno_linux_to_bsd(linux_ret);
+
+	if (err == -ENODATA || err == -ENOTSUP || err == -EOPNOTSUPP)
+		return -ENOATTR;
+
+	return err;
+}
+
+#endif // DARLING_CONVERSION_XATTR_ERRORS
