+
+// aarch64 perf (#11): vchroot_run lstat()s every accumulated path component on every translation, so a
+// dyld load re-walks the same system dirs thousands of times (measured 94% of newfstatat redundant;
+// /usr/lib/system re-stat'd ~400x per spawn). Cache the dominant "path exists and is not a symlink"
+// result, keyed by the full path and tagged with a generation that the namespace-mutating syscalls
+// (unlink/rename/symlink) bump, so an entry can never outlive the path being removed or retyped.
+// Symlinks and ENOENT bypass the cache (rare; full semantics preserved). Per-process; off in TEST.
+unsigned long __vchroot_generation = 1;
+void __vchroot_bump_generation(void) { __vchroot_generation++; }
+
+#ifndef TEST
+#define VCHROOT_CACHE_N 256
+struct vchroot_cache_ent {
+	unsigned long gen;
+	unsigned int  hash;
+	unsigned int  len;
+	char          path[256];
+};
+static struct vchroot_cache_ent vchroot_cache[VCHROOT_CACHE_N];
+
+static unsigned int vchroot_path_hash(const char* s, unsigned int len)
+{
+	unsigned int h = 2166136261u;
+	for (unsigned int i = 0; i < len; i++) { h ^= (unsigned char) s[i]; h *= 16777619u; }
+	return h;
+}
+static int vchroot_cache_hit(const char* path, unsigned int len)
+{
+	if (len == 0 || len >= sizeof(vchroot_cache[0].path))
+		return 0;
+	unsigned int h = vchroot_path_hash(path, len);
+	struct vchroot_cache_ent* e = &vchroot_cache[h % VCHROOT_CACHE_N];
+	return e->gen == __vchroot_generation && e->hash == h && e->len == len
+		&& memcmp(e->path, path, len) == 0;
+}
+static void vchroot_cache_put(const char* path, unsigned int len)
+{
+	if (len == 0 || len >= sizeof(vchroot_cache[0].path))
+		return;
+	unsigned int h = vchroot_path_hash(path, len);
+	struct vchroot_cache_ent* e = &vchroot_cache[h % VCHROOT_CACHE_N];
+	e->gen = __vchroot_generation;
+	e->hash = h;
+	e->len = len;
+	memcpy(e->path, path, len);
+}
+#else
+static int vchroot_cache_hit(const char* path, unsigned int len) { (void) path; (void) len; return 0; }
+static void vchroot_cache_put(const char* path, unsigned int len) { (void) path; (void) len; }
+#endif
 
 static int vchroot_run(const char* input_path, struct context* ctxt)
 {
