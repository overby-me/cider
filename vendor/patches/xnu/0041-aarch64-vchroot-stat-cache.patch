-							int status = LINUX_SYSCALL(__NR_newfstatat, LINUX_AT_FDCWD, ctxt->current_path, &st, LINUX_AT_SYMLINK_NOFOLLOW);
+					int status;
+					if (vchroot_cache_hit(ctxt->current_path, ctxt->current_path_len))
