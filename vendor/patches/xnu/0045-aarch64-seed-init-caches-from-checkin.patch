aarch64 #11/#25: seed the per-process init caches (task_self, uid/gid) from the checkin reply.

mldr folds task_self/uid/gid into the checkin reply and passes them to the image as apple[] strings
(dserver_task_self= / dserver_uid= / dserver_gid=, all hex). libsystem_kernel's mach_driver_init
parses them and seeds the task-self cache (0044) and getuid.c's uid/gid cache, so a freshly exec'd
image skips its first task_self_trap + uidgid RPCs. Sentinels (task_self 0, uid/gid ffffffff => -1)
leave the cache empty so the guest falls back to the RPC. The fork-child checkin (fork.c) passes
NULL for the new reply out-ptrs, since the child inherits the parent's warm caches. On top of 0044.

Signed-off-by: Niclas Overby <niclas@overby.me>
---
--- a/darling/src/libsystem_kernel/emulation/src/xnu_syscall/mach/impl/mach_traps.c
+++ b/darling/src/libsystem_kernel/emulation/src/xnu_syscall/mach/impl/mach_traps.c
@@ -710,6 +710,8 @@
 // deallocate it, so a cached name gets over-released and dies -> hang.)
 static mach_port_name_t _cached_task_self = MACH_PORT_NULL;
 void __task_self_trap_reset(void) { _cached_task_self = MACH_PORT_NULL; }
+// #11/#25: seed the task-self cache from the checkin reply (via apple[]); the NULL guard keeps the RPC fallback.
+void __task_self_trap_set(mach_port_name_t name) { if (name != MACH_PORT_NULL) _cached_task_self = name; }
 mach_port_name_t task_self_trap_impl(void)
 {
 	if (_cached_task_self != MACH_PORT_NULL)
--- a/darling/src/libsystem_kernel/emulation/src/xnu_syscall/bsd/impl/process/fork.c
+++ b/darling/src/libsystem_kernel/emulation/src/xnu_syscall/bsd/impl/process/fork.c
@@ -57,7 +57,7 @@
 		}
 
 		int dummy_stack_variable;
-		if (dserver_rpc_checkin(true, &dummy_stack_variable, newReadFd) < 0) {
+		if (dserver_rpc_checkin(true, &dummy_stack_variable, newReadFd, NULL, NULL, NULL) < 0) {
 			// we can't do ANYTHING if darlingserver fails to acknowledge us
 			__simple_printf("Failed to checkin with darlingserver after fork\n");
 			__simple_abort();
--- a/darling/src/libsystem_kernel/emulation/src/xnu_syscall/bsd/impl/unistd/getuid.c
+++ b/darling/src/libsystem_kernel/emulation/src/xnu_syscall/bsd/impl/unistd/getuid.c
@@ -76,6 +76,15 @@
 	return ret;
 };
 
+// #11/#25: seed the uid/gid cache from the checkin reply (via apple[]). Unlike __setuidgid this does
+// NOT tell the server (it is the source of these values); callers pass a valid (non-negative) pair only.
+void __getuidgid_seed(int32_t uid, int32_t gid) {
+	libsimple_rwlock_lock_write(&uidgid_rwlock);
+	stored_uid = uid;
+	stored_gid = gid;
+	libsimple_rwlock_unlock_write(&uidgid_rwlock);
+}
+
 long sys_getuid(void)
 {
 	int32_t uid;
--- a/darling/src/libsystem_kernel/emulation/src/other/mach/lkm.c
+++ b/darling/src/libsystem_kernel/emulation/src/other/mach/lkm.c
@@ -31,6 +31,8 @@
 static bool use_per_thread_driver_fd = false;
 
 extern void _xtrace_postfork_child(void);
+extern void __task_self_trap_set(unsigned int name);  // #11/#25: seed task-self cache from checkin
+extern void __getuidgid_seed(int uid, int gid);       // #11/#25: seed uid/gid cache from checkin
 
 void mach_driver_init(const char** applep)
 {
@@ -38,6 +40,9 @@
 	if (applep != NULL)
 	{
 		int i;
+		// #11/#25: seed the per-process init caches from the checkin reply that mldr folds into apple[]
+		// (all hex; task_self 0 / uid,gid ffffffff => -1 mean "unknown" -> leave the cache empty -> RPC).
+		int seed_uid = -1, seed_gid = -1;
 		for (i = 0; applep[i] != NULL; i++)
 		{
 			if (strncmp(applep[i], "elf_calls=", 10) == 0)
@@ -45,7 +50,19 @@
 				uintptr_t table = (uintptr_t) __simple_atoi16(applep[i] + 10, NULL);
 				_elfcalls = (struct elf_calls*) table;
 			}
+			else if (strncmp(applep[i], "dserver_task_self=", 18) == 0)
+			{
+				unsigned int name = (unsigned int) __simple_atoi16(applep[i] + 18, NULL);
+				if (name != 0)
+					__task_self_trap_set(name);
+			}
+			else if (strncmp(applep[i], "dserver_uid=", 12) == 0)
+				seed_uid = (int) (unsigned int) __simple_atoi16(applep[i] + 12, NULL);
+			else if (strncmp(applep[i], "dserver_gid=", 12) == 0)
+				seed_gid = (int) (unsigned int) __simple_atoi16(applep[i] + 12, NULL);
 		}
+		if (seed_uid >= 0 && seed_gid >= 0)
+			__getuidgid_seed(seed_uid, seed_gid);
 	}
 #else
 	// ask for elfcalls already set up by dyld
