aarch64 #11/#25 v2: seed the guest vchroot prefix cache from the checkin path (via apple[]).

mldr already fetches the vchroot prefix (rpc::vchroot_path) and now also passes it to the image as
apple[] dserver_vchroot=<path>. libsystem_kernel's mach_driver_init seeds prefix_path via a new
__vchroot_seed(), so a freshly exec'd process skips its first vchroot_path RPC. Empty/oversized
values are ignored (prefix_path_len stays -1 -> vchroot_expand still RPCs). Applies on top of 0045.

Signed-off-by: Niclas Overby <niclas@overby.me>
---
--- a/darling/src/libsystem_kernel/emulation/src/linux_premigration/vchroot_userspace.c
+++ b/darling/src/libsystem_kernel/emulation/src/linux_premigration/vchroot_userspace.c
@@ -180,6 +180,19 @@
  * This answers NULL rather than initialising anything, so a caller that is merely trying to do
  * better when it can, and is happy with the old behaviour when it cannot, has a way to ask.
  */
+// #11/#25 v2: seed the vchroot prefix cache from mldr (passed via apple[]) so a freshly exec'd
+// process skips its first vchroot_path RPC. Honors the no-trailing-slash invariant on prefix_path;
+// ignores an empty or oversized value (leaves prefix_path_len == -1 so vchroot_expand still RPCs).
+void __vchroot_seed(const char* path) {
+	if (!path) return;
+	int n = (int) strlen(path);
+	while (n > 0 && path[n-1] == '/') n--;
+	if (n == 0 || n >= (int) sizeof(prefix_path)) return;
+	memcpy(prefix_path, path, (unsigned) n);
+	prefix_path[n] = '\0';
+	prefix_path_len = n;
+}
+
 const char* vchroot_prefix_if_known(void)
 {
 	if (prefix_path_len <= 0)
--- a/darling/src/libsystem_kernel/emulation/src/other/mach/lkm.c
+++ b/darling/src/libsystem_kernel/emulation/src/other/mach/lkm.c
@@ -33,6 +33,7 @@
 extern void _xtrace_postfork_child(void);
 extern void __task_self_trap_set(unsigned int name);  // #11/#25: seed task-self cache from checkin
 extern void __getuidgid_seed(int uid, int gid);       // #11/#25: seed uid/gid cache from checkin
+extern void __vchroot_seed(const char* path);         // #11/#25 v2: seed vchroot prefix from mldr
 
 void mach_driver_init(const char** applep)
 {
@@ -60,6 +61,12 @@
 				seed_uid = (int) (unsigned int) __simple_atoi16(applep[i] + 12, NULL);
 			else if (strncmp(applep[i], "dserver_gid=", 12) == 0)
 				seed_gid = (int) (unsigned int) __simple_atoi16(applep[i] + 12, NULL);
+			else if (strncmp(applep[i], "dserver_vchroot=", 16) == 0)
+			{
+				const char* vc = applep[i] + 16;
+				if (*vc)
+					__vchroot_seed(vc);
+			}
 		}
 		if (seed_uid >= 0 && seed_gid >= 0)
 			__getuidgid_seed(seed_uid, seed_gid);
