 static _Bool inguest_ipc_on(void) { return g_inguest_ipc; }
+// #23 port table (milestone 1, port-returning queries): mint guest-owned port names in a reserved
+// high range ciderd never assigns, so a synthesized kernel query can hand back a port with no daemon.
+// exec-true only FETCHES these ports (clock service, task special ports) and never sends to them, so a
+// minted name that is only stored (and freed at exit) suffices; a name in the range routes port ops
+// in-guest (see the deallocate/mod_refs guards).
+#define INGUEST_PORT_BASE 0xE0000000u
+static libsimple_rwlock_t g_inguest_mint_lock = LIBSIMPLE_RWLOCK_INITIALIZER;
+static uint32_t g_inguest_next = 0;
+static mach_port_name_t inguest_mint_port(void) {
+	libsimple_rwlock_lock_write(&g_inguest_mint_lock);
+	uint32_t n = ++g_inguest_next;
+	libsimple_rwlock_unlock_write(&g_inguest_mint_lock);
+	return (mach_port_name_t) (INGUEST_PORT_BASE + n);
+}
+static _Bool inguest_is_minted(mach_port_name_t name) { return name >= INGUEST_PORT_BASE; }
