+// Synthesize a port-returning kernel query reply (host_get_clock_service 206, task special ports
+// 3409/3418): a COMPLEX message with ONE port descriptor, matching the real ciderd reply bytes
+// (Head COMPLEX + msgh_body{count=1} + port_descriptor, 40 bytes, no NDR/RetCode). want_port=0 returns
+// MACH_PORT_NULL (as ciderd does for task port 3409). The returned port is a guest-minted name that
+// exec-true only stores; reqid is passed already-read because rcv aliases the request.
+static _Bool inguest_serve_port_query(mach_msg_id_t reqid, mach_msg_header_t* rcv, mach_msg_size_t rcv_size, mach_port_name_t rcv_name, _Bool want_port) {
+	mach_msg_size_t reply_size = (mach_msg_size_t) (sizeof(mach_msg_header_t) + sizeof(mach_msg_body_t)
+		+ sizeof(mach_msg_port_descriptor_t));
+	if (rcv == 0 || rcv_size < reply_size + 8) return 0;
+	mach_port_name_t port = want_port ? inguest_mint_port() : MACH_PORT_NULL;
+	char* p = (char*) rcv;
+	memset(p, 0, reply_size);
+	mach_msg_header_t* h = (mach_msg_header_t*) p;
+	h->msgh_bits = 0x80001200; // MACH_MSGH_BITS_COMPLEX + MOVE_SEND_ONCE local, remote 0
+	h->msgh_size = reply_size;
+	h->msgh_remote_port = 0;
+	h->msgh_local_port = rcv_name;
+	h->msgh_id = reqid + 100;
+	mach_msg_body_t* body = (mach_msg_body_t*) (p + sizeof(mach_msg_header_t));
+	body->msgh_descriptor_count = 1;
+	mach_msg_port_descriptor_t* d = (mach_msg_port_descriptor_t*) (p + sizeof(mach_msg_header_t) + sizeof(mach_msg_body_t));
+	d->name = port;
+	d->disposition = 17; // MACH_MSG_TYPE_MOVE_SEND
+	d->type = MACH_MSG_PORT_DESCRIPTOR;
+	unsigned char* tr = p + reply_size;
+	tr[0] = 0; tr[1] = 0; tr[2] = 0; tr[3] = 0;
+	tr[4] = 8; tr[5] = 0; tr[6] = 0; tr[7] = 0;
+	return 1;
+}
