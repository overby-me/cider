-// ENOTSUP rather than ENOSYS: callers (Nix, copyfile, cp) treat ENOTSUP as
-// "cloning not supported on this filesystem" and fall back to a regular
-// read/write copy, whereas ENOSYS looks like a fatal missing syscall.
-long sys_clonefileat(int src_fd, const char* src_path, int dest_fd, const char* dest_path, uint32_t flags) {
+extern char* strcpy(char* dst, const char* src);
+
+#ifndef __NR_fstatat64
+	#define __NR_fstatat64 __NR_newfstatat
+#endif
+
+// sys/clonefile.h, which the guest side of this file cannot include.
+#define CLONE_NOFOLLOW 0x0001
+
+// REGULAR FILES, SYMLINKS AND DIRECTORIES. Directories are cloned RECURSIVELY, which macOS does and
+// which test_fclonefileat_folder_api_abuse asserts: it clones a folder of four files plus an inner
+// folder and then opens all five. An earlier version of this file answered ENOTSUP for directories
+// on the theory that callers would fall back to a plain copy; that is true of Nix and cp, and it is
+// not true of an application that simply expects the API to work.
+//
+// NOT carried: ACLs, extended attributes, and ownership. Anything else (devices, sockets, fifos)
+// still answers ENOTSUP, because reporting success for a clone that did not happen is worse than
+// admitting it.
+//
+// This is a COPY, not a reflink. Nothing here depends on the underlying filesystem, which is the
+// point: a container prefix on ext4 cannot reflink at all.
+
+static long clone_regular(int src_dfd, const char* src, int dst_dfd, const char* dst, int mode)
+{
+	char buf[65536];
+	long in, out, written, n;
+	long ret = 0;
+
+	in = LINUX_SYSCALL(__NR_openat, src_dfd, src, LINUX_O_RDONLY, 0);
+	if (in < 0)
+		return in;
+
+	// O_EXCL because macOS clonefile fails with EEXIST rather than overwriting.
+	out = LINUX_SYSCALL(__NR_openat, dst_dfd, dst,
+		LINUX_O_WRONLY | LINUX_O_CREAT | LINUX_O_EXCL, mode & 07777);
+	if (out < 0) {
+		LINUX_SYSCALL(__NR_close, in);
+		return out;
+	}
+
+	for (;;) {
+		n = LINUX_SYSCALL(__NR_read, in, buf, sizeof(buf));
+		if (n < 0) {
+			ret = n;
+			break;
+		}
+		if (n == 0)
+			break;
+		for (written = 0; written < n; ) {
+			long w = LINUX_SYSCALL(__NR_write, out, buf + written, n - written);
+			if (w < 0) {
+				ret = w;
+				break;
+			}
+			written += w;
+		}
+		if (ret < 0)
+			break;
+	}
+
+	LINUX_SYSCALL(__NR_close, in);
+	LINUX_SYSCALL(__NR_close, out);
+
+	// Leave no half-written file behind: a caller that sees the error must not also find a file.
+	if (ret < 0)
+		LINUX_SYSCALL(__NR_unlinkat, dst_dfd, dst, 0);
+
+	return ret;
+}
+
+static long clone_symlink(int src_dfd, const char* src, int dst_dfd, const char* dst)
+{
+	char target[4096];
+	long n;
+
+	n = LINUX_SYSCALL(__NR_readlinkat, src_dfd, src, target, sizeof(target) - 1);
+	if (n < 0)
+		return n;
+	target[n] = '\0';
+
+	return LINUX_SYSCALL(__NR_symlinkat, target, dst_dfd, dst);
+}
+
+static long clone_one(int src_dfd, const char* src, int dst_dfd, const char* dst, int depth);
+
+// A directory: make it, then clone every entry into it. The dirent buffer is small and the depth is
+// capped because both live on the stack of a guest thread, which is not the host's.
+#define CLONE_MAX_DEPTH 24
+
+static int name_is_dot(const char* n)
+{
+	return n[0] == '.' && (n[1] == '\0' || (n[1] == '.' && n[2] == '\0'));
+}
+
+static long clone_directory(int src_dfd, const char* src, int dst_dfd, const char* dst, int mode, int depth)
+{
+	char dirents[1024];
+	long sfd, dfd, n;
+	long ret = 0;
+
+	ret = LINUX_SYSCALL(__NR_mkdirat, dst_dfd, dst, mode & 07777);
+	if (ret < 0)
+		return ret;
+
+	sfd = LINUX_SYSCALL(__NR_openat, src_dfd, src, LINUX_O_RDONLY | LINUX_O_DIRECTORY, 0);
+	if (sfd < 0)
+		return sfd;
+	dfd = LINUX_SYSCALL(__NR_openat, dst_dfd, dst, LINUX_O_RDONLY | LINUX_O_DIRECTORY, 0);
+	if (dfd < 0) {
+		LINUX_SYSCALL(__NR_close, sfd);
+		return dfd;
+	}
+
+	while ((n = LINUX_SYSCALL(__NR_getdents64, sfd, dirents, sizeof(dirents))) > 0) {
+		char* iter;
+		for (iter = dirents; iter < dirents + n; ) {
+			struct linux_dirent64* de = (struct linux_dirent64*) iter;
+			iter += de->d_reclen;
+			if (name_is_dot(de->d_name))
+				continue;
+			ret = clone_one(sfd, de->d_name, dfd, de->d_name, depth + 1);
+			if (ret < 0)
+				break;
+		}
+		if (ret < 0)
+			break;
+	}
+	if (n < 0)
+		ret = n;
+
+	LINUX_SYSCALL(__NR_close, sfd);
+	LINUX_SYSCALL(__NR_close, dfd);
+	return ret;
+}
+
+// One entry, whatever it is. Never follows: inside a tree a symlink is copied as a symlink.
+static long clone_one(int src_dfd, const char* src, int dst_dfd, const char* dst, int depth)
+{
+	struct linux_stat st;
+	long ret;
+
+	if (depth > CLONE_MAX_DEPTH)
+		return -ELOOP;
+
+	ret = LINUX_SYSCALL(__NR_fstatat64, src_dfd, src, &st, LINUX_AT_SYMLINK_NOFOLLOW);
+	if (ret < 0)
+		return ret;
+
+	if (S_ISLNK(st.st_mode))
+		return clone_symlink(src_dfd, src, dst_dfd, dst);
+	if (S_ISDIR(st.st_mode))
+		return clone_directory(src_dfd, src, dst_dfd, dst, st.st_mode, depth);
+	if (S_ISREG(st.st_mode))
+		return clone_regular(src_dfd, src, dst_dfd, dst, st.st_mode);
 	return -ENOTSUP;
 }
 
+long sys_clonefileat(int src_fd, const char* src_path, int dest_fd, const char* dest_path, uint32_t flags) {
+	struct vchroot_expand_args src_vc;
+	struct vchroot_expand_args dst_vc;
+	struct linux_stat st;
+	long ret;
+
+	if (!src_path || !dest_path)
+		return -EFAULT;
+
+	// CLONE_NOFOLLOW clones the LINK; without it the link is resolved and its target is cloned.
+	src_vc.flags = (flags & CLONE_NOFOLLOW) ? 0 : VCHROOT_FOLLOW;
+	src_vc.dfd = atfd(src_fd);
+	strcpy(src_vc.path, src_path);
+	ret = vchroot_expand(&src_vc);
+	if (ret < 0)
+		return errno_linux_to_bsd(ret);
+
+	// The destination is the name being created, so its own last component is never followed.
+	dst_vc.flags = 0;
+	dst_vc.dfd = atfd(dest_fd);
+	strcpy(dst_vc.path, dest_path);
+	ret = vchroot_expand(&dst_vc);
+	if (ret < 0)
+		return errno_linux_to_bsd(ret);
+
+	// NOFOLLOW here too: src_vc has already resolved the link if it was supposed to, so this
+	// reports what is actually going to be cloned.
+	ret = LINUX_SYSCALL(__NR_fstatat64, src_vc.dfd, src_vc.path, &st, LINUX_AT_SYMLINK_NOFOLLOW);
+	if (ret < 0)
+		return errno_linux_to_bsd(ret);
+
+	if (S_ISLNK(st.st_mode))
+		ret = clone_symlink(src_vc.dfd, src_vc.path, dst_vc.dfd, dst_vc.path);
+	else if (S_ISDIR(st.st_mode))
+		ret = clone_directory(src_vc.dfd, src_vc.path, dst_vc.dfd, dst_vc.path, st.st_mode, 0);
+	else if (S_ISREG(st.st_mode))
+		ret = clone_regular(src_vc.dfd, src_vc.path, dst_vc.dfd, dst_vc.path, st.st_mode);
+	else
+		return -ENOTSUP;
+
+	__vchroot_bump_generation(); // #11: invalidate the vchroot stat cache
+
+	if (ret < 0)
+		return errno_linux_to_bsd(ret);
+	return 0;
+}
