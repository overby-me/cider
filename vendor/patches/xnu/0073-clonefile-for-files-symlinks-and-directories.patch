+	dst_vc.flags = 0;
+	dst_vc.dfd = atfd(dest_fd);
+	strcpy(dst_vc.path, dest_path);
+	ret = vchroot_expand(&dst_vc);
+	if (ret < 0)
+		return errno_linux_to_bsd(ret);
+
+	ret = LINUX_SYSCALL(__NR_fstatat64, src_fd, "", &st, LINUX_AT_EMPTY_PATH);
