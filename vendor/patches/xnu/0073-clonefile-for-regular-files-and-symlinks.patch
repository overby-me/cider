+// sys/clonefile.h, which the guest side of this file cannot include.
+#define CLONE_NOFOLLOW 0x0001
+
+// REGULAR FILES AND SYMLINKS ONLY, and ENOTSUP for everything else on purpose. macOS clones
+// directories recursively and carries ACLs and every extended attribute; this does not. Callers
+// (Nix, copyfile, cp) read ENOTSUP as "cloning is not available here" and fall back to a plain
+// read/write copy, so an unsupported case still gets copied correctly by somebody else. Answering
+// success for a half-done clone is the one outcome that would be worse than the old stub.
+//
+// This is a COPY, not a reflink. Nothing here depends on the underlying filesystem, which is the
+// point: a container prefix on ext4 cannot reflink at all.
+
+static long clone_regular(int src_dfd, const char* src, int dst_dfd, const char* dst, int mode)
+{
+	char buf[65536];
+	long in, out, written, n;
+	long ret = 0;
+
+	in = LINUX_SYSCALL(__NR_openat, src_dfd, src, LINUX_O_RDONLY, 0);
+	if (in < 0)
+		return in;
+
+	// O_EXCL because macOS clonefile fails with EEXIST rather than overwriting.
+	out = LINUX_SYSCALL(__NR_openat, dst_dfd, dst,
+		LINUX_O_WRONLY | LINUX_O_CREAT | LINUX_O_EXCL, mode & 07777);
+	if (out < 0) {
+		LINUX_SYSCALL(__NR_close, in);
+		return out;
+	}
+
+	for (;;) {
+		n = LINUX_SYSCALL(__NR_read, in, buf, sizeof(buf));
+		if (n < 0) {
+			ret = n;
+			break;
+		}
+		if (n == 0)
+			break;
+		for (written = 0; written < n; ) {
+			long w = LINUX_SYSCALL(__NR_write, out, buf + written, n - written);
+			if (w < 0) {
+				ret = w;
+				break;
+			}
+			written += w;
+		}
+		if (ret < 0)
+			break;
+	}
+
+	LINUX_SYSCALL(__NR_close, in);
+	LINUX_SYSCALL(__NR_close, out);
+
+	// Leave no half-written file behind: a caller that sees the error must not also find a file.
+	if (ret < 0)
+		LINUX_SYSCALL(__NR_unlinkat, dst_dfd, dst, 0);
+
+	return ret;
+}
+
+static long clone_symlink(int src_dfd, const char* src, int dst_dfd, const char* dst)
+{
+	char target[4096];
+	long n;
+
+	n = LINUX_SYSCALL(__NR_readlinkat, src_dfd, src, target, sizeof(target) - 1);
+	if (n < 0)
+		return n;
+	target[n] = '\0';
+
+	return LINUX_SYSCALL(__NR_symlinkat, target, dst_dfd, dst);
+}
 
