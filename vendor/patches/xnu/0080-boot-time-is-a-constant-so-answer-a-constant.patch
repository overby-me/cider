+/* BOOT TIME IS A CONSTANT, SO ANSWER A CONSTANT. It used to be recomputed per call as
+ * gettimeofday() minus sysinfo().uptime, and sysinfo reports uptime in WHOLE SECONDS, so the two
+ * floors stepped at different moments and the answer alternated between two values ONE SECOND
+ * apart. libc derives CLOCK_MONOTONIC as gettimeofday() minus this, so CLOCK_MONOTONIC was NOT
+ * MONOTONIC: it returned a smaller value later in the same thread, and a timed loop measured a
+ * NEGATIVE elapsed time. Anything pacing itself off it can spin or fire a deadline immediately.
+ *
+ * Computed once from the Linux monotonic clock, which has nanosecond resolution, then cached for
+ * the life of the process. Caching is what makes it safe to return real microseconds: the old code
+ * had to force tv_usec to 0 because a jittering value spun the retry loop in _mach_boottime_usec,
+ * and a value that never changes cannot spin it. Task #251. */
+static uint64_t _cider_boottime_usec(void)
+{
+	static uint64_t cached = 0;
+	uint64_t boot, expected = 0;
+	struct bsd_timeval now;
+	struct timespec mono;
+
+	boot = __atomic_load_n(&cached, __ATOMIC_ACQUIRE);
+	if (boot != 0)
+		return boot;
+
+	if (sys_gettimeofday(&now, NULL) < 0)
+		return 0;
+	if (__linux_clock_gettime(CLOCK_MONOTONIC, &mono) < 0)
+		return 0;
+
+	boot = (uint64_t) now.tv_sec * 1000000ull + (uint64_t) now.tv_usec;
+	boot -= (uint64_t) mono.tv_sec * 1000000ull + (uint64_t) mono.tv_nsec / 1000ull;
+
+	/* Zero is the not-computed sentinel, and it is also a boot time of the epoch, which cannot
+	 * happen here. Nudging it by one microsecond keeps the sentinel unambiguous. */
+	if (boot == 0)
+		boot = 1;
+
+	/* FIRST WRITER WINS, because two threads computing microseconds apart would otherwise cache
+	 * two different constants and put the jitter straight back. */
+	if (!__atomic_compare_exchange_n(&cached, &expected, boot, 0, __ATOMIC_ACQ_REL,
+	                                 __ATOMIC_ACQUIRE))
+		boot = expected;
+
+	return boot;
+}
