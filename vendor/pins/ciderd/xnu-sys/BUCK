# One target carrying xnu-sys's whole compile environment: the defines,
# the warning flags, and every include root, in the reference build's order.
# Everything that compiles xnu-sys code depends on just this.
cc_header_root(
    name = "dt_env",
    exported_flags = XNU_SYS_DEFINES + XNU_SYS_FLAGS,
    deps = [
        ":dt_defines",
        ":xnu_osfmk",
        ":xnu_bsd",
        ":xnu_libkern",
        ":xnu_osfmk_libsa",
        ":xnu_pexpert",
        ":xnu_iokit",
        ":xnu_external_headers",
        ":xnu_root",
        ":dt_internal_include",
        ":dt_include",
        "//darwin/libsimple:libsimple_headers",
        "//vendor/pins/ciderd:dserver_headers",
        "//vendor/pins/ciderd:dserver_rpc",
        "//linux/startup:rtsig_header",
    ],
    visibility = ["PUBLIC"],
)

