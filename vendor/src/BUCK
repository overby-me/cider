# IOKit's four mig protocols. iokitmig is generated TWICE from one definition, once per
# arch, because iokitmig.c #includes iokitmig64.c or iokitmig32.c depending on __LP64__ --
# so both spellings have to exist even in a 64-bit-only build. The other two are compiled
# directly, through gen_srcs.

mig_gen(
    name = "IOKit_mig_iokitmig32",
    defs = "IOKitUser/iokitmig.defs",
    out_base = "IOKitUser",
    arch = "i386",
    user_suffix = "32.c",
    header_suffix = "32.h",
    server_suffix = "Server32.c",
    sheader_suffix = "Server32.h",
    xtrace_suffix = "XtraceMig32.c",
    compile_srcs = [
    ],
    mig_sh = "//vendor/src:mig.sh",
    migcom = "//vendor/src:migcom",
    # The directory's COMPILE_DEFINITIONS, which mig runs the preprocessor with. Without
    # -DIOKIT the .defs preprocesses down to almost nothing: the generated user stub came
    # out 2.8K instead of the full routine set, and IOKit's link was missing every io_*.
    mig_flags = [
        "-DAPPLE",
        "-DDISPATCH_MACH_SPI=1",
        "-DHAVE_CFPLUGIN",
        "-DHAVE_CFURLACCESS",
        "-DIOKIT",
        "-DOS_CRASH_ENABLE_EXPERIMENTAL_LIBTRACE=1",
        "-DPRIVATE",
        "-D_ANSI_C_SOURCE",
        "-D_DARWIN_NO_64_BIT_INODE=1",
        "-D_LIBC_NO_FEATURE_VERIFICATION",
        "-D__MigTypeCheck=1",
        "-Dvolatile=__volatile",
    ],
    deps = [
        "//src/darwin:sdk_env",
        ":IOKit_inc_IOKitUser",
        "//vendor/src:fw_CoreFoundation",
    ],
    visibility = ["PUBLIC"],
)

mig_gen(
    name = "IOKit_mig_iokitmig64",
    defs = "IOKitUser/iokitmig.defs",
    out_base = "IOKitUser",
    arch = "x86_64",
    user_suffix = "64.c",
    header_suffix = "64.h",
    server_suffix = "Server64.c",
    sheader_suffix = "Server64.h",
    xtrace_suffix = "XtraceMig64.c",
    compile_srcs = [
    ],
    # The XtraceMig stub, which is what makes the [xtrace] output non-empty --
    # //vendor/src:iokitmig64_dylib links exactly this one file.
    xtrace_srcs = ["iokitmigXtraceMig64.c"],
    mig_sh = "//vendor/src:mig.sh",
    migcom = "//vendor/src:migcom",
    # The directory's COMPILE_DEFINITIONS, which mig runs the preprocessor with. Without
    # -DIOKIT the .defs preprocesses down to almost nothing: the generated user stub came
    # out 2.8K instead of the full routine set, and IOKit's link was missing every io_*.
    mig_flags = [
        "-DAPPLE",
        "-DDISPATCH_MACH_SPI=1",
        "-DHAVE_CFPLUGIN",
        "-DHAVE_CFURLACCESS",
        "-DIOKIT",
        "-DOS_CRASH_ENABLE_EXPERIMENTAL_LIBTRACE=1",
        "-DPRIVATE",
        "-D_ANSI_C_SOURCE",
        "-D_DARWIN_NO_64_BIT_INODE=1",
        "-D_LIBC_NO_FEATURE_VERIFICATION",
        "-D__MigTypeCheck=1",
        "-Dvolatile=__volatile",
    ],
    deps = [
        "//src/darwin:sdk_env",
        ":IOKit_inc_IOKitUser",
        "//vendor/src:fw_CoreFoundation",
    ],
    visibility = ["PUBLIC"],
)

mig_gen(
    name = "IOKit_mig_kextmanager",
    defs = "IOKitUser/kext.subproj/kextmanager_mig.defs",
    out_base = "IOKitUser/kext.subproj",
    arch = "x86_64",
    user_suffix = "User.c",
    header_suffix = ".h",
    server_suffix = "Server.c",
    sheader_suffix = "Server.h",
    xtrace_suffix = "XtraceMig.c",
    compile_srcs = [
        "kextmanager_migUser.c",
    ],
    # The XtraceMig stub, which is what makes the [xtrace] output non-empty --
    # //vendor/src:kextmanager_dylib links exactly this one file.
    xtrace_srcs = ["kextmanager_migXtraceMig.c"],
    mig_sh = "//vendor/src:mig.sh",
    migcom = "//vendor/src:migcom",
    # The directory's COMPILE_DEFINITIONS, which mig runs the preprocessor with. Without
    # -DIOKIT the .defs preprocesses down to almost nothing: the generated user stub came
    # out 2.8K instead of the full routine set, and IOKit's link was missing every io_*.
    mig_flags = [
        "-DAPPLE",
        "-DDISPATCH_MACH_SPI=1",
        "-DHAVE_CFPLUGIN",
        "-DHAVE_CFURLACCESS",
        "-DIOKIT",
        "-DOS_CRASH_ENABLE_EXPERIMENTAL_LIBTRACE=1",
        "-DPRIVATE",
        "-D_ANSI_C_SOURCE",
        "-D_DARWIN_NO_64_BIT_INODE=1",
        "-D_LIBC_NO_FEATURE_VERIFICATION",
        "-D__MigTypeCheck=1",
        "-Dvolatile=__volatile",
    ],
    deps = [
        "//src/darwin:sdk_env",
        ":IOKit_inc_IOKitUser",
        "//vendor/src:fw_CoreFoundation",
    ],
    visibility = ["PUBLIC"],
)

