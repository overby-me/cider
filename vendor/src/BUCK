# Security's Certificates.bundle: the trust store, in the form Security actually reads.
#
# The 159 .crt files are also installed one by one under System/Library/OpenSSL/certs (that
# is what the hash links are for, and the generated prefix-dirs block below does not cover
# them either -- they arrive as ordinary FILE entries). This is the other consumer: the same
# certificates packed into the DER table and index that Security's trust evaluation opens,
# next to the EV policy roots derived from evroot.config.
#
# Hand-written because the generator cannot reach it: the install(DIRECTORY) source is a
# path in the BUILD tree, and prefix_dir globs the repo. The bundle's contents are fixed by
# the script -- two plists at the bundle root, seven plus two data files under Resources --
# so naming them costs nothing and makes the rule assert that the script still writes them.
prefix_gen_dir(
    name = "certificates_bundle",
    script = "openssl_certificates/scripts/generate-ca-bundle.py",
    # It locates its own inputs from path.realpath(__file__), so nothing on the command line
    # names them.
    srcs = glob([
        "openssl_certificates/certs/*.crt",
        "openssl_certificates/security-bundle-resources/*",
    ]),
    contents = [
        "Certificates.bundle/Contents/Info.plist",
        "Certificates.bundle/Contents/version.plist",
        "Certificates.bundle/Contents/Resources/certsIndex.data",
        "Certificates.bundle/Contents/Resources/certsTable.data",
        "Certificates.bundle/Contents/Resources/EVRoots.plist",
        "Certificates.bundle/Contents/Resources/Allowed.plist",
        "Certificates.bundle/Contents/Resources/AssetVersion.plist",
        "Certificates.bundle/Contents/Resources/Blocked.plist",
        "Certificates.bundle/Contents/Resources/GrayListedKeys.plist",
        "Certificates.bundle/Contents/Resources/AppleESCertificates.plist",
    ],
    # install(DIRECTORY .../Certificates.bundle DESTINATION .../Security) lands the bundle
    # at .../Security/Certificates.bundle, so the destination already carries the bundle
    # name and the tree merged in there starts inside it.
    strip = "Certificates.bundle",
    visibility = ["PUBLIC"],
)

# cocotron's QuartzCore headers, reached from ANOTHER package: the four frameworks that
# layer on Core Animation (IconServices, ImageKit, QuartzComposer, SceneKit) live in
# //src/darwin/frameworks and compile against these, and cocotron is an unsplit pin so its files
# belong to //vendor/src. Without a root here the generator refuses the include dir outright,
# which is the correct refusal -- a glob written into the consuming package would silently
# stage nothing.
cc_header_root(
    name = "QuartzCore_inc_cocotron_QuartzCore_include",
    headers = glob([
        "cocotron/QuartzCore/include/*.h",
        "cocotron/QuartzCore/include/**/*.h",
    ]),
    root = "cocotron/QuartzCore/include",
    visibility = ["PUBLIC"],
)

# The guest-side bridge to the HOST's libfuse, which is what lets hdiutil mount a DMG.
#
# cmake spells this wrap_elf(fuse libfuse.so) in darling-dmg/CMakeLists.txt; here it is the
# two halves that hides. elf_wrapper runs wrapgen over the host library to generate the
# forwarding stubs, and darwin_dylib builds them into a Mach-O whose install_name is the one
# a guest binary records. Everything under /usr/lib/native is this shape.
elf_wrapper(
    name = "fuse_wrap",
    soname = "libfuse.so",
    name_base = "fuse",
    wrapgen = "//src/linux/libelfloader:wrapgen",
    lib_dirs = read_root_config("cider", "elf_lib_dirs", ""),
    deps = ["//src/darwin:sdk_env"],
    visibility = ["PUBLIC"],
)

