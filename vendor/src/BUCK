    name = "crypto41_inc_libressl_2_5_5_include",
    headers = glob([
        "libressl-2.5.5/include/*.h",
        "libressl-2.5.5/include/**/*.h",
        "libressl-2.5.5/include/*.c",
        "libressl-2.5.5/include/compat/*.h",
        "libressl-2.5.5/include/compat/**/*.h",
        "libressl-2.5.5/include/compat/*.c",
    ]),
    root = "libressl-2.5.5/include",
    include_subdirs = [
        ".",
        "compat",
    ],
    visibility = ["PUBLIC"],
)

