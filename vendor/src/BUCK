# securityd's own MIG protocol. Its xtrace stub is C while its client and server are C++,
# which is why the suffixes are spelled out rather than defaulted.
mig_gen(
    name = "securitydmig_self",
    defs = "security/securityd/mig/self.defs",
    out_base = "security/securityd/mig",
    user_suffix = "User.cpp",
    header_suffix = ".h",
    server_suffix = "Server.cpp",
    sheader_suffix = "Server.h",
    xtrace_suffix = "XtraceMig.c",
    compile_srcs = [
        "selfUser.cpp",
    ],
    # securityd is both ends of self.defs: the reference compiles selfUser.cpp and
    # selfServer.cpp into the same binary.
    server_srcs = ["selfServer.cpp"],
    xtrace_srcs = ["selfXtraceMig.c"],
    mig_sh = "//vendor/src:mig.sh",
    migcom = "//vendor/src:migcom",
    deps = [
        "//src/darwin:sdk_env",
    ],
    visibility = ["PUBLIC"],
)

# tokend: the protocol Security speaks to a smartcard token daemon. Its whole mig/
# directory is GENERATED except the definition itself and a makefile, which is why the
# generated header root for SecurityTokend/mig staged empty and the archive that includes
# <tokend.h> could not be built. The generated dir is the include root instead.
#
# The -I of security/darling/include/macOS is what lets tokend.defs resolve its own
# <securityd_client/ss_types.defs>.
mig_gen(
    name = "securitytokendmig_tokend",
    defs = "SecurityTokend/mig/tokend.defs",
    out_base = "SecurityTokend/mig",
    user_suffix = "Client.cpp",
    header_suffix = ".h",
    server_suffix = "Server.cpp",
    sheader_suffix = "Server.h",
    xtrace_suffix = "XtraceMig.cpp",
    compile_srcs = [
        "tokendClient.cpp",
    ],
    # The server end goes through the [server] subtarget: SecurityTokend implements the
    # protocol and links this, while libsecurity_tokend_client is the caller and must not.
    server_srcs = ["tokendServer.cpp"],
    xtrace_srcs = ["tokendXtraceMig.cpp"],
    mig_sh = "//vendor/src:mig.sh",
    migcom = "//vendor/src:migcom",
    deps = [
        "//src/darwin:sdk_env",
        ":security_tokend_client_inc_security_darling_include_macOS",
    ],
    visibility = ["PUBLIC"],
)

# reboot and shutdown ask kextd to unload kexts over this MIG protocol, and xtrace
# loads the generated stub as a dylib of its own. mig writes no XtraceMig.c for this
# definition -- the reference `touch`es an empty one -- which the runner already handles
# by pre-creating the file, so the dylib links from an empty object exactly as it does
# in the reference.
mig_gen(
    name = "rebootmig_kextmanager",
    defs = "//vendor/src/system_cmds:reboot.tproj_kextmanager.defs",
    # The defs lives in reboot.tproj/, but reboot includes the generated header bare
    # (#include "kextmanager.h"), so the subdirectory is stripped from the stem and the
    # outputs are staged flat -- the same shape the reference produces in that directory.
    out_base = "reboot.tproj",
    user_suffix = "User.c",
    header_suffix = ".h",
    server_suffix = "Server.c",
    sheader_suffix = "Server.h",
    xtrace_suffix = "XtraceMig.c",
    compile_srcs = [
        "kextmanagerUser.c",
    ],
    xtrace_srcs = ["kextmanagerXtraceMig.c"],
    mig_sh = "//vendor/src:mig.sh",
    migcom = "//vendor/src:migcom",
    deps = [
        "//src/darwin:sdk_env",
    ],
    visibility = ["PUBLIC"],
)

