    migcom = "//vendor/src:migcom",
    deps = [
        "//vendor/src/syslog:system_asl_inc_syslog_libsystem_asl_tproj_include",
        "//src/darwin:sdk_env",
    ],
    visibility = ["PUBLIC"],
)




