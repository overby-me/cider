        # arguments, so a chain that is bounded on macOS runs off the end of a 520 KB worker stack.
        # Measured: SIGSEGV with the stack pointer inside the guard page below the stack, faulting
        # on the store of an ARGUMENT, in _dispatch_source_wakeup. LibreOffice died about eighteen
        # seconds after launch, every run, as soon as its deferred work started running at all.
        "-O2",
    ],
