load("//buck/rules:cc.bzl", "cc_objects")
load("//buck/rules:darwin.bzl", "darwin_dylib")
load("//buck/rules:files.bzl", "export_file")

# The accelerated block CRC (crc32_vec, called from bzlib.c) has a per-arch hand-written
# implementation; each file is internally #if-guarded to its arch, so the x86_64 one emits
# nothing under -target arm64 and leaves _crc32_vec undefined. Pick the matching source by
# guest arch (aarch64 port). The arm64 file ships in the upstream bzip2 pin.
_M_ARM = read_root_config("cider", "guest_arch", "x86_64") == "arm64"
_BZ_CRC32VEC = "bzip2/arm64/crc32vec.S" if _M_ARM else "bzip2/x86_64/crc32vec.S"

# Targets over the bzip2 pin, materialized by scripts/buck-src.nu. The tree
# itself is gitignored (content is pinned in nix/submodules.json); this file is
# committed. One package per pin keeps what the Nix-lowered path has to parse
# small enough to evaluate (plan/buck2-port.md phase 3).

# BEGIN generated: bz2
# GENERATED from the reference build.ninja by
# gen-buck-from-ninja (deleted) bz2   -- review before committing.
# cmake target: bz2  ->  src/external/bzip2/libbz2.1.0.dylib

cc_objects(
    name = "bz2_obj",
    srcs = [
        "bzip2/blocksort.c",
        "bzip2/bzlib.c",
        "bzip2/compress.c",
        "bzip2/crctable.c",
        "bzip2/decompress.c",
        "bzip2/huffman.c",
        "bzip2/randtable.c",
    ],
    compiler_flags = [
        "-DPRIVATE",
        "-D_FILE_OFFSET_BITS=64",
        "-D_LIBC_NO_FEATURE_VERIFICATION",
        "-Dbz2_EXPORTS",
        "-msse",
        "-msse2",
        "-msse3",
        "-w",
        "-nostdinc",
        "-D__DARWIN_UNIX03",
        "-fPIC",
        "-w",
        "-fPIC",
    ],
    toolchain = "toolchains//:darwin_cc",
    deps = [
        "//src/darwin:sdk_env",
    ],
    visibility = ["PUBLIC"],
)

darwin_dylib(
    name = "bz2_firstpass",
    dylib_name = "libbz2_firstpass.dylib",
    firstpass = True,
    install_name = "/usr/lib/libbz2.1.0.dylib",
    objs = [
        ":bz2_obj",
    ],
    toolchain = "toolchains//:darwin_cc",
    deps = ["//src/darwin:sdk_env"],
    visibility = ["PUBLIC"],
)
# END generated: bz2

