    name = "unwind_inc_libunwind_libunwind",
    headers = glob([
        "libunwind/src/*.h",
        "libunwind/src/**/*.h",
        "libunwind/include/*.h",
        "libunwind/include/**/*.h",
    ]),
    root = "libunwind",
    include_subdirs = [
        "src",
        "include",
    ],
    visibility = ["PUBLIC"],
)

