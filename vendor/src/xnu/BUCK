# The mig exception SERVER, in its own object target for two reasons the emulation
# target cannot satisfy at once:
#
#   * it must NOT be compiled -fvisibility=hidden. libsystem_kernel exports _exc_server
#     (a cmake-built one does; nm shows it in __TEXT), and everything in emulation is
#     hidden, so riding along there compiled the code in but exported nothing.
#   * catch_exception_raise* must be redirected to the internal_ names that libsyscall's
#     exc_catcher.c defines -- but ONLY here. exc_catcher.c itself calls
#     catch_exception_raise (it dlsyms the user's handler), so defining the macro across
#     libsyscall would rewrite that call into a recursive one.
#
# nix's boehm-gc binds _exc_server, so without this the guest nix cannot load at all.
cc_objects(
    name = "exc_server_obj",
    srcs = [],
    gen_srcs = ["//vendor/src:emmig_signal_exc"],
    compiler_flags = [
        "-std=gnu99",
        "-fPIC",
        "-Dcatch_exception_raise=internal_catch_exception_raise",
        "-Dcatch_exception_raise_state=internal_catch_exception_raise_state",
        "-Dcatch_exception_raise_state_identity=internal_catch_exception_raise_state_identity",
    ],
    toolchain = "toolchains//:darwin_cc",
    deps = [
        "//src/darwin:sdk_env",
        "//vendor/src/xnu:emulation_included_sources",
        "//src/darwin/include:cider_config",
        "//src/linux/startup:rtsig_header",
        ":emulation_inc_xnu_darling_src_libsystem_kernel",
        "//vendor/pins/ciderd:dserver_headers",
        "//src/darwin/libsimple:libsimple_headers",
    ],
    visibility = ["PUBLIC"],
)
