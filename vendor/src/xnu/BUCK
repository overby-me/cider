# Darling's syscall emulation layer #INCLUDES .c files (helper/xattr/*_generic.c
# and friends), so the root staging its tree has to carry sources as well as
# headers. A headers-only root leaves those includes unresolved.
cc_header_root(
    name = "emulation_included_sources",
